{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build thesis (latexmk pdflatex, macOS)",
      "type": "shell",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-cd",
        "-pdf",
        "-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "${workspaceFolder}/docs/thesis/thesis.tex"
      ],
      "options": {
        "env": {
          "PATH": "/Library/TeX/texbin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "linux": { "hide": true },
      "windows": { "hide": true }
    },
    {
      "label": "Build thesis (latexmk pdflatex, Windows)",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-cd",
        "-pdf",
        "-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "${workspaceFolder}/docs/thesis/thesis.tex"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "windows": {
        "options": {
          "env": {
            "PATH": "${env:LOCALAPPDATA}\\Programs\\MiKTeX\\miktex\\bin\\x64;C:\\Strawberry\\perl\\bin;${env:PATH}"
          }
        }
      }
    }
  ]
}
