{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BanterExecutionRoleBootstrap",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:CreateRole", "iam:AttachRolePolicy"],
      "Resource": "arn:aws:iam::710271938540:role/banter-sagemaker-execution-role"
    },
    {
      "Sid": "BanterPassExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::710271938540:role/banter-sagemaker-execution-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "sagemaker.amazonaws.com" }
      }
    },
    {
      "Sid": "BanterQuotaDiscovery",
      "Effect": "Allow",
      "Action": [
        "servicequotas:ListServiceQuotas",
        "servicequotas:GetServiceQuota",
        "servicequotas:ListAWSDefaultServiceQuotas",
        "servicequotas:GetAWSDefaultServiceQuota"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BanterVectorStore",
      "Effect": "Allow",
      "Action": "s3vectors:*",
      "Resource": "*"
    },
    {
      "Sid": "BanterLogFilter",
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": "arn:aws:logs:*:710271938540:log-group:/aws/sagemaker/*"
    },
    {
      "Sid": "BanterTeardownLogSweep",
      "Effect": "Allow",
      "Action": "logs:DeleteLogGroup",
      "Resource": "arn:aws:logs:*:710271938540:log-group:/aws/sagemaker/*"
    }
  ]
}
