runs/
# setuptools editable-install metadata (auto-generated build output)
*.egg-info/
src/banter.egg-info/
# interfaces/ tracks ONLY source + config (config.yaml, *.py, pyproject.toml,
# SKILL.md, autoresearch/benchmark *.yaml). Everything preflight builds or checks
# out into it — wheels, bare binaries (hops, *-mcp), build/dist dirs, egg-info,
# cloned repos under src/ — is a build artifact and ignored.
# NOTE: gitignore has no inline comments, so keep these on their own lines.
# Ignore everything, then re-include directories + the source/config files.
interfaces/**
!interfaces/**/
!interfaces/**/*.yaml
!interfaces/**/*.py
!interfaces/**/pyproject.toml
!interfaces/**/*.md
!interfaces/**/.gitkeep
# Never track cloned remote repos or build dirs (they may contain *.py/*.yaml).
interfaces/**/src/
interfaces/**/build/
interfaces/**/dist/
interfaces/**/*.egg-info/
__pycache__/
.venv/
.env
.python-version
.kaggle/
cache/
.DS_Store
config/
.claude-oauth
# scratch dirs from ad-hoc probes — should never be committed
.runtime/
_sbxtest/
_denytest/
