runs/
# results/ holds generated run output (autoresearch + benchmark): engineer
# artifacts, .claude state, HOME-redirect Library/, per-version trees, csvs.
# Keep the folders (via .gitkeep) but never commit their contents.
results/autoresearch/*
!results/autoresearch/.gitkeep
results/benchmark/*
!results/benchmark/.gitkeep
# setuptools editable-install metadata (auto-generated build output)
*.egg-info/
src/banter.egg-info/
# platforms/ tracks ONLY source + config (config.yaml, *.py, pyproject.toml,
# SKILL.md, autoresearch/benchmark *.yaml). Everything preflight builds or checks
# out into it — wheels, bare binaries (hops, *-mcp), build/dist dirs, egg-info,
# cloned repos under src/ — is a build artifact and ignored.
# NOTE: gitignore has no inline comments, so keep these on their own lines.
# Ignore everything, then re-include directories + the source/config files.
platforms/**
!platforms/**/
!platforms/**/*.yaml
!platforms/**/*.md
!platforms/**/.gitkeep
# Source code (*.py) is committed ONLY for mlkit (its source IS the base). Every
# other platform's interface source is CHECKED OUT (git clone / local copy) into
# the folder at build time — a build artifact, so it stays ignored.
!platforms/mlkit/**/*.py
# pyproject.toml is NOT re-included: where a config.yaml has a `package:` block
# it's generated at build time (a build artifact), so it stays ignored.
# Never track build artifacts: built wheels, cloned/built src dirs, build/dist.
platforms/**/*.whl
platforms/**/src/
platforms/**/build/
platforms/**/dist/
platforms/**/*.egg-info/
__pycache__/
.ruff_cache/
.venv/
.env
.python-version
.kaggle/
cache/
.DS_Store
config/
.claude-oauth
# scratch dirs from ad-hoc probes — should never be committed
.runtime/
_sbxtest/
_denytest/
