runs/
# results/ holds generated run output: agent artifacts, .claude state,
# HOME-redirect Library/, per-run trees, csvs.
# Keep the folder (via .gitkeep) but never commit its contents.
results/*
!results/.gitkeep
# setuptools editable-install metadata (auto-generated build output)
*.egg-info/
src/banter.egg-info/
# configs/ holds yaml manifests plus committed platform CONTENT (skills
# SKILL.md trees, setup/teardown .py files). build/ is the gitignored BUILD
# HOME ($INTERFACE_DIR): source checkouts + built wheels/binaries, rebuilt on
# demand.
build/
__pycache__/
.ruff_cache/
.venv/
.env
.python-version
.kaggle/
cache/
.DS_Store
config/
.claude-oauth
# scratch dirs from ad-hoc probes — should never be committed
.runtime/
_sbxtest/
_denytest/
