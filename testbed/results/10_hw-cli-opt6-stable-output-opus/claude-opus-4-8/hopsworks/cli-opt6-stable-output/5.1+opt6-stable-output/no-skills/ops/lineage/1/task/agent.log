[agent:result] def fg_derive(
[agent:result]     ctx: click.Context,
[agent:result]     name: str,
[agent:result]     base_fg: str,
[agent:result]     joins: tuple[str, ...],
[agent:result]     primary_key: str,
[agent:result]     event_time: str | None,
[agent:result]     online: bool,
[agent:result]     description: str,
[agent:result] ) -> None:
[agent:result]     """Create a new feature group derived from joining existing ones.
[agent:result] 
[agent:result]     Args:
[agent:result]         ctx: Click context.
[agent:result]         name: Derived feature group name.
[agent:result]         base_fg: Base feature group on the left side of the join.
[agent:result]         joins: One or more join specs.
[agent:result]         primary_key: Comma-separated primary keys.
[agent:result]         event_time: Event-time column for the derived FG.
[agent:result]         online: Whether to enable online storage.
[agent:result]         description: Free-form description.
[agent:result]     """
[agent:result]     fs = session.get_feature_store(ctx)
[agent:result]     try:
[agent:result]         base = fs.get_feature_group(base_fg)
[agent:result]     except Exception as exc:  # noqa: BLE001
[agent:result]         raise click.ClickException(f"Base FG '{base_fg}' not found: {exc}") from exc
[agent:result] 
[agent:result]     query = base.select_all()
[agent:result]     parents = [base]
[agent:result]     for raw in joins:
[agent:result]         spec = _parse_join(raw)
[agent:result]         try:
[agent:result]             other = fs.get_feature_group(spec.fg_name, version=spec.version)
[agent:result]         except Exception as exc:  # noqa: BLE001
[agent:result]             raise click.ClickException(
[agent:result]                 f"Joined FG '{spec.fg_name}' not found: {exc}"
[agent:result]             ) from exc
[agent:result]         parents.append(other)
[agent:result]         query = query.join(
[agent:result]             other.select_all(),
[agent:result]             on=[spec.on] if not spec.right_on else None,
[agent:result]             left_on=[spec.on] if spec.right_on else None,
[agent:result]             right_on=[spec.right_on] if spec.right_on else None,
[agent:result]             join_type=spec.join_type.lower(),
[agent:result]             prefix=spec.prefix,
[agent:result]         )
[agent:result] 
[agent:result]     try:
[agent:result]         fg = fs.create_feature_group(
[agent:result]             name=name,
[agent:result]             description=description or f"Derived from {base_fg}",
[agent:result]             primary_key=_split_csv(primary_key) or None,
[agent:result]             event_time=event_time,
[agent:result]             online_enabled=online,
[agent:result]             parents=parents,
[agent:result]         )
[agent:result]         fg.insert(query.read())
[agent:result]     except Exception as exc:  # noqa: BLE001
[agent:result]         raise click.ClickException(f"Could not derive feature group: {exc}") from exc
[agent:result] 
