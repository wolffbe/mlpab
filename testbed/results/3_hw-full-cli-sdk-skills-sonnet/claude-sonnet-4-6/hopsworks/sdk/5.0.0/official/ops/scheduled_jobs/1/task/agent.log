[agent:result] def _dt_to_ms(v):
[agent:result]     """Serialise a datetime to epoch milliseconds.
[agent:result] 
[agent:result]     Naive datetimes are treated as UTC — the backend JobSchedule model stores instants
[agent:result]     in UTC, and `datetime.timestamp()` on a naive value would otherwise interpret it
[agent:result]     in the client machine's local timezone and silently shift scheduled times by the
[agent:result]     local offset on any client outside UTC. Mirrors the `_to_iso` convention in
[agent:result]     `execution_api.py`.
[agent:result]     """
[agent:result]     if v is None:
[agent:result]         return None
[agent:result]     if v.tzinfo is None or v.tzinfo.utcoffset(v) is None:
[agent:result]         v = v.replace(tzinfo=timezone.utc)
[agent:result]     return int(v.timestamp() * 1000.0)
[agent:result] 
