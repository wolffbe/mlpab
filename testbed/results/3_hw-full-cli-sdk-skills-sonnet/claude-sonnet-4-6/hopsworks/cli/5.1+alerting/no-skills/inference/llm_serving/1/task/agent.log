[agent:result] """A tiny deterministic pure-python "language model".
[agent:result] 
[agent:result] Character-trigram log-likelihood scorer: every trigram of the input text
[agent:result] contributes a weight derived from fixed constants; the score is the sum,
[agent:result] rounded to 6 decimal places. No dependencies beyond the standard library;
[agent:result] fully deterministic — the same text always yields the same score.
[agent:result] 
[agent:result]     >>> from scorer import score
[agent:result]     >>> score("hello world")
[agent:result]     {"score": ...}
[agent:result] """
[agent:result] import json
[agent:result] import math
[agent:result] import sys
[agent:result] 
[agent:result] # model weights (fixed at training time — do not change)
[agent:result] A = 2.382892
[agent:result] B = 2.613343
[agent:result] C = 0.566573
[agent:result] D = -0.845423
[agent:result] 
[agent:result] 
[agent:result] def _trigram_weight(tri):
[agent:result]     o0, o1, o2 = (ord(ch) for ch in tri)
[agent:result]     return math.sin(A * o0 + B * o1 + C * o2 + D)
[agent:result] 
[agent:result] 
[agent:result] def score(text):
[agent:result]     """Log-likelihood of `text` under the trigram model."""
[agent:result]     ll = 0.0
[agent:result]     for i in range(len(text) - 2):
[agent:result]         ll += _trigram_weight(text[i:i + 3])
[agent:result]     return {"score": round(ll, 6)}
[agent:result] 
[agent:result] 
[agent:result] if __name__ == "__main__":
[agent:result]     payload = sys.argv[1] if len(sys.argv) > 1 else sys.stdin.read()
[agent:result]     print(json.dumps(score(payload)))
