[agent] Online read works and matches the CSV. Now I'll loop over all 20 lookup keys through the online read path and assemble `answers.json` using only the CLI + bash builtins/grep:
[agent:bash] mkdir -p submission
[agent:bash] body=""
[agent:bash] first=1
[agent:bash] while IFS= read -r key || [ -n "$key" ]; do
[agent:bash]   key="${key//[$'\r\n ']/}"
[agent:bash]   [ -z "$key" ] && continue
[agent:bash]   json=$(hops --quiet --json fv get profiles4857af_fv --version 1 --entry "account_id=$key" 2>/dev/null)
[agent:bash]   vals=()
[agent:bash]   while IFS= read -r line; do
[agent:bash]     n="${line//[, ]/}"
[agent:bash]     vals+=("$n")
[agent:bash]   done < <(printf '%s\n' "$json" | grep -E '^[[:space:]]*-?[0-9]+(\.[0-9]+)?,?[[:space:]]*$')
[agent:bash]   if [ "${#vals[@]}" -ne 4 ]; then
[agent:bash]     echo "WARN: key $key returned ${#vals[@]} numeric values: ${vals[*]}" >&2
[agent:bash]   fi
[agent:bash]   entry="\"$key\": [${vals[0]}, ${vals[1]}, ${vals[2]}, ${vals[3]}]"
[agent:bash]   if [ $first -eq 1 ]; then first=0; body="$entry"; else body="$body, $entry"; fi
[agent:bash] done < data/lookup_keys.txt
[agent:bash] printf '{"vectors": {%s}}\n' "$body" > submission/answers.json
