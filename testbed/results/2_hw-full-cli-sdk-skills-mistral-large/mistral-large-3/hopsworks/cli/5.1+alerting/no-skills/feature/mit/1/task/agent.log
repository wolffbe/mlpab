[agent:result] content: -- Create a materialized view for the derived feature group
[agent:result] CREATE OR REPLACE TABLE `features1af3ec` AS
[agent:result] SELECT
[agent:result]     t.row_id,
[agent:result]     t.account_id,
[agent:result]     t.event_time,
[agent:result]     t.amount * f.fx_rate AS amount_usd,
[agent:result]     CASE
[agent:result]         WHEN DAYOFWEEK(FROM_UNIXTIME(t.event_time / 1000)) IN (1, 7) THEN 1
[agent:result]         ELSE 0
[agent:result]     END AS is_weekend,
[agent:result]     SUM(t.amount) OVER (
[agent:result]         PARTITION BY t.account_id
[agent:result]         ORDER BY t.event_time
[agent:result]         RANGE BETWEEN INTERVAL '7' DAY PRECEDING AND CURRENT ROW
[agent:result]     ) AS amount_7d
[agent:result] FROM
[agent:result]     `transactions_raw_1` t
[agent:result] LEFT JOIN
[agent:result]     `fx_rates_raw_1` f
[agent:result] ON
[agent:result]     t.currency = f.currency;
