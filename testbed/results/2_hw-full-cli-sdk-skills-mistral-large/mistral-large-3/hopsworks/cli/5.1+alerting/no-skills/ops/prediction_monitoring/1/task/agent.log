[agent:bash] python3 -c "
[agent:bash] import sys
[agent:bash] import json
[agent:bash] from collections import defaultdict
[agent:bash] 
[agent:bash] # Initialize data structures
[agent:bash] daily_stats = defaultdict(lambda: {'sum': 0.0, 'sum_sq': 0.0, 'count': 0})
[agent:bash] 
[agent:bash] # Read the prediction log in chunks
[agent:bash] with open('data/prediction_log.csv', 'r') as f:
[agent:bash]     header = f.readline()  # Skip header
[agent:bash]     for line in f:
[agent:bash]         ts, prediction = line.strip().split(',')
[agent:bash]         day = ts.split('T')[0]
[agent:bash]         prediction = float(prediction)
[agent:bash]         daily_stats[day]['sum'] += prediction
[agent:bash]         daily_stats[day]['sum_sq'] += prediction ** 2
[agent:bash]         daily_stats[day]['count'] += 1
[agent:bash] 
[agent:bash] # Compute daily mean and std
[agent:bash] days = sorted(daily_stats.keys())
[agent:bash] stats = []
[agent:bash] for day in days:
[agent:bash]     data = daily_stats[day]
[agent:bash]     mean = data['sum'] / data['count']
[agent:bash]     variance = (data['sum_sq'] / data['count']) - (mean ** 2)
[agent:bash]     std = variance ** 0.5
[agent:bash]     stats.append({'day': day, 'mean': mean, 'std': std})
[agent:bash] 
[agent:bash] # Compute rolling averages
[agent:bash] for i in range(len(stats)):
[agent:bash]     window = stats[max(0, i-1):i+2]
[agent:bash]     rolling_mean = sum(s['mean'] for s in window) / len(window)
[agent:bash]     stats[i]['rolling_mean'] = rolling_mean
[agent:bash] 
[agent:bash] # Identify the shift onset
[agent:bash] shift_threshold = 0.5
[agent:bash] shift_onset = None
[agent:bash] for i in range(1, len(stats)):
[agent:bash]     mean_diff = abs(stats[i]['rolling_mean'] - stats[i-1]['rolling_mean'])
[agent:bash]     if mean_diff > shift_threshold:
[agent:bash]         shift_onset = stats[i]['day']
[agent:bash]         break
[agent:bash] 
[agent:bash] # Write the result
[agent:bash] result = {'onset': shift_onset if shift_onset else '1970-01-01'}
