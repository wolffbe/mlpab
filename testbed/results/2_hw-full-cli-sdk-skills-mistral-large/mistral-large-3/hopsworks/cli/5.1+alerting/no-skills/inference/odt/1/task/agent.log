[agent:result] content: from hopsworks.core import transformation_function
[agent:result] from math import sqrt
[agent:result] 
[agent:result] @transformation_function
[agent:result] def compute_distance_and_score(request_lat: float, request_lon: float, home_lat: float, home_lon: float, base_score: float) -> tuple[float, float]:
[agent:result]     distance_deg = sqrt((request_lat - home_lat) ** 2 + (request_lon - home_lon) ** 2)
[agent:result]     distance_deg = round(distance_deg, 6)
[agent:result]     score = base_score - 0.1 * distance_deg
[agent:result]     score = round(score, 6)
[agent:result]     return distance_deg, score
