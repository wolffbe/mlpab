[agent:bash] hops td create churntraining1e2e16 --version 1 --description "Training dataset for churn prediction, version 1" --query "SELECT l.account_id, l.label_time, t.amount, t.balance, p.credit_score, p.tier, a.sessions_7d, h.health_score, l.churned FROM (SELECT account_id, label_time, churned, ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY label_time) as rn FROM hopsfs.\"Resources/labels_augmented.csv\" WHERE source = 'labels') l LEFT JOIN LATERAL (SELECT amount, balance FROM hopsfs.\"Resources/transactions_augmented.csv\" WHERE account_id = l.account_id AND event_time <= l.label_time AND source = 'transactions' ORDER BY event_time DESC LIMIT 1) t ON true LEFT JOIN LATERAL (SELECT amount as amount_late, balance as balance_late FROM hopsfs.\"Resources/transactions_late_augmented.csv\" WHERE account_id = l.account_id AND event_time <= l.label_time AND source = 'transactions_late' ORDER BY event_time DESC LIMIT 1) tl ON true LEFT JOIN LATERAL (SELECT credit_score, tier FROM hopsfs.\"Resources/profiles_augmented.csv\" WHERE account_id = l.account_id AND event_time <= l.label_time AND source = 'profiles' ORDER BY event_time DESC LIMIT 1) p ON true LEFT JOIN LATERAL (SELECT sessions_7d FROM hopsfs.\"Resources/activity_augmented.csv\" WHERE account_id = l.account_id AND event_time <= l.label_time AND source = 'activity' ORDER BY event_time DESC LIMIT 1) a ON true LEFT JOIN LATERAL (SELECT health_score FROM hopsfs.\"Resources/account_health_augmented.csv\" WHERE account_id = l.account_id AND event_time <= l.label_time AND source = 'account_health' ORDER BY event_time DESC LIMIT 1) h ON true WHERE l.rn = 1" --format csv --json
