[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Script to ingest daily increments into the feature group `incremental97a30c`.
[agent:result] This script is designed to run as a Hopsworks job.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import os
[agent:result] 
[agent:result] def ingest_increment():
[agent:result]     # Connect to Hopsworks
[agent:result]     project = hopsworks.login()
[agent:result]     fs = project.get_feature_store()
[agent:result]     
[agent:result]     # Get the feature group
[agent:result]     fg = fs.get_feature_group("incremental97a30c", version=1)
[agent:result]     
[agent:result]     # List all increment files in Resources
[agent:result]     resources_dir = "/Projects/{}/Resources/".format(project.projectname)
[agent:result]     increment_files = [f for f in os.listdir(resources_dir) if f.startswith("increment_") and f.endswith(".csv")]
[agent:result]     
[agent:result]     # Sort files to ensure chronological order
[agent:result]     increment_files.sort()
[agent:result]     
[agent:result]     # Read and insert each file
[agent:result]     for file in increment_files:
[agent:result]         file_path = os.path.join(resources_dir, file)
[agent:result]         df = pd.read_csv(file_path)
[agent:result]         print(f"Inserting {file} with {len(df)} rows...")
[agent:result]         fg.insert(df, write_options={"start_offline_materialization": True})
[agent:result]         print(f"Inserted {file} successfully.")
[agent:result] 
[agent:result] if __name__ == "__main__":
[agent:result]     ingest_increment()
