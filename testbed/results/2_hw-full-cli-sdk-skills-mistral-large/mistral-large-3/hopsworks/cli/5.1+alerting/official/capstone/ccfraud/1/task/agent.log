[agent:result]     a = (
[agent:result]         math.sin(dLat / 2) * math.sin(dLat / 2) +
[agent:result]         math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) *
[agent:result]         math.sin(dLon / 2) * math.sin(dLon / 2)
[agent:result]     )
[agent:result]     c = 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))
[agent:result]     return R * c
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] mr = project.get_model_registry()
[agent:result] 
[agent:result] # Read input data
[agent:result] score_df = pd.read_csv("/hopsfs/Resources/score_transactions.csv")
[agent:result] 
[agent:result] # Convert datetime to pandas datetime
[agent:result] score_df["datetime"] = pd.to_datetime(score_df["datetime"])
[agent:result] 
[agent:result] # Sort by cc_num and datetime for rolling calculations
[agent:result] score_df = score_df.sort_values(["cc_num", "datetime"])
[agent:result] 
[agent:result] # Feature 1: Transaction velocity (count per card in the last hour)
[agent:result] # Group by card and calculate rolling count
[agent:result] velocity = (
[agent:result]     score_df.set_index("datetime")
[agent:result]     .groupby("cc_num")
[agent:result]     .rolling("1h")
[agent:result]     .transaction_id.count()
[agent:result]     .reset_index()
[agent:result]     .rename(columns={"transaction_id": "velocity_1h"})
[agent:result] )
[agent:result] score_df = score_df.merge(velocity, on=["cc_num", "datetime"], how="left")
[agent:result] 
[agent:result] # Feature 2: Geo distance from the card's "home" location (first transaction in training data)
[agent:result] # Fetch home locations from the training feature group
[agent:result] train_fg = fs.get_feature_group("cctxnc444ca", version=1)
[agent:result] train_df = train_fg.read()
[agent:result] home_locations = train_df.groupby("cc_num").first()[["lat", "long"]]
[agent:result] score_df["home_lat"] = score_df["cc_num"].map(home_locations["lat"])
[agent:result] score_df["home_long"] = score_df["cc_num"].map(home_locations["long"])
[agent:result] score_df["geo_distance_km"] = score_df.apply(
[agent:result]     lambda row: haversine(
[agent:result]         row["home_lat"], row["home_long"], row["lat"], row["long"]
[agent:result]     ) if not pd.isna(row["home_lat"]) else np.nan,
[agent:result]     axis=1,
[agent:result] )
[agent:result] 
[agent:result] # Feature 3: Rolling average amount per card in the last hour
[agent:result] amount_avg = (
[agent:result]     score_df.set_index("datetime")
[agent:result]     .groupby("cc_num")
[agent:result]     .rolling("1h")
[agent:result]     .amount.mean()
[agent:result]     .reset_index()
[agent:result]     .rename(columns={"amount": "amount_rolling_avg_1h"})
[agent:result] )
[agent:result] score_df = score_df.merge(amount_avg, on=["cc_num", "datetime"], how="left")
[agent:result] 
[agent:result] # Drop temporary columns
[agent:result] score_df = score_df.drop(columns=["home_lat", "home_long"])
[agent:result] 
[agent:result] # Load model
[agent:result] model = mr.get_model("ccmodelc444ca", version=1)
[agent:result] model_dir = model.download()
[agent:result] clf = joblib.load(f"{model_dir}/fraud_model.pkl")
[agent:result] 
[agent:result] # Prepare features for scoring
[agent:result] X = score_df.drop(columns=["transaction_id", "datetime", "merchant", "category"])
[agent:result] 
[agent:result] # Fill missing values with 0 (for new cards or missing features)
[agent:result] X = X.fillna(0)
[agent:result] 
[agent:result] # Predict
[agent:result] score_df["fraud_probability"] = clf.predict_proba(X)[:, 1]
[agent:result] 
[agent:result] # Write predictions to feature group
[agent:result] pred_fg = fs.get_feature_group("ccpredc444ca", version=1)
[agent:result] pred_fg.insert(score_df[["transaction_id", "fraud_probability"]], write_options={"wait_for_job": True})
