[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Train a fraud classifier using the training dataset and register it as ccmodelc444ca.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] from sklearn.ensemble import RandomForestClassifier
[agent:result] from sklearn.metrics import roc_auc_score, classification_report
[agent:result] import joblib
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] mr = project.get_model_registry()
[agent:result] 
[agent:result] # Read training dataset
[agent:result] td = fs.get_training_dataset("cctfv444ca", version=1)
[agent:result] df = td.read()
[agent:result] 
[agent:result] # Split into features and label
[agent:result] X = df.drop(columns=["is_fraud", "datetime"])
[agent:result] y = df["is_fraud"]
[agent:result] 
[agent:result] # Train a RandomForest classifier
[agent:result] clf = RandomForestClassifier(n_estimators=100, random_state=42, class_weight="balanced")
[agent:result] clf.fit(X, y)
[agent:result] 
[agent:result] # Predict and evaluate
[agent:result] y_pred_proba = clf.predict_proba(X)[:, 1]
[agent:result] auc = roc_auc_score(y, y_pred_proba)
[agent:result] print(f"ROC AUC: {auc:.4f}")
[agent:result] print(classification_report(y, clf.predict(X)))
[agent:result] 
[agent:result] # Save model and metrics
[agent:result] joblib.dump(clf, "fraud_model.pkl")
[agent:result] metrics = {
[agent:result]     "roc_auc": auc,
[agent:result]     "classification_report": classification_report(y, clf.predict(X), output_dict=True)
[agent:result] }
[agent:result] 
[agent:result] # Register model
[agent:result] model = mr.python.create_model(
[agent:result]     name="ccmodelc444ca",
[agent:result]     description="Fraud detection classifier",
[agent:result]     metrics=metrics,
[agent:result] )
[agent:result] model.save("fraud_model.pkl")
[agent:result] 
[agent:result] print("Model trained and registered successfully.")
