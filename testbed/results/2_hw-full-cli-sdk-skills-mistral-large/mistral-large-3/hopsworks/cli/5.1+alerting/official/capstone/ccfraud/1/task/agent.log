[agent:result] bytes_written: 2026
[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Feature engineering for credit card fraud detection.
[agent:result] Ingests transactions.csv, engineers features, and writes to feature group cctxnc444ca.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from datetime import datetime, timedelta
[agent:result] from geopy.distance import geodesic
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Read input data
[agent:result] transactions_df = pd.read_csv("data/transactions.csv")
[agent:result] 
[agent:result] # Convert datetime to pandas datetime
[agent:result] transactions_df["datetime"] = pd.to_datetime(transactions_df["datetime"])
[agent:result] 
[agent:result] # Sort by cc_num and datetime for rolling calculations
[agent:result] transactions_df = transactions_df.sort_values(["cc_num", "datetime"])
[agent:result] 
[agent:result] # Feature 1: Transaction velocity (count per card in the last hour)
[agent:result] transactions_df["velocity_1h"] = (
[agent:result]     transactions_df.groupby("cc_num")["transaction_id"]
[agent:result]     .rolling("1h", on="datetime")
[agent:result]     .count()
[agent:result]     .reset_index(level=0, drop=True)
[agent:result]     .values
[agent:result] )
[agent:result] 
[agent:result] # Feature 2: Geo distance from the card's "home" location (first transaction)
[agent:result] home_locations = transactions_df.groupby("cc_num").first()["lat", "long"]
[agent:result] transactions_df["home_lat"] = transactions_df["cc_num"].map(home_locations["lat"])
[agent:result] transactions_df["home_long"] = transactions_df["cc_num"].map(home_locations["long"])
[agent:result] transactions_df["geo_distance_km"] = transactions_df.apply(
[agent:result]     lambda row: geodesic(
[agent:result]         (row["home_lat"], row["home_long"]), (row["lat"], row["long"])
[agent:result]     ).km,
[agent:result]     axis=1,
[agent:result] )
[agent:result] 
[agent:result] # Feature 3: Rolling average amount per card in the last hour
[agent:result] transactions_df["amount_rolling_avg_1h"] = (
[agent:result]     transactions_df.groupby("cc_num")["amount"]
[agent:result]     .rolling("1h", on="datetime")
[agent:result]     .mean()
[agent:result]     .reset_index(level=0, drop=True)
[agent:result]     .values
[agent:result] )
[agent:result] 
[agent:result] # Drop temporary columns
[agent:result] transactions_df = transactions_df.drop(columns=["home_lat", "home_long"])
[agent:result] 
[agent:result] # Write to feature group
[agent:result] fg = fs.get_feature_group("cctxnc444ca", version=1)
[agent:result] fg.insert(transactions_df, write_options={"wait_for_job": True})
[agent:result] 
[agent:result] print("Feature engineering and ingestion completed successfully.")
