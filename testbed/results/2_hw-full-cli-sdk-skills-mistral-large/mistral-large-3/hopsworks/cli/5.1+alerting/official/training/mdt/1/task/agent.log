[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Standardize features (f1, f2, f3, f4) using training split statistics and insert into scaled21081b.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Load raw data
[agent:result] train_fg = fs.get_feature_group("temp_train_raw", version=1)
[agent:result] train_df = train_fg.read()
[agent:result] 
[agent:result] serve_fg = fs.get_feature_group("temp_serve_raw", version=1)
[agent:result] serve_df = serve_fg.read()
[agent:result] 
[agent:result] # Compute statistics (mean, std) for training split
[agent:result] stats = train_df.agg({
[agent:result]     "f1": ["mean", "std"],
[agent:result]     "f2": ["mean", "std"],
[agent:result]     "f3": ["mean", "std"],
[agent:result]     "f4": ["mean", "std"]
[agent:result] }).T
[agent:result] 
[agent:result] stats.columns = ["mean", "std"]
[agent:result] stats["std"] = stats["std"].fillna(1.0)  # Avoid division by zero
[agent:result] 
[agent:result] # Standardize both splits
[agent:result] def standardize(df, split_name):
[agent:result]     df = df.copy()
[agent:result]     for col in ["f1", "f2", "f3", "f4"]:
[agent:result]         df[col] = ((df[col] - stats.loc[col, "mean"]) / stats.loc[col, "std"]).round(6)
[agent:result]     df["split"] = split_name
[agent:result]     return df
[agent:result] 
[agent:result] standardized_train = standardize(train_df, "train")
[agent:result] standardized_serve = standardize(serve_df, "serve")
[agent:result] 
[agent:result] # Combine and insert into scaled21081b
[agent:result] standardized_df = pd.concat([standardized_train, standardized_serve], ignore_index=True)
[agent:result] scaled_fg = fs.get_feature_group("scaled21081b", version=1)
[agent:result] scaled_fg.insert(standardized_df, write_options={"wait_for_job": True})
[agent:result] 
[agent:result] print("Standardization complete. Inserted rows:", len(standardized_df))
