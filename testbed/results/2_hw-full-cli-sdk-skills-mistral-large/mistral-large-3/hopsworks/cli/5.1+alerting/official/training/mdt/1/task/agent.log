[agent:bash] # Compute mean and std for each feature (population std, no Bessel's correction)
[agent:bash] stats = train.agg(['mean', 'std']).T
[agent:bash] stats['std'] = stats['std'].fillna(1.0)  # Avoid division by zero if std=0
[agent:bash] 
[agent:bash] # Standardize training and serving splits
