[agent:bash]         df[col] = ((df[col] - stats.loc[col, 'mean']) / stats.loc[col, 'std']).round(6)
[agent:bash]     df['split'] = split_name
[agent:bash]     df.to_csv(f'{split_name}_standardized.csv', index=False)
