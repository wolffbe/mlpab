[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Read the data files
[agent:result] requests_df = pd.read_csv('data/requests.csv')
[agent:result] profiles_df = pd.read_csv('data/profiles.csv')
[agent:result] 
[agent:result] # Merge requests with profiles on account_id
[agent:result] merged_df = pd.merge(requests_df, profiles_df, on='account_id', how='left')
[agent:result] 
[agent:result] # Calculate distance_deg and score
[agent:result] def calculate_distance(row):
[agent:result]     lat_diff = row['request_lat'] - row['home_lat']
[agent:result]     lon_diff = row['request_lon'] - row['home_lon']
[agent:result]     distance = sqrt(lat_diff**2 + lon_diff**2)
[agent:result]     return round(distance, 6)
[agent:result] 
[agent:result] merged_df['distance_deg'] = merged_df.apply(calculate_distance, axis=1)
[agent:result] merged_df['score'] = round(merged_df['base_score'] - 0.1 * merged_df['distance_deg'], 6)
[agent:result] 
[agent:result] # Select only the required columns
[agent:result] result_df = merged_df[['request_id', 'account_id', 'distance_deg', 'score']]
[agent:result] 
[agent:result] # Create the feature group
[agent:result] fg = fs.create_feature_group(
[agent:result]     name='scored9c0a6e',
[agent:result]     version=1,
[agent:result]     description='Feature table with request scoring based on distance from home location',
[agent:result]     primary_key=['request_id'],
[agent:result]     online_enabled=True,  # Enable online access for low-latency lookup
[agent:result]     statistics_config=False  # Disable statistics to speed up the process
[agent:result] )
[agent:result] 
[agent:result] # Insert the data into the feature group
[agent:result] fg.insert(result_df, wait=True)
[agent:result] 
