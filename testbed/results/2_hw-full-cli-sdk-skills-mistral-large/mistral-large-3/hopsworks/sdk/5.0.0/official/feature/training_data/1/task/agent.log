[agent:result] 
[agent:result] # Convert event_time and label_time to numeric (epoch ms)
[agent:result] for df in [transactions, profiles, activity, account_health]:
[agent:result]     df["event_time"] = pd.to_numeric(df["event_time"], errors="coerce")
[agent:result] labels["label_time"] = pd.to_numeric(labels["label_time"], errors="coerce")
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Create Feature Groups and ingest data
[agent:result] def create_and_ingest_fg(name, df, primary_key, event_time):
[agent:result]     fg = fs.create_feature_group(
[agent:result]         name=name,
[agent:result]         version=1,
[agent:result]         description=f"Feature group for {name}",
[agent:result]         primary_key=primary_key,
[agent:result]         event_time=event_time,
[agent:result]         statistics_config=False,
[agent:result]     )
[agent:result]     fg.insert(df, write_options={"wait_for_job": True})
[agent:result]     return fg
[agent:result] 
[agent:result] # Create FGs for each source table
[agent:result] transactions_fg = create_and_ingest_fg("transactions", transactions, ["account_id"], "event_time")
[agent:result] profiles_fg = create_and_ingest_fg("profiles", profiles, ["account_id"], "event_time")
[agent:result] activity_fg = create_and_ingest_fg("activity", activity, ["account_id"], "event_time")
