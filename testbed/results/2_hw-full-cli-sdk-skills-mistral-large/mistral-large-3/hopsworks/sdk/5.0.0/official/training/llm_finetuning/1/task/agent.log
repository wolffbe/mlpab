[agent:result] import os
[agent:result] import json
[agent:result] import hopsworks
[agent:result] import time
[agent:result] 
[agent:result] def main():
[agent:result]     # Login to Hopsworks
[agent:result]     project = hopsworks.login()
[agent:result]     job_api = project.get_job_api()
[agent:result]     dataset_api = project.get_dataset_api()
[agent:result]     model_registry = project.get_model_registry()
[agent:result]     
[agent:result]     # Upload data files to the platform
[agent:result]     print("Uploading data files to the platform...")
[agent:result]     dataset_api.upload("data/base_model.npz", "Resources", overwrite=True)
[agent:result]     dataset_api.upload("data/finetune.txt", "Resources", overwrite=True)
[agent:result]     dataset_api.upload("data/eval.txt", "Resources", overwrite=True)
[agent:result]     dataset_api.upload("data/finetune_model.py", "Resources", overwrite=True)
[agent:result]     
[agent:result]     # Create job configuration
[agent:result]     print("Creating job configuration...")
[agent:result]     job_config = job_api.get_configuration("PYTHON")
[agent:result]     job_config["appPath"] = "Resources/finetune_model.py"
[agent:result]     job_config["defaultArgs"] = ""
[agent:result]     
[agent:result]     # Create and run the job
[agent:result]     print("Creating and running the fine-tuning job...")
[agent:result]     job = job_api.create_job("ftjob77e07a", job_config)
[agent:result]     execution = job.run(await_termination=False)
[agent:result]     
[agent:result]     # Wait for job to complete
[agent:result]     print("Waiting for job to complete...")
[agent:result]     while True:
[agent:result]         execution = job.last_execution()
[agent:result]         if execution is None:
[agent:result]             time.sleep(5)
[agent:result]             continue
[agent:result]             
[agent:result]         status = execution.get_state()
[agent:result]         if status in ["FINISHED", "FAILED", "KILLED"]:
[agent:result]             break
[agent:result]         time.sleep(5)
[agent:result]     
[agent:result]     if status != "FINISHED":
[agent:result]         raise RuntimeError(f"Job failed with status: {status}")
[agent:result]     
[agent:result]     # Download metrics.json from the job execution
[agent:result]     print("Downloading metrics from job execution...")
[agent:result]     execution.download("metrics.json")
[agent:result]     
[agent:result]     # Read metrics
[agent:result]     with open("metrics.json", "r") as f:
[agent:result]         metrics = json.load(f)
[agent:result]     
[agent:result]     # Register the model
[agent:result]     print("Registering the fine-tuned model...")
[agent:result]     model = model_registry.python.create_model(
[agent:result]         name="ftmodel77e07a",
[agent:result]         version=1,
[agent:result]         metrics=metrics,
[agent:result]         description="Fine-tuned character-level language model"
[agent:result]     )
[agent:result]     
[agent:result]     # Save the model (this uploads the finetuned_model.npz from the job)
