[agent:result] content: #!/usr/bin/env python3
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import json
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] hopsworks.login()
[agent:result] project = hopsworks.project()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Load data
[agent:result] items_df = pd.read_csv("data/items.csv")
[agent:result] queries_df = pd.read_csv("data/queries.csv")
[agent:result] 
[agent:result] # Parse embeddings
[agent:result] items_df["embedding"] = items_df["embedding"].apply(lambda x: np.array(json.loads(x), dtype=np.float32))
[agent:result] queries_df["embedding"] = queries_df["embedding"].apply(lambda x: np.array(json.loads(x), dtype=np.float32))
[agent:result] 
[agent:result] # Create or get vector store
[agent:result] vector_db = project.get_vector_database()
[agent:result] try:
[agent:result]     store = vector_db.get_vector_collection("itemsedc1f4")
[agent:result]     store.delete()
[agent:result] except:
[agent:result]     pass
[agent:result] 
[agent:result] store = vector_db.create_vector_collection(
[agent:result]     name="itemsedc1f4",
[agent:result]     description="Vector store for items",
[agent:result]     embedding_dimension=16
[agent:result] )
[agent:result] 
[agent:result] # Ingest items
[agent:result] items = [
[agent:result]     {
[agent:result]         "id": row["item_id"],
[agent:result]         "embedding": row["embedding"].tolist(),
[agent:result]     }
[agent:result]     for _, row in items_df.iterrows()
[agent:result] ]
[agent:result] 
[agent:result] store.insert(items)
[agent:result] 
[agent:result] # Search for each query
[agent:result] neighbors = {}
[agent:result] for _, row in queries_df.iterrows():
[agent:result]     query_embedding = row["embedding"]
[agent:result]     results = store.find_nearest(
[agent:result]         embedding=query_embedding.tolist(),
[agent:result]         k=5,
[agent:result]         distance_metric="l2"
[agent:result]     )
[agent:result]     neighbors[row["query_id"]] = [result["id"] for result in results]
[agent:result] 
[agent:result] # Write results
[agent:result] with open("submission/answers.json", "w") as f:
[agent:result]     json.dump({
[agent:result]         "store": "itemsedc1f4",
[agent:result]         "neighbors": neighbors
[agent:result]     }, f, indent=2)
