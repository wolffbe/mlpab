[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Create a versioned training dataset named `churntraining1e2e16`, version 1, on Hopsworks.
[agent:result] 
[agent:result] For each (account_id, label_time) in labels.csv, fetch the most recent feature values
[agent:result] from the source tables where event_time <= label_time.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import os
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Read input files
[agent:result] labels_df = pd.read_csv("./data/labels.csv")
[agent:result] transactions_df = pd.read_csv("./data/transactions.csv")
[agent:result] transactions_late_df = pd.read_csv("./data/transactions_late.csv")
[agent:result] profiles_df = pd.read_csv("./data/profiles.csv")
[agent:result] activity_df = pd.read_csv("./data/activity.csv")
[agent:result] account_health_df = pd.read_csv("./data/account_health.csv")
[agent:result] 
[agent:result] # Combine transactions and transactions_late
[agent:result] transactions_combined = pd.concat([transactions_df, transactions_late_df], ignore_index=True)
[agent:result] 
[agent:result] # Initialize the output DataFrame
[agent:result] output_columns = [
[agent:result]     "account_id", "label_time", "amount", "balance", 
[agent:result]     "credit_score", "tier", "sessions_7d", "health_score", "churned"
[agent:result] ]
[agent:result] output_rows = []
[agent:result] 
[agent:result] # For each (account_id, label_time) in labels.csv, fetch the most recent feature values
[agent:result] for _, row in labels_df.iterrows():
[agent:result]     account_id = row["account_id"]
[agent:result]     label_time = row["label_time"]
[agent:result]     churned = row["churned"]
[agent:result]     
[agent:result]     # Fetch most recent transaction
[agent:result]     tx_filtered = transactions_combined[
[agent:result]         (transactions_combined["account_id"] == account_id) &
[agent:result]         (transactions_combined["event_time"] <= label_time)
[agent:result]     ]
[agent:result]     tx_most_recent = tx_filtered.sort_values("event_time", ascending=False).head(1)
[agent:result]     
[agent:result]     # Fetch most recent profile
[agent:result]     profile_filtered = profiles_df[
[agent:result]         (profiles_df["account_id"] == account_id) &
[agent:result]         (profiles_df["event_time"] <= label_time)
[agent:result]     ]
[agent:result]     profile_most_recent = profile_filtered.sort_values("event_time", ascending=False).head(1)
[agent:result]     
[agent:result]     # Fetch most recent activity
[agent:result]     activity_filtered = activity_df[
[agent:result]         (activity_df["account_id"] == account_id) &
[agent:result]         (activity_df["event_time"] <= label_time)
[agent:result]     ]
[agent:result]     activity_most_recent = activity_filtered.sort_values("event_time", ascending=False).head(1)
[agent:result]     
[agent:result]     # Fetch most recent account health
[agent:result]     health_filtered = account_health_df[
[agent:result]         (account_health_df["account_id"] == account_id) &
[agent:result]         (account_health_df["event_time"] <= label_time)
[agent:result]     ]
[agent:result]     health_most_recent = health_filtered.sort_values("event_time", ascending=False).head(1)
[agent:result]     
[agent:result]     # Prepare the output row
[agent:result]     output_row = {
[agent:result]         "account_id": account_id,
[agent:result]         "label_time": label_time,
[agent:result]         "amount": tx_most_recent["amount"].values[0] if not tx_most_recent.empty else None,
[agent:result]         "balance": tx_most_recent["balance"].values[0] if not tx_most_recent.empty else None,
[agent:result]         "credit_score": profile_most_recent["credit_score"].values[0] if not profile_most_recent.empty else None,
[agent:result]         "tier": profile_most_recent["tier"].values[0] if not profile_most_recent.empty else None,
[agent:result]         "sessions_7d": activity_most_recent["sessions_7d"].values[0] if not activity_most_recent.empty else None,
[agent:result]         "health_score": health_most_recent["health_score"].values[0] if not health_most_recent.empty else None,
[agent:result]         "churned": churned
[agent:result]     }
[agent:result]     output_rows.append(output_row)
[agent:result] 
[agent:result] # Create the output DataFrame
[agent:result] output_df = pd.DataFrame(output_rows, columns=output_columns)
[agent:result] 
[agent:result] # Drop rows with missing values (if any)
[agent:result] output_df = output_df.dropna()
[agent:result] 
[agent:result] # Create a feature group and upload the dataset
[agent:result] fg = fs.create_feature_group(
[agent:result]     name="churntraining1e2e16",
[agent:result]     version=1,
[agent:result]     description="Training dataset for churn prediction. One row per (account_id, label_time) in labels.csv, with the most recent feature values at or before label_time.",
[agent:result]     primary_key=["account_id", "label_time"],
[agent:result]     event_time="label_time"
[agent:result] )
[agent:result] 
[agent:result] # Upload the dataset
[agent:result] fg.insert(output_df)
[agent:result] 
[agent:result] print("Training dataset 'churntraining1e2e16', version 1, has been created on Hopsworks.")
