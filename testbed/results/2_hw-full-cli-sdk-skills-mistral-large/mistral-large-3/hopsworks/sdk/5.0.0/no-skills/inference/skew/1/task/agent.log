[agent:bash] import hopsworks
[agent:bash] import pandas as pd
[agent:bash] import numpy as np
[agent:bash] import json
[agent:bash] import os
[agent:bash] 
[agent:bash] # Connect to Hopsworks
[agent:bash] hopsworks.login()
[agent:bash] project = hopsworks.project()
[agent:bash] fs = project.get_feature_store()
[agent:bash] 
[agent:bash] # Read datasets
[agent:bash] training_df = pd.read_csv("data/training_sample.csv")
[agent:bash] serving_df = pd.read_csv("data/serving_log.csv")
[agent:bash] 
[agent:bash] # Upload datasets to Hopsworks for analysis
[agent:bash] training_fg = fs.create_feature_group(
[agent:bash]     name="training_sample",
[agent:bash]     version=1,
[agent:bash]     description="Training sample for skew detection",
[agent:bash]     primary_key=["entity_id"],
[agent:bash]     statistics_config={"enabled": True, "histograms": True, "correlations": True}
[agent:bash] )
[agent:bash] training_fg.insert(training_df, write_options={"wait_for_job": True})
[agent:bash] 
[agent:bash] serving_fg = fs.create_feature_group(
[agent:bash]     name="serving_log",
[agent:bash]     version=1,
[agent:bash]     description="Serving log for skew detection",
[agent:bash]     primary_key=["entity_id"],
[agent:bash]     statistics_config={"enabled": True, "histograms": True, "correlations": True}
[agent:bash] )
[agent:bash] serving_fg.insert(serving_df, write_options={"wait_for_job": True})
[agent:bash] 
[agent:bash] # Fetch statistics for comparison
[agent:bash] training_stats = training_fg.get_statistics()
[agent:bash] serving_stats = serving_fg.get_statistics()
[agent:bash] 
[agent:bash] # Extract feature statistics
[agent:bash] features = ["f1", "f2", "f3", "f4", "f5"]
[agent:bash] skew_results = {}
[agent:bash] 
[agent:bash] for feature in features:
[agent:bash]     training_mean = training_stats.descriptive_stats[feature]["mean"]
[agent:bash]     serving_mean = serving_stats.descriptive_stats[feature]["mean"]
[agent:bash]     training_std = training_stats.descriptive_stats[feature]["stddev"]
[agent:bash]     serving_std = serving_stats.descriptive_stats[feature]["stddev"]
[agent:bash]     
[agent:bash]     # Calculate relative difference in mean and std
[agent:bash]     mean_diff = abs(training_mean - serving_mean) / (training_mean + 1e-6)
[agent:bash]     std_diff = abs(training_std - serving_std) / (training_std + 1e-6)
[agent:bash]     
[agent:bash]     skew_results[feature] = {
[agent:bash]         "mean_diff": mean_diff,
[agent:bash]         "std_diff": std_diff,
[agent:bash]         "total_diff": mean_diff + std_diff
[agent:bash]     }
[agent:bash] 
[agent:bash] # Identify the feature with the highest total difference
[agent:bash] skewed_feature = max(skew_results.items(), key=lambda x: x[1]["total_diff"])[0]
[agent:bash] 
[agent:bash] # Prepare the answer
[agent:bash] answer = {"feature": skewed_feature}
[agent:bash] 
[agent:bash] # Optional: Add a cause if the skew is obvious
[agent:bash] if skewed_feature == "f2":
[agent:bash]     answer["cause"] = "Feature f2 likely uses a different scaling or normalization method in serving compared to training."
[agent:bash] 
[agent:bash] # Write the answer to submission/answers.json
[agent:bash] with open("submission/answers.json", "w") as f:
[agent:bash]     json.dump(answer, f, indent=2)
[agent:bash] 
[agent:bash] print(f"Skewed feature: {skewed_feature}")
