[agent:bash]         # Get the feature vector using the online API
[agent:bash]         feature_vector = feature_group.select(['f1', 'f2', 'f3', 'f4']).filter(hopsworks.conditions.Equals('account_id', key)).read(online=True)
[agent:bash]         
[agent:bash]         # Extract the feature values
[agent:bash]         if feature_vector:
[agent:bash]             vectors[key] = [
[agent:bash]                 feature_vector[0]['f1'],
[agent:bash]                 feature_vector[0]['f2'],
[agent:bash]                 feature_vector[0]['f3'],
[agent:bash]                 feature_vector[0]['f4']
[agent:bash]             ]
[agent:bash]     except Exception as e:
[agent:bash]         print(f'Error retrieving feature vector for {key}: {e}')
