[agent] 1-var OLS RMSE (2.05) exceeds the target, so I need multiple regression. I'll solve OLS in closed form via SQL (Cramer's rule on centered cross-products) for the 3 strongest predictors and measure the residual.
[agent:bash] hops sql --no-verify --catalog delta --schema mlpab350b65_featurestore "
[agent:bash] WITH m AS (
[agent:bash]   SELECT avg(pm25) my, avg(pm25_lag1) m1, avg(wind_speed) m2, avg(humidity) m3 FROM airq6e979b_1
[agent:bash] ),
[agent:bash] s AS (
[agent:bash]   SELECT
[agent:bash]     sum((pm25_lag1-m1)*(pm25_lag1-m1)) S11,
[agent:bash]     sum((wind_speed-m2)*(wind_speed-m2)) S22,
[agent:bash]     sum((humidity-m3)*(humidity-m3)) S33,
[agent:bash]     sum((pm25_lag1-m1)*(wind_speed-m2)) S12,
[agent:bash]     sum((pm25_lag1-m1)*(humidity-m3)) S13,
[agent:bash]     sum((wind_speed-m2)*(humidity-m3)) S23,
[agent:bash]     sum((pm25_lag1-m1)*(pm25-my)) S1y,
[agent:bash]     sum((wind_speed-m2)*(pm25-my)) S2y,
[agent:bash]     sum((humidity-m3)*(pm25-my)) S3y,
[agent:bash]     arbitrary(my) my, arbitrary(m1) m1, arbitrary(m2) m2, arbitrary(m3) m3
[agent:bash]   FROM airq6e979b_1 CROSS JOIN m
[agent:bash] ),
[agent:bash] c AS (
[agent:bash]   SELECT *,
[agent:bash]     S11*(S22*S33-S23*S23) - S12*(S12*S33-S23*S13) + S13*(S12*S23-S22*S13) AS det,
[agent:bash]     S1y*(S22*S33-S23*S23) - S12*(S2y*S33-S23*S3y) + S13*(S2y*S23-S22*S3y) AS d1,
[agent:bash]     S11*(S2y*S33-S3y*S23) - S1y*(S12*S33-S23*S13) + S13*(S12*S3y-S2y*S13) AS d2,
[agent:bash]     S11*(S22*S3y-S2y*S23) - S12*(S12*S3y-S2y*S13) + S1y*(S12*S23-S22*S13) AS d3
[agent:bash]   FROM s
[agent:bash] ),
[agent:bash] b AS (
[agent:bash]   SELECT d1/det b1, d2/det b2, d3/det b3, my - (d1/det)*m1 - (d2/det)*m2 - (d3/det)*m3 a FROM c
[agent:bash] )
[agent:bash] SELECT b.a, b.b1, b.b2, b.b3,
[agent:bash]   sqrt(avg(power(t.pm25 - (b.a + b.b1*t.pm25_lag1 + b.b2*t.wind_speed + b.b3*t.humidity),2))) rmse3
[agent:bash] FROM airq6e979b_1 t CROSS JOIN b GROUP BY b.a,b.b1,b.b2,b.b3" 2>&1 | tail -4
