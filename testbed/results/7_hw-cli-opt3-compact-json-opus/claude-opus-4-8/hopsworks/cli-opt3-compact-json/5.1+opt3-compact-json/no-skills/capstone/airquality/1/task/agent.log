[agent:bash]   sum((pm25_lag1-m1)*(pm25-my)) Y1, sum((wind_speed-m2)*(pm25-my)) Y2, sum((humidity-m3)*(pm25-my)) Y3, sum((pressure-m4)*(pm25-my)) Y4,
