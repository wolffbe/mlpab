[agent] `fg derive` only joins — it can't compute the prediction expression. So inference will run as platform SQL applying the trained coefficients, then the platform-computed rows land in the predictions FG. First, let me fit the final 4-predictor model on **all** data and get its training metrics.
[agent:bash] hops sql --no-verify --catalog delta --schema mlpab350b65_featurestore "
[agent:bash] WITH tr AS (SELECT * FROM airq6e979b_1),
[agent:bash] m AS (SELECT avg(pm25) my, avg(pm25_lag1) m1, avg(wind_speed) m2, avg(humidity) m3, avg(pressure) m4 FROM tr),
[agent:bash] s AS (SELECT
[agent:bash]   sum((pm25_lag1-m1)*(pm25_lag1-m1)) S11, sum((pm25_lag1-m1)*(wind_speed-m2)) S12, sum((pm25_lag1-m1)*(humidity-m3)) S13, sum((pm25_lag1-m1)*(pressure-m4)) S14,
[agent:bash]   sum((wind_speed-m2)*(wind_speed-m2)) S22, sum((wind_speed-m2)*(humidity-m3)) S23, sum((wind_speed-m2)*(pressure-m4)) S24,
[agent:bash]   sum((humidity-m3)*(humidity-m3)) S33, sum((humidity-m3)*(pressure-m4)) S34,
[agent:bash]   sum((pressure-m4)*(pressure-m4)) S44,
[agent:bash]   sum((pm25_lag1-m1)*(pm25-my)) Y1, sum((wind_speed-m2)*(pm25-my)) Y2, sum((humidity-m3)*(pm25-my)) Y3, sum((pressure-m4)*(pm25-my)) Y4,
[agent:bash]   arbitrary(my) my, arbitrary(m1) m1, arbitrary(m2) m2, arbitrary(m3) m3, arbitrary(m4) m4
[agent:bash]   FROM tr CROSS JOIN m),
[agent:bash] e1 AS (SELECT *,
[agent:bash]   S22-(S12/S11)*S12 a22, S23-(S12/S11)*S13 a23, S24-(S12/S11)*S14 a24, Y2-(S12/S11)*Y1 yy2,
[agent:bash]   S23-(S13/S11)*S12 a32, S33-(S13/S11)*S13 a33, S34-(S13/S11)*S14 a34, Y3-(S13/S11)*Y1 yy3,
[agent:bash]   S24-(S14/S11)*S12 a42, S34-(S14/S11)*S13 a43, S44-(S14/S11)*S14 a44, Y4-(S14/S11)*Y1 yy4
[agent:bash]   FROM s),
[agent:bash] e2 AS (SELECT *,
[agent:bash]   a33-(a32/a22)*a23 b33, a34-(a32/a22)*a24 b34, yy3-(a32/a22)*yy2 z3,
[agent:bash]   a43-(a42/a22)*a23 b43, a44-(a42/a22)*a24 b44, yy4-(a42/a22)*yy2 z4
[agent:bash]   FROM e1),
[agent:bash] e3 AS (SELECT *, b44-(b43/b33)*b34 c44, z4-(b43/b33)*z3 w4 FROM e2),
[agent:bash] sol AS (SELECT *, w4/c44 b4, (z3 - b34*(w4/c44))/b33 b3,
[agent:bash]   (yy2 - a23*((z3 - b34*(w4/c44))/b33) - a24*(w4/c44))/a22 b2 FROM e3),
[agent:bash] sol2 AS (SELECT *, (Y1 - S12*b2 - S13*b3 - S14*b4)/S11 b1 FROM sol),
[agent:bash] fin AS (SELECT b1,b2,b3,b4, my - b1*m1 - b2*m2 - b3*m3 - b4*m4 a FROM sol2)
[agent:bash] SELECT f.a, f.b1, f.b2, f.b3, f.b4,
[agent:bash]   sqrt(avg(power(t.pm25-(f.a+f.b1*t.pm25_lag1+f.b2*t.wind_speed+f.b3*t.humidity+f.b4*t.pressure),2))) train_rmse,
[agent:bash]   avg(abs(t.pm25-(f.a+f.b1*t.pm25_lag1+f.b2*t.wind_speed+f.b3*t.humidity+f.b4*t.pressure))) train_mae
[agent:bash] FROM airq6e979b_1 t CROSS JOIN fin f GROUP BY f.a,f.b1,f.b2,f.b3,f.b4" 2>&1 | tail -3
