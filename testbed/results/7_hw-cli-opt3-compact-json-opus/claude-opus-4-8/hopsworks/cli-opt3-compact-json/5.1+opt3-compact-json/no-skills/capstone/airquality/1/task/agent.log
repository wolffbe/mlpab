[agent:bash]   sum((wind_speed-m2)*(wind_speed-m2)) S22, sum((wind_speed-m2)*(humidity-m3)) S23, sum((wind_speed-m2)*(pressure-m4)) S24,
[agent:bash]   sum((humidity-m3)*(humidity-m3)) S33, sum((humidity-m3)*(pressure-m4)) S34,
