[agent] Now let me create a notebook to analyze the feature correlations on Databricks.
[agent:bash] cat > /tmp/leakage_analysis.py << 'NOTEBOOK_EOF'
[agent:bash] # Databricks notebook source
[agent:bash] # COMMAND ----------
[agent:bash] df = spark.read.csv("/Volumes/workspace/mlpab97d2fb/leakage_vol/training_data.csv", header=True, inferSchema=True)
[agent:bash] df.createOrReplaceTempView("training_data")
[agent:bash] print(f"Row count: {df.count()}")
[agent:bash] df.printSchema()
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Compute correlation of each feature with the label
[agent:bash] from pyspark.sql.functions import col, abs as spark_abs, corr, when, count
[agent:bash] 
[agent:bash] features = ["f1", "f2", "f3", "f4", "f5", "f6"]
[agent:bash] print("Pearson correlations with label:")
[agent:bash] for feat in features:
[agent:bash]     c = df.select(corr(col(feat), col("label").cast("double"))).collect()[0][0]
[agent:bash]     print(f"  {feat}: {c:.6f}  (abs: {abs(c):.6f})")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Check point-biserial correlation proxy and mutual information via a simple SQL groupby
[agent:bash] # For each feature, check mean values per label class
[agent:bash] print("\nMean values per label class:")
[agent:bash] for feat in features:
[agent:bash]     stats = df.groupBy("label").agg({"{}".format(feat): "mean"}).collect()
[agent:bash]     vals = {row["label"]: row["avg({})".format(feat)] for row in stats}
[agent:bash]     diff = abs(vals.get(1, 0) - vals.get(0, 0))
[agent:bash]     print(f"  {feat}: label=0 mean={vals.get(0,0):.4f}, label=1 mean={vals.get(1,0):.4f}, diff={diff:.4f}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Fit a simple logistic regression per feature to get individual AUC
[agent:bash] from pyspark.ml.feature import VectorAssembler
[agent:bash] from pyspark.ml.classification import LogisticRegression
[agent:bash] from pyspark.ml.evaluation import BinaryClassificationEvaluator
[agent:bash] from pyspark.sql.functions import col
[agent:bash] 
[agent:bash] evaluator = BinaryClassificationEvaluator(labelCol="label", metricName="areaUnderROC")
[agent:bash] 
[agent:bash] print("\nPer-feature AUC (logistic regression, single feature):")
[agent:bash] results = {}
[agent:bash] for feat in features:
[agent:bash]     assembler = VectorAssembler(inputCols=[feat], outputCol="features")
[agent:bash]     assembled = assembler.transform(df)
[agent:bash]     lr = LogisticRegression(featuresCol="features", labelCol="label")
[agent:bash]     model = lr.fit(assembled)
[agent:bash]     preds = model.transform(assembled)
[agent:bash]     auc = evaluator.evaluate(preds)
[agent:bash]     results[feat] = auc
[agent:bash]     print(f"  {feat}: AUC={auc:.6f}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Find the leaking feature (highest AUC)
[agent:bash] leaking = max(results, key=results.get)
[agent:bash] print(f"\nLeaking feature (highest AUC): {leaking} with AUC={results[leaking]:.6f}")
[agent:bash] 
[agent:bash] # Save result to volume
[agent:bash] result_json = '{{"feature": "{}"}}'.format(leaking)
[agent:bash] spark.createDataFrame([{"result": result_json}]).write.mode("overwrite").text("/Volumes/workspace/mlpab97d2fb/leakage_vol/result")
[agent:bash] print("Result saved:", result_json)
[agent:bash] NOTEBOOK_EOF
