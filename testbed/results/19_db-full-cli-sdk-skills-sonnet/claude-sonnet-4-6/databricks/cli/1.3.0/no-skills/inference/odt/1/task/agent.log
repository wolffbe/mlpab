[agent:result] VOL = f"/Volumes/{CAT}/{SCHEMA}/airqdata"
[agent:result] USER = spark.sql("select current_user()").collect()[0][0]
[agent:result] EXP = f"/Users/{USER}/mlpab600b4f/airq_experiment"
[agent:result] 
[agent:result] FG = f"{FQ}.airq0ecd46"
[agent:result] TD = f"{FQ}.airqtd0ecd46"
[agent:result] PRED = f"{FQ}.airqpred0ecd46"
[agent:result] MODEL = f"{FQ}.airqmodel0ecd46"
[agent:result] 
[agent:result] BASE_FEATS = ["pm25_lag1", "temperature", "humidity", "wind_speed", "pressure", "precipitation"]
[agent:result] 
[agent:result] # ---------- Load raw data ----------
[agent:result] hist = pd.read_csv(f"{VOL}/airquality_history.csv")
[agent:result] fc = pd.read_csv(f"{VOL}/forecast_days.csv")
[agent:result] 
[agent:result] def engineer(df):
[agent:result]     df = df.copy()
[agent:result]     d = pd.to_datetime(df["date"])
[agent:result]     doy = d.dt.dayofyear.astype(float)
[agent:result]     df["doy_sin"] = np.sin(2 * np.pi * doy / 365.25)
[agent:result]     df["doy_cos"] = np.cos(2 * np.pi * doy / 365.25)
[agent:result]     df["month"] = d.dt.month.astype(float)
[agent:result]     return df
[agent:result] 
[agent:result] hist_fe = engineer(hist)
[agent:result] fc_fe = engineer(fc)
[agent:result] FEATS = BASE_FEATS + ["doy_sin", "doy_cos", "month"]
[agent:result] 
[agent:result] # ---------- 1. Feature group ----------
[agent:result] fg_cols = ["date"] + FEATS + ["pm25"]
[agent:result] fg_pdf = hist_fe[fg_cols]
[agent:result] schema = StructType([StructField("date", StringType(), False)] +
[agent:result]                     [StructField(c, DoubleType(), True) for c in FEATS + ["pm25"]])
[agent:result] fg_sdf = spark.createDataFrame(fg_pdf.astype({c: float for c in FEATS + ["pm25"]}), schema=schema)
[agent:result] fg_sdf.write.mode("overwrite").option("overwriteSchema", "true").format("delta").saveAsTable(FG)
[agent:result] spark.sql(f"ALTER TABLE {FG} ALTER COLUMN date SET NOT NULL")
[agent:result] try:
[agent:result]     spark.sql(f"ALTER TABLE {FG} ADD CONSTRAINT pk_airqfg PRIMARY KEY (date)")
[agent:result] except Exception as e:
[agent:result]     print("fg pk:", e)
[agent:result] print("feature group rows:", spark.table(FG).count())
[agent:result] 
[agent:result] # ---------- 2. Training dataset ----------
[agent:result] td_sdf = spark.table(FG)
[agent:result] td_sdf.write.mode("overwrite").option("overwriteSchema", "true").format("delta").saveAsTable(TD)
[agent:result] print("training dataset rows:", spark.table(TD).count())
[agent:result] 
[agent:result] # ---------- 3. Train + register model ----------
[agent:result] mlflow.set_registry_uri("databricks-uc")
[agent:result] mlflow.set_experiment(EXP)
[agent:result] 
[agent:result] train_pdf = spark.table(TD).toPandas().sort_values("date").reset_index(drop=True)
[agent:result] X = train_pdf[FEATS]
[agent:result] y = train_pdf["pm25"].astype(float)
[agent:result] 
[agent:result] # Time-based held-out split for honest metric estimate
[agent:result] n = len(train_pdf)
[agent:result] cut = int(n * 0.8)
[agent:result] Xtr, Xval = X.iloc[:cut], X.iloc[cut:]
[agent:result] ytr, yval = y.iloc[:cut], y.iloc[cut:]
[agent:result] 
[agent:result] params = dict(n_estimators=500, learning_rate=0.03, max_depth=3, subsample=0.9, random_state=42)
[agent:result] val_model = GradientBoostingRegressor(**params).fit(Xtr, ytr)
[agent:result] val_pred = val_model.predict(Xval)
[agent:result] rmse = float(np.sqrt(mean_squared_error(yval, val_pred)))
[agent:result] print("held-out RMSE:", rmse)
[agent:result] 
[agent:result] # Final model on all data
[agent:result] final_model = GradientBoostingRegressor(**params).fit(X, y)
[agent:result] full_rmse = float(np.sqrt(mean_squared_error(y, final_model.predict(X))))
[agent:result] 
[agent:result] with mlflow.start_run(run_name="airq_gbr") as run:
