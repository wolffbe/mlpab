[agent:bash] # Create temporary staging tables and then the final feature table
[agent:bash] SQL_STMT="CREATE OR REPLACE TABLE workspace.mlpaba35f2a.scored50223c
[agent:bash] USING DELTA
[agent:bash] TBLPROPERTIES ('delta.minReaderVersion' = '1', 'delta.minWriterVersion' = '2')
[agent:bash] AS
[agent:bash] SELECT
[agent:bash]   r.request_id,
[agent:bash]   r.account_id,
[agent:bash]   ROUND(SQRT(POWER(r.request_lat - p.home_lat, 2) + POWER(r.request_lon - p.home_lon, 2)), 6) AS distance_deg,
[agent:bash]   ROUND(p.base_score - 0.1 * ROUND(SQRT(POWER(r.request_lat - p.home_lat, 2) + POWER(r.request_lon - p.home_lon, 2)), 6), 6) AS score
[agent:bash] FROM (
[agent:bash]   SELECT request_id, account_id, CAST(request_lat AS DOUBLE) AS request_lat, CAST(request_lon AS DOUBLE) AS request_lon
[agent:bash]   FROM read_files('/Volumes/workspace/mlpaba35f2a/data_upload/requests.csv', format => 'csv', header => true)
