[agent:bash] databricks experimental aitools tools query "CREATE TABLE workspace.mlpab7f9c18.churntraining807643 AS WITH t_ranked AS (SELECT l.account_id, l.label_time, t.amount, t.balance, ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY t.event_time DESC) as rn FROM workspace.mlpab7f9c18.labels_raw l JOIN workspace.mlpab7f9c18.transactions_raw t ON t.account_id = l.account_id AND t.event_time <= l.label_time), p_ranked AS (SELECT l.account_id, l.label_time, p.credit_score, p.tier, ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY p.event_time DESC) as rn FROM workspace.mlpab7f9c18.labels_raw l JOIN workspace.mlpab7f9c18.profiles_raw p ON p.account_id = l.account_id AND p.event_time <= l.label_time), a_ranked AS (SELECT l.account_id, l.label_time, a.sessions_7d, ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY a.event_time DESC) as rn FROM workspace.mlpab7f9c18.labels_raw l JOIN workspace.mlpab7f9c18.activity_raw a ON a.account_id = l.account_id AND a.event_time <= l.label_time), h_ranked AS (SELECT l.account_id, l.label_time, h.health_score, ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY h.event_time DESC) as rn FROM workspace.mlpab7f9c18.labels_raw l JOIN workspace.mlpab7f9c18.account_health_raw h ON h.account_id = l.account_id AND h.event_time <= l.label_time) SELECT l.account_id, l.label_time, t.amount, t.balance, p.credit_score, p.tier, a.sessions_7d, h.health_score, l.churned FROM workspace.mlpab7f9c18.labels_raw l LEFT JOIN t_ranked t ON t.account_id = l.account_id AND t.label_time = l.label_time AND t.rn = 1 LEFT JOIN p_ranked p ON p.account_id = l.account_id AND p.label_time = l.label_time AND p.rn = 1 LEFT JOIN a_ranked a ON a.account_id = l.account_id AND a.label_time = l.label_time AND a.rn = 1 LEFT JOIN h_ranked h ON h.account_id = l.account_id AND h.label_time = l.label_time AND h.rn = 1" 2>&1
