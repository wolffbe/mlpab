String: # ---------------------------------------------------------------------------
# 4. Detect available cluster configuration
# ---------------------------------------------------------------------------
print("\n[4] Detecting cluster configuration...")

# Get Spark versions - prefer LTS, non-ML
spark_version = None
try:
    versions = w.clusters.spark_versions()
    # Prefer a stable LTS version
    candidates = []
    for v in versions.versions:
        if v.key and "-scala2.12" in v.key and "ml" not in v.key and "gpu" not in v.key.lower():
            candidates.append(v.key)
    # Sort to get most recent LTS
    lts = [c for c in candidates if "lts" in c]
    if lts:
        spark_version = sorted(lts)[-1]
    elif candidates:
        spark_version = sorted(candidates)[-1]
    print(f"    Spark version: {spark_version}")
except Exception as e:
    spark_version = "15.4.x-scala2.12"
    print(f"    Using default Spark version: {spark_version} (error: {e})")

# Get node types - prefer small compute-optimized
node_type_id = None
try:
    node_types = w.clusters.list_node_types()
    all_types = {nt.node_type_id: nt for nt in node_types.node_types}
    # Try common small types across clouds
    preferred = [
        "m5.large", "m4.large",          # AWS
        "Standard_DS3_v2", "Standard_D4s_v3",  # Azure
        "n1-standard-4", "n1-standard-2",  # GCP
    ]
    for p in preferred:
        if p in all_types:
            node_type_id = p
            break
    if not node_type_id:
        # Sort by memory and pick the smallest
        types_list = sorted(
            node_types.node_types,
            key=lambda x: (x.memory_mb or 999999, x.node_type_id)
        )
        if types_list:
            node_type_id = types_list[0].node_type_id
    print(f"    Node type: {node_type_id}")
except Exception as e:
    node_type_id = "m5.large"
    print(f"    Using default node type: {node_type_id} (error: {e})")

# ---------------------------------------------------------------------------
# 5. Creating Databricks job...
# ---------------------------------------------------------------------------
print("\n[5] Creating Databricks job...")

new_cluster = compute_svc.ClusterSpec(
    spark_version=spark_version,
    node_type_id=node_type_id,
    num_workers=0,
    spark_conf={"spark.master": "local[*, 4]"},
    custom_tags={"mlpab_prefix": PREFIX},
)

job_task = jobs_svc.Task(
    task_key="finetune",
    notebook_task=jobs_svc.NotebookTask(
        notebook_path=notebook_path,
    ),
    new_cluster=new_cluster,
)</tool_use_error>
