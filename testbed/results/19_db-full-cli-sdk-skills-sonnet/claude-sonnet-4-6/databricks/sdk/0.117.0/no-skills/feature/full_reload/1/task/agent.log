[agent:bash] python3 -c "
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service.catalog import OnlineTable, OnlineTableSpec, OnlineTableSpecTriggeredSchedulingPolicy
[agent:bash] import os
[agent:bash] 
[agent:bash] w = WorkspaceClient()
[agent:bash] schema = os.environ['MLPAB_DATABRICKS_SCHEMA']
[agent:bash] parts = schema.split('.')
