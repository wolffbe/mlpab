[agent:bash] 
[agent:bash] # Create online table - same name as source but in the online tables system
[agent:bash] # The online table provides key-value lookup from the Delta table
[agent:bash] online_table = OnlineTable(
[agent:bash]     name=online_table_name,
[agent:bash]     spec=OnlineTableSpec(
[agent:bash]         source_table_full_name=source_table,
[agent:bash]         primary_key_columns=['row_id'],
