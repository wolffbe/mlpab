[agent:result] 13	## Email Notifications
[agent:result] 14	
[agent:result] 15	Send email alerts for job lifecycle events.
[agent:result] 16	
[agent:result] 17	### DABs YAML
[agent:result] 18	
[agent:result] 19	```yaml
[agent:result] 20	resources:
[agent:result] 21	  jobs:
[agent:result] 22	    monitored_job:
[agent:result] 23	      name: "Monitored Job"
[agent:result] 24	      email_notifications:
[agent:result] 25	        on_start:
[agent:result] 26	          - "team@example.com"
[agent:result] 27	        on_success:
[agent:result] 28	          - "team@example.com"
[agent:result] 29	        on_failure:
[agent:result] 30	          - "oncall@example.com"
[agent:result] 31	          - "team@example.com"
[agent:result] 32	        on_duration_warning_threshold_exceeded:
[agent:result] 33	          - "oncall@example.com"
[agent:result] 34	        no_alert_for_skipped_runs: true
[agent:result] 35	      tasks:
[agent:result] 36	        - task_key: main
[agent:result] 37	          notebook_task:
[agent:result] 38	            notebook_path: ../src/main.py
[agent:result] 39	```
[agent:result] 40	
[agent:result] 41	### Python SDK
[agent:result] 42	
[agent:result] 43	```python
