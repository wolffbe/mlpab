[agent:bash]     mlflow.log_metric('base_eval_loss', metrics['base_eval_loss'])
[agent:bash] 
[agent:bash]     # Log artifact (the model file)
[agent:bash]     mlflow.log_artifact(model_dst, artifact_path='model_files')
[agent:bash] 
