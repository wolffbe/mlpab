[agent:bash] cd "$(pwd)" && mkdir -p .tmp && cat > .tmp/recs.sql <<'EOF'
[agent:bash] WITH scores AS (
[agent:bash]   SELECT u.user_id AS user_id, i.item_id AS item_id,
[agent:bash]          u.e1*i.e1 + u.e2*i.e2 + u.e3*i.e3 + u.e4*i.e4
[agent:bash]        + u.e5*i.e5 + u.e6*i.e6 + u.e7*i.e7 + u.e8*i.e8 AS score
[agent:bash]   FROM iceberg.mlpabd66451_featurestore.user_embeddings_1 u
[agent:bash]   CROSS JOIN iceberg.mlpabd66451_featurestore.item_embeddings_1 i
[agent:bash]   WHERE NOT EXISTS (
[agent:bash]     SELECT 1 FROM iceberg.mlpabd66451_featurestore.user_interactions_1 x
[agent:bash]     WHERE x.user_id = u.user_id AND x.item_id = i.item_id
[agent:bash]   )
[agent:bash] ),
[agent:bash] ranked AS (
[agent:bash]   SELECT user_id, item_id, score,
[agent:bash]          ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY score DESC, item_id ASC) AS rank
[agent:bash]   FROM scores
[agent:bash] )
[agent:bash] SELECT user_id || '#' || CAST(rank AS VARCHAR) AS rec_id, user_id, rank, item_id
[agent:bash] FROM ranked
[agent:bash] WHERE rank <= 5
[agent:bash] ORDER BY user_id, rank
