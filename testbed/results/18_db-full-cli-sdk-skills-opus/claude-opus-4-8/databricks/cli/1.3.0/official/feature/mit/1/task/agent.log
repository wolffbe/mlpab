[agent] Now I'll create the feature table on the platform via SQL, computing all derived columns.
[agent:bash] databricks experimental aitools tools query "CREATE OR REPLACE TABLE workspace.mlpab519231.features74f1ef
[agent:bash] TBLPROPERTIES (delta.enableChangeDataFeed = true) AS
[agent:bash] WITH tx AS (
[agent:bash]   SELECT CAST(row_id AS STRING) AS row_id,
[agent:bash]          CAST(account_id AS STRING) AS account_id,
[agent:bash]          CAST(event_time AS BIGINT) AS event_time,
[agent:bash]          CAST(amount AS DOUBLE) AS amount,
[agent:bash]          CAST(currency AS STRING) AS currency
[agent:bash]   FROM read_files('/Volumes/workspace/mlpab519231/raw/transactions.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] fx AS (
[agent:bash]   SELECT CAST(currency AS STRING) AS currency, CAST(fx_rate AS DOUBLE) AS fx_rate
[agent:bash]   FROM read_files('/Volumes/workspace/mlpab519231/raw/fx_rates.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] joined AS (
[agent:bash]   SELECT tx.*, fx.fx_rate FROM tx JOIN fx USING (currency)
[agent:bash] )
[agent:bash] SELECT row_id, account_id, event_time,
[agent:bash]   amount * fx_rate AS amount_usd,
[agent:bash]   CAST(CASE WHEN ((event_time DIV 86400000) + 4) % 7 IN (0, 6) THEN 1 ELSE 0 END AS INT) AS is_weekend,
[agent:bash]   SUM(amount) OVER (PARTITION BY account_id ORDER BY event_time RANGE BETWEEN 604800000 PRECEDING AND CURRENT ROW) AS amount_7d
[agent:bash] FROM joined" 2>&1 | tail -20
