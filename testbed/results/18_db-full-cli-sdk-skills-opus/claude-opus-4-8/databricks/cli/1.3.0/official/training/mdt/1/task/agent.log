[agent] Now I'll build the feature table with train-only standardization, computed entirely on the warehouse.
[agent:bash] export DATABRICKS_WAREHOUSE_ID=4dfab06c923fe3cc
[agent:bash] databricks experimental aitools tools query "
[agent:bash] CREATE OR REPLACE TABLE workspace.mlpab54f0e1.scaledd437a3
[agent:bash] TBLPROPERTIES (delta.enableChangeDataFeed = true) AS
[agent:bash] WITH train AS (
[agent:bash]   SELECT row_id, CAST(f1 AS DOUBLE) f1, CAST(f2 AS DOUBLE) f2, CAST(f3 AS DOUBLE) f3, CAST(f4 AS DOUBLE) f4
[agent:bash]   FROM read_files('/Volumes/workspace/mlpab54f0e1/taskdata/features_train.csv', format=>'csv', header=>true)
[agent:bash] ),
[agent:bash] serve AS (
[agent:bash]   SELECT row_id, CAST(f1 AS DOUBLE) f1, CAST(f2 AS DOUBLE) f2, CAST(f3 AS DOUBLE) f3, CAST(f4 AS DOUBLE) f4
[agent:bash]   FROM read_files('/Volumes/workspace/mlpab54f0e1/taskdata/features_serve.csv', format=>'csv', header=>true)
[agent:bash] ),
[agent:bash] stats AS (
[agent:bash]   SELECT avg(f1) m1, stddev_pop(f1) s1, avg(f2) m2, stddev_pop(f2) s2,
[agent:bash]          avg(f3) m3, stddev_pop(f3) s3, avg(f4) m4, stddev_pop(f4) s4 FROM train
[agent:bash] ),
[agent:bash] both AS (
[agent:bash]   SELECT 'train' AS split, row_id, f1, f2, f3, f4 FROM train
[agent:bash]   UNION ALL
[agent:bash]   SELECT 'serve' AS split, row_id, f1, f2, f3, f4 FROM serve
[agent:bash] )
[agent:bash] SELECT b.row_id, b.split,
[agent:bash]   round((b.f1 - s.m1)/s.s1, 6) AS f1,
[agent:bash]   round((b.f2 - s.m2)/s.s2, 6) AS f2,
[agent:bash]   round((b.f3 - s.m3)/s.s3, 6) AS f3,
[agent:bash]   round((b.f4 - s.m4)/s.s4, 6) AS f4
[agent:bash] FROM both b CROSS JOIN stats s
[agent:bash] " 2>&1 | head -30
