import databricks.sdk
w = databricks.sdk.WorkspaceClient()
cat, sch = "workspace", "mlpab92a5cb"
wh = "4dfab06c923fe3cc"
def sql(q):
    r = w.statement_execution.execute_statement(warehouse_id=wh, statement=q, catalog=cat, schema=sch, wait_timeout="50s")
    if r.status.state.value == "SUCCEEDED":
        return r
    print("FAIL", r.status.error); raise SystemExit(1)
print("== columns ==")
for row in sql("DESCRIBE recs2ead15").result.data_array:
    print(row)
print("== PK constraint ==")
for row in sql("SELECT constraint_name, constraint_type FROM information_schema.table_constraints WHERE table_name=\"recs2ead15\"").result.data_array:
    print(row)
print("== integrity: total rows / users / ranks 1..5 / rec_id format ==")
r = sql("""SELECT
  (SELECT count(*) FROM recs2ead15),
  (SELECT count(DISTINCT user_id) FROM recs2ead15),
  (SELECT count(*) FROM recs2ead15 WHERE rank BETWEEN 1 AND 5),
  (SELECT count(*) FROM recs2ead15 WHERE rec_id = concat(user_id, \"#\", rank)),
  (SELECT count(*) FROM (SELECT user_id FROM recs2ead15 GROUP BY user_id HAVING count(*)<>5 OR count(distinct rank)<>5))""")
print("rows, users, ranks_ok, recid_ok, bad_users:", r.result.data_array)
# verify ranking correctness on a sample user against manual dot products
print("== sample U0007 top5 with scores ==")
dot = "+".join(["u.e%d*i.e%d"%(k,k) for k in range(1,9)])
r = sql("""WITH s AS (SELECT i.item_id,("""+dot+""") sc FROM stg_user u CROSS JOIN stg_item i
 WHERE u.user_id=\"U0007\" AND NOT EXISTS(SELECT 1 FROM stg_inter x WHERE x.user_id=\"U0007\" AND x.item_id=i.item_id))
 SELECT item_id, round(sc,4), row_number() OVER(ORDER BY sc DESC, item_id ASC) rn FROM s ORDER BY rn LIMIT 5""")
for row in r.result.data_array: print("  manual:", row)
r = sql("SELECT item_id, rank FROM recs2ead15 WHERE user_id=\"U0007\" ORDER BY rank")
for row in r.result.data_array: print("  table :", row)
