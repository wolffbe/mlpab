[agent] Now build the feature table with the dot-product ranking computation.
[agent:bash] cd "$(pwd)" && python3 -c '
[agent:bash] import databricks.sdk
[agent:bash] w = databricks.sdk.WorkspaceClient()
[agent:bash] cat, sch = "workspace", "mlpab92a5cb"
[agent:bash] wh = "4dfab06c923fe3cc"
[agent:bash] def sql(q):
[agent:bash]     r = w.statement_execution.execute_statement(warehouse_id=wh, statement=q, catalog=cat, schema=sch, wait_timeout="50s")
[agent:bash]     if r.status.state.value == "SUCCEEDED":
[agent:bash]         return r
[agent:bash]     print("FAIL", r.status.state.value, r.status.error); raise SystemExit(1)
[agent:bash] sql("DROP TABLE IF EXISTS recs2ead15")
[agent:bash] sql("""CREATE TABLE recs2ead15 (
[agent:bash]   rec_id STRING NOT NULL,
[agent:bash]   user_id STRING,
[agent:bash]   rank INT,
[agent:bash]   item_id STRING,
[agent:bash]   CONSTRAINT recs2ead15_pk PRIMARY KEY (rec_id)
[agent:bash] ) TBLPROPERTIES (delta.enableChangeDataFeed = true)""")
[agent:bash] print("table created")
[agent:bash] dot = "+".join(["u.e%d*i.e%d" % (k,k) for k in range(1,9)])
[agent:bash] ins = """INSERT INTO recs2ead15
[agent:bash] WITH scored AS (
[agent:bash]   SELECT u.user_id AS user_id, i.item_id AS item_id, (""" + dot + """) AS score
[agent:bash]   FROM stg_user u CROSS JOIN stg_item i
[agent:bash]   WHERE NOT EXISTS (SELECT 1 FROM stg_inter x WHERE x.user_id=u.user_id AND x.item_id=i.item_id)
[agent:bash] ),
[agent:bash] ranked AS (
[agent:bash]   SELECT user_id, item_id, score,
[agent:bash]     ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY score DESC, item_id ASC) AS rank
[agent:bash]   FROM scored
[agent:bash] )
[agent:bash] SELECT concat(user_id, \"#\", rank) AS rec_id, user_id, CAST(rank AS INT) AS rank, item_id
[agent:bash] FROM ranked WHERE rank <= 5"""
[agent:bash] sql(ins)
[agent:bash] print("inserted")
[agent:bash] r = sql("SELECT count(*), count(distinct user_id) FROM recs2ead15")
[agent:bash] print("counts (rows, users):", r.result.data_array)
[agent:bash] r = sql("SELECT rec_id, user_id, rank, item_id FROM recs2ead15 WHERE user_id IN (\"U0000\",\"U0003\") ORDER BY user_id, rank")
[agent:bash] for row in r.result.data_array:
[agent:bash]     print(row)
