[agent:bash] 
[agent:bash] def run(sql):
[agent:bash]     r=w.statement_execution.execute_statement(warehouse_id=WH, statement=sql, wait_timeout='50s')
[agent:bash]     st=r.status.state
[agent:bash]     if st!=StatementState.SUCCEEDED:
[agent:bash]         raise RuntimeError(f'{st}: {r.status.error}')
[agent:bash]     return r
[agent:bash] 
[agent:bash] # Create feature table with PK on row_id
[agent:bash] run(f"""
[agent:bash] CREATE OR REPLACE TABLE {tbl} (
[agent:bash]   row_id STRING NOT NULL,
[agent:bash]   account_id STRING,
[agent:bash]   event_time BIGINT,
[agent:bash]   amount DOUBLE,
[agent:bash]   category STRING,
[agent:bash]   CONSTRAINT events88b330_pk PRIMARY KEY (row_id)
[agent:bash] )
[agent:bash] TBLPROPERTIES (delta.enableChangeDataFeed = true)
[agent:bash] """)
[agent:bash] print('table created')
[agent:bash] 
[agent:bash] # Insert ONLY valid rows. Read all cols as strings to validate presence/format.
[agent:bash] run(f"""
[agent:bash] INSERT INTO {tbl}
[agent:bash] SELECT row_id, account_id,
[agent:bash]        CAST(event_time AS BIGINT) AS event_time,
[agent:bash]        CAST(amount AS DOUBLE) AS amount,
[agent:bash]        category
[agent:bash] FROM read_files('{path}', format=>'csv', header=>true,
[agent:bash]      schema=>'row_id string, account_id string, event_time string, amount string, category string')
[agent:bash] WHERE amount IS NOT NULL AND trim(amount) <> ''
[agent:bash]   AND CAST(amount AS DOUBLE) IS NOT NULL
[agent:bash]   AND CAST(amount AS DOUBLE) BETWEEN 0 AND 10000
[agent:bash]   AND category IN ('grocery','travel','salary','rent','other')
[agent:bash] """)
[agent:bash] print('valid rows inserted')
[agent:bash] 
[agent:bash] r=run(f"SELECT count(*) FROM {tbl}")
[agent:bash] print('loaded count:', r.result.data_array[0][0])
