[agent] Now create the feature table with the join and on-demand transformation computed, with a primary key on `request_id`.
[agent:bash] python3 -c "
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] import os
[agent:bash] w = WorkspaceClient()
[agent:bash] catalog, schema = os.environ['MLPAB_DATABRICKS_SCHEMA'].split('.')
[agent:bash] wh = '4dfab06c923fe3cc'
[agent:bash] tbl = f'{catalog}.{schema}.scoredbfc4ef'
[agent:bash] def sql(s):
[agent:bash]     r = w.statement_execution.execute_statement(statement=s, warehouse_id=wh, wait_timeout='50s')
[agent:bash]     st = r.status.state.value
[agent:bash]     if st != 'SUCCEEDED':
[agent:bash]         raise RuntimeError(f'{st}: {getattr(r.status,\"error\",None)} :: {s[:80]}')
[agent:bash]     return r
[agent:bash] base = f'/Volumes/{catalog}/{schema}/src_data'
[agent:bash] sql(f'DROP TABLE IF EXISTS {tbl}')
[agent:bash] # Create feature table with computed columns. request_id NOT NULL + PRIMARY KEY for online sync.
[agent:bash] create = f'''
[agent:bash] CREATE TABLE {tbl} (
[agent:bash]   request_id STRING NOT NULL,
[agent:bash]   account_id STRING,
[agent:bash]   distance_deg DOUBLE,
[agent:bash]   score DOUBLE,
[agent:bash]   CONSTRAINT scoredbfc4ef_pk PRIMARY KEY(request_id)
[agent:bash] ) TBLPROPERTIES (delta.enableChangeDataFeed = true)
[agent:bash] '''
[agent:bash] sql(create)
[agent:bash] print('table created')
[agent:bash] insert = f'''
[agent:bash] INSERT INTO {tbl}
[agent:bash] WITH j AS (
[agent:bash]   SELECT r.request_id, r.account_id,
[agent:bash]          round(sqrt(pow(r.request_lat - p.home_lat,2) + pow(r.request_lon - p.home_lon,2)),6) AS distance_deg,
[agent:bash]          p.base_score
[agent:bash]   FROM read_files('{base}/requests.csv', format=>'csv', header=>true) r
[agent:bash]   JOIN read_files('{base}/profiles.csv', format=>'csv', header=>true) p
[agent:bash]     ON r.account_id = p.account_id
[agent:bash] )
[agent:bash] SELECT request_id, account_id, distance_deg,
[agent:bash]        round(base_score - 0.1*distance_deg, 6) AS score
[agent:bash] FROM j
[agent:bash] '''
[agent:bash] sql(insert)
[agent:bash] print('data inserted')
[agent:bash] r = sql(f'SELECT count(*) c, count(distinct request_id) d FROM {tbl}')
[agent:bash] print('counts:', r.result.data_array)
[agent:bash] r = sql(f'SELECT * FROM {tbl} ORDER BY request_id LIMIT 3')
[agent:bash] print('sample:', r.result.data_array)
[agent:bash] "
