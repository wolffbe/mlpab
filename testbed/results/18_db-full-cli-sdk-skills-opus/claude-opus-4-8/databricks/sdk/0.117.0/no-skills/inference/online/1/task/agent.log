[agent:result] 458	def _imported_modules(text: str) -> set:
[agent:result] 459	    """Root module names imported by `text`. Handles `import a, b.c as d`,
[agent:result] 460	    `from x.y import z`, and `;`/newline-separated statements — so comma-lists
[agent:result] 461	    like `import hopsworks, sklearn` are fully covered."""
