[agent:bash]     vals = ",".join(f"('{a}',{f1},{f2},{f3},{f4})" for (a,f1,f2,f3,f4) in chunk)
[agent:bash]     run(f"INSERT INTO {TABLE} (account_id,f1,f2,f3,f4) VALUES {vals}")
[agent:bash]     print("inserted batch", i)
[agent:bash] 
