[agent:bash] def run(sql):
[agent:bash]     r = w.statement_execution.execute_statement(warehouse_id=WH, statement=sql, wait_timeout="50s")
[agent:bash]     st = r.status.state.value if r.status else None
[agent:bash]     if st not in ("SUCCEEDED",):
[agent:bash]         # poll if pending
[agent:bash]         while st in ("PENDING","RUNNING"):
[agent:bash]             time.sleep(2)
[agent:bash]             r = w.statement_execution.get_statement(r.statement_id)
[agent:bash]             st = r.status.state.value
[agent:bash]     if st != "SUCCEEDED":
[agent:bash]         raise RuntimeError(f"FAILED {st}: {r.status.error}\nSQL: {sql[:200]}")
[agent:bash]     return r
[agent:bash] 
[agent:bash] run(f"DROP TABLE IF EXISTS {TABLE}")
[agent:bash] run(f"""CREATE TABLE {TABLE} (
[agent:bash]   account_id STRING NOT NULL,
[agent:bash]   f1 DOUBLE, f2 DOUBLE, f3 DOUBLE, f4 DOUBLE,
[agent:bash]   CONSTRAINT profilesf45007_pk PRIMARY KEY(account_id)
[agent:bash] ) TBLPROPERTIES (delta.enableChangeDataFeed = true)""")
[agent:bash] print("table created")
[agent:bash] 
[agent:bash] # load data via INSERT
