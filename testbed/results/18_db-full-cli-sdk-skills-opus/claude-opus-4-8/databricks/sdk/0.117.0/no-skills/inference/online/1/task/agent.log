[agent:result] 463	    for stmt in re.split(r"[;\n]", text):
[agent:result] 464	        s = stmt.strip()
[agent:result] 465	        if s.startswith("import "):
[agent:result] 466	            for part in s[len("import ") :].split(","):
[agent:result] 467	                head = part.strip().split()
[agent:result] 468	                if head:
[agent:result] 469	                    root = head[0].split(".")[0]
[agent:result] 470	                    if root:
[agent:result] 471	                        mods.add(root)
[agent:result] 472	        elif s.startswith("from "):
[agent:result] 473	            after = s[len("from ") :].split(" import ")[0].strip()
[agent:result] 474	            root = after.split(".")[0]
[agent:result] 475	            if root:
[agent:result] 476	                mods.add(root)
[agent:result] 477	    # Dynamic imports with string-literal module name:
[agent:result] 478	    # `__import__("torch")`, `importlib.import_module('sklearn')`.
[agent:result] 479	    for m in re.finditer(r"""(?:__import__|import_module)\(\s*['"]([\w.]+)""", text):
[agent:result] 480	        mods.add(m.group(1).split(".")[0])
[agent:result] 481	    return mods
