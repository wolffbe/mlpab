[agent:result] def gate_check(command: str) -> str | None:
[agent:result]     """Full in-flight check for a Bash command, used by the vibe/codex exec gate
[agent:result]     (hooks/exec_gate.py). The Bash subset of what the PreToolUse hook's main()
[agent:result]     enforces for Claude: the single-interface allowlist + the instance-type
[agent:result]     guard + the solution/ answer-key deny. One source of truth for all engines."""
