[agent:result] def _seg_exec(tokens: list, depth: int = 0) -> str | None:
[agent:result]     """Segment's executable token: skips env-assignment prefixes,
[agent:result]     `env [-i] [VAR=VAL]...` and `uv run` wrappers; recurses into
[agent:result]     `bash -c "<script>"`."""
[agent:result]     i = 0
[agent:result]     while i < len(tokens):
[agent:result]         tok = tokens[i]
[agent:result]         if _is_env_assign(tok):
[agent:result]             i += 1
[agent:result]             continue
[agent:result]         if (
[agent:result]             depth < 2
[agent:result]             and tok in ("bash", "sh", "zsh")
[agent:result]             and i + 2 < len(tokens)
[agent:result]             and tokens[i + 1] == "-c"
[agent:result]         ):
[agent:result]             return _seg_exec(_split(tokens[i + 2]), depth + 1)
[agent:result]         # `env [-i|--unset=..] [VAR=VAL]... cmd ...` → real command follows.
[agent:result]         if tok in ("env", "/usr/bin/env") and depth < 3:
[agent:result]             j = i + 1
[agent:result]             while j < len(tokens) and (_is_env_assign(tokens[j]) or tokens[j].startswith("-")):
[agent:result]                 j += 1
[agent:result]             i = j
[agent:result]             continue
[agent:result]         # `uv run [-flags] python ...` → skip the `uv run` wrapper.
[agent:result]         if tok == "uv" and i + 1 < len(tokens) and tokens[i + 1] == "run" and depth < 3:
[agent:result]             j = i + 2
[agent:result]             while j < len(tokens) and tokens[j].startswith("-"):
[agent:result]                 j += 1
[agent:result]             i = j
[agent:result]             continue
[agent:result]         return tok
[agent:result]     return None
