[agent:result] def _python_payloads(command: str) -> tuple[str, list]:
[agent:result]     """What python actually EXECUTES locally in this command.
[agent:result] 
[agent:result]     Returns `(payload_text, unreadable_scripts)`:
[agent:result]       - `payload_text` — concatenated inline `-c` bodies, `-m module` (synthetic
[agent:result]         import), and contents of the executed `.py` SCRIPT (first `.py` token
[agent:result]         after the interpreter; trailing `.py` ARGS are not executed code). Empty
[agent:result]         when no python runs locally — a script merely created with `Write` is
[agent:result]         never flagged. `cd` is tracked so `cd work && python train.py` resolves
[agent:result]         train.py.
[agent:result]       - `unreadable_scripts` — executed `.py` scripts we could NOT read (imports
[agent:result]         unverifiable). Caller fails CLOSED on these in SDK mode.
[agent:result]     """
[agent:result]     texts: list = []
[agent:result]     unreadable: list = []
[agent:result]     curdir = os.getcwd()
[agent:result]     for seg in _segments(command):
[agent:result]         ex = _seg_exec(seg)
[agent:result]         if ex == "cd" and len(seg) > 1:
[agent:result]             target = seg[1]
[agent:result]             curdir = (
[agent:result]                 target if os.path.isabs(target) else os.path.normpath(os.path.join(curdir, target))
[agent:result]             )
[agent:result]             continue
[agent:result]         if not (ex and _is_python_tok(ex)):
[agent:result]             continue
[agent:result]         if "-c" in seg:
[agent:result]             j = seg.index("-c")
[agent:result]             if j + 1 < len(seg):
[agent:result]                 texts.append(seg[j + 1])
[agent:result]             continue
[agent:result]         if "-m" in seg:
[agent:result]             j = seg.index("-m")
[agent:result]             if j + 1 < len(seg):
[agent:result]                 texts.append("import " + seg[j + 1])
[agent:result]             continue
[agent:result]         # `python script.py [args]` — script is the FIRST .py token; later .py
[agent:result]         # tokens are args (e.g. `--config c.py`), not executed code.
[agent:result]         script = next((t for t in seg if t.endswith(".py")), None)
[agent:result]         if script is None:
[agent:result]             continue
[agent:result]         path = script if os.path.isabs(script) else os.path.join(curdir, script)
[agent:result]         try:
[agent:result]             with open(path, errors="ignore") as f:
[agent:result]                 texts.append(f.read())
[agent:result]         except OSError:
[agent:result]             unreadable.append(script)
[agent:result]     return "\n".join(texts), unreadable
[agent:result] 
