[agent:result] # --- Free-tier instance-type allowlist -----------------------------------------
[agent:result] # SageMaker-style instance types (`ml.<family>.<size>`) appear LITERALLY in every
[agent:result] # job-creating call, whatever the interface: CLI args (`--resource-config
[agent:result] # InstanceType=…` / `--cli-input-json`), MCP tool arguments, SDK python code, and
[agent:result] # job-spec files written via Write/Edit before being referenced. When
[agent:result] # TESTBED_INSTANCE_ALLOW is set (comma-separated, from the interface manifest's
[agent:result] # `instance_allowlist`), any OTHER `ml.*.*` token in a tool call is denied — the
[agent:result] # hard guarantee that agent runs only request AWS Free Tier instance types.
[agent:result] 
[agent:result] _INSTANCE_TYPE_RE = re.compile(
[agent:result]     r"\bml\.[a-z][a-z0-9-]*\.(?:nano|micro|small|medium|large|\d*xlarge)\b"
[agent:result] )
[agent:result] 
[agent:result] 
[agent:result] def enforce_instance_types(tool_name: str, tool_input: dict) -> str | None:
[agent:result]     """Return a denial reason if the call names an instance type outside
[agent:result]     TESTBED_INSTANCE_ALLOW, else None. Unset/empty allowlist → no-op (platforms
[agent:result]     without instance types never set it)."""
[agent:result]     allow = {
[agent:result]         t.strip() for t in (os.environ.get("TESTBED_INSTANCE_ALLOW") or "").split(",") if t.strip()
[agent:result]     }
[agent:result]     if not allow:
[agent:result]         return None
[agent:result]     if tool_name == "Bash":
[agent:result]         command = tool_input.get("command") or ""
[agent:result]         # Include what python EXECUTES (inline -c bodies + executed .py scripts)
[agent:result]         # so `python job.py` is checked against the script's contents too.
[agent:result]         payload, _ = _python_payloads(command)
[agent:result]         text = f"{command}\n{payload}"
[agent:result]     else:
[agent:result]         # MCP tool args + Write/Edit/NotebookEdit content: a job spec written to
[agent:result]         # a .json/.py file and only referenced later is caught at write time.
[agent:result]         text = json.dumps(tool_input, default=str)
[agent:result]     denied = sorted({m for m in _INSTANCE_TYPE_RE.findall(text) if m not in allow})
[agent:result]     if denied:
[agent:result]         return (
[agent:result]             f"DENIED: instance type(s) {', '.join(denied)} are outside the AWS "
[agent:result]             f"Free Tier. Use ONLY {', '.join(sorted(allow))} — single instance, "
[agent:result]             f"short jobs. Serverless Inference (no instance type) is also "
[agent:result]             f"Free Tier. Do not retry with a bigger or different instance type."
[agent:result]         )
[agent:result]     return None
[agent:result] 
[agent:result] 
[agent:result] # The run's solution/ folder is the eval's ANSWER KEY: off limits to the agent.
[agent:result] # `solution/` preceded by start-of-string or a separator (incl. `/`, so both
[agent:result] # `solution/` and `../solution/` / an absolute `…/solution/` match).
[agent:result] _SOLUTION_RE = re.compile(r'(?:^|[\s"\'=/(`;|&])solution/')
[agent:result] 
[agent:result] 
[agent:result] def _bash_solution_violation(command: str) -> str | None:
[agent:result]     if _SOLUTION_RE.search(command or ""):
[agent:result]         return (
[agent:result]             "DENIED: the solution/ folder is the eval's answer key — "
[agent:result]             "off limits to the agent. Solve the task from data/ only."
[agent:result]         )
[agent:result]     return None
