[agent:result] def _imported_modules(text: str) -> set:
[agent:result]     """Root module names imported by `text`. Handles `import a, b.c as d`,
[agent:result]     `from x.y import z`, and `;`/newline-separated statements — so comma-lists
[agent:result]     like `import hopsworks, sklearn` are fully covered."""
[agent:result]     mods: set = set()
[agent:result]     for stmt in re.split(r"[;\n]", text):
[agent:result]         s = stmt.strip()
[agent:result]         if s.startswith("import "):
[agent:result]             for part in s[len("import ") :].split(","):
[agent:result]                 head = part.strip().split()
[agent:result]                 if head:
[agent:result]                     root = head[0].split(".")[0]
[agent:result]                     if root:
[agent:result]                         mods.add(root)
[agent:result]         elif s.startswith("from "):
[agent:result]             after = s[len("from ") :].split(" import ")[0].strip()
[agent:result]             root = after.split(".")[0]
[agent:result]             if root:
[agent:result]                 mods.add(root)
[agent:result]     # Dynamic imports with string-literal module name:
[agent:result]     # `__import__("torch")`, `importlib.import_module('sklearn')`.
[agent:result]     for m in re.finditer(r"""(?:__import__|import_module)\(\s*['"]([\w.]+)""", text):
[agent:result]         mods.add(m.group(1).split(".")[0])
[agent:result]     return mods
[agent:result] 
[agent:result] 
[agent:result] def _imports_any(text: str, modules: list) -> str | None:
[agent:result]     """Return the first module in `modules` that `text` imports, else None."""
[agent:result]     imported = _imported_modules(text)
[agent:result]     for mod in modules:
[agent:result]         if mod in imported:
[agent:result]             return mod
[agent:result]     return None
[agent:result] 
