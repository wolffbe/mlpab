[agent:bash] cd "$(pwd)" && cat > .tmp_register.py << 'PY'
[agent:bash] import pandas as pd, numpy as np
[agent:bash] import hopsworks
[agent:bash] 
[agent:bash] feats = ['f1','f2','f3','f4']
[agent:bash] tr = pd.read_csv('data/features_train.csv')
[agent:bash] sv = pd.read_csv('data/features_serve.csv')
[agent:bash] 
[agent:bash] mean = tr[feats].mean()
[agent:bash] std = tr[feats].std(ddof=0)  # population std over TRAIN rows only
[agent:bash] 
[agent:bash] def standardize(df, split):
[agent:bash]     out = df.copy()
[agent:bash]     for f in feats:
[agent:bash]         out[f] = ((out[f] - mean[f]) / std[f]).round(6)
[agent:bash]     out['split'] = split
[agent:bash]     return out[['row_id','split'] + feats]
[agent:bash] 
[agent:bash] train_std = standardize(tr, 'train')
[agent:bash] serve_std = standardize(sv, 'serve')
[agent:bash] both = pd.concat([train_std, serve_std], ignore_index=True)
[agent:bash] print('total rows', len(both))
[agent:bash] print(both.head(3).to_string())
[agent:bash] print(both.tail(3).to_string())
[agent:bash] 
[agent:bash] proj = hopsworks.login()
[agent:bash] fs = proj.get_feature_store()
[agent:bash] 
[agent:bash] fg = fs.create_feature_group(
[agent:bash]     name='scaled1f3dc5',
[agent:bash]     version=1,
[agent:bash]     description='Standardized features (train-only mean/population-std), both splits',
[agent:bash]     primary_key=['row_id'],
[agent:bash]     online_enabled=True,
[agent:bash]     statistics_config=False,
[agent:bash] )
[agent:bash] fg.insert(both)
[agent:bash] print('INSERT DONE; fg id', fg.id, 'online_enabled', fg.online_enabled)
