[agent] The platform performed the point-in-time join correctly (verified: A0000 → revision at 1773019860000, the latest ≤ T). Now apply the model and write the deliverable table with online access enabled.
[agent:bash] cd "$(pwd)" && python -c "
[agent:bash] import hopsworks, warnings, pandas as pd, math, json
[agent:bash] warnings.filterwarnings('ignore')
[agent:bash] proj=hopsworks.login(); fs=proj.get_feature_store()
[agent:bash] 
[agent:bash] m=json.load(open('data/model.json')); w=m['weights']; b=m['bias']
[agent:bash] print('model', w, b)
[agent:bash] 
[agent:bash] # Point-in-time-correct features (join performed on platform via Query Service)
[agent:bash] sfg=fs.get_feature_group('score_spine_fg', version=1)
[agent:bash] src=fs.get_feature_group('feature_history_src', version=1)
[agent:bash] q=sfg.select(['account_id']).join(src.select(['f1','f2','f3']), on=['account_id'])
[agent:bash] pit=q.read(read_options={'arrow_flight_config':{'timeout':120}})
[agent:bash] assert pit['account_id'].nunique()==len(pit)==80, ('bad count', len(pit))
[agent:bash] 
[agent:bash] def score(r):
[agent:bash]     z=w['f1']*r.f1 + w['f2']*r.f2 + w['f3']*r.f3 + b
[agent:bash]     return round(1.0/(1.0+math.exp(-z)), 6)
[agent:bash] out=pd.DataFrame({'account_id':pit['account_id'].astype(str),
[agent:bash]                   'score':[score(r) for r in pit.itertuples()]})
[agent:bash] out=out.sort_values('account_id').reset_index(drop=True)
[agent:bash] print('out rows', len(out)); print(out.head(5).to_string())
[agent:bash] 
[agent:bash] scores=fs.get_or_create_feature_group(
[agent:bash]     name='scores30c485', version=1,
[agent:bash]     description='Batch logistic scores as of T=1773410400000',
[agent:bash]     primary_key=['account_id'], online_enabled=True)
[agent:bash] scores.insert(out, wait=True)
[agent:bash] print('SCORES FG INSERTED, online_enabled=', scores.online_enabled)
[agent:bash] " 2>&1 | tail -30
