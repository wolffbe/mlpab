[agent] Online store query works (700 rows). Offline Hive is unsupported in this client. I'll run the transform SQL against the online store (MySQL/RonDB-compatible). Let me build and test the transform query.
[agent:bash] python -c "
[agent:bash] import hopsworks, warnings
[agent:bash] warnings.filterwarnings('ignore')
[agent:bash] proj = hopsworks.login()
[agent:bash] fs = proj.get_feature_store()
[agent:bash] q = '''
[agent:bash] SELECT t.row_id, t.account_id, t.event_time,
[agent:bash]        t.amount * f.fx_rate AS amount_usd,
[agent:bash]        CASE WHEN MOD(FLOOR(t.event_time/86400000)+4, 7) IN (0,6) THEN 1 ELSE 0 END AS is_weekend,
[agent:bash]        (SELECT SUM(t2.amount) FROM \`transactions_raw48dc48_1\` t2
[agent:bash]          WHERE t2.account_id = t.account_id
[agent:bash]            AND t2.event_time BETWEEN t.event_time - 604800000 AND t.event_time) AS amount_7d
[agent:bash] FROM \`transactions_raw48dc48_1\` t
[agent:bash] JOIN \`fx_rates_raw48dc48_1\` f ON t.currency = f.currency
[agent:bash] '''
[agent:bash] df = fs.sql(q, online=True)
[agent:bash] print('rows:', len(df), 'cols:', list(df.columns))
[agent:bash] print(df.dtypes)
[agent:bash] print(df.sort_values('row_id').head(6).to_string())
[agent:bash] print('weekend count:', int(df['is_weekend'].sum()))
[agent:bash] print('nulls:', df.isnull().sum().to_dict())
[agent:bash] " 2>&1 | grep -viE "^202|INFO:" | grep -v "^$"
