[agent] BigQuery access works. Now I'll load the 3 batches into a staging table and create the deduplicated feature table (latest revision per row_id) — all executed on BigQuery.
[agent:bash] ./venv/bin/python - <<'PY'
[agent:bash] import google.cloud.bigquery as bq
[agent:bash] import os
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] client=bq.Client(project=proj)
[agent:bash] staging=f"{proj}.{ds}.accountsed4daa_staging"
[agent:bash] 
[agent:bash] schema=[
[agent:bash]     bq.SchemaField("row_id","STRING"),
[agent:bash]     bq.SchemaField("status","STRING"),
[agent:bash]     bq.SchemaField("balance","FLOAT64"),
[agent:bash]     bq.SchemaField("updated_at","INT64"),
[agent:bash] ]
[agent:bash] # Load batch_1 with WRITE_TRUNCATE, then 2 & 3 with WRITE_APPEND
[agent:bash] for i,csv in enumerate(["data/batch_1.csv","data/batch_2.csv","data/batch_3.csv"]):
[agent:bash]     disp = bq.WriteDisposition.WRITE_TRUNCATE if i==0 else bq.WriteDisposition.WRITE_APPEND
[agent:bash]     cfg=bq.LoadJobConfig(schema=schema, skip_leading_rows=1,
[agent:bash]                          source_format=bq.SourceFormat.CSV, write_disposition=disp)
[agent:bash]     with open(csv,"rb") as f:
[agent:bash]         job=client.load_table_from_file(f, staging, job_config=cfg)
[agent:bash]     job.result()
[agent:bash]     print("loaded", csv, "->", job.output_rows, "rows")
[agent:bash] 
[agent:bash] tbl=client.get_table(staging)
[agent:bash] print("staging total rows:", tbl.num_rows)
[agent:bash] 
[agent:bash] # Dedup to latest revision per row_id, materialize final feature table
[agent:bash] final=f"{proj}.{ds}.accountsed4daa"
[agent:bash] sql=f"""
[agent:bash] CREATE OR REPLACE TABLE `{final}` AS
[agent:bash] SELECT row_id, status, balance, updated_at
[agent:bash] FROM (
[agent:bash]   SELECT *, ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY updated_at DESC) rn
[agent:bash]   FROM `{staging}`
[agent:bash] )
[agent:bash] WHERE rn = 1
[agent:bash] """
[agent:bash] client.query(sql).result()
[agent:bash] ft=client.get_table(final)
[agent:bash] print("final table rows:", ft.num_rows)
[agent:bash] # sanity: distinct row_ids in staging
[agent:bash] d=list(client.query(f"SELECT COUNT(DISTINCT row_id) c FROM `{staging}`").result())[0].c
[agent:bash] print("distinct row_ids in staging:", d)
[agent:bash] PY
