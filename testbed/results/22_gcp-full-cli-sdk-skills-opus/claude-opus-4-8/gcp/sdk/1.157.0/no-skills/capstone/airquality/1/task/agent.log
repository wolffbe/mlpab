[agent:result] airqtdf3f1d8 979 ['date', 'pm25_lag1', 'temperature', 'humidity', 'wind_speed', 'pressure', 'precipitation', 'month', 'doy_sin', 'doy_cos', 'wind_lag', 'pm25']
[agent] Now train the BQML boosted-tree regressor and register it to Vertex Model Registry with the prefixed name.
[agent:bash] python3 -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']; pref=os.environ['MLPAB_GCP_PREFIX']
[agent:bash] c=bigquery.Client(project=proj)
[agent:bash] sql=f'''
[agent:bash] CREATE OR REPLACE MODEL \`{proj}.{ds}.airqmodelf3f1d8\`
[agent:bash] OPTIONS(
[agent:bash]   model_type='BOOSTED_TREE_REGRESSOR',
[agent:bash]   input_label_cols=['pm25'],
[agent:bash]   max_iterations=60,
[agent:bash]   max_tree_depth=4,
[agent:bash]   learn_rate=0.1,
[agent:bash]   subsample=0.85,
[agent:bash]   l2_reg=1.0,
[agent:bash]   early_stop=TRUE,
[agent:bash]   data_split_method='AUTO_SPLIT',
[agent:bash]   model_registry='vertex_ai',
[agent:bash]   vertex_ai_model_id='{pref}_airqmodelf3f1d8',
[agent:bash]   vertex_ai_model_version_aliases=['default']
[agent:bash] ) AS
[agent:bash] SELECT * EXCEPT(date) FROM \`{proj}.{ds}.airqtdf3f1d8\`'''
[agent:bash] print('training...')
[agent:bash] c.query(sql).result()
[agent:bash] print('trained')
