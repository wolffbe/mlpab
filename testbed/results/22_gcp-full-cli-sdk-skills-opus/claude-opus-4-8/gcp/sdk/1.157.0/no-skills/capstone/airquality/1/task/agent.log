[agent] Just using `pm25_lag1` gives RMSE 2.258 — close. A model adding weather + seasonality should clear 2.193. Let me build the feature group table with engineered features.
[agent:bash] python3 -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] c=bigquery.Client(project=proj)
[agent:bash] def run(sql):
[agent:bash]     c.query(sql).result()
[agent:bash] # Feature group table: engineered features for history (includes label pm25)
[agent:bash] run(f'''
[agent:bash] CREATE OR REPLACE TABLE \`{proj}.{ds}.airqf3f1d8\` AS
[agent:bash] SELECT
[agent:bash]   CAST(date AS STRING) AS date,
[agent:bash]   TIMESTAMP(date) AS feature_timestamp,
[agent:bash]   pm25_lag1,
[agent:bash]   temperature, humidity, wind_speed, pressure, precipitation,
[agent:bash]   EXTRACT(MONTH FROM date) AS month,
[agent:bash]   SIN(2*ACOS(-1)*EXTRACT(DAYOFYEAR FROM date)/365.0) AS doy_sin,
[agent:bash]   COS(2*ACOS(-1)*EXTRACT(DAYOFYEAR FROM date)/365.0) AS doy_cos,
[agent:bash]   wind_speed*pm25_lag1 AS wind_lag,
[agent:bash]   pm25
[agent:bash] FROM \`{proj}.{ds}.stg_history\`''')
[agent:bash] t=c.get_table(f'{proj}.{ds}.airqf3f1d8')
[agent:bash] print('airqf3f1d8', t.num_rows, [s.name for s in t.schema])
[agent:bash] # Training dataset: features + label (drop entity/timestamp helper cols not needed for training but keep date)
[agent:bash] run(f'''
[agent:bash] CREATE OR REPLACE TABLE \`{proj}.{ds}.airqtdf3f1d8\` AS
[agent:bash] SELECT date, pm25_lag1, temperature, humidity, wind_speed, pressure, precipitation,
[agent:bash]        month, doy_sin, doy_cos, wind_lag, pm25
[agent:bash] FROM \`{proj}.{ds}.airqf3f1d8\`''')
[agent:bash] t=c.get_table(f'{proj}.{ds}.airqtdf3f1d8')
[agent:bash] print('airqtdf3f1d8', t.num_rows, [s.name for s in t.schema])
[agent:bash] "
