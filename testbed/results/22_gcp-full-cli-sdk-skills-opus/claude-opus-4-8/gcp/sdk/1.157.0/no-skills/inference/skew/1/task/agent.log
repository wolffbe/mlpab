[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] 
[agent:bash] project = os.environ["GCP_PROJECT"]
[agent:bash] dataset = os.environ["GCP_BQ_DATASET"]
[agent:bash] client = bigquery.Client(project=project)
[agent:bash] 
[agent:bash] schema = [
[agent:bash]     bigquery.SchemaField("entity_id", "STRING"),
[agent:bash]     bigquery.SchemaField("f1", "FLOAT"),
[agent:bash]     bigquery.SchemaField("f2", "FLOAT"),
[agent:bash]     bigquery.SchemaField("f3", "FLOAT"),
[agent:bash]     bigquery.SchemaField("f4", "FLOAT"),
[agent:bash]     bigquery.SchemaField("f5", "FLOAT"),
[agent:bash] ]
[agent:bash] 
[agent:bash] def load(tbl, path):
[agent:bash]     tid = f"{project}.{dataset}.{tbl}"
[agent:bash]     job_config = bigquery.LoadJobConfig(
[agent:bash]         schema=schema, skip_leading_rows=1,
[agent:bash]         source_format=bigquery.SourceFormat.CSV,
[agent:bash]         write_disposition="WRITE_TRUNCATE",
[agent:bash]     )
[agent:bash]     with open(path, "rb") as f:
[agent:bash]         job = client.load_table_from_file(f, tid, job_config=job_config)
[agent:bash]     job.result()
[agent:bash]     print("loaded", tid, client.get_table(tid).num_rows, "rows")
[agent:bash] 
[agent:bash] load("skew_train", "data/training_sample.csv")
[agent:bash] load("skew_serve", "data/serving_log.csv")
[agent:bash] 
[agent:bash] feats = ["f1","f2","f3","f4","f5"]
[agent:bash] # Join on entity_id (matching entities), compute per-feature diff stats
[agent:bash] sel = ",\n".join([
[agent:bash]     f"AVG(ABS(t.{f}-s.{f})) AS mad_{f}, "
[agent:bash]     f"CORR(t.{f}, s.{f}) AS corr_{f}, "
[agent:bash]     f"AVG(t.{f}) AS tmean_{f}, AVG(s.{f}) AS smean_{f}, "
[agent:bash]     f"AVG(ABS(t.{f}-s.{f})/NULLIF(ABS(t.{f}),0)) AS relmad_{f}"
[agent:bash]     for f in feats
[agent:bash] ])
[agent:bash] q = f"""
[agent:bash] SELECT COUNT(*) AS n, {sel}
[agent:bash] FROM `{project}.{dataset}.skew_train` t
[agent:bash] JOIN `{project}.{dataset}.skew_serve` s USING(entity_id)
[agent:bash] """
[agent:bash] row = list(client.query(q).result())[0]
[agent:bash] print("matched entities:", row["n"])
[agent:bash] print(f"{'feat':4} {'MAD':>10} {'relMAD':>10} {'CORR':>8} {'tmean':>8} {'smean':>8}")
[agent:bash] for f in feats:
