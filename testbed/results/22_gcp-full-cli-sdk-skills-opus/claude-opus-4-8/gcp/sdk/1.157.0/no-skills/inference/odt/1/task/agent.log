[agent] Now I'll build the offline table: load CSVs into BigQuery and run the on-demand transform (join + compute) entirely in BigQuery.
[agent:bash] python3 << 'EOF'
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] 
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] c=bigquery.Client(project=proj)
[agent:bash] 
[agent:bash] def load(csv, table, schema):
[agent:bash]     ref=f"{proj}.{ds}.{table}"
[agent:bash]     job_config=bigquery.LoadJobConfig(
[agent:bash]         source_format=bigquery.SourceFormat.CSV,
[agent:bash]         skip_leading_rows=1, schema=schema,
[agent:bash]         write_disposition="WRITE_TRUNCATE")
[agent:bash]     with open(csv,"rb") as f:
[agent:bash]         job=c.load_table_from_file(f, ref, job_config=job_config)
[agent:bash]     job.result()
[agent:bash]     print("loaded", ref, c.get_table(ref).num_rows, "rows")
[agent:bash] 
[agent:bash] load("data/requests.csv","requests",[
[agent:bash]     bigquery.SchemaField("request_id","STRING"),
[agent:bash]     bigquery.SchemaField("account_id","STRING"),
[agent:bash]     bigquery.SchemaField("request_lat","FLOAT64"),
[agent:bash]     bigquery.SchemaField("request_lon","FLOAT64"),
[agent:bash]     bigquery.SchemaField("requested_at","TIMESTAMP"),
[agent:bash] ])
[agent:bash] load("data/profiles.csv","profiles",[
[agent:bash]     bigquery.SchemaField("account_id","STRING"),
[agent:bash]     bigquery.SchemaField("home_lat","FLOAT64"),
[agent:bash]     bigquery.SchemaField("home_lon","FLOAT64"),
[agent:bash]     bigquery.SchemaField("base_score","FLOAT64"),
[agent:bash] ])
[agent:bash] 
[agent:bash] # On-demand transform computed platform-side in BigQuery.
[agent:bash] sql=f"""
[agent:bash] CREATE OR REPLACE TABLE `{proj}.{ds}.scored3ace95` AS
[agent:bash] WITH j AS (
[agent:bash]   SELECT r.request_id, r.account_id,
[agent:bash]          ROUND(SQRT(POW(r.request_lat - p.home_lat,2)+POW(r.request_lon - p.home_lon,2)),6) AS distance_deg,
[agent:bash]          p.base_score
[agent:bash]   FROM `{proj}.{ds}.requests` r
[agent:bash]   JOIN `{proj}.{ds}.profiles` p USING (account_id)
[agent:bash] )
[agent:bash] SELECT request_id, account_id, distance_deg,
[agent:bash]        ROUND(base_score - 0.1*distance_deg, 6) AS score,
[agent:bash]        CURRENT_TIMESTAMP() AS feature_timestamp
[agent:bash] FROM j
[agent:bash] """
[agent:bash] c.query(sql).result()
[agent:bash] t=c.get_table(f"{proj}.{ds}.scored3ace95")
[agent:bash] print("scored3ace95 rows:", t.num_rows, "cols:", [f.name for f in t.schema])
[agent:bash] for row in c.query(f"SELECT request_id,account_id,distance_deg,score FROM `{proj}.{ds}.scored3ace95` ORDER BY request_id LIMIT 3").result():
[agent:bash]     print(dict(row))
