[agent] Raw data loaded. Now standardize both splits using train-only population stats, via BigQuery SQL.
[agent:bash] cd "$PWD" && python -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] project=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] client=bigquery.Client(project=project)
[agent:bash] base=f'{project}.{ds}'
[agent:bash] sql=f'''
[agent:bash] CREATE OR REPLACE TABLE \`{base}.scaled7b36f6\` AS
[agent:bash] WITH stats AS (
[agent:bash]   SELECT AVG(f1) m1, STDDEV_POP(f1) s1, AVG(f2) m2, STDDEV_POP(f2) s2,
[agent:bash]          AVG(f3) m3, STDDEV_POP(f3) s3, AVG(f4) m4, STDDEV_POP(f4) s4
[agent:bash]   FROM \`{base}.raw_train\`
[agent:bash] ),
[agent:bash] combined AS (
[agent:bash]   SELECT row_id, 'train' AS split, f1,f2,f3,f4 FROM \`{base}.raw_train\`
[agent:bash]   UNION ALL
[agent:bash]   SELECT row_id, 'serve' AS split, f1,f2,f3,f4 FROM \`{base}.raw_serve\`
[agent:bash] )
[agent:bash] SELECT c.row_id, c.split,
[agent:bash]   ROUND((c.f1 - s.m1)/s.s1, 6) AS f1,
[agent:bash]   ROUND((c.f2 - s.m2)/s.s2, 6) AS f2,
[agent:bash]   ROUND((c.f3 - s.m3)/s.s3, 6) AS f3,
[agent:bash]   ROUND((c.f4 - s.m4)/s.s4, 6) AS f4,
[agent:bash]   CURRENT_TIMESTAMP() AS feature_timestamp
[agent:bash] FROM combined c CROSS JOIN stats s
[agent:bash] '''
[agent:bash] client.query(sql).result()
[agent:bash] t=client.get_table(f'{base}.scaled7b36f6')
[agent:bash] print('rows', t.num_rows, 'schema', [(s.name,s.field_type) for s in t.schema])
[agent:bash] for r in client.query(f'SELECT split, COUNT(*) n FROM \`{base}.scaled7b36f6\` GROUP BY split ORDER BY split').result():
[agent:bash]     print(r.split, r.n)
[agent:bash] print('--- sample train rows ---')
[agent:bash] for r in client.query(f'SELECT row_id,split,f1,f2,f3,f4 FROM \`{base}.scaled7b36f6\` WHERE row_id IN (\"R00000\",\"R00400\") ORDER BY row_id').result():
[agent:bash]     print(dict(r))
[agent:bash] print('--- train mean should be ~0 ---')
[agent:bash] for r in client.query(f'SELECT ROUND(AVG(f1),4) a1, ROUND(STDDEV_POP(f1),4) sd1 FROM \`{base}.scaled7b36f6\` WHERE split=\"train\"').result():
[agent:bash]     print(dict(r))
[agent:bash] "
