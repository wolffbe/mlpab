[agent:bash] for split,path in [('train','data/features_train.csv'),('serve','data/features_serve.csv')]:
[agent:bash]     table_id=f'{project}.{ds}.raw_{split}'
[agent:bash]     job_config=bigquery.LoadJobConfig(source_format=bigquery.SourceFormat.CSV, skip_leading_rows=1, autodetect=True, write_disposition='WRITE_TRUNCATE')
[agent:bash]     with open(path,'rb') as f:
