[agent] Data looks good (lag correlation 0.65, target feasible). Now let me create the feature group table with engineered features.
[agent:bash] bq --project_id="$GCP_PROJECT" query --use_legacy_sql=false --format=none "
[agent:bash] CREATE OR REPLACE TABLE ${GCP_BQ_DATASET}.airqf3f1d8 AS
[agent:bash] SELECT
[agent:bash]   date,
[agent:bash]   TIMESTAMP(date) AS feature_timestamp,
[agent:bash]   pm25_lag1,
[agent:bash]   temperature,
[agent:bash]   humidity,
[agent:bash]   wind_speed,
[agent:bash]   pressure,
[agent:bash]   precipitation,
[agent:bash]   EXTRACT(MONTH FROM date) AS month,
[agent:bash]   SIN(2*ACOS(-1)*EXTRACT(DAYOFYEAR FROM date)/365.0) AS doy_sin,
[agent:bash]   COS(2*ACOS(-1)*EXTRACT(DAYOFYEAR FROM date)/365.0) AS doy_cos,
[agent:bash]   temperature*humidity AS temp_hum,
[agent:bash]   AVG(pm25_lag1) OVER (ORDER BY date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS pm25_roll7,
[agent:bash]   pm25
[agent:bash] FROM ${GCP_BQ_DATASET}.stg_history
[agent:bash] " 2>&1 | tail -3
