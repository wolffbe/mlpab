[agent:result]     def get_vector_store(self, name: str) -> dict:
[agent:result]         """Native Gemini Enterprise Agent Platform Vector Search (Matching Engine): match an index by
[agent:result]         display_name. native_ann=True — the platform has first-class ANN."""
[agent:result]         try:
[agent:result]             ai = _init_ai(self)
[agent:result]             qname = self._q(name)
[agent:result]             idxs = [i for i in ai.MatchingEngineIndex.list() if qname in (i.display_name or "")]
[agent:result]             return {
[agent:result]                 "exists": bool(idxs),
[agent:result]                 "kind": "vertex-vector-search",
[agent:result]                 "native_ann": True,
[agent:result]                 "matches": [i.display_name for i in idxs],
[agent:result]             }
[agent:result]         except Exception as e:
[agent:result]             return {"exists": False, "error": str(e)}
