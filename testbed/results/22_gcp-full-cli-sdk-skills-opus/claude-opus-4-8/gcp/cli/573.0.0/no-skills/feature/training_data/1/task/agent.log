[agent:result]     def get_alert(self, name_or_hint: str) -> dict:
[agent:result]         """Alerting on GCP = Cloud Monitoring alert policy whose name matches."""
[agent:result]         try:
[agent:result]             from google.cloud import monitoring_v3
[agent:result] 
[agent:result]             client = monitoring_v3.AlertPolicyServiceClient()
[agent:result]             project = f"projects/{self.project}"
[agent:result]             hint = self._q(name_or_hint)
[agent:result]             hits = [
[agent:result]                 p.display_name
[agent:result]                 for p in client.list_alert_policies(name=project)
[agent:result]                 if hint in (p.display_name or "")
[agent:result]             ]
[agent:result]             return {"exists": bool(hits), "count": len(hits), "matches": hits}
[agent:result]         except Exception as e:
[agent:result]             return {"exists": False, "error": str(e)}
