[agent:result]     def get_job(self, name: str) -> dict:
[agent:result]         """Custom / pipeline jobs by display_name; scheduled = a Schedule exists."""
[agent:result]         try:
[agent:result]             ai = _init_ai(self)
[agent:result]             qname = self._q(name)
[agent:result]             hits = []
[agent:result]             for lister in (ai.CustomJob, ai.PipelineJob):
[agent:result]                 try:
[agent:result]                     hits += [j for j in lister.list(filter=f'display_name="{qname}"')]
[agent:result]                 except Exception:
[agent:result]                     pass
[agent:result]             if not hits:
[agent:result]                 return {"exists": False}
[agent:result]             j = hits[0]
[agent:result]             scheduled = False
[agent:result]             try:
[agent:result]                 scheduled = any(
[agent:result]                     qname in (s.display_name or "") for s in ai.PipelineJobSchedule.list()
[agent:result]                 )
[agent:result]             except Exception:
[agent:result]                 pass
[agent:result]             return {
[agent:result]                 "exists": True,
[agent:result]                 "last_run_state": str(getattr(j, "state", "")),
[agent:result]                 "scheduled": scheduled,
[agent:result]                 "kind": type(j).__name__,
[agent:result]             }
[agent:result]         except Exception as e:
[agent:result]             return {"exists": False, "error": str(e)}
[agent:result] 
[agent:result]     def get_endpoint(self, name: str) -> dict:
[agent:result]         try:
[agent:result]             ai = _init_ai(self)
[agent:result]             eps = list(ai.Endpoint.list(filter=f'display_name="{self._q(name)}"'))
[agent:result]             if not eps:
[agent:result]                 return {"exists": False}
[agent:result]             e = eps[0]
[agent:result]             return {"exists": True, "status": "deployed" if e.list_models() else "no-model"}
[agent:result]         except Exception as e:
[agent:result]             return {"exists": False, "error": str(e)}
