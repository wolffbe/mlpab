[agent:result] """F5 (PIT) — grader: assertion suite over a produced training dataset.
[agent:result] 
[agent:result] The dataset normally arrives THROUGH a platform checker adapter (read the
[agent:result] versioned training dataset back via Hopsworks/Databricks/SageMaker read
[agent:result] paths); until adapters land, `--csv` grades a local file the same way.
[agent:result] 
[agent:result] Success is binary: A1–A4 must all pass. On a content mismatch (A4) the grader
[agent:result] compares against the generator's known-wrong variants to NAME the failure:
[agent:result]     latest_join  → joined overall-latest rows (used future data)
[agent:result]     ignore_late  → dropped the late-arriving export
[agent:result]     leak_future  → PIT-correct except the leak table (took the future value)
[agent:result] 
[agent:result] Usage:
[agent:result]     python -m evals.feature.pit.grade --instance /tmp/pit-m7 --csv produced.csv
[agent:result] """
[agent:result] 
[agent:result] from __future__ import annotations
[agent:result] 
[agent:result] import argparse
[agent:result] import json
[agent:result] import sys
[agent:result] from pathlib import Path
[agent:result] 
[agent:result] import pandas as pd
[agent:result] 
[agent:result] from evals.common import Suite, read_csv_or_empty, read_deliverable, tally
[agent:result] from evals.feature.pit.generate import canonicalize, digest
[agent:result] 
[agent:result] VARIANT_DIAGNOSIS = {
[agent:result]     "latest_join": "joined each account's overall-latest feature rows — values from "
[agent:result]     "AFTER label_time leaked into the training data",
[agent:result]     "ignore_late": "the late-arriving export (transactions_late.csv) was not ingested",
[agent:result]     "leak_future": "PIT-correct except the leak-tempting table, whose post-label row "
[agent:result]     "was used — future information leaked into the training data",
[agent:result] }
[agent:result] 
[agent:result] 
[agent:result] def grade(instance_dir: Path, produced: pd.DataFrame) -> dict:
[agent:result]     truth_meta = json.loads((instance_dir / "solution" / "truth.json").read_text())
[agent:result]     columns = truth_meta["columns"]
[agent:result]     s = Suite()
[agent:result]     diagnostic = None
[agent:result] 
[agent:result]     # A1 — column set (canonicalize would throw on missing columns; check first)
[agent:result]     produced.columns = [str(c).strip().lower() for c in produced.columns]
[agent:result]     missing = [c for c in columns if c not in produced.columns]
[agent:result]     a1 = s.check("A1_columns", not missing, f"missing columns: {missing}")
[agent:result] 
[agent:result]     if not a1:
[agent:result]         # No gradeable deliverable — the downstream checks are unreachable.
[agent:result]         s.skip("A2_row_count", "skipped: required columns are missing")
[agent:result]         s.skip("A3_labels", "skipped: required columns are missing")
[agent:result]         s.skip("A4_content", "skipped: required columns are missing")
[agent:result]     else:
[agent:result]         norm = canonicalize(produced, columns)
[agent:result]         # A2 — one row per label row
[agent:result]         a2 = s.check(
[agent:result]             "A2_row_count",
[agent:result]             len(norm) == truth_meta["row_count"],
[agent:result]             f"got {len(norm)}, expected {truth_meta['row_count']}",
[agent:result]         )
[agent:result]         # A3 — label passthrough (account_id + churned must match exactly)
[agent:result]         truth = pd.read_csv(instance_dir / "solution" / "truth.csv")
[agent:result]         truth = canonicalize(truth, columns)
[agent:result]         if a2:
[agent:result]             s.check(
[agent:result]                 "A3_labels",
[agent:result]                 norm[["account_id", "churned"]].equals(truth[["account_id", "churned"]]),
[agent:result]                 "account_id/churned do not match labels.csv",
[agent:result]             )
[agent:result]         else:
[agent:result]             s.skip("A3_labels", "skipped: row count differs, label alignment undefined")
[agent:result]         # A4 — content
[agent:result]         d = digest(norm)
[agent:result]         a4 = s.check("A4_content", d == truth_meta["digest"], "content digest mismatch")
[agent:result]         if not a4:
[agent:result]             for vname, vdigest in truth_meta.get("variant_digests", {}).items():
[agent:result]                 if d == vdigest:
[agent:result]                     diagnostic = VARIANT_DIAGNOSIS.get(vname, vname)
[agent:result]                     break
[agent:result]             if diagnostic is None and a2:
[agent:result]                 # first few differing cells, for a readable report
[agent:result]                 neq = norm != truth
[agent:result]                 bad = neq.any(axis=1)
[agent:result]                 examples = []
[agent:result]                 for idx in norm.index[bad][:3]:
[agent:result]                     cols_bad = [c for c in columns if neq.at[idx, c]]
[agent:result]                     examples.append(
[agent:result]                         {
[agent:result]                             "account_id": norm.at[idx, "account_id"],
[agent:result]                             "columns": {
[agent:result]                                 c: {"got": norm.at[idx, c], "expected": truth.at[idx, c]}
[agent:result]                                 for c in cols_bad
[agent:result]                             },
[agent:result]                         }
[agent:result]                     )
[agent:result]                 diagnostic = f"content differs on {int(bad.sum())} rows; examples: {examples}"
[agent:result] 
[agent:result]     return {
[agent:result]         "family": "pit",
[agent:result]         "seed": truth_meta["seed"],
[agent:result]         **tally(s.asserts),
[agent:result]         "asserts": s.asserts,
[agent:result]         **({"diagnostic": diagnostic} if diagnostic else {}),
[agent:result]     }
[agent:result] 
