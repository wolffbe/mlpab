[agent:result]     def get_model(self, name: str, version: int = 1) -> dict:
[agent:result]         """the platform model registry: match by display_name; metrics from the latest
[agent:result]         model evaluation if one was uploaded."""
[agent:result]         try:
[agent:result]             ai = _init_ai(self)
[agent:result]             models = list(ai.Model.list(filter=f'display_name="{self._q(name)}"'))
[agent:result]             if not models:
[agent:result]                 return {"exists": False}
[agent:result]             m = models[0]
[agent:result]             metrics = None
[agent:result]             try:
[agent:result]                 evals = list(m.list_model_evaluations())
[agent:result]                 if evals:
[agent:result]                     metrics = dict(evals[0].metrics) if evals[0].metrics else None
[agent:result]             except Exception:
[agent:result]                 pass
[agent:result]             return {
