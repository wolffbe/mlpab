[agent:result] class VertexChecker:
[agent:result]     def __init__(self) -> None:
[agent:result]         self.project = os.environ["GCP_PROJECT"]
[agent:result]         self.location = os.environ.get("GCP_LOCATION", "us-central1")
[agent:result]         # Per-run dataset (runner overrides GCP_BQ_DATASET=mlpab_<run>); BQ reads
[agent:result]         # are scoped by it, so feature/training-dataset NAMES stay bare. The
[agent:result]         # schema-less aiplatform/monitoring resources instead carry a per-run
[agent:result]         # display_name prefix (`<run>_`), which the state reads below prepend.
[agent:result]         self.dataset = os.environ.get("GCP_BQ_DATASET", "mlpab")
[agent:result]         self._prefix = os.environ.get("MLPAB_GCP_PREFIX") or ""
[agent:result] 
[agent:result]     def _q(self, name: str) -> str:
[agent:result]         """Prefix a state-resource name with this run's id (no-op when unset)."""
[agent:result]         return f"{self._prefix}_{name}" if self._prefix else name
[agent:result] 
[agent:result]     # -- BigQuery-backed feature reads -------------------------------------
[agent:result]     def _bq(self):
[agent:result]         from google.cloud import bigquery  # lazy
[agent:result] 
[agent:result]         return bigquery.Client(project=self.project)
[agent:result] 
[agent:result]     def _table_ref(self, name: str) -> str:
[agent:result]         return f"{self.project}.{self.dataset}.{name}"
[agent:result] 
[agent:result]     def get_feature_table(self, name: str, version: int | None = None) -> TableInfo | None:
[agent:result]         bq = self._bq()
[agent:result]         try:
[agent:result]             t = bq.get_table(self._table_ref(name))
[agent:result]         except Exception:
[agent:result]             return None
[agent:result]         schema = {f.name: f.field_type for f in t.schema}
[agent:result]         # the platform feature groups carry an entity-id column + a feature-timestamp;
[agent:result]         # surface them if present (convention: entity_id / feature_timestamp).
[agent:result]         pk = [c for c in ("entity_id", "entity_id_column") if c in schema]
[agent:result]         event = next((c for c in ("feature_timestamp", "event_timestamp") if c in schema), None)
[agent:result]         return TableInfo(
[agent:result]             name=name, version=version, primary_key=pk, event_time=event, schema=schema
[agent:result]         )
[agent:result] 
[agent:result]     def read_rows(self, name: str, version: int | None = None) -> pd.DataFrame:
[agent:result]         # Translate a missing table into LookupError (graceful A0 fail), matching
[agent:result]         # hopsworks/databricks/azure — otherwise BigQuery's NotFound propagates
[agent:result]         # and crashes the grader instead of failing the deliverable check.
[agent:result]         ref = self._table_ref(name)
[agent:result]         try:
[agent:result]             return self._bq().query(f"SELECT * FROM `{ref}`").to_dataframe()
[agent:result]         except Exception as e:
[agent:result]             if "Not found" in str(e) or "notFound" in str(e) or "does not exist" in str(e):
[agent:result]                 raise LookupError(f"table {ref} not found") from e
[agent:result]             raise
[agent:result] 
[agent:result]     def read_training_dataset(self, name: str, version: int = 1) -> pd.DataFrame:
[agent:result]         for table in (f"{name}_v{version}", name):
[agent:result]             if self.get_feature_table(table) is not None:
[agent:result]                 return self.read_rows(table)
[agent:result]         raise LookupError(
[agent:result]             f"training dataset {name!r} v{version} not found — expected BigQuery "
[agent:result]             f"table {self._table_ref(name + f'_v{version}')} (or {self._table_ref(name)})"
[agent:result]         )
