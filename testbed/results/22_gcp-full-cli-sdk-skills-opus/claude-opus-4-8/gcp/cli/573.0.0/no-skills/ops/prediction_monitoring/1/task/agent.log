[agent] The shift is unmistakable: daily mean is ~2.5 through Feb 25, then jumps to ~5.2 on Feb 26. Let me confirm the onset boundary precisely with a change-point query in BigQuery.
[agent:bash] TBL="${GCP_PROJECT}.${GCP_BQ_DATASET}.${MLPAB_GCP_PREFIX}_prediction_log"
[agent:bash] bq --project_id="$GCP_PROJECT" query --use_legacy_sql=false --format=pretty \
[agent:bash] "WITH d AS (SELECT DATE(ts) day, AVG(prediction) m FROM ${TBL} GROUP BY day),
[agent:bash]  g AS (SELECT day, m, AVG(m) OVER (ORDER BY day ROWS BETWEEN 3 PRECEDING AND 1 PRECEDING) prev3,
[agent:bash]         AVG(m) OVER (ORDER BY day ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) next3 FROM d)
[agent:bash]  SELECT day, ROUND(m,3) mean, ROUND(next3-prev3,3) jump FROM g
[agent:bash]  ORDER BY ABS(next3-prev3) DESC LIMIT 5" 2>&1 | tail -12
