[agent:bash] mkdir -p submission .tmp && cat > .tmp/vs_task.py <<'EOF'
[agent:bash] import csv, json, os, time
[agent:bash] from datetime import timedelta
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service.vectorsearch import (
[agent:bash]     EndpointType, VectorIndexType, DirectAccessVectorIndexSpec, EmbeddingVectorColumn)
[agent:bash] 
[agent:bash] w = WorkspaceClient()
[agent:bash] schema = os.environ["MLPAB_DATABRICKS_SCHEMA"]          # workspace.mlpab12199a
[agent:bash] prefix = os.environ["MLPAB_DATABRICKS_PREFIX"]          # mlpab12199a
[agent:bash] endpoint_name = f"{prefix}_itemse391d8"
[agent:bash] index_name = f"{schema}.itemse391d8"
[agent:bash] 
[agent:bash] # 1. endpoint
[agent:bash] existing = {e.name for e in w.vector_search_endpoints.list_endpoints()}
[agent:bash] if endpoint_name not in existing:
[agent:bash]     print("creating endpoint", endpoint_name, flush=True)
[agent:bash]     w.vector_search_endpoints.create_endpoint(
[agent:bash]         name=endpoint_name, endpoint_type=EndpointType.STANDARD
[agent:bash]     ).result(timeout=timedelta(minutes=45))
[agent:bash] else:
[agent:bash]     w.vector_search_endpoints.wait_get_endpoint_vector_search_endpoint_online(
[agent:bash]         endpoint_name, timeout=timedelta(minutes=45))
[agent:bash] print("endpoint online", flush=True)
[agent:bash] 
[agent:bash] # 2. direct-access index
[agent:bash] try:
[agent:bash]     w.vector_search_indexes.create_index(
[agent:bash]         name=index_name,
[agent:bash]         endpoint_name=endpoint_name,
[agent:bash]         primary_key="item_id",
[agent:bash]         index_type=VectorIndexType.DIRECT_ACCESS,
[agent:bash]         direct_access_index_spec=DirectAccessVectorIndexSpec(
[agent:bash]             embedding_vector_columns=[EmbeddingVectorColumn(name="embedding", embedding_dimension=16)],
[agent:bash]             schema_json=json.dumps({"item_id": "string", "embedding": "array<float>", "label": "string"}),
[agent:bash]         ),
[agent:bash]     )
[agent:bash]     print("index created", flush=True)
[agent:bash] except Exception as e:
[agent:bash]     if "already exists" in str(e).lower():
[agent:bash]         print("index exists", flush=True)
[agent:bash]     else:
[agent:bash]         raise
[agent:bash] 
[agent:bash] for _ in range(120):
[agent:bash]     st = w.vector_search_indexes.get_index(index_name).status
[agent:bash]     if st and st.ready:
[agent:bash]         break
[agent:bash]     time.sleep(10)
[agent:bash] print("index ready", flush=True)
[agent:bash] 
[agent:bash] # 3. upsert items
[agent:bash] with open("data/items.csv") as f:
[agent:bash]     items = [{"item_id": r["item_id"],
[agent:bash]               "embedding": json.loads(r["embedding"]),
[agent:bash]               "label": r["label"]} for r in csv.DictReader(f)]
[agent:bash] for i in range(0, len(items), 100):
[agent:bash]     resp = w.vector_search_indexes.upsert_data_vector_index(
[agent:bash]         index_name=index_name, inputs_json=json.dumps(items[i:i+100]))
[agent:bash]     print("upsert batch", i, resp.status, flush=True)
[agent:bash] 
[agent:bash] # 4. query
[agent:bash] with open("data/queries.csv") as f:
[agent:bash]     queries = [(r["query_id"], json.loads(r["embedding"])) for r in csv.DictReader(f)]
[agent:bash] 
[agent:bash] neighbors = {}
[agent:bash] for qid, vec in queries:
[agent:bash]     for attempt in range(10):
[agent:bash]         try:
[agent:bash]             res = w.vector_search_indexes.query_index(
[agent:bash]                 index_name=index_name, columns=["item_id"],
[agent:bash]                 query_vector=vec, num_results=5)
[agent:bash]             rows = res.result.data_array
[agent:bash]             if rows and len(rows) == 5:
[agent:bash]                 neighbors[qid] = [r[0] for r in rows]
[agent:bash]                 break
[agent:bash]         except Exception as e:
[agent:bash]             print(qid, "retry:", e, flush=True)
[agent:bash]         time.sleep(15)
[agent:bash]     else:
[agent:bash]         raise RuntimeError(f"query {qid} failed")
[agent:bash]     print(qid, neighbors[qid], flush=True)
[agent:bash] 
[agent:bash] with open("submission/answers.json", "w") as f:
[agent:bash]     json.dump({"store": index_name, "neighbors": neighbors}, f, indent=1)
[agent:bash] print("DONE")
