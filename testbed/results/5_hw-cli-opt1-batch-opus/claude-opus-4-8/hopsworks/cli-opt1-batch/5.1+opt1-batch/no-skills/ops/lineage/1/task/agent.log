[agent:result] """Shared rendering for ``hops <entity> lineage`` commands.
[agent:result] 
[agent:result] The SDK's provenance accessors (``get_*_provenance``,
[agent:result] ``get_parent_feature_groups``, ...) return
[agent:result] ``hsfs.core.explicit_provenance.Links`` results, which bucket related
[agent:result] artifacts into ``accessible`` (full domain objects the user can read),
[agent:result] ``inaccessible`` (exist but no access), ``deleted`` (removed), and ``faulty``
[agent:result] (corrupted).
[agent:result] This module flattens one or more such results into a single table or JSON
[agent:result] payload so every entity's lineage command renders identically.
[agent:result] """
[agent:result] 
[agent:result] from __future__ import annotations
[agent:result] 
[agent:result] from typing import TYPE_CHECKING, Any
[agent:result] 
[agent:result] from hopsworks.cli import output
[agent:result] 
[agent:result] 
[agent:result] if TYPE_CHECKING:
[agent:result]     from collections.abc import Iterator
[agent:result] 
[agent:result] 
[agent:result] # Links buckets, in the order they are listed; the bucket name is the status.
[agent:result] _BUCKETS = ("accessible", "inaccessible", "deleted", "faulty")
[agent:result] 
[agent:result] 
[agent:result] def fetch(fn: Any) -> Any:
[agent:result]     """Call a provenance accessor and return its result.
[agent:result] 
[agent:result]     The SDK accessors return None (or an empty Links) when an edge is simply
[agent:result]     absent and raise RestAPIError only on real backend errors. We deliberately
[agent:result]     do NOT swallow exceptions here: a permission, auth, or server error must
[agent:result]     surface and fail the command rather than render misleadingly as "no
[agent:result]     lineage". Returns None only when the accessor itself is absent (fn is None).
[agent:result] 
[agent:result]     Args:
[agent:result]         fn: A zero-argument provenance accessor, or None.
[agent:result] 
[agent:result]     Returns:
[agent:result]         The accessor's result (which may itself be None), or None if fn is None.
[agent:result]     """
[agent:result]     return fn() if fn is not None else None
[agent:result] 
[agent:result] 
[agent:result] def _iter_artifacts(links: Any) -> Iterator[tuple[Any, str]]:
[agent:result]     """Yield ``(artifact, status)`` pairs from a Links result or plain value.
[agent:result] 
[agent:result]     Accepts an ``explicit_provenance.Links`` (whose four buckets carry the
[agent:result]     status), a list of objects, or a single object.
[agent:result]     This lets callers mix provenance links with a directly-resolved object,
[agent:result]     such as the model a deployment serves.
[agent:result]     """
[agent:result]     if links is None:
[agent:result]         return
[agent:result]     if hasattr(links, "accessible") and hasattr(links, "deleted"):
[agent:result]         for bucket in _BUCKETS:
[agent:result]             for art in getattr(links, bucket, None) or []:
[agent:result]                 yield art, bucket
[agent:result]         return
[agent:result]     if isinstance(links, (list, tuple)):
[agent:result]         for art in links:
[agent:result]             yield art, "accessible"
[agent:result]         return
[agent:result]     yield links, "accessible"
[agent:result] 
[agent:result] 
