[agent:result]     prefix = os.environ['MLPAB_DATABRICKS_PREFIX']  # mlpabe4c51d
[agent:result]     warehouse_id = "8a93fc195da2ceb1"  # mlpab-grader
[agent:result]     
[agent:result]     # Read the CSV files
[agent:result]     requests = []
[agent:result]     with open('data/requests.csv', 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             requests.append({
[agent:result]                 'request_id': row['request_id'],
[agent:result]                 'account_id': row['account_id'],
[agent:result]                 'request_lat': float(row['request_lat']),
[agent:result]                 'request_lon': float(row['request_lon'])
[agent:result]             })
[agent:result]     
[agent:result]     profiles = {}
[agent:result]     with open('data/profiles.csv', 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             profiles[row['account_id']] = {
[agent:result]                 'home_lat': float(row['home_lat']),
[agent:result]                 'home_lon': float(row['home_lon']),
[agent:result]                 'base_score': float(row['base_score'])
[agent:result]             }
[agent:result]     
[agent:result]     print(f"Loaded {len(requests)} requests and {len(profiles)} profiles")
[agent:result]     
[agent:result]     # Create the scored table
[agent:result]     create_scored_table = f"""
[agent:result]     CREATE OR REPLACE TABLE {schema_name}.scored68393f (
[agent:result]         request_id STRING,
[agent:result]         account_id STRING,
[agent:result]         distance_deg DOUBLE,
[agent:result]         score DOUBLE
[agent:result]     )
[agent:result]     COMMENT 'Feature table with scored requests'
[agent:result]     """
[agent:result]     
[agent:result]     print("Creating scored68393f table...")
[agent:result]     ws.statement_execution.execute_statement(
[agent:result]         create_scored_table,
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         wait_timeout="10s"
[agent:result]     )
[agent:result]     print("Created scored68393f table")
[agent:result]     
[agent:result]     # Calculate and insert data in batches
[agent:result]     batch_size = 50
[agent:result]     for i in range(0, len(requests), batch_size):
[agent:result]         batch = requests[i:i + batch_size]
[agent:result]         
[agent:result]         insert_values = []
[agent:result]         for req in batch:
[agent:result]             account_id = req['account_id']
[agent:result]             profile = profiles[account_id]
[agent:result]             
[agent:result]             # Calculate distance_deg
[agent:result]             distance_deg = math.sqrt((req['request_lat'] - profile['home_lat'])**2 + 
[agent:result]                                    (req['request_lon'] - profile['home_lon'])**2)
[agent:result]             distance_deg_rounded = round(distance_deg, 6)
[agent:result]             
[agent:result]             # Calculate score
[agent:result]             score = profile['base_score'] - 0.1 * distance_deg_rounded
[agent:result]             score_rounded = round(score, 6)
[agent:result]             
[agent:result]             insert_values.append(
[agent:result]                 f"('{req['request_id']}', '{account_id}', {distance_deg_rounded}, {score_rounded})"
[agent:result]             )
[agent:result]         
[agent:result]         values_str = ", ".join(insert_values)
[agent:result]         insert_sql = f"""
[agent:result]         INSERT INTO {schema_name}.scored68393f
[agent:result]         VALUES {values_str}
[agent:result]         """
[agent:result]         
[agent:result]         print(f"Inserting batch {i//batch_size + 1}...")
[agent:result]         ws.statement_execution.execute_statement(
