[agent:result]     # For each label, get the most recent feature values at or before label_time
[agent:result]     query = f"""
[agent:result] WITH latest_features AS (
[agent:result]   -- Get latest transaction features for each account at or before each label_time
[agent:result]   SELECT 
[agent:result]     l.account_id,
[agent:result]     l.label_time,
[agent:result]     l.churned,
[agent:result]     -- Latest amount and balance from transactions
[agent:result]     (SELECT t.amount FROM temp_transactions t 
[agent:result]      WHERE t.account_id = l.account_id AND t.event_time <= l.label_time
[agent:result]      ORDER BY t.event_time DESC LIMIT 1) as amount,
[agent:result]     (SELECT t.balance FROM temp_transactions t 
[agent:result]      WHERE t.account_id = l.account_id AND t.event_time <= l.label_time
[agent:result]      ORDER BY t.event_time DESC LIMIT 1) as balance,
[agent:result]     -- Latest credit_score and tier from profiles
[agent:result]     (SELECT p.credit_score FROM temp_profiles p 
[agent:result]      WHERE p.account_id = l.account_id AND p.event_time <= l.label_time
[agent:result]      ORDER BY p.event_time DESC LIMIT 1) as credit_score,
[agent:result]     (SELECT p.tier FROM temp_profiles p 
[agent:result]      WHERE p.account_id = l.account_id AND p.event_time <= l.label_time
[agent:result]      ORDER BY p.event_time DESC LIMIT 1) as tier,
[agent:result]     -- Latest sessions_7d from activity
[agent:result]     (SELECT a.sessions_7d FROM temp_activity a 
[agent:result]      WHERE a.account_id = l.account_id AND a.event_time <= l.label_time
[agent:result]      ORDER BY a.event_time DESC LIMIT 1) as sessions_7d,
[agent:result]     -- Latest health_score from account_health
[agent:result]     (SELECT h.health_score FROM temp_account_health h 
[agent:result]      WHERE h.account_id = l.account_id AND h.event_time <= l.label_time
[agent:result]      ORDER BY h.event_time DESC LIMIT 1) as health_score
[agent:result]   FROM temp_labels l
[agent:result] )
[agent:result] SELECT 
[agent:result]   account_id,
[agent:result]   label_time,
[agent:result]   amount,
[agent:result]   balance,
[agent:result]   credit_score,
[agent:result]   tier,
[agent:result]   sessions_7d,
[agent:result]   health_score,
[agent:result]   churned
[agent:result] FROM latest_features
[agent:result] ORDER BY account_id, label_time
[agent:result] """
