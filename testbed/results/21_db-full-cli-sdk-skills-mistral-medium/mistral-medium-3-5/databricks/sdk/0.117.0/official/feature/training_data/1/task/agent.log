[agent:result]     ws.sql.execute(f"CREATE OR REPLACE TEMPORARY VIEW temp_activity AS SELECT * FROM csv.`{dbfs_path}activity.csv`")
[agent:result]     ws.sql.execute(f"CREATE OR REPLACE TEMPORARY VIEW temp_account_health AS SELECT * FROM csv.`{dbfs_path}account_health.csv`")
[agent:result]     ws.sql.execute(f"CREATE OR REPLACE TEMPORARY VIEW temp_labels AS SELECT * FROM csv.`{dbfs_path}labels.csv`")
