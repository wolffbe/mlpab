[agent:result] def generate_batch_insert(file_path, table_name, batch_size=50):
[agent:result]     """Generate batch INSERT statements for a CSV file"""
[agent:result]     with open(file_path, 'r') as f:
[agent:result]         reader = csv.reader(f)
[agent:result]         header = next(reader)
[agent:result]         columns = ', '.join(header)
[agent:result]         
[agent:result]         batch_statements = []
[agent:result]         current_batch = []
[agent:result]         
[agent:result]         for row in reader:
[agent:result]             # Escape single quotes by doubling them and handle NULL values
[agent:result]             escaped_values = []
[agent:result]             for value in row:
[agent:result]                 if value == '' or value.lower() == 'null':
[agent:result]                     escaped_values.append('NULL')
[agent:result]                 else:
[agent:result]                     # Escape single quotes
[agent:result]                     escaped_value = value.replace("'", "''")
[agent:result]                     escaped_values.append(f"'{escaped_value}'")
[agent:result]             
[agent:result]             current_batch.append(f"({', '.join(escaped_values)})")
[agent:result]             
[agent:result]             if len(current_batch) >= batch_size:
[agent:result]                 values = ', '.join(current_batch)
[agent:result]                 batch_statements.append(f"INSERT INTO {table_name} ({columns}) VALUES {values};")
[agent:result]                 current_batch = []
[agent:result]         
[agent:result]         # Add the last batch
[agent:result]         if current_batch:
[agent:result]             values = ', '.join(current_batch)
[agent:result]             batch_statements.append(f"INSERT INTO {table_name} ({columns}) VALUES {values};")
[agent:result]         
[agent:result]         return batch_statements
[agent:result] 
