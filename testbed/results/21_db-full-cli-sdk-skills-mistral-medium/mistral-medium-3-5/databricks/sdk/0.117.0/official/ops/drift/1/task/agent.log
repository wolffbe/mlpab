[agent:result] content: #!/usr/bin/env python3
[agent:result] import os
[agent:result] import json
[agent:result] import csv
[agent:result] from datetime import datetime
[agent:result] from collections import defaultdict
[agent:result] 
[agent:result] # Read the CSV file
[agent:result] print("Reading CSV file...")
[agent:result] with open('data/features.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     rows = list(reader)
[agent:result] 
[agent:result] print(f"Read {len(rows)} rows")
[agent:result] 
[agent:result] # Parse dates and extract features
[agent:result] dates = []
[agent:result] features = ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']
[agent:result] feature_values = {feat: [] for feat in features}
[agent:result] 
[agent:result] for row in rows:
[agent:result]     date_str = row['event_time']
[agent:result]     date = datetime.fromisoformat(date_str.replace('Z', '+00:00')).date()
[agent:result]     dates.append(date)
[agent:result]     
[agent:result]     for feat in features:
[agent:result]         feature_values[feat].append(float(row[feat]))
[agent:result] 
[agent:result] print(f"Dates range: {min(dates)} to {max(dates)}")
[agent:result] 
[agent:result] # Group by date and compute daily statistics
[agent:result] daily_data = defaultdict(lambda: {feat: [] for feat in features})
[agent:result] for i, date in enumerate(dates):
[agent:result]     for feat in features:
[agent:result]         daily_data[date][feat].append(feature_values[feat][i])
[agent:result] 
[agent:result] # Compute daily means
[agent:result] daily_means = {}
[agent:result] for date in sorted(daily_data.keys()):
[agent:result]     daily_means[date] = {}
[agent:result]     for feat in features:
[agent:result]         values = daily_data[date][feat]
[agent:result]         daily_means[date][feat] = sum(values) / len(values)
[agent:result] 
[agent:result] # Convert to sorted list
[agent:result] sorted_dates = sorted(daily_means.keys())
[agent:result] 
[agent:result] # Print daily means for f5 to see the transition
[agent:result] print(f"\nDaily means for f5:")
[agent:result] for date in sorted_dates:
[agent:result]     print(f"  {date.isoformat()}: {daily_means[date]['f5']:.3f}")
[agent:result] 
[agent:result] # Now let's detect the exact transition point for each feature
[agent:result] # We'll look for the point where the mean changes the most from one day to the next
[agent:result] print("\nDetecting exact transition points...")
[agent:result] 
[agent:result] feature_transitions = {}
[agent:result] for feat in features:
[agent:result]     means = [daily_means[date][feat] for date in sorted_dates]
[agent:result]     
[agent:result]     # Find the point with maximum absolute change from one day to the next
[agent:result]     max_change = 0
[agent:result]     max_change_idx = 0
[agent:result]     for i in range(1, len(means)):
[agent:result]         change = abs(means[i] - means[i-1])
[agent:result]         if change > max_change:
[agent:result]             max_change = change
[agent:result]             max_change_idx = i
[agent:result]     
[agent:result]     transition_date = sorted_dates[max_change_idx]
[agent:result]     feature_transitions[feat] = {
[agent:result]         'date': transition_date,
[agent:result]         'change': max_change,
[agent:result]         'before': means[max_change_idx-1],
[agent:result]         'after': means[max_change_idx]
[agent:result]     }
[agent:result]     print(f"  {feat}: transition at {transition_date.isoformat()}, change={max_change:.4f}, before={means[max_change_idx-1]:.4f}, after={means[max_change_idx]:.4f}")
[agent:result] 
[agent:result] # Find the feature with the largest change
[agent:result] max_feature = max(feature_transitions.keys(), key=lambda x: feature_transitions[x]['change'])
[agent:result] max_date = feature_transitions[max_feature]['date']
[agent:result] max_change = feature_transitions[max_feature]['change']
[agent:result] 
[agent:result] print(f"\nFeature with largest transition: {max_feature}")
[agent:result] print(f"Transition date: {max_date.isoformat()}")
[agent:result] print(f"Change magnitude: {max_change:.4f}")
[agent:result] 
[agent:result] # Verify by looking at all features
[agent:result] print(f"\nAll features transitions:")
[agent:result] for feat in features:
[agent:result]     trans = feature_transitions[feat]
[agent:result]     print(f"  {feat}: {trans['date'].isoformat()}, change={trans['change']:.4f}, before={trans['before']:.4f}, after={trans['after']:.4f}")
[agent:result] 
[agent:result] # Create submission directory
[agent:result] os.makedirs('submission', exist_ok=True)
[agent:result] 
[agent:result] # Write the answer
[agent:result] answer = {
[agent:result]     "feature": max_feature,
[agent:result]     "onset": max_date.isoformat()
[agent:result] }
[agent:result] 
[agent:result] with open('submission/answers.json', 'w') as f:
[agent:result]     json.dump(answer, f)
[agent:result] 
