[agent:result] # Query to get daily statistics for each feature
[agent:result] query = f"""
[agent:result] WITH daily_stats AS (
[agent:result]     SELECT 
[agent:result]         DATE(event_time) as date,
[agent:result]         AVG(f1) as avg_f1, STDDEV(f1) as std_f1,
[agent:result]         AVG(f2) as avg_f2, STDDEV(f2) as std_f2,
[agent:result]         AVG(f3) as avg_f3, STDDEV(f3) as std_f3,
[agent:result]         AVG(f4) as avg_f4, STDDEV(f4) as std_f4,
[agent:result]         AVG(f5) as avg_f5, STDDEV(f5) as std_f5,
[agent:result]         AVG(f6) as avg_f6, STDDEV(f6) as std_f6,
[agent:result]         COUNT(*) as count
[agent:result]     FROM {SCHEMA}.{PREFIX}_features
[agent:result]     GROUP BY DATE(event_time)
[agent:result]     ORDER BY date
[agent:result] )
[agent:result] SELECT * FROM daily_stats
[agent:result] """
[agent:result] 
[agent:result] result = w.statement_execution.execute_statement(
[agent:result]     warehouse_id=warehouse_id,
[agent:result]     catalog=catalog_name,
