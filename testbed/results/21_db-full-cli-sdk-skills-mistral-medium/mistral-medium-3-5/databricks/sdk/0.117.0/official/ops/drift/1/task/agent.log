[agent:result] # Find the drift point for each feature using a simple change detection
[agent:result] def detect_drift(means, dates):
[agent:result]     """Detect drift by finding the point with maximum change in rolling mean"""
[agent:result]     if len(means) < 2:
[agent:result]         return None, 0
[agent:result]     
[agent:result]     # Calculate rolling mean with window of 7 days
[agent:result]     window = 7
[agent:result]     rolling_means = []
[agent:result]     for i in range(len(means)):
[agent:result]         start = max(0, i - window + 1)
[agent:result]         rolling_mean = sum(means[start:i+1]) / (i - start + 1)
[agent:result]         rolling_means.append(rolling_mean)
[agent:result]     
[agent:result]     # Find the point with maximum absolute change
[agent:result]     max_change = 0
[agent:result]     max_change_idx = 0
[agent:result]     for i in range(1, len(rolling_means)):
[agent:result]         change = abs(rolling_means[i] - rolling_means[i-1])
[agent:result]         if change > max_change:
[agent:result]             max_change = change
[agent:result]             max_change_idx = i
[agent:result]     
[agent:result]     return dates[max_change_idx], max_change
[agent:result] 
[agent:result] # Detect drift for each feature
