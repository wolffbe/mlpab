[agent:result]         COUNT(*) as count
[agent:result]     FROM {SCHEMA}.{PREFIX}_features
[agent:result]     GROUP BY DATE(event_time)
[agent:result]     ORDER BY date
[agent:result] )
[agent:result] SELECT * FROM daily_stats
[agent:result] """
[agent:result] 
