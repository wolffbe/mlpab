[agent:result] 
[agent:result] print("\nLast few days:")
[agent:result] for i, row in enumerate(results[-5:]):
[agent:result]     print(f"  {row[0]}: f1={row[1]:.3f}, f2={row[3]:.3f}, f3={row[5]:.3f}, f4={row[7]:.3f}, f5={row[9]:.3f}, f6={row[11]:.3f}")
[agent:result] 
[agent:result] # Now let's detect drift by looking for significant changes in mean
[agent:result] print("\nDetecting drift...")
[agent:result] 
[agent:result] # Extract dates and feature means
[agent:result] dates = [row[0] for row in results]
[agent:result] features = ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']
[agent:result] feature_means = {}
[agent:result] for i, feat in enumerate(features):
[agent:result]     feature_means[feat] = [results[j][1 + i*2] for j in range(len(results))]
[agent:result] 
[agent:result] # Find the drift point for each feature using a simple change detection
[agent:result] def detect_drift(means, dates):
[agent:result]     """Detect drift by finding the point with maximum change in rolling mean"""
[agent:result]     if len(means) < 2:
[agent:result]         return None, 0
[agent:result]     
[agent:result]     # Calculate rolling mean with window of 7 days
[agent:result]     window = 7
[agent:result]     rolling_means = []
[agent:result]     for i in range(len(means)):
[agent:result]         start = max(0, i - window + 1)
[agent:result]         rolling_mean = sum(means[start:i+1]) / (i - start + 1)
[agent:result]         rolling_means.append(rolling_mean)
[agent:result]     
[agent:result]     # Find the point with maximum absolute change
[agent:result]     max_change = 0
[agent:result]     max_change_idx = 0
[agent:result]     for i in range(1, len(rolling_means)):
[agent:result]         change = abs(rolling_means[i] - rolling_means[i-1])
[agent:result]         if change > max_change:
[agent:result]             max_change = change
[agent:result]             max_change_idx = i
[agent:result]     
[agent:result]     return dates[max_change_idx], max_change
[agent:result] 
[agent:result] # Detect drift for each feature
[agent:result] feature_drifts = {}
[agent:result] for feat in features:
[agent:result]     onset, change = detect_drift(feature_means[feat], dates)
[agent:result]     feature_drifts[feat] = {
[agent:result]         'onset': onset,
[agent:result]         'change': change
[agent:result]     }
[agent:result]     print(f"  {feat}: onset={onset}, change={change:.4f}")
[agent:result] 
[agent:result] # Find the feature with the largest change
[agent:result] max_feature = max(feature_drifts.keys(), key=lambda x: feature_drifts[x]['change'])
[agent:result] max_onset = feature_drifts[max_feature]['onset']
[agent:result] max_change = feature_drifts[max_feature]['change']
[agent:result] 
[agent:result] print(f"\nFeature with largest drift: {max_feature}")
[agent:result] print(f"Onset date: {max_onset}")
[agent:result] print(f"Change magnitude: {max_change:.4f}")
[agent:result] 
[agent:result] # Verify by looking at the actual distribution shift
[agent:result] print(f"\nVerifying drift for {max_feature} around {max_onset}...")
[agent:result] 
[agent:result] # Find the index of the onset date
[agent:result] onset_idx = dates.index(max_onset) if max_onset in dates else len(dates) // 2
[agent:result] 
[agent:result] print(f"Before {max_onset}: mean={feature_means[max_feature][onset_idx-1]:.4f}")
[agent:result] print(f"After {max_onset}: mean={feature_means[max_feature][onset_idx]:.4f}")
[agent:result] 
[agent:result] # Check all features for significant changes
[agent:result] print("\nChecking all features for significant changes:")
[agent:result] for feat in features:
[agent:result]     before = feature_means[feat][onset_idx - 1] if onset_idx > 0 else feature_means[feat][0]
[agent:result]     after = feature_means[feat][onset_idx]
[agent:result]     change = abs(after - before)
[agent:result]     rel_change = change / abs(before) if before != 0 else float('inf')
[agent:result]     print(f"  {feat}: before={before:.4f}, after={after:.4f}, change={change:.4f}, rel_change={rel_change:.2%}")
[agent:result] 
