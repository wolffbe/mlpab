[agent:result]         state = run_info.state
[agent:result]         if state.life_cycle_state in ["TERMINATED", "INTERNAL_ERROR"]:
[agent:result]             print(f"Job run {run_id} completed with state: {state.life_cycle_state}, result: {state.result_state}")
