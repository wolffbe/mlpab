[agent:result]     print(f"Workspace path: {workspace_path}")
[agent:result]     
[agent:result]     # Step 1: Upload data files and training script to workspace
[agent:result]     print("\n=== Uploading files ===")
[agent:result]     with open("data/train.csv", "rb") as f:
[agent:result]         w.workspace.upload(f"{workspace_path}train.csv", f.read(), overwrite=True)
[agent:result]     print("Uploaded train.csv")
[agent:result]     
[agent:result]     with open("data/score.csv", "rb") as f:
[agent:result]         w.workspace.upload(f"{workspace_path}score.csv", f.read(), overwrite=True)
[agent:result]     print("Uploaded score.csv")
[agent:result]     
[agent:result]     with open("data/train_model.py", "rb") as f:
[agent:result]         w.workspace.upload(f"{workspace_path}train_model.py", f.read(), overwrite=True)
[agent:result]     print("Uploaded train_model.py")
[agent:result]     
[agent:result]     # Step 2: Create a job to run the training script
[agent:result]     print("\n=== Creating job ===")
[agent:result]     job_name = f"{prefix}_trainjobd631cc"
[agent:result]     
[agent:result]     # Check if job already exists and delete it
[agent:result]     existing_jobs = w.jobs.list(name=job_name)
[agent:result]     if existing_jobs:
[agent:result]         job_id = existing_jobs[0].job_id
[agent:result]         print(f"Deleting existing job {job_id}")
[agent:result]         w.jobs.delete(job_id)
[agent:result]     
[agent:result]     # Create new job
[agent:result]     job = w.jobs.create(
[agent:result]         name=job_name,
[agent:result]         tasks=[
[agent:result]             {
[agent:result]                 "task_key": "train",
[agent:result]                 "new_cluster": {
[agent:result]                     "spark_version": "14.3.x-scala2.12",
[agent:result]                     "node_type_id": "Standard_DS3_v2",
[agent:result]                     "num_workers": 0,
[agent:result]                 },
[agent:result]                 "spark_python_task": {
[agent:result]                     "python_file": f"{workspace_path}train_model.py",
[agent:result]                 },
[agent:result]             }
[agent:result]         ],
[agent:result]     )
[agent:result]     
[agent:result]     job_id = job.job_id
