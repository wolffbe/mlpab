[agent:result] import os
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] 
[agent:result] def main():
[agent:result]     # Initialize workspace client
[agent:result]     wc = WorkspaceClient()
[agent:result]     
[agent:result]     # Environment variables
[agent:result]     schema_name = os.environ['MLPAB_DATABRICKS_SCHEMA']  # workspace.mlpab6ccd46
[agent:result]     prefix = os.environ['MLPAB_DATABRICKS_PREFIX']  # mlpab6ccd46
[agent:result]     warehouse_id = '4dfab06c923fe3cc'  # mlpab-grader
[agent:result]     
[agent:result]     # Parse catalog and schema from MLPAB_DATABRICKS_SCHEMA
[agent:result]     catalog_name, schema_name_only = schema_name.split('.')
[agent:result]     
[agent:result]     print(f"Catalog: {catalog_name}")
[agent:result]     print(f"Schema: {schema_name_only}")
[agent:result]     print(f"Prefix: {prefix}")
[agent:result]     
[agent:result]     # Step 1: Upload CSV files to DBFS
[agent:result]     print("\n=== Step 1: Uploading CSV files to DBFS ===")
[agent:result]     dbfs_path = f"dbfs:/FileStore/{prefix}/transactions/"
[agent:result]     wc.dbfs.mkdirs(dbfs_path)
[agent:result]     
[agent:result]     # Upload file 1
[agent:result]     wc.dbfs.upload(
[agent:result]         src_path='data/transactions_export_1.csv',
[agent:result]         dst_path=f'{dbfs_path}transactions_export_1.csv',
