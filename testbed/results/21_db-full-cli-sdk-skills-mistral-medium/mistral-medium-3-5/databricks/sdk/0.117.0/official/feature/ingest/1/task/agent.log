[agent:result]     print(f"Table row count: {row_count}")
[agent:result]     
[agent:result]     if row_count != 600:
[agent:result]         print(f"WARNING: Expected 600 rows, got {row_count}")
[agent:result]     else:
[agent:result]         print("SUCCESS: Table has exactly 600 unique rows")
[agent:result]     
[agent:result]     # Step 4: Create online store and publish table
[agent:result]     print("\n=== Step 4: Creating online store and publishing table ===")
[agent:result]     online_store_name = f"{prefix}_feature_store"
[agent:result]     
[agent:result]     # Check if online store exists, create if not
[agent:result]     try:
[agent:result]         existing_store = wc.feature_store.get_online_store(online_store_name)
[agent:result]         print(f"Online store {online_store_name} already exists")
[agent:result]     except Exception as e:
[agent:result]         print(f"Creating online store {online_store_name}")
[agent:result]         wc.feature_store.create_online_store(
[agent:result]             name=online_store_name,
[agent:result]             storage_path=f"dbfs:/databricks-datasets/feature-store/{prefix}"
[agent:result]         )
[agent:result]         print(f"Created online store {online_store_name}")
[agent:result]     
[agent:result]     # Publish the table to online store
[agent:result]     # This makes the features available for low-latency lookup
[agent:result]     online_table_full_name = f"{catalog_name}.{schema_name}.{table_name}"
[agent:result]     
[agent:result]     publish_spec = PublishSpec(
[agent:result]         online_store=online_store_name,
[agent:result]         online_table_name=online_table_full_name,
[agent:result]         publish_mode=PublishSpecPublishMode.SNAPSHOT
[agent:result]     )
[agent:result]     
[agent:result]     publish_response = wc.feature_store.publish_table(
[agent:result]         source_table_name=full_table_name,
[agent:result]         publish_spec=publish_spec
[agent:result]     )
[agent:result]     print(f"Published table to online store")
[agent:result]     print(f"  Source: {full_table_name}")
[agent:result]     print(f"  Online table: {online_table_full_name}")
[agent:result]     print(f"  Online store: {online_store_name}")
[agent:result]     
[agent:result]     # Step 5: Also create an OnlineTable resource for explicit online access
[agent:result]     print("\n=== Step 5: Creating OnlineTable resource ===")
[agent:result]     online_table_name = f"{prefix}_transactions30b87b_online"
[agent:result]     
[agent:result]     online_table_spec = OnlineTableSpec(
[agent:result]         source_table_full_name=full_table_name,
[agent:result]         primary_key_columns=['row_id'],
[agent:result]         timeseries_key='event_time',
[agent:result]         perform_full_copy=True
[agent:result]     )
[agent:result]     
[agent:result]     online_table = OnlineTable(
[agent:result]         name=online_table_name,
[agent:result]         spec=online_table_spec
[agent:result]     )
[agent:result]     
[agent:result]     try:
