[agent:result] def main():
[agent:result]     # Initialize workspace client
[agent:result]     wc = WorkspaceClient()
[agent:result]     
[agent:result]     # Environment variables
[agent:result]     full_schema = os.environ['MLPAB_DATABRICKS_SCHEMA']  # workspace.mlpab6ccd46
[agent:result]     prefix = os.environ['MLPAB_DATABRICKS_PREFIX']  # mlpab6ccd46
[agent:result]     warehouse_id = '4dfab06c923fe3cc'  # mlpab-grader
[agent:result]     
[agent:result]     # Parse catalog and schema from MLPAB_DATABRICKS_SCHEMA
[agent:result]     catalog_name, schema_name = full_schema.split('.')
[agent:result]     
[agent:result]     print(f"Catalog: {catalog_name}")
[agent:result]     print(f"Schema: {schema_name}")
[agent:result]     print(f"Prefix: {prefix}")
[agent:result]     
[agent:result]     # Step 1: Create a volume for storing the CSV files
[agent:result]     print("\n=== Step 1: Creating volume ===")
[agent:result]     volume_name = 'transactions_data'
[agent:result]     volume_path = f'/Volumes/{catalog_name}/{schema_name}/{volume_name}/'
[agent:result]     
[agent:result]     try:
[agent:result]         volume = wc.volumes.create(
[agent:result]             catalog_name=catalog_name,
[agent:result]             schema_name=schema_name,
[agent:result]             name=volume_name,
[agent:result]             volume_type='MANAGED'
[agent:result]         )
[agent:result]         print(f"Created volume: {volume.full_name}")
[agent:result]     except Exception as e:
[agent:result]         print(f"Volume may already exist or error: {e}")
[agent:result]     
[agent:result]     # Step 2: Upload CSV files to the volume
[agent:result]     print("\n=== Step 2: Uploading CSV files to volume ===")
[agent:result]     
[agent:result]     # Upload file 1
[agent:result]     with open('data/transactions_export_1.csv', 'rb') as f:
[agent:result]         contents = io.BytesIO(f.read())
[agent:result]     
[agent:result]     wc.files.upload(
[agent:result]         file_path=f'{volume_path}transactions_export_1.csv',
[agent:result]         contents=contents,
[agent:result]         overwrite=True
[agent:result]     )
[agent:result]     print("Uploaded transactions_export_1.csv")
[agent:result]     
[agent:result]     # Upload file 2
[agent:result]     with open('data/transactions_export_2.csv', 'rb') as f:
[agent:result]         contents = io.BytesIO(f.read())
[agent:result]     
[agent:result]     wc.files.upload(
[agent:result]         file_path=f'{volume_path}transactions_export_2.csv',
[agent:result]         contents=contents,
[agent:result]         overwrite=True
[agent:result]     )
[agent:result]     print("Uploaded transactions_export_2.csv")
[agent:result]     
[agent:result]     # Step 3: Create Delta table from CSV files with deduplication
[agent:result]     print("\n=== Step 3: Creating Delta table ===")
[agent:result]     table_name = 'transactions30b87b'
[agent:result]     full_table_name = f"{catalog_name}.{schema_name}.{table_name}"
[agent:result]     
[agent:result]     # Create the table from both CSV files with DISTINCT to deduplicate
[agent:result]     create_table_sql = f"""
[agent:result] CREATE TABLE IF NOT EXISTS {full_table_name} 
[agent:result] USING DELTA
[agent:result] AS 
[agent:result] SELECT DISTINCT * FROM (
[agent:result]   SELECT * FROM csv.`{volume_path}transactions_export_1.csv`
[agent:result]   UNION ALL
[agent:result]   SELECT * FROM csv.`{volume_path}transactions_export_2.csv`
[agent:result] )
[agent:result] """
[agent:result]     
[agent:result]     result = wc.statement_execution.execute_statement(
[agent:result]         statement=create_table_sql,
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         wait_timeout='50s'
[agent:result]     )
[agent:result]     
[agent:result]     statement_id = result.statement_id
[agent:result]     print(f"Created table, statement_id: {statement_id}")
[agent:result]     
[agent:result]     # Verify the table was created with correct row count
[agent:result]     row_count_result = wc.statement_execution.execute_statement(
[agent:result]         statement=f"SELECT COUNT(*) as cnt FROM {full_table_name}",
