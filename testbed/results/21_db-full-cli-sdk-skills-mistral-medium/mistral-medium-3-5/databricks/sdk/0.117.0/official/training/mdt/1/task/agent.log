[agent:result]     n = len(values)
[agent:result]     mean = sum(values) / n
[agent:result]     # Population standard deviation (no Bessel's correction)
[agent:result]     variance = sum((x - mean) ** 2 for x in values) / n
[agent:result]     std = variance ** 0.5
[agent:result]     stats[feature] = {'mean': mean, 'std': std}
[agent:result]     print(f"{feature}: mean={mean:.6f}, std={std:.6f}")
