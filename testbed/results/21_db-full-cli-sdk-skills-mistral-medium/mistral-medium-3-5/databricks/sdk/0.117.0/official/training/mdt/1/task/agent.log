[agent:result]         'f1': standardize_value(row['f1'], stats['f1']['mean'], stats['f1']['std']),
[agent:result]         'f2': standardize_value(row['f2'], stats['f2']['mean'], stats['f2']['std']),
[agent:result]         'f3': standardize_value(row['f3'], stats['f3']['mean'], stats['f3']['std']),
