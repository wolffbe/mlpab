[agent:result] 
[agent:result] def standardize_value(value, mean, std):
[agent:result]     """Standardize a value: (x - mean) / std, rounded to 6 decimals."""
[agent:result]     if std == 0:
[agent:result]         return 0.0  # Avoid division by zero
[agent:result]     standardized = (value - mean) / std
[agent:result]     return round(standardized, 6)
[agent:result] 
