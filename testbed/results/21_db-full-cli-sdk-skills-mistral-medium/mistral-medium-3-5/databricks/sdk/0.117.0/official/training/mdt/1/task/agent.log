[agent:result] def read_csv(file_path):
[agent:result]     """Read CSV file and return list of dicts."""
[agent:result]     data = []
[agent:result]     with open(file_path, 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             # Convert numeric fields to float
[agent:result]             for key in ['f1', 'f2', 'f3', 'f4']:
[agent:result]                 row[key] = float(row[key])
[agent:result]             data.append(row)
[agent:result]     return data
