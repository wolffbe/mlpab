[agent:result]         'f2': standardize_value(row['f2'], stats['f2']['mean'], stats['f2']['std']),
[agent:result]         'f3': standardize_value(row['f3'], stats['f3']['mean'], stats['f3']['std']),
[agent:result]         'f4': standardize_value(row['f4'], stats['f4']['mean'], stats['f4']['std'])
[agent:result]     }
[agent:result]     standardized_train.append(std_row)
[agent:result] 
[agent:result] # Process serving data
