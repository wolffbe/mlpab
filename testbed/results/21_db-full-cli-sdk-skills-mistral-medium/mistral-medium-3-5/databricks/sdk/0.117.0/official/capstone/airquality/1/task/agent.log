[agent:result]     "temp_humidity", "temp_wind", "humidity_wind", "rolling_avg_3d", "rolling_std_3d",
[agent:result]     col("pm25").alias("label")
[agent:result] ).filter(col("pm25").isNotNull())
[agent:result] 
[agent:result] training_df.write.mode("overwrite").saveAsTable("{TRAINING_TABLE}")
[agent:result] print(f"Training dataset saved: {TRAINING_TABLE}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Train model
