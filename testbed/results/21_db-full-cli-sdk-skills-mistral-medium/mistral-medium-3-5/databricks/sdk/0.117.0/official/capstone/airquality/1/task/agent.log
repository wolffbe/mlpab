[agent:result]     'pm25_lag1', 'temperature', 'humidity', 'wind_speed', 'pressure', 'precipitation',
[agent:result]     'temp_squared', 'humidity_squared', 'wind_speed_squared', 'pressure_squared',
[agent:result]     'temp_humidity', 'temp_wind', 'humidity_wind', 'rolling_avg_3d', 'rolling_std_3d'
[agent:result] ]
[agent:result] 
[agent:result] assembler = VectorAssembler(inputCols=feature_cols, outputCol="features")
[agent:result] train_data, test_data = training_df.randomSplit([0.8, 0.2], seed=42)
[agent:result] 
[agent:result] rf = RandomForestRegressor(labelCol="label", featuresCol="features", numTrees=200, maxDepth=8, minInstancesPerNode=5, seed=42)
[agent:result] pipeline = Pipeline(stages=[assembler, rf])
[agent:result] 
[agent:result] mlflow.set_experiment(f"/Users/{USER}/{PREFIX}/airq_experiment")
[agent:result] 
[agent:result] with mlflow.start_run():
[agent:result]     model = pipeline.fit(train_data)
[agent:result]     predictions = model.transform(test_data)
[agent:result]     evaluator = RegressionEvaluator(labelCol="label", predictionCol="prediction", metricName="rmse")
[agent:result]     rmse = evaluator.evaluate(predictions)
[agent:result]     print(f"Test RMSE: {{rmse}}")
[agent:result]     mlflow.log_metric("rmse", rmse)
[agent:result]     mlflow.spark.log_model(model, "model")
[agent:result]     model_uri = f"runs:/{{mlflow.active_run().info.run_id}}/model"
[agent:result]     mlflow.register_model(model_uri, "{MODEL_NAME}")
[agent:result]     print(f"Model registered: {MODEL_NAME}, RMSE: {{rmse}}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Make predictions
[agent:result] model_path = f"/Users/{USER}/{PREFIX}/airq_experiment"
[agent:result] experiment = mlflow.get_experiment_by_name(model_path)
[agent:result] best_run = mlflow.search_runs(experiment_ids=[experiment.experiment_id], order_by=["metrics.rmse ASC"], max_results=1)[0]
[agent:result] run_id = best_run.run_id
[agent:result] pipeline_model = mlflow.spark.load_model(f"runs:/{run_id}/model")
[agent:result] 
[agent:result] # Feature engineering for forecast
[agent:result] feature_forecast = forecast_df.withColumn("temp_squared", col("temperature") * col("temperature")) \\
[agent:result]     .withColumn("humidity_squared", col("humidity") * col("humidity")) \\
[agent:result]     .withColumn("wind_speed_squared", col("wind_speed") * col("wind_speed")) \\
[agent:result]     .withColumn("pressure_squared", col("pressure") * col("pressure")) \\
