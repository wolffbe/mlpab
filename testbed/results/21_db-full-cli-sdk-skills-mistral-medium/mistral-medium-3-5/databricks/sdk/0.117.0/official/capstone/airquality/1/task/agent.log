[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] spark = SparkSession.builder.getOrCreate()
[agent:result] 
[agent:result] # Load data
[agent:result] history_df = spark.read.csv("/{PREFIX}/airquality_history.csv", header=True, inferSchema=True)
[agent:result] forecast_df = spark.read.csv("/{PREFIX}/forecast_days.csv", header=True, inferSchema=True)
[agent:result] print(f"History: {{history_df.count()}} rows, Forecast: {{forecast_df.count()}} rows")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Feature engineering
[agent:result] feature_history = history_df.withColumn("temp_squared", col("temperature") * col("temperature")) \\
[agent:result]     .withColumn("humidity_squared", col("humidity") * col("humidity")) \\
[agent:result]     .withColumn("wind_speed_squared", col("wind_speed") * col("wind_speed")) \\
[agent:result]     .withColumn("pressure_squared", col("pressure") * col("pressure")) \\
[agent:result]     .withColumn("temp_humidity", col("temperature") * col("humidity")) \\
[agent:result]     .withColumn("temp_wind", col("temperature") * col("wind_speed")) \\
[agent:result]     .withColumn("humidity_wind", col("humidity") * col("wind_speed"))
[agent:result] 
[agent:result] window_spec = Window.orderBy("date").rowsBetween(-2, 0)
[agent:result] feature_history = feature_history.withColumn("rolling_avg_3d", avg("pm25").over(window_spec)) \\
