[agent:result]     w = databricks.sdk.WorkspaceClient()
[agent:result]     
[agent:result]     # Get current user
[agent:result]     current_user = w.current_user.me().user_name
[agent:result]     print(f"Current user: {current_user}")
[agent:result]     
[agent:result]     # Path for the heartbeat script in workspace
[agent:result]     workspace_path = f"/Users/{current_user}/{MLPAB_DATABRICKS_PREFIX}/heartbeat.py"
[agent:result]     
[agent:result]     # Read the heartbeat.py file
[agent:result]     with open("data/heartbeat.py", "r") as f:
[agent:result]         heartbeat_content = f.read()
[agent:result]     
[agent:result]     # Upload the script to workspace
[agent:result]     print(f"Uploading heartbeat.py to {workspace_path}")
[agent:result]     w.workspace.fset(workspace_path, heartbeat_content, overwrite=True)
[agent:result]     print("Script uploaded successfully")
[agent:result]     
[agent:result]     # Create the job with a recurring schedule
[agent:result]     job = jobs.Job(
[agent:result]         name=JOB_NAME,
[agent:result]         description="Heartbeat job that prints a heartbeat line periodically",
[agent:result]         tags={"purpose": "heartbeat"},
[agent:result]         tasks=[
[agent:result]             jobs.Task(
[agent:result]                 task_key="heartbeat_task",
[agent:result]                 description="Run heartbeat script",
[agent:result]                 existing_cluster_id="1201-220628-235451-kingfisher-0001",  # Use a basic cluster
[agent:result]                 spark_python_task=jobs.SparkPythonTask(
[agent:result]                     python_file=f"dbfs:{workspace_path}"
[agent:result]                 ),
[agent:result]                 libraries=[],
[agent:result]                 timeout_seconds=60,
[agent:result]             )
[agent:result]         ],
[agent:result]         # Schedule: run hourly (recurring job)
[agent:result]         schedule=jobs.CronSchedule(
[agent:result]             quartz_cron_expression="0 0 * * *",  # Every hour at minute 0
[agent:result]             timezone_id="UTC",
[agent:result]             pause_status=jobs.PauseStatus.UNPAUSED
[agent:result]         ),
[agent:result]         max_concurrent_runs=1,
[agent:result]     )
[agent:result]     
[agent:result]     print(f"Creating job: {JOB_NAME}")
[agent:result]     # Create the job
[agent:result]     create_response = w.jobs.create(job)
[agent:result]     job_id = create_response.job_id
[agent:result]     print(f"Job created with ID: {job_id}")
[agent:result]     
[agent:result]     # Trigger one run immediately
[agent:result]     print("Triggering first run...")
[agent:result]     run_response = w.jobs.run_now(job_id)
[agent:result]     run_id = run_response.run_id
[agent:result]     print(f"Run triggered with ID: {run_id}")
[agent:result]     
[agent:result]     # Wait for the run to complete
[agent:result]     print("Waiting for run to complete...")
[agent:result]     try:
[agent:result]         # Use wait_get_run_job_terminated_or_skipped to wait for completion
[agent:result]         final_run = w.jobs.wait_get_run_job_terminated_or_skipped(run_id, timeout_seconds=300)
[agent:result]         print(f"Run completed with state: {final_run.state}")
[agent:result]         
[agent:result]         if final_run.state and final_run.state.value in ["SUCCESS", "TERMINATED"]:
[agent:result]             print("Run completed successfully!")
[agent:result]         else:
[agent:result]             print(f"Run completed with state: {final_run.state}")
[agent:result]     except Exception as e:
[agent:result]         print(f"Error waiting for run: {e}")
[agent:result]         # Still continue to create submission file
[agent:result]     
[agent:result]     # Create submission directory and write answers.json
[agent:result]     os.makedirs("submission", exist_ok=True)
[agent:result]     submission_data = {
[agent:result]         "job_name": JOB_NAME
[agent:result]     }
[agent:result]     
[agent:result]     with open("submission/answers.json", "w") as f:
[agent:result]         json.dump(submission_data, f, indent=2)
[agent:result]     
[agent:result]     print(f"Submission file written: submission/answers.json")
