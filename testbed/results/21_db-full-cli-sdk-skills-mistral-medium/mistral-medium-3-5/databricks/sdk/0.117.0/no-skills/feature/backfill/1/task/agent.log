[agent:result]     print('\n=== Publishing as online table ===')
[agent:result]     
[agent:result]     # First, check if online store exists
[agent:result]     online_store_name = f'{prefix}_store'
[agent:result]     try:
[agent:result]         stores = list(ws.feature_store.list_online_stores())
[agent:result]         store_names = [s.name for s in stores]
[agent:result]         print(f'Existing online stores: {store_names}')
[agent:result]         
[agent:result]         if online_store_name not in store_names:
[agent:result]             # Create online store
[agent:result]             print(f'Creating online store: {online_store_name}')
[agent:result]             from databricks.sdk.service.ml import OnlineStore
[agent:result]             # OnlineStore requires name and capacity
[agent:result]             online_store = OnlineStore(name=online_store_name, capacity='SMALL')
[agent:result]             ws.feature_store.create_online_store(online_store)
[agent:result]             print(f'Created online store: {online_store_name}')
[agent:result]         else:
[agent:result]             print(f'Using existing online store: {online_store_name}')
[agent:result]     except Exception as e:
