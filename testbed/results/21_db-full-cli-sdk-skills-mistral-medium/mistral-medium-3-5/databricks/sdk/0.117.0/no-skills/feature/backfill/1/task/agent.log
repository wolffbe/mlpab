[agent:result]         online_table_name=online_table_name,
[agent:result]         publish_mode=PublishSpecPublishMode.CONTINUOUS
[agent:result]     )
[agent:result]     
[agent:result]     print(f'Publishing table {full_table_name} as online table {online_table_name}')
[agent:result]     try:
[agent:result]         response = ws.feature_store.publish_table(
