[agent:result]     
[agent:result]     # Table configuration
[agent:result]     table_name = 'accounts9ad208'
[agent:result]     full_table_name = f'{schema_name}.{table_name}'
[agent:result]     online_table_name = f'{prefix}_{table_name}'
[agent:result]     
[agent:result]     print(f'Schema: {schema_name}')
[agent:result]     print(f'Table name: {full_table_name}')
[agent:result]     print(f'Online table name: {online_table_name}')
[agent:result]     
[agent:result]     # Get warehouse ID
[agent:result]     warehouses = list(ws.warehouses.list())
[agent:result]     warehouse_id = warehouses[0].id if warehouses else None
[agent:result]     print(f'Using warehouse ID: {warehouse_id}')
[agent:result]     
[agent:result]     # Step 1: Upload CSV files to workspace
[agent:result]     print('\n=== Uploading CSV files to workspace ===')
[agent:result]     workspace_path = '/data/accounts_batches'
[agent:result]     
[agent:result]     # Create directory
[agent:result]     ws.workspace.mkdirs(workspace_path)
[agent:result]     
[agent:result]     # Upload batch files
[agent:result]     batch_files = ['data/batch_1.csv', 'data/batch_2.csv', 'data/batch_3.csv']
[agent:result]     for batch_file in batch_files:
[agent:result]         filename = os.path.basename(batch_file)
[agent:result]         workspace_file = f'{workspace_path}/{filename}'
[agent:result]         print(f'Uploading {batch_file} to {workspace_file}')
[agent:result]         with open(batch_file, 'rb') as f:
[agent:result]             content = f.read()
[agent:result]             ws.workspace.upload(workspace_file, content, format=ImportFormat.RAW, overwrite=True)
[agent:result]     
[agent:result]     # Step 2: Create Delta table with merged data (latest revision per row_id)
[agent:result]     print('\n=== Creating Delta table with latest revisions ===')
[agent:result]     
[agent:result]     # Use the CSV format to read from workspace files
[agent:result]     backtick = chr(96)  # Use chr(96) for backtick to avoid bash interpretation
[agent:result]     batch_paths = [
[agent:result]         f'/Workspace{workspace_path}/batch_1.csv',
[agent:result]         f'/Workspace{workspace_path}/batch_2.csv',
[agent:result]         f'/Workspace{workspace_path}/batch_3.csv'
[agent:result]     ]
[agent:result]     
[agent:result]     # Set the current catalog and schema
[agent:result]     ws.statement_execution.execute_statement(
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         statement='USE CATALOG workspace'
[agent:result]     )
[agent:result]     ws.statement_execution.execute_statement(
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         statement=f'USE SCHEMA {schema_name}'
[agent:result]     )
[agent:result]     
[agent:result]     # Create the table
[agent:result]     create_table_sql = f"""
[agent:result] CREATE OR REPLACE TABLE {table_name} (
[agent:result]     row_id STRING,
[agent:result]     status STRING,
[agent:result]     balance DOUBLE,
[agent:result]     updated_at BIGINT
[agent:result] ) USING DELTA
[agent:result] COMMENT 'Accounts feature table with latest revisions'
[agent:result] """
[agent:result]     print(f'Creating Delta table')
[agent:result]     result = ws.statement_execution.execute_statement(
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         statement=create_table_sql
[agent:result]     )
[agent:result]     print(f'Create table status: {result.status}')
[agent:result]     
[agent:result]     # Insert data with deduplication (keep latest per row_id)
[agent:result]     # CSV files have header row, so skip it with WHERE row_id != 'row_id'
[agent:result]     insert_sql = f"""
[agent:result] INSERT INTO {table_name}
[agent:result] WITH all_batches AS (
[agent:result]   SELECT * FROM csv.{backtick}{batch_paths[0]}{backtick} WHERE row_id != 'row_id'
[agent:result]   UNION ALL
[agent:result]   SELECT * FROM csv.{backtick}{batch_paths[1]}{backtick} WHERE row_id != 'row_id'
[agent:result]   UNION ALL
[agent:result]   SELECT * FROM csv.{backtick}{batch_paths[2]}{backtick} WHERE row_id != 'row_id'
[agent:result] )
[agent:result] SELECT 
[agent:result]   row_id,
[agent:result]   status,
[agent:result]   CAST(balance AS DOUBLE) as balance,
[agent:result]   CAST(updated_at AS BIGINT) as updated_at
[agent:result] FROM all_batches
[agent:result] QUALIFY ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY CAST(updated_at AS BIGINT) DESC) = 1
[agent:result] """
[agent:result]     print(f'Inserting latest revisions')
[agent:result]     result = ws.statement_execution.execute_statement(
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         statement=insert_sql
[agent:result]     )
[agent:result]     print(f'Insert status: {result.status}')
[agent:result]     
[agent:result]     # Verify the table
