[agent:result] notebook_content = f'''# Fraud Detection Pipeline
[agent:result] import base64
[agent:result] import io
[agent:result] 
[agent:result] # Decode and write data files
[agent:result] transactions_b64 = {transactions_data}
[agent:result] score_b64 = {score_data}
