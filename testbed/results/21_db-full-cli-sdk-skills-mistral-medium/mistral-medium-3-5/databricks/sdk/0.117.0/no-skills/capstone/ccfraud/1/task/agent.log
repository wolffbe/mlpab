[agent:result] 
[agent:result] with open("/tmp/score_transactions.csv", "wb") as f:
[agent:result]     f.write(base64.b64decode(score_b64))
[agent:result] 
[agent:result] print("Data files decoded")
[agent:result] 
[agent:result] # Load data
[agent:result] transactions_df = spark.read.csv("/tmp/transactions.csv", header=True, inferSchema=True)
[agent:result] score_df = spark.read.csv("/tmp/score_transactions.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] print(f"Loaded {{transactions_df.count()}} training transactions")
[agent:result] print(f"Loaded {{score_df.count()}} score transactions")
[agent:result] 
[agent:result] # Feature Engineering
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.functions import udf
[agent:result] from pyspark.sql.types import FloatType
[agent:result] import math
[agent:result] 
[agent:result] # Convert datetime
[agent:result] transactions_df = transactions_df.withColumn("datetime", F.to_timestamp("datetime"))
[agent:result] score_df = score_df.withColumn("datetime", F.to_timestamp("datetime"))
[agent:result] 
[agent:result] # Time features
[agent:result] for df in [transactions_df, score_df]:
[agent:result]     df = df.withColumn("hour_of_day", F.hour("datetime"))
[agent:result]     df = df.withColumn("day_of_week", F.dayofweek("datetime") - 1)
[agent:result]     df = df.withColumn("amount_log", F.log(F.col("amount") + 1))
[agent:result] 
[agent:result] # Haversine UDF
[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     R = 6371.0
[agent:result]     dLat = math.radians(lat2 - lat1)
[agent:result]     dLon = math.radians(lon2 - lon1)
[agent:result]     a = math.sin(dLat/2)**2 + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dLon/2)**2
[agent:result]     c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))
[agent:result]     return R * c
[agent:result] 
[agent:result] haversine_udf = udf(haversine, FloatType())
[agent:result] 
[agent:result] # Card-level stats from training data
[agent:result] print("Computing card-level statistics...")
[agent:result] card_stats = transactions_df.groupBy("cc_num").agg(
[agent:result]     F.avg("amount").alias("card_avg_amount"),
[agent:result]     F.stddev("amount").alias("card_std_amount"),
[agent:result]     F.count("*").alias("card_txn_count"),
[agent:result]     F.avg("lat").alias("card_avg_lat"),
[agent:result]     F.avg("long").alias("card_avg_long")
[agent:result] )
[agent:result] 
[agent:result] merchant_freq = transactions_df.groupBy("cc_num", "merchant").agg(F.count("*").alias("mc"))
[agent:result] merchant_freq = merchant_freq.groupBy("cc_num").agg(
[agent:result]     F.max("mc").alias("max_merchant_freq"),
[agent:result]     F.countDistinct("merchant").alias("unique_merchants")
[agent:result] )
[agent:result] 
[agent:result] category_freq = transactions_df.groupBy("cc_num", "category").agg(F.count("*").alias("cc"))
[agent:result] category_freq = category_freq.groupBy("cc_num").agg(F.max("cc").alias("max_category_freq"))
[agent:result] 
[agent:result] # Join to both datasets
[agent:result] for df in [transactions_df, score_df]:
[agent:result]     df = df.join(card_stats, "cc_num", "left")
[agent:result]     df = df.join(merchant_freq, "cc_num", "left")
[agent:result]     df = df.join(category_freq, "cc_num", "left")
[agent:result]     df = df.withColumn("amount_dev", F.when(F.col("card_avg_amount") > 0, F.col("amount") / F.col("card_avg_amount")).otherwise(0))
[agent:result]     df = df.withColumn("geo_dist", haversine_udf(F.col("lat"), F.col("long"), F.col("card_avg_lat"), F.col("card_avg_long")))
[agent:result] 
[agent:result] # Fill nulls
[agent:result] fill_cols = ["card_avg_amount", "card_std_amount", "card_txn_count", "max_merchant_freq", 
[agent:result]             "unique_merchants", "max_category_freq", "card_avg_lat", "card_avg_long", 
[agent:result]             "geo_dist", "amount_dev"]
[agent:result] for df in [transactions_df, score_df]:
