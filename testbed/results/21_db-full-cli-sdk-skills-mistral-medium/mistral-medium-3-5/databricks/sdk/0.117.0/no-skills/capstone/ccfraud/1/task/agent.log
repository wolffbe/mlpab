[agent:result] # Train Model
[agent:result] from pyspark.ml.feature import VectorAssembler, StringIndexer, OneHotEncoder
[agent:result] from pyspark.ml import Pipeline
[agent:result] from pyspark.ml.classification import RandomForestClassifier
[agent:result] from pyspark.ml.evaluation import BinaryClassificationEvaluator
[agent:result] import mlflow
[agent:result] from mlflow.models.signature import infer_signature
[agent:result] 
[agent:result] # Prepare features
[agent:result] cat_cols = ["merchant", "category"]
[agent:result] indexers = [StringIndexer(inputCol=c, outputCol=f"{c}_idx", handleInvalid="keep").fit(td_df) for c in cat_cols]
[agent:result] encoder = OneHotEncoder(inputCols=[f"{c}_idx" for c in cat_cols], outputCols=[f"{c}_enc" for c in cat_cols])
[agent:result] 
[agent:result] num_cols = ["amount", "hour_of_day", "day_of_week", "amount_log", "txn_24h", "card_avg_amount", 
[agent:result]            "card_std_amount", "card_txn_count", "amount_dev", "max_merchant_freq", 
[agent:result]            "unique_merchants", "max_category_freq", "geo_dist", "lat", "long"]
[agent:result] 
[agent:result] assembler = VectorAssembler(inputCols=num_cols + [f"{c}_enc" for c in cat_cols], outputCol="features")
[agent:result] rf = RandomForestClassifier(labelCol="is_fraud", featuresCol="features", numTrees=200, maxDepth=6, seed=42)
[agent:result] pipeline = Pipeline(stages=[*indexers, encoder, assembler, rf])
[agent:result] 
[agent:result] train_data, test_data = td_df.randomSplit([0.8, 0.2], seed=42)
[agent:result] model = pipeline.fit(train_data)
[agent:result] 
[agent:result] predictions = model.transform(test_data)
[agent:result] evaluator = BinaryClassificationEvaluator(labelCol="is_fraud", rawPredictionCol="rawPrediction", metricName="areaUnderROC")
[agent:result] auc = evaluator.evaluate(predictions)
[agent:result] print(f"Test AUC: {auc}")
[agent:result] 
