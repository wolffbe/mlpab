[agent:result] # Create a notebook for feature engineering and model training
[agent:result] notebook_content = """# Credit Card Fraud Detection Pipeline
[agent:result] 
[agent:result] # Step 1: Load and prepare data
[agent:result] transactions_df = spark.read.csv("dbfs:/FileStore/transactions.csv", header=True, inferSchema=True)
[agent:result] score_df = spark.read.csv("dbfs:/FileStore/score_transactions.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] print(f"Transactions: {transactions_df.count()}")
[agent:result] print(f"Score transactions: {score_df.count()}")
[agent:result] 
[agent:result] # Step 2: Feature Engineering
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] import pyspark.sql.types as T
[agent:result] 
[agent:result] # Convert datetime to timestamp
[agent:result] transactions_df = transactions_df.withColumn("datetime", F.to_timestamp("datetime"))
[agent:result] score_df = score_df.withColumn("datetime", F.to_timestamp("datetime"))
[agent:result] 
[agent:result] # Feature 1: Hour of day
[agent:result] transactions_df = transactions_df.withColumn("hour_of_day", F.hour("datetime"))
[agent:result] score_df = score_df.withColumn("hour_of_day", F.hour("datetime"))
[agent:result] 
[agent:result] # Feature 2: Day of week (0=Monday, 6=Sunday)
[agent:result] transactions_df = transactions_df.withColumn("day_of_week", F.dayofweek("datetime") - 1)
[agent:result] score_df = score_df.withColumn("day_of_week", F.dayofweek("datetime") - 1)
[agent:result] 
[agent:result] # Feature 3: Amount features
[agent:result] transactions_df = transactions_df.withColumn("amount_log", F.log(F.col("amount") + 1))
[agent:result] score_df = score_df.withColumn("amount_log", F.log(F.col("amount") + 1))
[agent:result] 
[agent:result] # Feature 4: Transaction velocity per card (count in last 24 hours)
[agent:result] window_spec_24h = Window.partitionBy("cc_num").orderBy("datetime").rowsBetween(-24, 0)
