[agent:result]     
[agent:result]     # Step 4: Create the feature table with all required computations
[agent:result]     print("Creating feature table...")
[agent:result]     
[agent:result]     wc.statement_execution.execute_statement(
[agent:result]         statement=f"""
[agent:result]         CREATE OR REPLACE TABLE {catalog_name}.{schema_part}.features7ab995_v1 (
[agent:result]             row_id STRING,
[agent:result]             account_id STRING,
[agent:result]             event_time BIGINT,
[agent:result]             amount_usd DOUBLE,
[agent:result]             is_weekend INT,
[agent:result]             amount_7d DOUBLE
[agent:result]         ) 
[agent:result]         USING DELTA
[agent:result]         """,
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         catalog=catalog_name,
[agent:result]         schema=schema_part
[agent:result]     )
[agent:result]     print("Created empty feature table")
[agent:result]     
[agent:result]     # Step 5: Populate the feature table with the computed values
[agent:result]     print("Populating feature table...")
[agent:result]     
[agent:result]     wc.statement_execution.execute_statement(
[agent:result]         statement=f"""
[agent:result]         INSERT INTO {catalog_name}.{schema_part}.features7ab995_v1
[agent:result]         SELECT 
[agent:result]             t.row_id,
[agent:result]             t.account_id,
[agent:result]             t.event_time,
[agent:result]             -- amount_usd = amount * fx_rate of the row's currency
[agent:result]             t.amount * fr.fx_rate AS amount_usd,
[agent:result]             -- is_weekend = 1 if event_time falls on Saturday or Sunday (UTC), else 0
[agent:result]             CASE 
[agent:result]                 WHEN date_format(from_utc_timestamp(from_unixtime(t.event_time / 1000)), 'u') IN ('6', '7') THEN 1
[agent:result]                 ELSE 0
[agent:result]             END AS is_weekend,
[agent:result]             -- amount_7d = sum of THIS account's amount over the 7 days up to and including the row's event_time
[agent:result]             COALESCE((
[agent:result]                 SELECT SUM(t2.amount)
[agent:result]                 FROM {catalog_name}.{schema_part}.transactions_temp t2
[agent:result]                 WHERE t2.account_id = t.account_id 
[agent:result]                     AND t2.event_time >= t.event_time - (7 * 24 * 60 * 60 * 1000)  -- 7 days in milliseconds
[agent:result]                     AND t2.event_time <= t.event_time
[agent:result]             ), 0) AS amount_7d
[agent:result]         FROM {catalog_name}.{schema_part}.transactions_temp t
[agent:result]         JOIN {catalog_name}.{schema_part}.fx_rates_temp fr ON t.currency = fr.currency
[agent:result]         """,
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         catalog=catalog_name,
[agent:result]         schema=schema_part
[agent:result]     )
