[agent:result] def main():
[agent:result]     print("Starting workflow...")
[agent:result]     
[agent:result]     # Step 1: Read CSV data
[agent:result]     print("\n1. Reading CSV data...")
[agent:result]     csv_path = "data/features.csv"
[agent:result]     
[agent:result]     # Read the CSV file
[agent:result]     rows = []
[agent:result]     with open(csv_path, 'r') as f:
[agent:result]         # Skip header
[agent:result]         header = f.readline().strip()
[agent:result]         columns = [col.strip() for col in header.split(',')]
[agent:result]         print(f"   Columns: {columns}")
[agent:result]         
[agent:result]         for line in f:
[agent:result]             values = [v.strip() for v in line.strip().split(',')]
[agent:result]             rows.append(values)
[agent:result]     
[agent:result]     print(f"   Read {len(rows)} rows")
[agent:result]     
[agent:result]     # Step 2: Delete existing table if it exists
[agent:result]     print("\n2. Deleting existing table...")
[agent:result]     try:
[agent:result]         w.tables.delete(FULL_TABLE_NAME)
[agent:result]         print(f"   Deleted table {FULL_TABLE_NAME}")
[agent:result]     except Exception as e:
[agent:result]         print(f"   Table may not exist: {e}")
[agent:result]     
[agent:result]     # Step 3: Create Delta table
[agent:result]     print("\n3. Creating Delta table...")
[agent:result]     
[agent:result]     # First create an empty table
[agent:result]     create_table_sql = f"""
[agent:result]     CREATE OR REPLACE TABLE {FULL_TABLE_NAME} 
[agent:result]     (account_id STRING, f1 DOUBLE, f2 DOUBLE, f3 DOUBLE, f4 DOUBLE)
[agent:result]     USING DELTA
[agent:result]     """
[agent:result]     
[agent:result]     result = execute_sql(create_table_sql)
[agent:result]     print(f"   Table {FULL_TABLE_NAME} created")
[agent:result]     
[agent:result]     # Then insert data in batches
[agent:result]     batch_size = 20
[agent:result]     for i in range(0, len(rows), batch_size):
[agent:result]         batch = rows[i:i+batch_size]
[agent:result]         
[agent:result]         # Build VALUES clause
[agent:result]         values_clauses = []
[agent:result]         for row in batch:
[agent:result]             # Escape single quotes by doubling them
[agent:result]             escaped_values = [v.replace("'", "''") for v in row]
[agent:result]             values_clauses.append(f"('{escaped_values[0]}', {escaped_values[1]}, {escaped_values[2]}, {escaped_values[3]}, {escaped_values[4]})")
[agent:result]         
[agent:result]         values_str = ", ".join(values_clauses)
[agent:result]         
[agent:result]         insert_sql = f"""
[agent:result]         INSERT INTO {FULL_TABLE_NAME} 
[agent:result]         VALUES {values_str}
[agent:result]         """
[agent:result]         
[agent:result]         result = execute_sql(insert_sql)
[agent:result]         print(f"   Batch {i//batch_size + 1} inserted ({len(batch)} rows)")
[agent:result]     
[agent:result]     print(f"   Table {FULL_TABLE_NAME} populated with {len(rows)} rows")
[agent:result]     
[agent:result]     # Step 4: Read lookup keys
[agent:result]     print("\n4. Reading lookup keys...")
[agent:result]     with open("data/lookup_keys.txt", 'r') as f:
[agent:result]         lookup_keys = [line.strip() for line in f.readlines()]
[agent:result]     
[agent:result]     print(f"   Found {len(lookup_keys)} keys: {lookup_keys}")
[agent:result]     
[agent:result]     # Step 5: Query the table for the lookup keys
[agent:result]     print("\n5. Querying table...")
[agent:result]     vectors = {}
[agent:result]     
[agent:result]     # Build query for all keys
[agent:result]     keys_str = ", ".join([f"'{key}'" for key in lookup_keys])
[agent:result]     query = f"""
[agent:result]     SELECT account_id, f1, f2, f3, f4 
[agent:result]     FROM {FULL_TABLE_NAME}
[agent:result]     WHERE account_id IN ({keys_str})
[agent:result]     ORDER BY account_id
[agent:result]     """
[agent:result]     
[agent:result]     result = execute_sql(query, wait_timeout="50s")
[agent:result]     
