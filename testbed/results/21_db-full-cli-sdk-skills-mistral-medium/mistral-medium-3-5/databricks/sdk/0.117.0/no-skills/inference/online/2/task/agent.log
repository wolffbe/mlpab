[agent:result] # Read CSV data
[agent:result] import csv
[agent:result] with open('data/features.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     rows = list(reader)
[agent:result] 
[agent:result] # Build a single CREATE TABLE AS SELECT statement with UNION ALL
[agent:result] # Split into multiple statements to avoid hitting SQL length limits
[agent:result] batch_size = 30
[agent:result] for batch_num in range(0, len(rows), batch_size):
[agent:result]     batch = rows[batch_num:batch_num+batch_size]
[agent:result]     
[agent:result]     # Create a temp table for this batch
[agent:result]     temp_table_name = f"{catalog}.{schema}.{SOURCE_TABLE_NAME}_batch_{batch_num//batch_size}"
[agent:result]     
[agent:result]     select_clauses = []
[agent:result]     for row in batch:
[agent:result]         select_clauses.append(f"SELECT '{row['account_id']}' AS account_id, {row['f1']} AS f1, {row['f2']} AS f2, {row['f3']} AS f3, {row['f4']} AS f4")
[agent:result]     
[agent:result]     create_batch_sql = f"CREATE TABLE {temp_table_name} AS {" UNION ALL ".join(select_clauses)}"
[agent:result]     
[agent:result]     print(f"  Creating batch table {batch_num//batch_size + 1}")
[agent:result]     result = w.statement_execution.execute_statement(
[agent:result]         statement=create_batch_sql,
[agent:result]         warehouse_id='8a93fc195da2ceb1',
[agent:result]         wait_timeout='0s'
[agent:result]     )
[agent:result]     wait_for_statement(result.statement_id)
[agent:result] 
[agent:result] # Now combine all batch tables into the final source table
[agent:result] # First, get all batch table names
[agent:result] batch_table_names = [f"{catalog}.{schema}.{SOURCE_TABLE_NAME}_batch_{i}" for i in range(0, len(rows), batch_size)]
[agent:result] 
[agent:result] # Create the final table by selecting from all batch tables
[agent:result] final_create_sql = f"""
[agent:result] CREATE TABLE IF NOT EXISTS {source_table_full_name} AS
[agent:result] SELECT * FROM {batch_table_names[0]}
[agent:result] """
[agent:result] 
[agent:result] for table in batch_table_names[1:]:
[agent:result]     final_create_sql += f" UNION ALL SELECT * FROM {table}\n"
