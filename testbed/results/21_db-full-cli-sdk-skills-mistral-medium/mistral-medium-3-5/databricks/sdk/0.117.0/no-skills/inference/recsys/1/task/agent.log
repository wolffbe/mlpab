[agent:result] # MAGIC ## Compute Recommendations
[agent:result] # MAGIC 
[agent:result] # MAGIC This notebook computes top-5 recommendations for each user based on dot product similarity
[agent:result] # MAGIC between user and item embeddings, excluding already interacted items.
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read the CSV files from DBFS
[agent:result] import pandas as pd
[agent:result] from pyspark.sql import SparkSession
[agent:result] from pyspark.sql.functions import col, lit, array, struct, explode
[agent:result] from pyspark.sql.types import StructType, StructField, StringType, FloatType, IntegerType
[agent:result] import numpy as np
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Define schema for embeddings
[agent:result] embedding_schema = StructType([
[agent:result]     StructField("id", StringType(), True),
[agent:result]     StructField("e1", FloatType(), True),
[agent:result]     StructField("e2", FloatType(), True),
[agent:result]     StructField("e3", FloatType(), True),
[agent:result]     StructField("e4", FloatType(), True),
[agent:result]     StructField("e5", FloatType(), True),
[agent:result]     StructField("e6", FloatType(), True),
[agent:result]     StructField("e7", FloatType(), True),
[agent:result]     StructField("e8", FloatType(), True)
[agent:result] ])
[agent:result] 
[agent:result] # Read interactions
[agent:result] interactions_df = spark.read.csv("/dbfs/FileStore/tables/interactions.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Read user embeddings
[agent:result] user_emb_df = spark.read.csv("/dbfs/FileStore/tables/user_embeddings.csv", header=True, schema=embedding_schema)
[agent:result] user_emb_df = user_emb_df.withColumnRenamed("id", "user_id")
[agent:result] 
[agent:result] # Read item embeddings  
[agent:result] item_emb_df = spark.read.csv("/dbfs/FileStore/tables/item_embeddings.csv", header=True, schema=embedding_schema)
[agent:result] item_emb_df = item_emb_df.withColumnRenamed("id", "item_id")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Collect user embeddings to driver for broadcasting
[agent:result] user_emb_local = user_emb_df.collect()
[agent:result] user_emb_dict = {row.user_id: [row.e1, row.e2, row.e3, row.e4, row.e5, row.e6, row.e7, row.e8] for row in user_emb_local}
[agent:result] 
[agent:result] # Collect interactions per user
[agent:result] interactions_local = interactions_df.collect()
[agent:result] interacted_items = {}
[agent:result] for row in interactions_local:
[agent:result]     user_id = row.user_id
[agent:result]     item_id = row.item_id
[agent:result]     if user_id not in interacted_items:
[agent:result]         interacted_items[user_id] = set()
[agent:result]     interacted_items[user_id].add(item_id)
[agent:result] 
[agent:result] # Collect all item embeddings
[agent:result] item_emb_local = item_emb_df.collect()
[agent:result] item_emb_dict = {row.item_id: [row.e1, row.e2, row.e3, row.e4, row.e5, row.e6, row.e7, row.e8] for row in item_emb_local}
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute recommendations for each user
[agent:result] import itertools
[agent:result] 
[agent:result] results = []
[agent:result] for user_id, user_emb in user_emb_dict.items():
[agent:result]     user_interacted = interacted_items.get(user_id, set())
[agent:result]     
[agent:result]     # Compute dot product for each item
[agent:result]     item_scores = []
[agent:result]     for item_id, item_emb in item_emb_dict.items():
[agent:result]         if item_id in user_interacted:
[agent:result]             continue
[agent:result]         dot_product = sum(u * i for u, i in zip(user_emb, item_emb))
[agent:result]         item_scores.append((item_id, dot_product))
[agent:result]     
[agent:result]     # Sort by dot product descending, then by item_id ascending for ties
[agent:result]     item_scores.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     top5 = item_scores[:5]
[agent:result]     
[agent:result]     for rank, (item_id, score) in enumerate(top5, 1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         results.append((rec_id, user_id, rank, item_id))
