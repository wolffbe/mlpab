[agent:result] # Read CSV files
[agent:result] interactions_df = spark.read.csv(f"{dbfs_data_path}/interactions.csv", header=True, inferSchema=True)
[agent:result] user_embeddings_df = spark.read.csv(f"{dbfs_data_path}/user_embeddings.csv", header=True, inferSchema=True)
[agent:result] item_embeddings_df = spark.read.csv(f"{dbfs_data_path}/item_embeddings.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Cache the dataframes for performance
[agent:result] interactions_df.cache()
[agent:result] user_embeddings_df.cache()
[agent:result] item_embeddings_df.cache()
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Collect embeddings to driver for computation (data is small: 40 users, 60 items)
[agent:result] user_embeddings = user_embeddings_df.collect()
[agent:result] item_embeddings = item_embeddings_df.collect()
[agent:result] interactions = interactions_df.collect()
[agent:result] 
[agent:result] # Create dictionaries for quick lookup
[agent:result] user_emb_dict = {row['user_id']: [row[f'e{i+1}'] for i in range(8)] for row in user_embeddings}
[agent:result] item_emb_dict = {row['item_id']: [row[f'e{i+1}'] for i in range(8)] for row in item_embeddings}
[agent:result] 
[agent:result] # Create interaction set for each user
[agent:result] interaction_dict = {}
[agent:result] for row in interactions:
[agent:result]     user_id = row['user_id']
[agent:result]     item_id = row['item_id']
[agent:result]     if user_id not in interaction_dict:
[agent:result]         interaction_dict[user_id] = set()
[agent:result]     interaction_dict[user_id].add(item_id)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute dot products and find top-5 recommendations for each user
[agent:result] import numpy as np
[agent:result] 
[agent:result] recommendations = []
[agent:result] 
[agent:result] for user_id, user_emb in user_emb_dict.items():
[agent:result]     user_emb_array = np.array(user_emb, dtype=np.float64)
[agent:result]     
[agent:result]     # Get items user has already interacted with
[agent:result]     interacted_items = interaction_dict.get(user_id, set())
[agent:result]     
[agent:result]     # Compute dot product with all items
[agent:result]     item_scores = []
[agent:result]     for item_id, item_emb in item_emb_dict.items():
[agent:result]         if item_id in interacted_items:
[agent:result]             continue
[agent:result]         item_emb_array = np.array(item_emb, dtype=np.float64)
[agent:result]         dot_product = np.dot(user_emb_array, item_emb_array)
[agent:result]         item_scores.append((item_id, dot_product))
[agent:result]     
[agent:result]     # Sort by dot product descending, then by item_id ascending for ties
[agent:result]     item_scores.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     top_5 = item_scores[:5]
[agent:result]     
[agent:result]     for rank, (item_id, score) in enumerate(top_5, 1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             'rec_id': rec_id,
[agent:result]             'user_id': user_id,
[agent:result]             'rank': rank,
[agent:result]             'item_id': item_id
[agent:result]         })
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create Spark DataFrame from recommendations
[agent:result] schema = StructType([
[agent:result]     StructField('rec_id', StringType(), False),
[agent:result]     StructField('user_id', StringType(), False),
[agent:result]     StructField('rank', IntegerType(), False),
[agent:result]     StructField('item_id', StringType(), False)
[agent:result] ])
[agent:result] 
[agent:result] recs_df = spark.createDataFrame(recommendations, schema=schema)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Write to Unity Catalog table
[agent:result] catalog_name = "workspace"
[agent:result] schema_name = "mlpabad73a8"
[agent:result] table_name = "recs02400f"
[agent:result] 
[agent:result] # Create the table
[agent:result] recs_df.write.mode("overwrite").saveAsTable(f"{catalog_name}.{schema_name}.{table_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] print(f"Table {catalog_name}.{schema_name}.{table_name} created successfully!")
[agent:result] print(f"Total recommendations: {recs_df.count()}")
