[agent:result]     .withColumn('month', F.month('date')) \
[agent:result]     .withColumn('year', F.year('date'))
[agent:result] 
[agent:result] forecast_df = forecast_df.withColumn('day_of_week', F.dayofweek('date')) \
[agent:result]     .withColumn('day_of_month', F.dayofmonth('date')) \
[agent:result]     .withColumn('month', F.month('date')) \
[agent:result]     .withColumn('year', F.year('date'))
[agent:result] 
