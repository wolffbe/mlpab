[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Create Schema
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] spark.sql(f"CREATE SCHEMA IF NOT EXISTS {catalog_name}.{schema_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Feature Engineering
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Convert to date
[agent:result] history_df = history_df.withColumn('date', F.to_date('date'))
[agent:result] forecast_df = forecast_df.withColumn('date', F.to_date('date'))
[agent:result] 
[agent:result] # Add temporal features
[agent:result] history_df = history_df.withColumn('day_of_week', F.dayofweek('date')) \
[agent:result]     .withColumn('day_of_month', F.dayofmonth('date')) \
[agent:result]     .withColumn('month', F.month('date')) \
[agent:result]     .withColumn('year', F.year('date'))
[agent:result] 
[agent:result] forecast_df = forecast_df.withColumn('day_of_week', F.dayofweek('date')) \
[agent:result]     .withColumn('day_of_month', F.dayofmonth('date')) \
[agent:result]     .withColumn('month', F.month('date')) \
[agent:result]     .withColumn('year', F.year('date'))
[agent:result] 
[agent:result] # Add rolling features (7-day mean)
[agent:result] window_spec = Window.orderBy('date').rowsBetween(-6, 0)
[agent:result] 
[agent:result] history_df = history_df.withColumn('pm25_rolling_7d_mean', F.avg('pm25').over(window_spec)) \
[agent:result]     .withColumn('temp_rolling_7d_mean', F.avg('temperature').over(window_spec)) \
[agent:result]     .withColumn('humidity_rolling_7d_mean', F.avg('humidity').over(window_spec))
[agent:result] 
[agent:result] # Fill nulls
[agent:result] for col in ['pm25_rolling_7d_mean', 'temp_rolling_7d_mean', 'humidity_rolling_7d_mean']:
[agent:result]     history_df = history_df.withColumn(col, F.coalesce(F.col(col), F.lit(0.0)))
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Create Feature Table (airqb70a96)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] feature_columns = [
[agent:result]     'date', 'pm25_lag1', 'temperature', 'humidity', 'wind_speed', 
[agent:result]     'pressure', 'precipitation', 'day_of_week', 'day_of_month', 
[agent:result]     'month', 'year', 'pm25_rolling_7d_mean', 'temp_rolling_7d_mean', 
[agent:result]     'humidity_rolling_7d_mean'
[agent:result] ]
[agent:result] 
[agent:result] feature_table_name = f"{catalog_name}.{schema_name}.airqb70a96"
[agent:result] spark.sql(f"DROP TABLE IF EXISTS {feature_table_name}")
[agent:result] history_df.select(feature_columns).write.saveAsTable(feature_table_name, mode='overwrite')
[agent:result] print(f"Created feature table: {feature_table_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Create Training Dataset (airqtdb70a96)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] training_table_name = f"{catalog_name}.{schema_name}.airqtdb70a96"
[agent:result] spark.sql(f"DROP TABLE IF EXISTS {training_table_name}")
[agent:result] history_df.select(feature_columns + ['pm25']).write.saveAsTable(training_table_name, mode='overwrite')
[agent:result] print(f"Created training dataset: {training_table_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Publish Feature Group using SQL
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # In Unity Catalog, we can publish a table as a feature group using SQL
[agent:result] # But for now, let's just ensure the table exists with the right name
[agent:result] # The feature group is essentially the table itself
[agent:result] 
[agent:result] # Add comment to mark it as a feature group
[agent:result] spark.sql(f"COMMENT ON TABLE {feature_table_name} IS 'Feature group airqb70a96'")
[agent:result] print(f"Feature group published: {feature_table_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Train Model
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] import mlflow
[agent:result] import mlflow.sklearn
[agent:result] from sklearn.ensemble import RandomForestRegressor
[agent:result] from sklearn.metrics import mean_squared_error
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Load training data
[agent:result] training_df = spark.table(training_table_name)
[agent:result] pdf = training_df.toPandas()
[agent:result] 
[agent:result] X = pdf[feature_columns]
[agent:result] y = pdf['pm25']
[agent:result] 
[agent:result] # Train
[agent:result] rf = RandomForestRegressor(n_estimators=100, max_depth=10, min_samples_split=5, random_state=42, n_jobs=-1)
[agent:result] rf.fit(X, y)
[agent:result] 
[agent:result] # Evaluate
[agent:result] y_pred = rf.predict(X)
[agent:result] rmse = np.sqrt(mean_squared_error(y, y_pred))
[agent:result] print(f"Training RMSE: {rmse:.4f}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Register Model (airqmodelb70a96)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] model_name = f"{catalog_name}.{schema_name}.airqmodelb70a96"
[agent:result] mlflow.set_experiment(f"/Users/benedict@hopsworks.ai/{MLPAB_DATABRICKS_PREFIX}/airqmodelb70a96")
[agent:result] 
[agent:result] with mlflow.start_run():
[agent:result]     mlflow.sklearn.log_model(rf, "model", registered_model_name=model_name)
[agent:result]     mlflow.log_metric("train_rmse", rmse)
[agent:result]     mlflow.log_param("n_estimators", 100)
[agent:result]     mlflow.log_param("max_depth", 10)
[agent:result]     print(f"Model registered: {model_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Predict on Forecast Days
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Get last rolling means from history
[agent:result] last_rolling = history_df.orderBy('date', ascending=False).limit(1).select(
[agent:result]     'pm25_rolling_7d_mean', 'temp_rolling_7d_mean', 'humidity_rolling_7d_mean'
[agent:result] ).collect()[0]
[agent:result] 
[agent:result] # Add rolling features to forecast
[agent:result] forecast_with_features = forecast_df \
[agent:result]     .withColumn('pm25_rolling_7d_mean', F.lit(float(last_rolling['pm25_rolling_7d_mean']))) \
[agent:result]     .withColumn('temp_rolling_7d_mean', F.lit(float(last_rolling['temp_rolling_7d_mean']))) \
[agent:result]     .withColumn('humidity_rolling_7d_mean', F.lit(float(last_rolling['humidity_rolling_7d_mean'])))
[agent:result] 
[agent:result] forecast_features = forecast_with_features.select(feature_columns)
[agent:result] forecast_pdf = forecast_features.toPandas()
[agent:result] 
[agent:result] # Predict
[agent:result] predictions = rf.predict(forecast_pdf)
[agent:result] forecast_df_pdf = forecast_df.toPandas()
[agent:result] forecast_df_pdf['pm25_pred'] = predictions
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Save Predictions (airqpredb70a96)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] predictions_table_name = f"{catalog_name}.{schema_name}.airqpredb70a96"
[agent:result] spark.sql(f"DROP TABLE IF EXISTS {predictions_table_name}")
[agent:result] spark.createDataFrame(forecast_df_pdf).select('date', 'pm25_pred').write.saveAsTable(predictions_table_name, mode='overwrite')
[agent:result] print(f"Created predictions table: {predictions_table_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
