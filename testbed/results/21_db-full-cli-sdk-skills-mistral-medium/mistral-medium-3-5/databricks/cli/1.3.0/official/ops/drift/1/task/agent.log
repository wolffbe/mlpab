[agent:result]   {
[agent:result]    "cell_type": "code",
[agent:result]    "execution_count": null,
[agent:result]    "metadata": {},
[agent:result]    "outputs": [],
[agent:result]    "source": [
[agent:result]     "# Convert event_time to datetime\n",
[agent:result]     "df['event_time'] = pd.to_datetime(df['event_time'])\n",
[agent:result]     "df['date'] = df['event_time'].dt.date\n",
[agent:result]     "\n",
[agent:result]     "# Extract features\n",
[agent:result]     "features = ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']\n",
[agent:result]     "\n",
[agent:result]     "# Check date range\n",
[agent:result]     "print(f'Date range: {df["date"].min()} to {df["date"].max()}')\n",
[agent:result]     "print(f'Unique dates: {df["date"].nunique()}')"
[agent:result]    ]
[agent:result]   },
[agent:result]   {
[agent:result]    "cell_type": "code",
[agent:result]    "execution_count": null,
[agent:result]    "metadata": {},
[agent:result]    "outputs": [],
[agent:result]    "source": [
[agent:result]     "# Analyze each feature for drift\n",
[agent:result]     "results = []\n",
[agent:result]     "dates = sorted(df['date'].unique())\n",
[agent:result]     "\n",
[agent:result]     "for feature in features:\n",
[agent:result]     "    # Split into before and after each possible date\n",
[agent:result]     "    best_p_value = 1.0\n",
[agent:result]     "    best_date = None\n",
[agent:result]     "    best_stat = 0\n",
[agent:result]     "    \n",
[agent:result]     "    for i in range(10, len(dates) - 10):  # Need enough samples on both sides\n",
[agent:result]     "        split_date = dates[i]\n",
[agent:result]     "        before = df[df['date'] < split_date][feature]\n",
[agent:result]     "        after = df[df['date'] >= split_date][feature]\n",
[agent:result]     "        \n",
[agent:result]     "        if len(before) > 20 and len(after) > 20:\n",
[agent:result]     "            ks_stat, p_val = stats.ks_2samp(before, after)\n",
[agent:result]     "            if p_val < best_p_value:\n",
[agent:result]     "                best_p_value = p_val\n",
[agent:result]     "                best_date = split_date\n",
[agent:result]     "                best_stat = ks_stat\n",
[agent:result]     "    \n",
[agent:result]     "    results.append({\n",
[agent:result]     "        'feature': feature,\n",
[agent:result]     "        'best_split_date': best_date,\n",
[agent:result]     "        'best_p_value': best_p_value,\n",
[agent:result]     "        'best_ks_stat': best_stat\n",
[agent:result]     "    })\n",
[agent:result]     "\n",
[agent:result]     "results_df = pd.DataFrame(results)\n",
[agent:result]     "results_df = results_df.sort_values('best_p_value')\n",
[agent:result]     "print(results_df)"
[agent:result]    ]
[agent:result]   },
[agent:result]   {
[agent:result]    "cell_type": "code",
[agent:result]    "execution_count": null,
[agent:result]    "metadata": {},
[agent:result]    "outputs": [],
[agent:result]    "source": [
[agent:result]     "# Visual inspection - look at statistics over time\n",
[agent:result]     "stats_over_time = df.groupby('date')[features].agg(['mean', 'std']).reset_index()\n",
[agent:result]     "print('Statistics over time (last 20 days):')\n",
[agent:result]     "print(stats_over_time.tail(20).round(4))"
[agent:result]    ]
[agent:result]   },
[agent:result]   {
[agent:result]    "cell_type": "code",
[agent:result]    "execution_count": null,
[agent:result]    "metadata": {},
[agent:result]    "outputs": [],
[agent:result]    "source": [
[agent:result]     "# Find the feature with the most significant drift\n",
[agent:result]     "most_significant = results_df.iloc[0]\n",
[agent:result]     "print(f'Most significant drift: {most_significant["feature"]}')\n",
[agent:result]     "print(f'Best split date: {most_significant["best_split_date"]}')\n",
[agent:result]     "print(f'P-value: {most_significant["best_p_value"]}')\n",
[agent:result]     "print(f'KS statistic: {most_significant["best_ks_stat"]}')\n",
[agent:result]     "\n",
[agent:result]     "# Check the distribution before and after\n",
[agent:result]     "split_date = most_significant['best_split_date']\n",
[agent:result]     "feature = most_significant['feature']\n",
[agent:result]     "before = df[df['date'] < split_date][feature]\n",
[agent:result]     "after = df[df['date'] >= split_date][feature]\n",
[agent:result]     "print(f'\\n{feature} before {split_date}: mean={before.mean():.4f}, std={before.std():.4f}, min={before.min():.4f}, max={before.max():.4f}')\n",
[agent:result]     "print(f'{feature} after {split_date}: mean={after.mean():.4f}, std={after.std():.4f}, min={after.min():.4f}, max={after.max():.4f}')"
[agent:result]    ]
[agent:result]   },
