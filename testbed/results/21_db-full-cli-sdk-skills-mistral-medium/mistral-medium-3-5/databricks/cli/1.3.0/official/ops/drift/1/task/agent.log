[agent:bash] 
[agent:bash] import pandas as pd
[agent:bash] import numpy as np
[agent:bash] from datetime import datetime
[agent:bash] import json
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Read the CSV file
[agent:bash] dbfs_path = "/Workspace/Users/benedict@logicalclocks.com/mlpabe1a140/features.csv"
[agent:bash] df = pd.read_csv(dbfs_path)
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Convert event_time to datetime
[agent:bash] df['event_time'] = pd.to_datetime(df['event_time'])
[agent:bash] df['date'] = df['event_time'].dt.date
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Extract features
[agent:bash] features = ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Function to detect drift using Kolmogorov-Smirnov test
[agent:bash] from scipy import stats
[agent:bash] 
[agent:bash] def detect_drift_ks(df, feature, window_size=30):
[agent:bash]     """Detect drift using KS test on rolling windows"""
[agent:bash]     dates = sorted(df['date'].unique())
[agent:bash]     
[agent:bash]     if len(dates) < 2:
[agent:bash]         return None, None
[agent:bash]     
[agent:bash]     # Split data into two halves
[agent:bash]     mid_point = len(dates) // 2
[agent:bash]     first_half = df[df['date'] <= dates[mid_point]][feature]
[agent:bash]     second_half = df[df['date'] > dates[mid_point]][feature]
[agent:bash]     
[agent:bash]     # Perform KS test
[agent:bash]     ks_stat, p_value = stats.ks_2samp(first_half, second_half)
[agent:bash]     
[agent:bash]     return ks_stat, p_value
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Function to detect drift using mean shift
[agent:bash] import changepy
[agent:bash] 
[agent:bash] def detect_drift_changepoint(df, feature, dates):
[agent:bash]     """Detect drift using changepy"""
[agent:bash]     try:
[agent:bash]         # Aggregate by date
[agent:bash]         daily_data = df.groupby('date')[feature].mean().reset_index()
[agent:bash]         
[agent:bash]         # Prepare data for changepy
[agent:bash]         data = daily_data[feature].values
[agent:bash]         
[agent:bash]         # Detect change points
[agent:bash]         algo = changepy.RuptureDetection(n_bkps=1)
[agent:bash]         algo.fit(data)
[agent:bash]         
[agent:bash]         if len(algo.predict()) > 0:
[agent:bash]             change_idx = algo.predict()[0]
[agent:bash]             change_date = daily_data.iloc[change_idx]['date']
[agent:bash]             return change_date, algo.cost
[agent:bash]         return None, None
[agent:bash]     except Exception as e:
[agent:bash]         return None, None
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Analyze each feature
[agent:bash] results = []
[agent:bash] for feature in features:
[agent:bash]     # KS test
[agent:bash]     ks_stat, p_value = detect_drift_ks(df, feature)
[agent:bash]     
[agent:bash]     # Mean/median shift detection
[agent:bash]     dates = sorted(df['date'].unique())
[agent:bash]     
[agent:bash]     # Split into before and after each possible date
[agent:bash]     best_p_value = 1.0
[agent:bash]     best_date = None
[agent:bash]     
[agent:bash]     for i in range(1, len(dates)):
[agent:bash]         split_date = dates[i]
[agent:bash]         before = df[df['date'] < split_date][feature]
[agent:bash]         after = df[df['date'] >= split_date][feature]
[agent:bash]         
[agent:bash]         if len(before) > 10 and len(after) > 10:
[agent:bash]             _, p_val = stats.ks_2samp(before, after)
[agent:bash]             if p_val < best_p_value:
[agent:bash]                 best_p_value = p_val
[agent:bash]                 best_date = split_date
[agent:bash]     
[agent:bash]     results.append({
[agent:bash]         'feature': feature,
[agent:bash]         'ks_statistic': ks_stat,
[agent:bash]         'p_value': p_value,
[agent:bash]         'best_split_date': best_date,
[agent:bash]         'best_p_value': best_p_value
[agent:bash]     })
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Display results
[agent:bash] results_df = pd.DataFrame(results)
[agent:bash] print(results_df.sort_values('best_p_value'))
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Visual inspection - look at statistics over time
[agent:bash] stats_over_time = df.groupby('date')[features].agg(['mean', 'std']).reset_index()
[agent:bash] print("\nStatistics over time:")
[agent:bash] print(stats_over_time.tail(20))
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Find the feature with the most significant drift
[agent:bash] most_significant = results_df.sort_values('best_p_value').iloc[0]
[agent:bash] print(f"\nMost significant drift: {most_significant['feature']}")
[agent:bash] print(f"Best split date: {most_significant['best_split_date']}")
[agent:bash] print(f"P-value: {most_significant['best_p_value']}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Save the answer
[agent:bash] answer = {
[agent:bash]     "feature": most_significant['feature'],
[agent:bash]     "onset": str(most_significant['best_split_date'])
[agent:bash] }
[agent:bash] 
[agent:bash] # Write to workspace
[agent:bash] with open('/dbfs/FileStore/answer.json', 'w') as f:
[agent:bash]     json.dump(answer, f)
