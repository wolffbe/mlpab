[agent:result] def haversine_udf(lat1, lon1, lat2, lon2):
[agent:result]     """Calculate haversine distance between two points in km"""
[agent:result]     try:
[agent:result]         R = 6371.0
[agent:result]         lat1_rad = math.radians(float(lat1)) if lat1 is not None else 0.0
[agent:result]         lon1_rad = math.radians(float(lon1)) if lon1 is not None else 0.0
[agent:result]         lat2_rad = math.radians(float(lat2)) if lat2 is not None else 0.0
[agent:result]         lon2_rad = math.radians(float(lon2)) if lon2 is not None else 0.0
[agent:result]         dlat = lat2_rad - lat1_rad
[agent:result]         dlon = lon2_rad - lon1_rad
[agent:result]         a = math.sin(dlat/2)**2 + math.cos(lat1_rad) * math.cos(lat2_rad) * math.sin(dlon/2)**2
[agent:result]         c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a)) if a < 1 else 0.0
[agent:result]         return R * c
[agent:result]     except:
[agent:result]         return 0.0
[agent:result] 
[agent:result] haversine = F.udf(haversine_udf, DoubleType())
