[agent:result] content: # Databricks notebook source
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] from pyspark.sql.types import DoubleType
[agent:result] import math
[agent:result] 
[agent:result] print("Testing UDF...")
[agent:result] 
[agent:result] volume_path = "/Volumes/workspace/mlpabfcf9c1/ccfraud_data/"
[agent:result] transactions_path = f"{volume_path}transactions.csv"
[agent:result] 
[agent:result] df = spark.read.csv(transactions_path, header=True, inferSchema=True)
[agent:result] df = df.withColumn("datetime", F.to_timestamp("datetime", "yyyy-MM-dd'T'HH:mm:ss'Z'"))
[agent:result] 
[agent:result] print(f"Initial count: {df.count()}")
[agent:result] 
[agent:result] # Define UDF
[agent:result] def haversine_udf(lat1, lon1, lat2, lon2):
[agent:result]     """Calculate haversine distance between two points in km"""
[agent:result]     try:
[agent:result]         R = 6371.0
[agent:result]         lat1_rad = math.radians(float(lat1)) if lat1 is not None else 0.0
[agent:result]         lon1_rad = math.radians(float(lon1)) if lon1 is not None else 0.0
[agent:result]         lat2_rad = math.radians(float(lat2)) if lat2 is not None else 0.0
[agent:result]         lon2_rad = math.radians(float(lon2)) if lon2 is not None else 0.0
[agent:result]         dlat = lat2_rad - lat1_rad
[agent:result]         dlon = lon2_rad - lon1_rad
[agent:result]         a = math.sin(dlat/2)**2 + math.cos(lat1_rad) * math.cos(lat2_rad) * math.sin(dlon/2)**2
[agent:result]         c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a)) if a < 1 else 0.0
[agent:result]         return R * c
[agent:result]     except:
[agent:result]         return 0.0
[agent:result] 
[agent:result] haversine = F.udf(haversine_udf, DoubleType())
[agent:result] 
[agent:result] # Add card location features
[agent:result] window_spec = Window.partitionBy("cc_num")
[agent:result] df = df.withColumn("card_lat_mean", F.mean("lat").over(window_spec))
[agent:result] df = df.withColumn("card_long_mean", F.mean("long").over(window_spec))
