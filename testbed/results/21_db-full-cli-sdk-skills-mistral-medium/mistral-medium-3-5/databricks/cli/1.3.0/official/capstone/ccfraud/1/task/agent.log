[agent:result] def haversine_distance(lat1, lon1, lat2, lon2):
[agent:result]     """Calculate haversine distance between two points in km"""
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     
[agent:result]     lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])
[agent:result]     dlat = lat2 - lat1
[agent:result]     dlon = lon2 - lon1
[agent:result]     
[agent:result]     a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
[agent:result]     c = 2 * np.arcsin(np.sqrt(a))
[agent:result]     
[agent:result]     return R * c
[agent:result] 
[agent:result] def engineer_features(df):
[agent:result]     """Engineer fraud detection features"""
[agent:result]     df = df.copy()
[agent:result]     
[agent:result]     # Convert to datetime if not already
[agent:result]     df['datetime'] = pd.to_datetime(df['datetime'])
[agent:result]     
[agent:result]     # Extract time features
[agent:result]     df['hour_of_day'] = df['datetime'].dt.hour
[agent:result]     df['day_of_week'] = df['datetime'].dt.dayofweek
[agent:result]     df['day_of_month'] = df['datetime'].dt.day
[agent:result]     df['month'] = df['datetime'].dt.month
[agent:result]     
[agent:result]     # Amount features
[agent:result]     df['amount_log'] = np.log1p(df['amount'])
[agent:result]     df['amount_std'] = df.groupby('cc_num')['amount'].transform('std')
[agent:result]     df['amount_mean'] = df.groupby('cc_num')['amount'].transform('mean')
[agent:result]     df['amount_zscore'] = (df['amount'] - df['amount_mean']) / (df['amount_std'] + 1e-6)
[agent:result]     
[agent:result]     # Time since last transaction per card (in hours)
[agent:result]     df = df.sort_values(['cc_num', 'datetime'])
[agent:result]     df['time_since_last_txn'] = df.groupby('cc_num')['datetime'].diff().dt.total_seconds() / 3600
[agent:result]     df['time_since_last_txn'].fillna(999, inplace=True)  # First transaction for a card
[agent:result]     
[agent:result]     # Transaction velocity (count per card in last 24 hours)
[agent:result]     df['txn_count_24h'] = df.groupby('cc_num').rolling('24h', on='datetime')['transaction_id'].count().reset_index(0, drop=True)
[agent:result]     df['txn_count_24h'].fillna(0, inplace=True)
[agent:result]     
[agent:result]     # Transaction velocity (count per card in last 1 hour)
[agent:result]     df['txn_count_1h'] = df.groupby('cc_num').rolling('1h', on='datetime')['transaction_id'].count().reset_index(0, drop=True)
[agent:result]     df['txn_count_1h'].fillna(0, inplace=True)
[agent:result]     
[agent:result]     # Amount velocity (total amount per card in last 24 hours)
[agent:result]     df['amount_24h'] = df.groupby('cc_num').rolling('24h', on='datetime')['amount'].sum().reset_index(0, drop=True)
[agent:result]     df['amount_24h'].fillna(0, inplace=True)
[agent:result]     
[agent:result]     # Merchant frequency per card
[agent:result]     df['merchant_count_per_card'] = df.groupby('cc_num')['merchant'].transform('nunique')
[agent:result]     
[agent:result]     # Category frequency per card
[agent:result]     df['category_count_per_card'] = df.groupby('cc_num')['category'].transform('nunique')
[agent:result]     
[agent:result]     # Calculate card's usual location (mean lat/long)
[agent:result]     card_location = df.groupby('cc_num')[['lat', 'long']].mean().reset_index()
[agent:result]     card_location.columns = ['cc_num', 'card_lat_mean', 'card_long_mean']
[agent:result]     df = df.merge(card_location, on='cc_num', how='left')
[agent:result]     
[agent:result]     # Distance from usual location
[agent:result]     df['distance_from_usual_km'] = haversine_distance(
[agent:result]         df['lat'], df['long'], 
[agent:result]         df['card_lat_mean'], df['card_long_mean']
[agent:result]     )
[agent:result]     
[agent:result]     # Distance features
[agent:result]     df['distance_std'] = df.groupby('cc_num')['distance_from_usual_km'].transform('std')
[agent:result]     df['distance_mean'] = df.groupby('cc_num')['distance_from_usual_km'].transform('mean')
[agent:result]     df['distance_zscore'] = (df['distance_from_usual_km'] - df['distance_mean']) / (df['distance_std'] + 1e-6)
[agent:result]     
[agent:result]     # Merchant category encoding
[agent:result]     category_dummies = pd.get_dummies(df['category'], prefix='cat')
[agent:result]     df = pd.concat([df, category_dummies], axis=1)
[agent:result]     
[agent:result]     # Is weekend
[agent:result]     df['is_weekend'] = (df['day_of_week'] >= 5).astype(int)
[agent:result]     
[agent:result]     # Is night (10 PM to 6 AM)
[agent:result]     df['is_night'] = ((df['hour_of_day'] >= 22) | (df['hour_of_day'] < 6)).astype(int)
[agent:result]     
[agent:result]     return df
[agent:result] 
