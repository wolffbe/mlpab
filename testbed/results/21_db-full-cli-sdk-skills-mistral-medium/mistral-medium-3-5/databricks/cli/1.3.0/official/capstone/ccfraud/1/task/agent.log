[agent:result] def haversine_udf(lat1, lon1, lat2, lon2):
[agent:result]     """Calculate haversine distance between two points in km"""
[agent:result]     R = 6371.0  # Earth radius in km
[agent:result]     
[agent:result]     lat1_rad = math.radians(float(lat1)) if lat1 is not None else 0.0
[agent:result]     lon1_rad = math.radians(float(lon1)) if lon1 is not None else 0.0
[agent:result]     lat2_rad = math.radians(float(lat2)) if lat2 is not None else 0.0
[agent:result]     lon2_rad = math.radians(float(lon2)) if lon2 is not None else 0.0
[agent:result]     
[agent:result]     dlat = lat2_rad - lat1_rad
[agent:result]     dlon = lon2_rad - lon1_rad
[agent:result]     
[agent:result]     a = math.sin(dlat/2)**2 + math.cos(lat1_rad) * math.cos(lat2_rad) * math.sin(dlon/2)**2
[agent:result]     c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a)) if a < 1 else 0.0
[agent:result]     
[agent:result]     return R * c
[agent:result] 
[agent:result] # Register UDF
[agent:result] haversine = F.udf(haversine_udf, DoubleType())
[agent:result] 
[agent:result] # Feature engineering
[agent:result] window_spec = Window.partitionBy("cc_num")
[agent:result] window_spec_time = Window.partitionBy("cc_num").orderBy("datetime")
[agent:result] 
[agent:result] # Extract time features
[agent:result] df_transactions = df_transactions.withColumn("hour_of_day", F.hour("datetime"))
[agent:result] df_transactions = df_transactions.withColumn("day_of_week", F.dayofweek("datetime"))
[agent:result] df_transactions = df_transactions.withColumn("day_of_month", F.dayofmonth("datetime"))
[agent:result] df_transactions = df_transactions.withColumn("month", F.month("datetime"))
[agent:result] 
[agent:result] # Amount features
[agent:result] df_transactions = df_transactions.withColumn("amount_log", F.log1p("amount"))
[agent:result] df_transactions = df_transactions.withColumn("amount_mean", F.mean("amount").over(window_spec))
[agent:result] df_transactions = df_transactions.withColumn("amount_std", F.stddev("amount").over(window_spec))
[agent:result] df_transactions = df_transactions.withColumn("amount_zscore", 
[agent:result]     (F.col("amount") - F.col("amount_mean")) / (F.col("amount_std") + 1e-6))
[agent:result] 
[agent:result] # Time since last transaction per card (in hours)
[agent:result] df_transactions = df_transactions.withColumn("time_since_last_txn", 
[agent:result]     F.coalesce((F.unix_timestamp("datetime") - F.unix_timestamp(F.lag("datetime").over(window_spec_time))) / 3600.0, F.lit(999.0)))
[agent:result] 
[agent:result] # Transaction velocity (simplified - count per card)
[agent:result] df_transactions = df_transactions.withColumn("txn_count_per_card", 
[agent:result]     F.count("transaction_id").over(window_spec))
[agent:result] df_transactions = df_transactions.withColumn("txn_count_24h", F.lit(0))
[agent:result] df_transactions = df_transactions.withColumn("txn_count_1h", F.lit(0))
[agent:result] df_transactions = df_transactions.withColumn("amount_24h", F.lit(0))
[agent:result] 
[agent:result] # Merchant and category frequency per card
[agent:result] df_transactions = df_transactions.withColumn("merchant_count_per_card", 
[agent:result]     F.countDistinct("merchant").over(window_spec))
[agent:result] df_transactions = df_transactions.withColumn("category_count_per_card", 
[agent:result]     F.countDistinct("category").over(window_spec))
[agent:result] 
[agent:result] # Calculate card's usual location (mean lat/long)
[agent:result] df_transactions = df_transactions.withColumn("card_lat_mean", 
[agent:result]     F.mean("lat").over(window_spec))
[agent:result] df_transactions = df_transactions.withColumn("card_long_mean", 
[agent:result]     F.mean("long").over(window_spec))
[agent:result] 
[agent:result] # Distance from usual location
[agent:result] df_transactions = df_transactions.withColumn("distance_from_usual_km", 
[agent:result]     haversine(F.col("lat"), F.col("long"), F.col("card_lat_mean"), F.col("card_long_mean")))
[agent:result] 
[agent:result] # Distance features
