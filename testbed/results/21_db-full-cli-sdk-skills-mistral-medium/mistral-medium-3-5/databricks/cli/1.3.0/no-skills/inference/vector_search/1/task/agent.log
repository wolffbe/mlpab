[agent:bash] import json
[agent:bash] import sys
[agent:bash] 
[agent:bash] # Read items CSV
[agent:bash] import csv
[agent:bash] items = []
[agent:bash] with open('/dbfs/Workspace/Users/benedict@hopsworks.ai/mlpab09d23e/items.csv', 'r') as f:
[agent:bash]     reader = csv.DictReader(f)
[agent:bash]     for row in reader:
[agent:bash]         items.append(row)
[agent:bash] 
[agent:bash] # Read queries CSV
[agent:bash] queries = []
[agent:bash] with open('/dbfs/Workspace/Users/benedict@hopsworks.ai/mlpab09d23e/queries.csv', 'r') as f:
[agent:bash]     reader = csv.DictReader(f)
[agent:bash]     for row in reader:
[agent:bash]         queries.append(row)
[agent:bash] 
[agent:bash] print(f"Loaded {len(items)} items and {len(queries)} queries")
[agent:bash] 
[agent:bash] # Create table
[agent:bash] from pyspark.sql import SparkSession
[agent:bash] spark = SparkSession.builder.getOrCreate()
[agent:bash] 
[agent:bash] # Create DataFrame from items
[agent:bash] items_df = spark.createDataFrame(items)
[agent:bash] items_df.write.saveAsTable("workspace.mlpab09d23e.itemsffc8a7")
[agent:bash] 
[agent:bash] # Create vector search index
[agent:bash] from databricks.vector_search.client import VectorSearchClient
[agent:bash] vsc = VectorSearchClient()
[agent:bash] 
[agent:bash] # Create DELTA_SYNC index
[agent:bash] vsc.create_delta_sync_index(
[agent:bash]     name="workspace.mlpab09d23e.itemsffc8a7",
[agent:bash]     source_table_name="workspace.mlpab09d23e.itemsffc8a7",
[agent:bash]     endpoint_name="mlpab09d23e_itemsffc8a7",
[agent:bash]     primary_key="item_id",
[agent:bash]     embedding_vector_column="embedding",
[agent:bash]     embedding_dimension=16,
[agent:bash]     metric_type="L2"
[agent:bash] )
[agent:bash] 
[agent:bash] # Wait for index to be ready
[agent:bash] import time
[agent:bash] index = vsc.get_index("workspace.mlpab09d23e.itemsffc8a7")
[agent:bash] while index.get("status", {}).get("state") != "ONLINE":
[agent:bash]     print(f"Index status: {index.get('status', {}).get('state')}")
[agent:bash]     time.sleep(10)
[agent:bash]     index = vsc.get_index("workspace.mlpab09d23e.itemsffc8a7")
[agent:bash] 
[agent:bash] print("Index is ONLINE!")
[agent:bash] 
[agent:bash] # Query each query
[agent:bash] results = {}
[agent:bash] for query in queries:
[agent:bash]     query_id = query['query_id']
[agent:bash]     query_embedding = json.loads(query['embedding'])
[agent:bash]     
[agent:bash]     search_results = vsc.search(
[agent:bash]         index_name="workspace.mlpab09d23e.itemsffc8a7",
[agent:bash]         query_vector=query_embedding,
[agent:bash]         num_results=5,
[agent:bash]         metric_type="L2"
[agent:bash]     )
[agent:bash]     
[agent:bash]     item_ids = [result.get("item_id") for result in search_results.get("results", [])[:5]]
[agent:bash]     results[query_id] = item_ids
[agent:bash]     print(f"Query {query_id}: {item_ids}")
[agent:bash] 
[agent:bash] # Save results
[agent:bash] output = {
[agent:bash]     "store": "workspace.mlpab09d23e.itemsffc8a7",
[agent:bash]     "neighbors": results
[agent:bash] }
[agent:bash] 
[agent:bash] with open('/dbfs/Workspace/Users/benedict@hopsworks.ai/mlpab09d23e/answers.json', 'w') as f:
