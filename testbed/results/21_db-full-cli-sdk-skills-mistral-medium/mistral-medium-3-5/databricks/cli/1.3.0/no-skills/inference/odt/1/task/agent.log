[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %python
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql.functions import col, sqrt, pow, round as spark_round
[agent:result] from pyspark.sql.types import StructType, StructField, StringType, DoubleType
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Define schemas
[agent:result] requests_schema = StructType([
[agent:result]     StructField('request_id', StringType(), True),
[agent:result]     StructField('account_id', StringType(), True),
[agent:result]     StructField('request_lat', DoubleType(), True),
[agent:result]     StructField('request_lon', DoubleType(), True),
[agent:result]     StructField('requested_at', StringType(), True)
[agent:result] ])
[agent:result] 
[agent:result] profiles_schema = StructType([
[agent:result]     StructField('account_id', StringType(), True),
[agent:result]     StructField('home_lat', DoubleType(), True),
[agent:result]     StructField('home_lon', DoubleType(), True),
[agent:result]     StructField('base_score', DoubleType(), True)
[agent:result] ])
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read CSV files from workspace
[agent:result] requests_df = spark.read.csv('/Workspace/Users/benedict@hopsworks.ai/mlpab545541/data/requests.csv', header=True, schema=requests_schema)
[agent:result] profiles_df = spark.read.csv('/Workspace/Users/benedict@hopsworks.ai/mlpab545541/data/profiles.csv', header=True, schema=profiles_schema)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Join requests with profiles on account_id
[agent:result] joined_df = requests_df.join(profiles_df, 'account_id', 'inner')
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute distance_deg and score
[agent:result] distance_df = joined_df.withColumn(
[agent:result]     'distance_deg',
[agent:result]     spark_round(
[agent:result]         sqrt(pow(col('request_lat') - col('home_lat'), 2) + pow(col('request_lon') - col('home_lon'), 2)),
[agent:result]         6
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] score_df = distance_df.withColumn(
[agent:result]     'score',
[agent:result]     spark_round(col('base_score') - 0.1 * col('distance_deg'), 6)
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Select the required columns
[agent:result] result_df = score_df.select('request_id', 'account_id', 'distance_deg', 'score')
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Write to Unity Catalog table
[agent:result] result_df.write.mode('overwrite').saveAsTable('workspace.mlpab545541.scored68393f')
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
