[agent:result]         pass
[agent:result]     
[agent:result]     def predict(self, context, model_input):
[agent:result]         """
[agent:result]         Handle serving endpoint input.
[agent:result]         Serving endpoint sends: {"inputs": ["text1", "text2", ...]}
[agent:result]         MLflow wraps this and passes it as model_input.
[agent:result]         """
[agent:result]         # Extract text(s) from various possible input formats
[agent:result]         if isinstance(model_input, dict):
[agent:result]             # Format 1: {"inputs": ["text1", "text2", ...]}
[agent:result]             if "inputs" in model_input:
[agent:result]                 inputs = model_input["inputs"]
[agent:result]                 if isinstance(inputs, list):
[agent:result]                     texts = inputs
[agent:result]                 else:
[agent:result]                     texts = [inputs]
[agent:result]             # Format 2: {"instances": [{"text": "t1"}, ...]}
[agent:result]             elif "instances" in model_input:
[agent:result]                 texts = [inst.get("text", "") for inst in model_input["instances"]]
[agent:result]             # Format 3: {"text": "single text"}
[agent:result]             elif "text" in model_input:
[agent:result]                 texts = [model_input["text"]]
[agent:result]             else:
[agent:result]                 texts = [str(model_input)]
[agent:result]         elif hasattr(model_input, 'columns'):
[agent:result]             # pandas DataFrame - get first column
[agent:result]             texts = model_input.iloc[:, 0].tolist()
[agent:result]         elif isinstance(model_input, list):
[agent:result]             # List of strings or list of dicts
[agent:result]             if model_input and isinstance(model_input[0], dict):
[agent:result]                 texts = [item.get("text", "") for item in model_input]
[agent:result]             else:
[agent:result]                 texts = model_input
[agent:result]         else:
[agent:result]             texts = [str(model_input)]
[agent:result]         
[agent:result]         # Score each text and return list of results
[agent:result]         return [score(text) for text in texts]
