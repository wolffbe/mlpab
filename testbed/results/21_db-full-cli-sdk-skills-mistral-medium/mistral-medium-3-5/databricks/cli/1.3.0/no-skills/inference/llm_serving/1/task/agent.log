[agent:result] content:         1→"""A tiny deterministic pure-python "language model".
[agent:result]         2→
[agent:result]         3→Character-trigram log-likelihood scorer: every trigram of the input text
[agent:result]         4→contributes a weight derived from fixed constants; the score is the sum,
[agent:result]         5→rounded to 6 decimal places. No dependencies beyond the standard library;
[agent:result]         6→fully deterministic — the same text always yields the same score.
[agent:result]         7→
[agent:result]         8→    >>> from scorer import score
[agent:result]         9→    >>> score("hello world")
[agent:result]        10→    {"score": ...}
[agent:result]        11→"""
[agent:result]        12→import json
[agent:result]        13→import math
[agent:result]        14→import sys
[agent:result]        15→
[agent:result]        16→# model weights (fixed at training time — do not change)
[agent:result]        17→A = 2.653901
[agent:result]        18→B = 1.890485
[agent:result]        19→C = 1.091312
[agent:result]        20→D = 1.69396
[agent:result]        21→
[agent:result]        22→
[agent:result]        23→def _trigram_weight(tri):
[agent:result]        24→    o0, o1, o2 = (ord(ch) for ch in tri)
[agent:result]        25→    return math.sin(A * o0 + B * o1 + C * o2 + D)
[agent:result]        26→
[agent:result]        27→
[agent:result]        28→def score(text):
[agent:result]        29→    """Log-likelihood of `text` under the trigram model."""
[agent:result]        30→    ll = 0.0
[agent:result]        31→    for i in range(len(text) - 2):
[agent:result]        32→        ll += _trigram_weight(text[i:i + 3])
[agent:result]        33→    return {"score": round(ll, 6)}
[agent:result]        34→
[agent:result]        35→
[agent:result]        36→if __name__ == "__main__":
[agent:result]        37→    payload = sys.argv[1] if len(sys.argv) > 1 else sys.stdin.read()
[agent:result]        38→    print(json.dumps(score(payload)))
