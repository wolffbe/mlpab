[agent] Good! Now let me create a notebook that will do the computation. Let me create a Python notebook:
[agent:bash] cat > /tmp/score_notebook.py << 'EOF'
[agent:bash] # Databricks notebook source
[agent:bash] # MAGIC %md
[agent:bash] # Batch Scoring Notebook
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] import pandas as pd
[agent:bash] import numpy as np
[agent:bash] import json
[agent:bash] import re
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Read the input files from workspace
[agent:bash] dbfs_path = "/Workspace/Users/benedict@logicalclocks.com/mlpab383e7b/"
[agent:bash] 
[agent:bash] # Read feature history
[agent:bash] feature_history_path = f"{dbfs_path}feature_history.csv"
[agent:bash] feature_history = spark.read.csv(feature_history_path, header=True, inferSchema=True)
[agent:bash] 
[agent:bash] # Read model
[agent:bash] model_path = f"{dbfs_path}model.json"
[agent:bash] model_json = spark.read.text(model_path).collect()[0][0]
[agent:bash] model = json.loads(model_json)
[agent:bash] 
[agent:bash] # Read scoring request
[agent:bash] scoring_path = f"{dbfs_path}scoring_request.md"
[agent:bash] scoring_text = spark.read.text(scoring_path).collect()[0][0]
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Parse T from scoring request
[agent:bash] match = re.search(r'T = (\d+)', scoring_text)
[agent:bash] T = int(match.group(1))
[agent:bash] print(f"Scoring timestamp T: {T}")
[agent:bash] 
[agent:bash] # Get weights and bias
[agent:bash] weights = model["weights"]
[agent:bash] bias = model["bias"]
[agent:bash] print(f"Weights: {weights}")
[agent:bash] print(f"Bias: {bias}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Filter feature history to get most recent revision at or before T for each account
[agent:bash] from pyspark.sql import functions as F
[agent:bash] from pyspark.sql.window import Window
[agent:bash] 
[agent:bash] # Convert event_time to long type
[agent:bash] feature_history = feature_history.withColumn("event_time", F.col("event_time").cast("long"))
[agent:bash] 
[agent:bash] # Filter to only include revisions at or before T
[agent:bash] filtered_history = feature_history.filter(F.col("event_time") <= T)
[agent:bash] 
[agent:bash] # For each account, get the most recent revision
[agent:bash] window_spec = Window.partitionBy("account_id").orderBy(F.col("event_time").desc())
[agent:bash] ranked_history = filtered_history.withColumn("rank", F.row_number().over(window_spec))
[agent:bash] latest_revisions = ranked_history.filter(F.col("rank") == 1).drop("rank", "event_time")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Compute scores
[agent:bash] weights_f1 = weights["f1"]
[agent:bash] weights_f2 = weights["f2"]
[agent:bash] weights_f3 = weights["f3"]
[agent:bash] 
[agent:bash] # Create the linear combination
[agent:bash] latest_revisions = latest_revisions.withColumn(
[agent:bash]     "linear_comb",
[agent:bash]     F.col("f1") * weights_f1 + F.col("f2") * weights_f2 + F.col("f3") * weights_f3 + bias
[agent:bash] )
[agent:bash] 
[agent:bash] # Apply sigmoid and round to 6 decimal places
[agent:bash] from pyspark.sql.types import DoubleType
[agent:bash] 
[agent:bash] def sigmoid_udf(x):
[agent:bash]     return float(1 / (1 + np.exp(-x)))
[agent:bash] 
[agent:bash] sigmoid_func = F.udf(sigmoid_udf, DoubleType())
[agent:bash] 
[agent:bash] scores_df = latest_revisions.withColumn("score", F.round(sigmoid_func(F.col("linear_comb")), 6))
[agent:bash] 
[agent:bash] # Select only account_id and score
