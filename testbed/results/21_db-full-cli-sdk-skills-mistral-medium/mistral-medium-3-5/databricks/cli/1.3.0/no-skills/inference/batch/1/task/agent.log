[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Define sigmoid function
[agent:result] def sigmoid(x):
[agent:result]     return 1 / (1 + np.exp(-x))
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Filter feature history to get most recent revision at or before T for each account
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Convert event_time to long type
[agent:result] feature_history = feature_history.withColumn("event_time", F.col("event_time").cast("long"))
[agent:result] 
[agent:result] # Filter to only include revisions at or before T
[agent:result] filtered_history = feature_history.filter(F.col("event_time") <= T)
[agent:result] 
[agent:result] # For each account, get the most recent revision
[agent:result] window_spec = Window.partitionBy("account_id").orderBy(F.col("event_time").desc())
[agent:result] ranked_history = filtered_history.withColumn("rank", F.row_number().over(window_spec))
[agent:result] latest_revisions = ranked_history.filter(F.col("rank") == 1).drop("rank", "event_time")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute scores
[agent:result] weights_f1 = weights["f1"]
[agent:result] weights_f2 = weights["f2"]
[agent:result] weights_f3 = weights["f3"]
[agent:result] 
[agent:result] # Create the linear combination
[agent:result] latest_revisions = latest_revisions.withColumn(
[agent:result]     "linear_comb",
[agent:result]     F.col("f1") * weights_f1 + F.col("f2") * weights_f2 + F.col("f3") * weights_f3 + bias
[agent:result] )
[agent:result] 
[agent:result] # Apply sigmoid and round to 6 decimal places
[agent:result] from pyspark.sql.types import DoubleType
[agent:result] 
[agent:result] def sigmoid_udf(x):
[agent:result]     return float(1 / (1 + np.exp(-x)))
[agent:result] 
[agent:result] sigmoid_func = F.udf(sigmoid_udf, DoubleType())
[agent:result] 
[agent:result] scores_df = latest_revisions.withColumn("score", F.round(sigmoid_func(F.col("linear_comb")), 6))
[agent:result] 
