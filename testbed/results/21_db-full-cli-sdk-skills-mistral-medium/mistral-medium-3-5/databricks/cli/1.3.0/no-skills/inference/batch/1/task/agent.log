[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Parse T from scoring request
[agent:result] import re
[agent:result] match = re.search(r'T = (\d+)', scoring_request)
[agent:result] T = int(match.group(1))
[agent:result] print(f"Scoring timestamp T: {T}")
[agent:result] 
[agent:result] # Get weights and bias
[agent:result] weights = model["weights"]
[agent:result] bias = model["bias"]
[agent:result] print(f"Weights: {weights}")
[agent:result] print(f"Bias: {bias}")
