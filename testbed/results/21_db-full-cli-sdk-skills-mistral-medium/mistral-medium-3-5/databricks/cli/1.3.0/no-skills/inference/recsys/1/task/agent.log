[agent:result]                    for _, row in user_embeddings_df.iterrows()}
[agent:result] 
[agent:result] # Create a mapping from item_id to their embedding vector
[agent:result] item_embeddings = {row['item_id']: row[['e1', 'e2', 'e3', 'e4', 'e5', 'e6', 'e7', 'e8']].values.astype(float) 
[agent:result]                    for _, row in item_embeddings_df.iterrows()}
[agent:result] 
[agent:result] # Create a mapping from user_id to their interacted items
[agent:result] user_interactions = {}
[agent:result] for _, row in interactions_df.iterrows():
[agent:result]     user_id = row['user_id']
[agent:result]     item_id = row['item_id']
[agent:result]     if user_id not in user_interactions:
[agent:result]         user_interactions[user_id] = set()
[agent:result]     user_interactions[user_id].add(item_id)
[agent:result] 
