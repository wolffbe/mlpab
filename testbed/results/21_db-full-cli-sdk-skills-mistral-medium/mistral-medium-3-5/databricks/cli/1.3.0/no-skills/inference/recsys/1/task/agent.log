[agent:result]         
[agent:result]         item_emb = item_embeddings[item_id]
[agent:result]         dot_product = np.dot(user_emb, item_emb)
[agent:result]         scores.append((item_id, dot_product))
[agent:result]     
[agent:result]     # Sort by score descending, then by item_id ascending for ties
[agent:result]     scores.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
