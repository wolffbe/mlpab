[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %python
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql import SparkSession
[agent:result] from pyspark.sql.functions import col, lit, round as spark_round
[agent:result] import pyspark.sql.functions as F
[agent:result] 
[agent:result] # Read the training and serving data from workspace
[agent:result] spark = SparkSession.builder.getOrCreate()
[agent:result] 
[agent:result] # Use the workspace path
[agent:result] train_df = spark.read.csv("/Workspace/mlpabddc8d5_data/features_train.csv", header=True, inferSchema=True)
[agent:result] serve_df = spark.read.csv("/Workspace/mlpabddc8d5_data/features_serve.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Compute mean and std from training data only (population std)
[agent:result] features = ['f1', 'f2', 'f3', 'f4']
[agent:result] 
[agent:result] # Calculate statistics from training data
[agent:result] stats = train_df.agg(
[agent:result]     *[F.mean(c).alias(f"mean_{c}") for c in features],
[agent:result]     *[F.stddev_pop(c).alias(f"std_{c}") for c in features]
[agent:result] ).collect()[0]
[agent:result] 
[agent:result] means = {f: stats[f"mean_{f}"] for f in features}
[agent:result] stds = {f: stats[f"std_{c}"] for f in features}
[agent:result] 
[agent:result] # Standardize training data
[agent:result] for f in features:
[agent:result]     train_df = train_df.withColumn(f, spark_round((col(f) - means[f]) / stds[f], 6))
[agent:result] 
[agent:result] # Standardize serving data using the same statistics
[agent:result] for f in features:
[agent:result]     serve_df = serve_df.withColumn(f, spark_round((col(f) - means[f]) / stds[f], 6))
[agent:result] 
[agent:result] # Add split column
[agent:result] train_df = train_df.withColumn("split", lit("train"))
[agent:result] serve_df = serve_df.withColumn("split", lit("serve"))
[agent:result] 
[agent:result] # Combine both datasets
[agent:result] combined_df = train_df.union(serve_df)
[agent:result] 
[agent:result] # Reorder columns: row_id, split, f1, f2, f3, f4
[agent:result] combined_df = combined_df.select("row_id", "split", "f1", "f2", "f3", "f4")
[agent:result] 
[agent:result] # Write to Unity Catalog table
[agent:result] combined_df.writeTo("workspace.mlpabddc8d5.scaleda1a1c9").create()
[agent:result] 
[agent:result] print("Table created successfully!")
