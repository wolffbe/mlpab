[agent:bash] python3 -c "
[agent:bash] import os
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service import catalog, jobs
[agent:bash] 
[agent:bash] # Environment variables
[agent:bash] schema_name = os.getenv('MLPAB_DATABRICKS_SCHEMA')
[agent:bash] prefix = os.getenv('MLPAB_DATABRICKS_PREFIX')
[agent:bash] volume_name = f'{prefix}_volume'
[agent:bash] feature_table_name = 'incrementala59b19'
[agent:bash] job_name = f'{prefix}_incrementaljoba59b19'
[agent:bash] 
[agent:bash] # Initialize WorkspaceClient
[agent:bash] w = WorkspaceClient()
[agent:bash] 
[agent:bash] # Create Volume to store increment files
[agent:bash] try:
[agent:bash]     volume = w.volumes.create(
[agent:bash]         catalog_name='workspace',
[agent:bash]         schema_name=schema_name,
[agent:bash]         name=volume_name,
[agent:bash]         volume_type=catalog.VolumeType.MANAGED
[agent:bash]     )
[agent:bash]     print(f'Volume created: {volume_name}')
[agent:bash] except Exception as e:
[agent:bash]     print(f'Volume creation failed: {e}')
[agent:bash] 
[agent:bash] # Upload increment files to Volume
[agent:bash] increment_files = [f'increment_{i:02d}.csv' for i in range(1, 7)]
[agent:bash] volume_path = f'/Volumes/workspace/{schema_name}/{volume_name}'
[agent:bash] 
[agent:bash] for file_name in increment_files:
[agent:bash]     file_path = f'data/{file_name}'
[agent:bash]     try:
[agent:bash]         with open(file_path, 'rb') as f:
[agent:bash]             w.files.upload(f'{volume_path}/{file_name}', f, overwrite=True)
[agent:bash]         print(f'Uploaded: {file_name}')
[agent:bash]     except Exception as e:
[agent:bash]         print(f'Failed to upload {file_name}: {e}')
[agent:bash] 
[agent:bash] # Register Feature Table
[agent:bash] try:
[agent:bash]     feature_table = w.feature_store.create_table(
[agent:bash]         name=f'workspace.{schema_name}.{feature_table_name}',
[agent:bash]         primary_keys=['row_id'],
[agent:bash]         df_columns=[
[agent:bash]             catalog.ColumnTypeName(name='row_id', type_name='STRING'),
[agent:bash]             catalog.ColumnTypeName(name='account_id', type_name='STRING'),
[agent:bash]             catalog.ColumnTypeName(name='event_time', type_name='BIGINT'),
[agent:bash]             catalog.ColumnTypeName(name='amount', type_name='DOUBLE'),
[agent:bash]             catalog.ColumnTypeName(name='category', type_name='STRING'),
[agent:bash]         ],
[agent:bash]         timestamp_keys=['event_time'],
[agent:bash]         description='Feature table for incremental events data'
[agent:bash]     )
[agent:bash]     print(f'Feature table created: {feature_table_name}')
[agent:bash] except Exception as e:
[agent:bash]     print(f'Feature table creation failed: {e}')
[agent:bash] 
[agent:bash] # Load data into Feature Table
[agent:bash] try:
[agent:bash]     for file_name in increment_files:
[agent:bash]         df = w.dataframes.read_csv(
[agent:bash]             f'{volume_path}/{file_name}',
[agent:bash]             header=True,
[agent:bash]             infer_schema=True
[agent:bash]         )
[agent:bash]         w.feature_store.write_table(
[agent:bash]             name=f'workspace.{schema_name}.{feature_table_name}',
[agent:bash]             df=df,
[agent:bash]             mode='merge'
[agent:bash]         )
[agent:bash]         print(f'Loaded data from: {file_name}')
[agent:bash] except Exception as e:
[agent:bash]     print(f'Data loading failed: {e}')
[agent:bash] 
[agent:bash] # Enable Online Access
[agent:bash] try:
[agent:bash]     online_table = w.online_tables.create(
[agent:bash]         name=f'workspace.{schema_name}.{feature_table_name}_online',
[agent:bash]         feature_table_name=f'workspace.{schema_name}.{feature_table_name}',
[agent:bash]         primary_key_columns=['row_id']
[agent:bash]     )
[agent:bash]     print(f'Online table enabled: {feature_table_name}_online')
[agent:bash] except Exception as e:
[agent:bash]     print(f'Online table creation failed: {e}')
[agent:bash] 
[agent:bash] # Create Recurring Job
[agent:bash] try:
[agent:bash]     job = w.jobs.create(
[agent:bash]         name=job_name,
[agent:bash]         tasks=[
[agent:bash]             jobs.Task(
[agent:bash]                 task_key='ingest_increments',
[agent:bash]                 description='Ingest daily increments into feature table',
[agent:bash]                 new_cluster={
[agent:bash]                     'spark_version': '14.3.x-scala2.12',
[agent:bash]                     'node_type_id': 'i3.xlarge',
[agent:bash]                     'num_workers': 1
[agent:bash]                 },
[agent:bash]                 spark_python_task={
[agent:bash]                     'python_file': f'dbfs:/Volumes/workspace/{schema_name}/{volume_name}/ingest_script.py'
[agent:bash]                 },
[agent:bash]                 libraries=[
[agent:bash]                     {'pypi': {'package': 'databricks-feature-store'}}
[agent:bash]                 ],
[agent:bash]                 email_notifications={}
[agent:bash]             )
[agent:bash]         ],
[agent:bash]         schedule=jobs.CronSchedule(
[agent:bash]             quartz_cron_expression='0 0 0 * * ?',  # Daily at midnight
[agent:bash]             timezone_id='UTC',
[agent:bash]             pause_status=jobs.PauseStatus.UNPAUSED
[agent:bash]         )
[agent:bash]     )
[agent:bash]     print(f'Job created: {job_name}')
[agent:bash] except Exception as e:
[agent:bash]     print(f'Job creation failed: {e}')
[agent:bash] 
[agent:bash] # Write submission/answers.json
[agent:bash] os.makedirs('submission', exist_ok=True)
[agent:bash] with open('submission/answers.json', 'w') as f:
[agent:bash]     f.write(f'{{{{ \"job_name\": \"{job_name}\" }}}}')
[agent:bash] print('submission/answers.json written')
[agent:bash] "
