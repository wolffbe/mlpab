[agent:bash] try:
[agent:bash]     w.files.upload(
[agent:bash]         source_path='./data/training_sample.csv',
[agent:bash]         target_path=f'/Volumes/workspace/{schema}/{volume_name}/training_sample.csv',
[agent:bash]         overwrite=True
[agent:bash]     )
[agent:bash]     w.files.upload(
[agent:bash]         source_path='./data/serving_log.csv',
