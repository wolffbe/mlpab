[agent:bash]     default_warehouse = next((wh for wh in warehouses if wh.name == 'Starter Warehouse'), None)
[agent:bash]     if not default_warehouse:
[agent:bash]         raise Exception('No default warehouse found.')
[agent:bash]     
[agent:bash]     warehouse_id = default_warehouse.id
[agent:bash]     
[agent:bash]     w.statement_execution.execute_statement(
[agent:bash]         warehouse_id=warehouse_id,
[agent:bash]         catalog='workspace',
[agent:bash]         schema=schema,
[agent:bash]         statement=f'''
[agent:bash]         CREATE OR REPLACE TABLE {schema}.training_sample AS
[agent:bash]         SELECT * FROM csv.\"/Volumes/workspace/{schema}/{volume_name}/training_sample.csv\" 
[agent:bash]         TBLPROPERTIES ('header' = 'true', 'inferSchema' = 'true')
[agent:bash]         '''
[agent:bash]     )
[agent:bash]     
[agent:bash]     w.statement_execution.execute_statement(
[agent:bash]         warehouse_id=warehouse_id,
[agent:bash]         catalog='workspace',
[agent:bash]         schema=schema,
[agent:bash]         statement=f'''
[agent:bash]         CREATE OR REPLACE TABLE {schema}.serving_log AS
[agent:bash]         SELECT * FROM csv.\"/Volumes/workspace/{schema}/{volume_name}/serving_log.csv\" 
[agent:bash]         TBLPROPERTIES ('header' = 'true', 'inferSchema' = 'true')
[agent:bash]         '''
[agent:bash]     )
[agent:bash]     print('Tables created successfully.')
[agent:bash] except Exception as e:
[agent:bash]     print(f'Table creation failed: {e}')
[agent:bash] 
[agent:bash] # Step 4: Compute summary statistics for each feature
[agent:bash] try:
[agent:bash]     stats_query = f'''
[agent:bash]     WITH training_stats AS (
[agent:bash]         SELECT
[agent:bash]             'training' AS dataset,
[agent:bash]             feature,
[agent:bash]             AVG(value) AS mean,
[agent:bash]             STDDEV(value) AS stddev,
[agent:bash]             MIN(value) AS min,
[agent:bash]             MAX(value) AS max
[agent:bash]         FROM {schema}.training_sample
[agent:bash]         UNPIVOT (
[agent:bash]             value FOR feature IN (f1, f2, f3, f4, f5)
[agent:bash]         )
[agent:bash]         GROUP BY feature
[agent:bash]     ),
[agent:bash]     serving_stats AS (
[agent:bash]         SELECT
[agent:bash]             'serving' AS dataset,
[agent:bash]             feature,
[agent:bash]             AVG(value) AS mean,
[agent:bash]             STDDEV(value) AS stddev,
[agent:bash]             MIN(value) AS min,
[agent:bash]             MAX(value) AS max
[agent:bash]         FROM {schema}.serving_log
[agent:bash]         UNPIVOT (
[agent:bash]             value FOR feature IN (f1, f2, f3, f4, f5)
[agent:bash]         )
[agent:bash]         GROUP BY feature
[agent:bash]     )
[agent:bash]     SELECT
[agent:bash]         t.feature,
[agent:bash]         t.mean AS training_mean,
[agent:bash]         s.mean AS serving_mean,
[agent:bash]         ABS(t.mean - s.mean) AS mean_diff,
[agent:bash]         t.stddev AS training_stddev,
[agent:bash]         s.stddev AS serving_stddev,
[agent:bash]         ABS(t.stddev - s.stddev) AS stddev_diff
[agent:bash]     FROM training_stats t
[agent:bash]     JOIN serving_stats s ON t.feature = s.feature
[agent:bash]     ORDER BY mean_diff DESC
[agent:bash]     '''
[agent:bash]     
[agent:bash]     result = w.statement_execution.execute_statement(
[agent:bash]         warehouse_id=warehouse_id,
[agent:bash]         catalog='workspace',
[agent:bash]         schema=schema,
[agent:bash]         statement=stats_query
[agent:bash]     )
[agent:bash]     
