[agent:result] content:         1→#!/usr/bin/env python3
[agent:result]         2→"""Engine-agnostic in-flight exec gate — the SHELL that the hookless agents
[agent:result]         3→(vibe / codex) run their commands through, so the single-interface allowlist is
[agent:result]         4→enforced AT EXECUTION TIME for them too, not just post-hoc.
[agent:result]         5→
[agent:result]         6→Why this exists: the Claude runner enforces the contract via a PreToolUse hook,
[agent:result]         7→but vibe and codex have no such hook. Both, however, execute shell commands
[agent:result]         8→through a configurable shell — vibe via `create_subprocess_shell(cmd,
[agent:result]         9→executable=$SHELL)`, codex via its `user_shell` (derived from $SHELL). So the
[agent:result]        10→runners point `SHELL` (and a `bash`/`sh` on PATH) at THIS script. Invoked as
[agent:result]        11→`exec_gate.py -c "<command>"` (the standard non-interactive shell form), it:
[agent:result]        12→
[agent:result]        13→  1. extracts the command string,
[agent:result]        14→  2. runs the SAME `enforce()` / `enforce_instance_types()` as the Claude hook
[agent:result]        15→     (this module's sibling `log_tool_call.py`, copied alongside; both read the
[agent:result]        16→     TESTBED_* env the runner sets),
[agent:result]        17→  3. on a denial: prints the `DENIED: …` reason to stderr and exits non-zero —
[agent:result]        18→     the agent sees a failed command with the identical message a Claude run
[agent:result]        19→     would have shown, so it reacts the same way,
[agent:result]        20→  4. otherwise: hands off UNCHANGED to the real shell (`MLPAB_REAL_SHELL`, an
[agent:result]        21→     absolute path, so there is no recursion back into the gate).
[agent:result]        22→
[agent:result]        23→Any invocation WITHOUT `-c` (an interactive/login shell with no command) passes
[agent:result]        24→straight through. Stdlib-only, like the hook, so it runs under any interpreter.
[agent:result]        25→"""
[agent:result]        26→
[agent:result]        27→from __future__ import annotations
[agent:result]        28→
[agent:result]        29→import os
[agent:result]        30→import sys
[agent:result]        31→
[agent:result]        32→# Resolved by install_exec_gate to a REAL shell (absolute path) so exec'ing it
[agent:result]        33→# never re-enters this gate. Fall back to /bin/bash, then /bin/sh.
[agent:result]        34→_REAL_SHELL = os.environ.get("MLPAB_REAL_SHELL") or (
[agent:result]        35→    "/bin/bash" if os.path.exists("/bin/bash") else "/bin/sh"
[agent:result]        36→)
[agent:result]        37→
[agent:result]        38→
[agent:result]        39→# Short-flag clusters that may bundle `-c` (login/interactive/restricted/etc.).
[agent:result]        40→# Restricting to known shell flag letters avoids treating an arbitrary `-Xc`
[agent:result]        41→# token as `-c` and mis-reading the following arg as the command.
[agent:result]        42→_SHELL_FLAG_LETTERS = set("cilsxeruvfmnptbBCEHPT")
[agent:result]        43→
[agent:result]        44→
[agent:result]        45→def _extract_command(argv: list[str]) -> str | None:
[agent:result]        46→    """The command string from a non-interactive shell invocation. Handles
[agent:result]        47→    `-c CMD`, combined short clusters containing c (`-lc CMD`, `-ic CMD`),
[agent:result]        48→    `-l -c CMD`, and a `--` between the flag and the command (`-c -- CMD`).
[agent:result]        49→    Returns None when there is no `-c` (interactive/login shell)."""
[agent:result]        50→    for i, tok in enumerate(argv):
[agent:result]        51→        is_c = tok == "-c" or (
[agent:result]        52→            tok.startswith("-")
[agent:result]        53→            and not tok.startswith("--")
[agent:result]        54→            and "c" in tok[1:]
[agent:result]        55→            and all(ch in _SHELL_FLAG_LETTERS for ch in tok[1:])
[agent:result]        56→        )
[agent:result]        57→        if not is_c:
[agent:result]        58→            continue
[agent:result]        59→        # The command is the next non-`--` argument (a `--` end-of-options
[agent:result]        60→        # marker between `-c` and the command must not be taken as the command).
[agent:result]        61→        j = i + 1
[agent:result]        62→        while j < len(argv) and argv[j] == "--":
[agent:result]        63→            j += 1
[agent:result]        64→        return argv[j] if j < len(argv) else None
[agent:result]        65→    return None
[agent:result]        66→
[agent:result]        67→
[agent:result]        68→def main(argv: list[str] | None = None) -> int:
[agent:result]        69→    argv = list(sys.argv[1:] if argv is None else argv)
[agent:result]        70→    command = _extract_command(argv)
[agent:result]        71→    if command is not None:
[agent:result]        72→        # Import the shared enforcement logic copied next to this gate.
[agent:result]        73→        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
[agent:result]        74→        import log_tool_call as gate  # noqa: E402  (sibling, stdlib-only)
[agent:result]        75→
[agent:result]        76→        # gate_check = the Bash subset of the Claude hook's main(): single-interface
[agent:result]        77→        # allowlist + instance guard + solution/ answer-key deny (same source).
[agent:result]        78→        reason = gate.gate_check(command)
[agent:result]        79→        if reason:
