[agent:result]        81→            sys.stderr.write(reason.rstrip() + "\n")
[agent:result]        82→            return 2
[agent:result]        83→    # Allowed (or no command): run the real shell with the original args.
[agent:result]        84→    os.execv(_REAL_SHELL, [_REAL_SHELL, *argv])
[agent:result]        85→    return 127  # unreachable unless execv fails
