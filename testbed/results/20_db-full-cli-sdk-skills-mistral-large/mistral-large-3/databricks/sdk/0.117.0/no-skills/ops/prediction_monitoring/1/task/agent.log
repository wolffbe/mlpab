[agent:result]         raise Exception(f"Refresh failed: {refresh_status.message}")
[agent:result]     else:
[agent:result]         print(f"Refresh status: {refresh_status.status}")
[agent:result]         time.sleep(10)
[agent:result] 
[agent:result] # Query the metrics table to detect the shift
[agent:result] # The metrics table is named `<output_schema>.monitor_metrics_<table_id>`
[agent:result] metrics_table_name = f"{OUTPUT_SCHEMA_NAME}.monitor_metrics_{TABLE_NAME}"
[agent:result] 
[agent:result] # Query the metrics table to find the onset of the shift
[agent:result] query = f"""
[agent:result] SELECT 
[agent:result]     window.start as window_start,
[agent:result]     window.end as window_end,
[agent:result]     AVG(metrics.prediction) as avg_prediction,
[agent:result]     STDDEV(metrics.prediction) as stddev_prediction,
[agent:result]     COUNT(*) as count
[agent:result] FROM {metrics_table_name}
[agent:result] GROUP BY window.start, window.end
[agent:result] ORDER BY window.start
[agent:result] """
[agent:result] 
[agent:result] try:
[agent:result]     result = w.statement_execution.execute_statement(
