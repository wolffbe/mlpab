[agent:result]         assets_dir=ASSETS_DIR,
[agent:result]         time_series=catalog.MonitorTimeSeries(
[agent:result]             timestamp_col="ts",
[agent:result]             granularity="1 day"
[agent:result]         ),
[agent:result]         slicing_exprs=[],
[agent:result]         skip_builtin_dashboard=False,
