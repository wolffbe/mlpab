[agent:result]         schema=SCHEMA.split('.')[1],
[agent:result]         statement=query,
[agent:result]         disposition=sql.Disposition.INLINE,
[agent:result]         format=sql.Format.JSON_ARRAY
[agent:result]     )
[agent:result]     
[agent:result]     # Poll for query result
[agent:result]     while True:
[agent:result]         status = w.statement_execution.get_statement_result(result.statement_id)
[agent:result]         if status.status.state == sql.StatementState.SUCCEEDED:
[agent:result]             rows = status.result.data_array
[agent:result]             break
[agent:result]         elif status.status.state == sql.StatementState.FAILED:
[agent:result]             print(f"Query failed: {status.status.error}")
[agent:result]             raise Exception(f"Query failed: {status.status.error}")
[agent:result]         else:
[agent:result]             time.sleep(5)
[agent:result]     
[agent:result]     # Analyze the results to find the shift
[agent:result]     onset_date = None
[agent:result]     prev_avg = None
[agent:result]     for row in rows:
[agent:result]         window_start = row[0]
[agent:result]         avg_prediction = float(row[2])
[agent:result]         stddev_prediction = float(row[3])
[agent:result]         count = int(row[4])
[agent:result]         
[agent:result]         if prev_avg is not None and count > 100:  # Ensure enough data points
[agent:result]             # Detect a significant shift (e.g., > 20% change in mean)
[agent:result]             if abs(avg_prediction - prev_avg) > 0.2 * prev_avg:
[agent:result]                 onset_date = window_start.split('T')[0]  # Extract date
[agent:result]                 print(f"Shift detected on {onset_date}: {prev_avg} -> {avg_prediction}")
[agent:result]                 break
[agent:result]         prev_avg = avg_prediction
[agent:result]     
[agent:result]     if onset_date is None:
[agent:result]         print("No significant shift detected.")
[agent:result]         onset_date = "1970-01-01"  # Fallback
[agent:result]     
[agent:result]     # Write the result to submission/answers.json
[agent:result]     import json
[agent:result]     with open("submission/answers.json", "w") as f:
[agent:result]         json.dump({"onset": onset_date}, f)
[agent:result]     
[agent:result]     print(f"Onset date written to submission/answers.json: {onset_date}")
[agent:result]     
[agent:result] except Exception as e:
