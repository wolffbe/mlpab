[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Compute top-5 recommendations for every user and create a feature table on Databricks.
[agent:result] """
[agent:result] 
[agent:result] import os
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service import catalog
[agent:result] 
[agent:result] # Load data
[agent:result] interactions = pd.read_csv("data/interactions.csv")
[agent:result] user_embeddings = pd.read_csv("data/user_embeddings.csv")
[agent:result] item_embeddings = pd.read_csv("data/item_embeddings.csv")
[agent:result] 
[agent:result] # Extract embedding columns (e1..e8)
[agent:result] user_emb_cols = [f"e{i}" for i in range(1, 9)]
[agent:result] item_emb_cols = [f"e{i}" for i in range(1, 9)]
[agent:result] 
[agent:result] # Convert embeddings to numpy arrays
[agent:result] user_embeddings_array = user_embeddings[user_emb_cols].values
[agent:result] item_embeddings_array = item_embeddings[item_emb_cols].values
[agent:result] 
[agent:result] # Create a set of interacted items for each user
[agent:result] interacted_items = interactions.groupby('user_id')['item_id'].apply(set).to_dict()
[agent:result] 
[agent:result] # Compute recommendations for each user
[agent:result] recommendations = []
[agent:result] for idx, user_row in user_embeddings.iterrows():
[agent:result]     user_id = user_row['user_id']
[agent:result]     user_emb = user_embeddings_array[idx]
[agent:result]     
[agent:result]     # Compute dot products for all items
[agent:result]     scores = np.dot(item_embeddings_array, user_emb)
[agent:result]     
[agent:result]     # Create a DataFrame for scores and item_ids
[agent:result]     scores_df = pd.DataFrame({
[agent:result]         'item_id': item_embeddings['item_id'],
[agent:result]         'score': scores
[agent:result]     })
[agent:result]     
[agent:result]     # Exclude interacted items
[agent:result]     interacted = interacted_items.get(user_id, set())
[agent:result]     scores_df = scores_df[~scores_df['item_id'].isin(interacted)]
[agent:result]     
[agent:result]     # Sort by score (descending) and item_id (ascending for ties)
[agent:result]     scores_df = scores_df.sort_values(by=['score', 'item_id'], ascending=[False, True])
[agent:result]     
[agent:result]     # Take top-5
[agent:result]     top_5 = scores_df.head(5)
[agent:result]     
[agent:result]     # Format recommendations
[agent:result]     for rank, (_, row) in enumerate(top_5.iterrows(), start=1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             'rec_id': rec_id,
[agent:result]             'user_id': user_id,
[agent:result]             'rank': rank,
[agent:result]             'item_id': row['item_id']
[agent:result]         })
[agent:result] 
[agent:result] # Convert recommendations to DataFrame
[agent:result] recs_df = pd.DataFrame(recommendations)
[agent:result] 
[agent:result] # Initialize Databricks WorkspaceClient
[agent:result] w = WorkspaceClient()
[agent:result] 
[agent:result] # Get schema and prefix from environment variables
[agent:result] schema_name = os.environ['MLPAB_DATABRICKS_SCHEMA']
[agent:result] table_name = "recse3a36e"
[agent:result] full_table_name = f"{schema_name}.{table_name}"
[agent:result] 
[agent:result] # Create schema if it doesn't exist
[agent:result] try:
[agent:result]     w.schemas.create(name=schema_name, catalog_name="workspace")
[agent:result] except Exception as e:
[agent:result]     if "already exists" not in str(e):
[agent:result]         raise
[agent:result] 
[agent:result] # Create the feature table
[agent:result] try:
[agent:result]     w.tables.create(
[agent:result]         name=table_name,
[agent:result]         catalog_name="workspace",
[agent:result]         schema_name=schema_name,
[agent:result]         table_type=catalog.TableType.MANAGED,
[agent:result]         data_source_format=catalog.DataSourceFormat.DELTA,
[agent:result]         columns=[
[agent:result]             catalog.Column(name="rec_id", type_name=catalog.ColumnTypeName.STRING, nullable=False, comment="Record key: <user_id>#<rank>"),
[agent:result]             catalog.Column(name="user_id", type_name=catalog.ColumnTypeName.STRING, nullable=False),
[agent:result]             catalog.Column(name="rank", type_name=catalog.ColumnTypeName.INT, nullable=False),
[agent:result]             catalog.Column(name="item_id", type_name=catalog.ColumnTypeName.STRING, nullable=False),
[agent:result]         ],
[agent:result]         comment="Top-5 recommendations for every user."
[agent:result]     )
[agent:result] except Exception as e:
[agent:result]     if "already exists" not in str(e):
[agent:result]         raise
[agent:result] 
[agent:result] # Write recommendations to the table
[agent:result] # Convert DataFrame to a list of dictionaries for Spark
[agent:result] spark_df = w.create_dataframe(recs_df)
[agent:result] 
[agent:result] # Write to the table
[agent:result] spark_df.write.saveAsTable(full_table_name, mode="overwrite")
[agent:result] 
[agent:result] # Enable online access for low-latency lookup
[agent:result] try:
[agent:result]     w.online_tables.create(
[agent:result]         name=full_table_name,
[agent:result]         spec=catalog.OnlineTableSpec(
[agent:result]             source_table_full_name=full_table_name,
[agent:result]             primary_key_columns=["rec_id"]
[agent:result]         )
[agent:result]     )
[agent:result] except Exception as e:
