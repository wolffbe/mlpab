[agent:result]         catalog.Column(name="score", type_name=catalog.ColumnTypeName.DOUBLE),
[agent:result]     ],
[agent:result]     comment="Feature table for batch scoring task."
[agent:result] )
[agent:result] 
[agent:result] # Write data to table
