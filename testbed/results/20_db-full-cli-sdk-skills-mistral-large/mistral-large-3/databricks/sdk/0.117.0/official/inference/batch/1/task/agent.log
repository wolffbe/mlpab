[agent:result] """
[agent:result] 
[agent:result] import json
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service import catalog
[agent:result] 
[agent:result] # Load inputs
[agent:result] T = 1773234000000  # As-of timestamp
[agent:result] 
[agent:result] # Load feature history
[agent:result] feature_history = pd.read_csv("data/feature_history.csv")
[agent:result] 
[agent:result] # Load model
[agent:result] with open("data/model.json", "r") as f:
[agent:result]     model = json.load(f)
[agent:result] 
[agent:result] weights = model["weights"]
[agent:result] bias = model["bias"]
[agent:result] 
[agent:result] # Filter feature history to revisions at or before T
[agent:result] feature_history["event_time"] = pd.to_numeric(feature_history["event_time"])
[agent:result] valid_revisions = feature_history[feature_history["event_time"] <= T]
[agent:result] 
[agent:result] # For each account, select the most recent revision
[agent:result] most_recent_revisions = valid_revisions.sort_values("event_time").groupby("account_id").last().reset_index()
[agent:result] 
[agent:result] # Compute scores
[agent:result] def sigmoid(x):
[agent:result]     return 1 / (1 + np.exp(-x))
[agent:result] 
[agent:result] most_recent_revisions["score"] = sigmoid(
