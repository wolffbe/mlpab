[agent:result] # Step 2: Compute daily statistics for each feature
[agent:result] def compute_daily_stats():
[agent:result]     query = f"""
[agent:result]     SELECT
[agent:result]         event_time,
[agent:result]         AVG(f1) as avg_f1, STDDEV(f1) as std_f1,
[agent:result]         AVG(f2) as avg_f2, STDDEV(f2) as std_f2,
[agent:result]         AVG(f3) as avg_f3, STDDEV(f3) as std_f3,
[agent:result]         AVG(f4) as avg_f4, STDDEV(f4) as std_f4,
[agent:result]         AVG(f5) as avg_f5, STDDEV(f5) as std_f5,
[agent:result]         AVG(f6) as avg_f6, STDDEV(f6) as std_f6
[agent:result]     FROM {FULL_TABLE_NAME}
[agent:result]     GROUP BY event_time
[agent:result]     ORDER BY event_time
[agent:result]     """
[agent:result]     
[agent:result]     result = w.statement_execution.execute_statement(
[agent:result]         warehouse_id=w.warehouses.list()[0].id,
[agent:result]         catalog=CATALOG_SCHEMA.split(".")[0],
[agent:result]         schema=CATALOG_SCHEMA.split(".")[1],
[agent:result]         statement=query
[agent:result]     ).result()
[agent:result]     
[agent:result]     # Fetch the results
[agent:result]     stats_df = pd.DataFrame(
[agent:result]         [row.as_dict() for row in result.result.data_array],
[agent:result]         columns=[col.name for col in result.result.schema]
[agent:result]     )
[agent:result]     return stats_df
[agent:result] 
[agent:result] # Step 3: Detect drift by identifying sudden changes in statistics
[agent:result] def detect_drift(stats_df):
[agent:result]     features = ["f1", "f2", "f3", "f4", "f5", "f6"]
[agent:result]     drift_info = {}
[agent:result]     
[agent:result]     for feature in features:
[agent:result]         avg_col = f"avg_{feature}"
[agent:result]         std_col = f"std_{feature}"
[agent:result]         
[agent:result]         # Calculate rolling mean and std to smooth out noise
[agent:result]         stats_df[f"rolling_avg_{feature}"] = stats_df[avg_col].rolling(window=3).mean()
[agent:result]         stats_df[f"rolling_std_{feature}"] = stats_df[std_col].rolling(window=3).mean()
[agent:result]         
[agent:result]         # Calculate the difference between consecutive days
[agent:result]         stats_df[f"diff_{feature}"] = stats_df[f"rolling_avg_{feature}"].diff().abs()
[agent:result]         
[agent:result]         # Identify the day with the maximum difference
[agent:result]         max_diff_idx = stats_df[f"diff_{feature}"].idxmax()
[agent:result]         max_diff = stats_df[f"diff_{feature}"].max()
[agent:result]         
[agent:result]         # Store the drift info if the difference is significant
[agent:result]         if max_diff > 0.5 * stats_df[f"rolling_std_{feature}"].mean():
[agent:result]             drift_info[feature] = {
[agent:result]                 "onset": stats_df.loc[max_diff_idx, "event_time"].strftime("%Y-%m-%d"),
[agent:result]                 "diff": max_diff
[agent:result]             }
[agent:result]     
[agent:result]     # Identify the feature with the largest drift
[agent:result]     if drift_info:
[agent:result]         drifted_feature = max(drift_info.items(), key=lambda x: x[1]["diff"])
[agent:result]         return {
[agent:result]             "feature": drifted_feature[0],
[agent:result]             "onset": drifted_feature[1]["onset"]
[agent:result]         }
[agent:result]     else:
[agent:result]         return None
[agent:result] 
[agent:result] # Step 4: Write the result to submission/answers.json
[agent:result] def write_result(result):
[agent:result]     with open("submission/answers.json", "w") as f:
[agent:result]         json.dump(result, f, indent=2)
[agent:result] 
[agent:result] if __name__ == "__main__":
