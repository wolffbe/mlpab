[agent:result] # Define a function to get the most recent row for each account_id at or before label_time
[agent:result] def get_most_recent(df, account_id_col, event_time_col, label_time_col):
[agent:result]     window = Window.partitionBy(account_id_col).orderBy(col(event_time_col).desc())
[agent:result]     filtered_df = df.filter(col(event_time_col) <= col(label_time_col))
[agent:result]     ranked_df = filtered_df.withColumn("rank", col("rank").over(window))
[agent:result]     return ranked_df.filter(col("rank") == 1).drop("rank")
[agent:result] 
