[agent:result] )
[agent:result] 
[agent:result] # Join activity
[agent:result] activity_window = Window.partitionBy("account_id").orderBy(col("event_time").desc())
[agent:result] activity_ranked = activity_df.withColumn("rank", col("rank").over(activity_window))
[agent:result] activity_latest = activity_ranked.filter(col("rank") == 1).drop("rank", "event_time")
[agent:result] result_df = result_df.join(
