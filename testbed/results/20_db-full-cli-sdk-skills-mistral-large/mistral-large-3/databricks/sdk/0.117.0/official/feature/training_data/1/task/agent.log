[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] PySpark script to build the training dataset for churn prediction.
[agent:result] 
[agent:result] Steps:
[agent:result] 1. Read input files from the volume.
[agent:result] 2. For each (account_id, label_time) in labels.csv, join the most recent feature values
[agent:result]    from all source tables at or before label_time.
[agent:result] 3. Write the result to a Delta table named `churntrainingaf8b21`.
[agent:result] """
[agent:result] 
[agent:result] import argparse
[agent:result] from pyspark.sql import SparkSession
[agent:result] from pyspark.sql.functions import col
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Parse arguments
[agent:result] parser = argparse.ArgumentParser()
[agent:result] parser.add_argument("--schema", type=str, required=True, help="Schema name")
[agent:result] parser.add_argument("--volume", type=str, required=True, help="Volume name")
[agent:result] args = parser.parse_args()
[agent:result] 
[agent:result] # Initialize Spark
[agent:result] spark = SparkSession.builder.getOrCreate()
[agent:result] 
[agent:result] # Read input files from the volume
[agent:result] base_path = f"/Volumes/{args.schema.split('.')[0]}/{args.schema.split('.')[1]}/{args.volume}"
[agent:result] transactions_df = spark.read.csv(f"{base_path}/transactions.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv(f"{base_path}/profiles.csv", header=True, inferSchema=True)
[agent:result] activity_df = spark.read.csv(f"{base_path}/activity.csv", header=True, inferSchema=True)
[agent:result] health_df = spark.read.csv(f"{base_path}/account_health.csv", header=True, inferSchema=True)
[agent:result] transactions_late_df = spark.read.csv(f"{base_path}/transactions_late.csv", header=True, inferSchema=True)
[agent:result] labels_df = spark.read.csv(f"{base_path}/labels.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Union transactions and transactions_late
[agent:result] transactions_df = transactions_df.union(transactions_late_df)
[agent:result] 
[agent:result] # For each (account_id, label_time), get the most recent feature values at or before label_time
[agent:result] print("Joining feature data...")
[agent:result] 
[agent:result] # Start with labels
[agent:result] result_df = labels_df
[agent:result] 
[agent:result] # Join transactions: most recent at or before label_time
[agent:result] transactions_window = Window.partitionBy("account_id", "label_time").orderBy(col("event_time").desc())
[agent:result] transactions_filtered = transactions_df.filter(col("event_time") <= col("label_time"))
[agent:result] transactions_ranked = transactions_filtered.withColumn("rank", col("rank").over(transactions_window))
[agent:result] transactions_latest = transactions_ranked.filter(col("rank") == 1).drop("rank", "event_time")
[agent:result] result_df = result_df.join(
[agent:result]     transactions_latest, 
[agent:result]     on=["account_id", "label_time"], 
[agent:result]     how="left"
[agent:result] )
[agent:result] 
[agent:result] # Join profiles: most recent at or before label_time
[agent:result] profiles_window = Window.partitionBy("account_id", "label_time").orderBy(col("event_time").desc())
[agent:result] profiles_filtered = profiles_df.filter(col("event_time") <= col("label_time"))
[agent:result] profiles_ranked = profiles_filtered.withColumn("rank", col("rank").over(profiles_window))
[agent:result] profiles_latest = profiles_ranked.filter(col("rank") == 1).drop("rank", "event_time")
[agent:result] result_df = result_df.join(
[agent:result]     profiles_latest, 
[agent:result]     on=["account_id", "label_time"], 
[agent:result]     how="left"
[agent:result] )
[agent:result] 
[agent:result] # Join activity: most recent at or before label_time
[agent:result] activity_window = Window.partitionBy("account_id", "label_time").orderBy(col("event_time").desc())
[agent:result] activity_filtered = activity_df.filter(col("event_time") <= col("label_time"))
[agent:result] activity_ranked = activity_filtered.withColumn("rank", col("rank").over(activity_window))
[agent:result] activity_latest = activity_ranked.filter(col("rank") == 1).drop("rank", "event_time")
[agent:result] result_df = result_df.join(
[agent:result]     activity_latest, 
[agent:result]     on=["account_id", "label_time"], 
[agent:result]     how="left"
[agent:result] )
[agent:result] 
[agent:result] # Join health: most recent at or before label_time
[agent:result] health_window = Window.partitionBy("account_id", "label_time").orderBy(col("event_time").desc())
[agent:result] health_filtered = health_df.filter(col("event_time") <= col("label_time"))
[agent:result] health_ranked = health_filtered.withColumn("rank", col("rank").over(health_window))
[agent:result] health_latest = health_ranked.filter(col("rank") == 1).drop("rank", "event_time")
[agent:result] result_df = result_df.join(
[agent:result]     health_latest, 
[agent:result]     on=["account_id", "label_time"], 
[agent:result]     how="left"
[agent:result] )
[agent:result] 
[agent:result] # Select the required columns
[agent:result] result_df = result_df.select(
[agent:result]     "account_id", 
[agent:result]     "label_time", 
[agent:result]     "amount", 
[agent:result]     "balance", 
[agent:result]     "credit_score", 
[agent:result]     "tier", 
[agent:result]     "sessions_7d", 
[agent:result]     "health_score", 
[agent:result]     "churned"
[agent:result] )
[agent:result] 
[agent:result] # Write the result to a Delta table
[agent:result] print(f"Writing result to {args.schema}.churntrainingaf8b21...")
