[agent:result] """
[agent:result] 
[agent:result] import csv
[agent:result] import json
[agent:result] import os
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service.catalog import *
[agent:result] 
[agent:result] # Data contract rules
[agent:result] VALID_CATEGORIES = {"grocery", "travel", "salary", "rent", "other"}
[agent:result] 
[agent:result] 
[agent:result] def is_valid_row(row):
[agent:result]     """Check if a row satisfies all contract rules."""
[agent:result]     try:
[agent:result]         amount = row['amount']
[agent:result]         if amount == '':
[agent:result]             return False
[agent:result]         amount = float(amount)
[agent:result]         if not (0 <= amount <= 10000):
[agent:result]             return False
[agent:result]         if row['category'] not in VALID_CATEGORIES:
[agent:result]             return False
[agent:result]         return True
[agent:result]     except (ValueError, KeyError):
[agent:result]         return False
[agent:result] 
[agent:result] 
[agent:result] def main():
[agent:result]     # Read and filter events
[agent:result]     valid_rows = []
[agent:result]     rejected_row_ids = []
[agent:result]     
[agent:result]     with open('data/events.csv', 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             if is_valid_row(row):
[agent:result]                 valid_rows.append(row)
[agent:result]             else:
[agent:result]                 rejected_row_ids.append(row['row_id'])
[agent:result]     
[agent:result]     # Write rejected row IDs to submission/answers.json
[agent:result]     with open('submission/answers.json', 'w') as f:
[agent:result]         json.dump({"rejected": rejected_row_ids}, f, indent=2)
[agent:result]     
[agent:result]     # Initialize Databricks WorkspaceClient
[agent:result]     w = WorkspaceClient()
[agent:result]     
[agent:result]     # Schema details
[agent:result]     catalog_name = "workspace"
[agent:result]     schema_name = os.environ["MLPAB_DATABRICKS_SCHEMA"]
[agent:result]     table_name = "events45bd4b"
[agent:result]     full_table_name = f"{catalog_name}.{schema_name}.{table_name}"
[agent:result]     
[agent:result]     # Create a temporary Delta table with valid rows
[agent:result]     temp_dir = "/tmp/events45bd4b_temp"
[agent:result]     dbutils = w.dbutils
[agent:result]     
[agent:result]     # Create DataFrame from valid rows
[agent:result]     from pyspark.sql import SparkSession
