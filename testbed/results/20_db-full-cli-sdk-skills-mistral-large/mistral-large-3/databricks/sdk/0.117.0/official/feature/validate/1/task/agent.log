[agent:bash] catalog_name = 'workspace'
[agent:bash] schema_name = os.environ['MLPAB_DATABRICKS_SCHEMA'].split('.')[-1]  # Extract only the schema name
[agent:bash] table_name = 'events45bd4b'
[agent:bash] full_table_name = f'{catalog_name}.{schema_name}.{table_name}'
[agent:bash] 
[agent:bash] # Prefix for DBFS paths
[agent:bash] prefix = os.environ['MLPAB_DATABRICKS_PREFIX']
[agent:bash] delta_path = f'/tmp/{prefix}_events45bd4b_delta'
[agent:bash] 
[agent:bash] # Create a SQL warehouse if none exists
[agent:bash] warehouses = list(w.warehouses.list())
[agent:bash] if not warehouses:
[agent:bash]     warehouse = w.warehouses.create(
[agent:bash]         name=f'{prefix}_warehouse',
[agent:bash]         cluster_size='2X-Small',
[agent:bash]         auto_stop_mins=10,
[agent:bash]         max_num_clusters=1
[agent:bash]     )
[agent:bash] else:
[agent:bash]     warehouse = warehouses[0]
[agent:bash] 
[agent:bash] # Create an empty Delta table
[agent:bash] create_table_query = f'''
[agent:bash] CREATE TABLE {full_table_name} (
[agent:bash]     row_id STRING,
[agent:bash]     account_id STRING,
[agent:bash]     event_time BIGINT,
[agent:bash]     amount DOUBLE,
[agent:bash]     category STRING,
[agent:bash]     PRIMARY KEY (row_id)
[agent:bash] )
[agent:bash] USING DELTA
[agent:bash] LOCATION \"dbfs:{delta_path}\"'''
[agent:bash] 
