[agent:result]         name=volume_name,
[agent:result]         volume_type=catalog.VolumeType.MANAGED
[agent:result]     )
[agent:result]     print(f"Created volume: {catalog_name}.{schema}.{volume_name}")
[agent:result] except Exception as e:
[agent:result]     print(f"Volume may already exist: {e}")
[agent:result] 
[agent:result] # Upload files to volume
[agent:result] volume_path = f"/Volumes/{catalog_name}/{schema}/{volume_name}"
[agent:result] training_path = f"{volume_path}/training_sample.csv"
[agent:result] serving_path = f"{volume_path}/serving_log.csv"
[agent:result] 
[agent:result] w.files.upload(
[agent:result]     source_path="data/training_sample.csv",
