[agent:result]     overwrite=True
[agent:result] )
[agent:result] print("Uploaded files to volume.")
[agent:result] 
[agent:result] # Read data into DataFrames
[agent:result] training_df = pd.read_csv(f"/dbfs{volume_path}/training_sample.csv")
[agent:result] serving_df = pd.read_csv(f"/dbfs{volume_path}/serving_log.csv")
[agent:result] 
[agent:result] # Compute summary statistics for each feature
[agent:result] features = ["f1", "f2", "f3", "f4", "f5"]
[agent:result] stats = []
[agent:result] 
[agent:result] for feature in features:
[agent:result]     training_mean = training_df[feature].mean()
[agent:result]     training_std = training_df[feature].std()
[agent:result]     serving_mean = serving_df[feature].mean()
[agent:result]     serving_std = serving_df[feature].std()
[agent:result]     
[agent:result]     # Compute divergence (absolute difference in mean and std)
