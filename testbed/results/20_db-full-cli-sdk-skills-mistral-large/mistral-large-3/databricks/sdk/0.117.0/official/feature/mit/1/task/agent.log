[agent:result]     print(f"Pipeline run ID: {run.run_id}")
[agent:result]     
[agent:result]     # Wait for completion (polling)
[agent:result]     run = w.pipelines.get_run(run_id=run.run_id)
[agent:result]     while run.state in (pipelines.PipelineState.RUNNING, pipelines.PipelineState.STARTING, pipelines.PipelineState.PENDING):
[agent:result]         run = w.pipelines.get_run(run_id=run.run_id)
