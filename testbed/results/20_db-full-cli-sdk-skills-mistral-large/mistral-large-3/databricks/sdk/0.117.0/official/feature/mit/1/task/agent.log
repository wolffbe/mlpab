[agent:result] 
[agent:result] import os
[agent:result] from datetime import datetime, timedelta
[agent:result] import pyspark.sql.functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service import jobs, pipelines
[agent:result] 
[agent:result] # Environment variables
[agent:result] PREFIX = os.environ["MLPAB_DATABRICKS_PREFIX"]
[agent:result] SCHEMA = os.environ["MLPAB_DATABRICKS_SCHEMA"]  # catalog.schema
[agent:result] 
[agent:result] # Pipeline and table names
[agent:result] PIPELINE_NAME = f"{PREFIX}_featuresfbc05f_pipeline"
[agent:result] TABLE_NAME = "featuresfbc05f"
[agent:result] FULL_TABLE_NAME = f"{SCHEMA}.{TABLE_NAME}"
[agent:result] 
[agent:result] # Input paths (on DBFS)
[agent:result] TRANSACTIONS_PATH = "/dbfs/FileStore/data/transactions.csv"
[agent:result] FX_RATES_PATH = "/dbfs/FileStore/data/fx_rates.csv"
[agent:result] 
[agent:result] # DLT Pipeline definition
[agent:result] def create_pipeline_spec():
[agent:result]     """Returns the Python code for the DLT pipeline as a string."""
[agent:result]     return f"""
[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col, expr, when
[agent:result] from pyspark.sql.window import Window
[agent:result] from datetime import datetime, timedelta
[agent:result] 
[agent:result] @dlt.table(
[agent:result]     name="{TABLE_NAME}",
[agent:result]     comment="Feature table for transactions with USD conversion, weekend flag, and 7-day rolling sum.",
[agent:result]     table_properties={{
[agent:result]         "quality": "gold",
[agent:result]         "delta.autoOptimize.optimizeWrite": "true",
[agent:result]         "delta.autoOptimize.autoCompact": "true"
[agent:result]     }}
[agent:result] )
[agent:result] @dlt.expect_or_drop("valid_row_id", "row_id IS NOT NULL")
[agent:result] @dlt.expect_or_drop("valid_account_id", "account_id IS NOT NULL")
[agent:result] @dlt.expect_or_drop("valid_event_time", "event_time IS NOT NULL")
[agent:result] @dlt.expect_or_drop("valid_amount", "amount IS NOT NULL")
[agent:result] @dlt.expect_or_drop("valid_currency", "currency IS NOT NULL")
[agent:result] def {TABLE_NAME}():
[agent:result]     # Read raw data
[agent:result]     transactions = dlt.read("transactions").alias("t")
[agent:result]     fx_rates = dlt.read("fx_rates").alias("fx")
[agent:result]     
[agent:result]     # Join and compute features
[agent:result]     joined = transactions.join(
[agent:result]         fx_rates, 
[agent:result]         transactions.currency == fx_rates.currency,
[agent:result]         "inner"
[agent:result]     ).select(
[agent:result]         col("t.row_id"),
[agent:result]         col("t.account_id"),
[agent:result]         col("t.event_time"),
[agent:result]         (col("t.amount") * col("fx.fx_rate")).alias("amount_usd"),
[agent:result]         col("t.currency"),
[agent:result]         col("t.amount")
[agent:result]     )
[agent:result]     
[agent:result]     # Weekend flag (UTC)
[agent:result]     result = joined.withColumn(
[agent:result]         "is_weekend",
[agent:result]         when(expr("date_format(to_timestamp(event_time / 1000), 'E') IN ('Sat', 'Sun')"), 1).otherwise(0)
[agent:result]     )
[agent:result]     
[agent:result]     # 7-day rolling sum for each account
[agent:result]     window = Window.partitionBy("account_id").orderBy("event_time").rangeBetween(-7 * 24 * 60 * 60 * 1000, 0)
[agent:result]     result = result.withColumn("amount_7d", F.sum("amount").over(window))
[agent:result]     
[agent:result]     return result.select(
[agent:result]         "row_id",
[agent:result]         "account_id",
[agent:result]         "event_time",
[agent:result]         "amount_usd",
[agent:result]         "is_weekend",
[agent:result]         "amount_7d"
[agent:result]     )
[agent:result] 
[agent:result] @dlt.table(name="transactions")
[agent:result] def transactions():
[agent:result]     return spark.read.csv("{TRANSACTIONS_PATH}", header=True, inferSchema=True)
[agent:result] 
[agent:result] @dlt.table(name="fx_rates")
[agent:result] @dlt.expect_or_drop("valid_currency", "currency IS NOT NULL")
[agent:result] @dlt.expect_or_drop("valid_fx_rate", "fx_rate IS NOT NULL")
[agent:result] def fx_rates():
[agent:result]     return spark.read.csv("{FX_RATES_PATH}", header=True, inferSchema=True)
[agent:result] """
[agent:result] 
[agent:result] 
[agent:result] def main():
[agent:result]     w = WorkspaceClient()
[agent:result]     
[agent:result]     # Upload the transactions and fx_rates files to DBFS
[agent:result]     dbutils = w.dbutils
[agent:result]     dbutils.fs.mkdirs("/FileStore/data/")
[agent:result]     dbutils.fs.cp("file:/workspace/data/transactions.csv", "{TRANSACTIONS_PATH}")
[agent:result]     dbutils.fs.cp("file:/workspace/data/fx_rates.csv", "{FX_RATES_PATH}")
[agent:result]     
[agent:result]     # Create the DLT pipeline
[agent:result]     pipeline_spec = create_pipeline_spec()
[agent:result]     
[agent:result]     pipeline = w.pipelines.create(
[agent:result]         name=PIPELINE_NAME,
[agent:result]         storage=f"/pipelines/{PIPELINE_NAME}",
[agent:result]         configuration={{
[agent:result]             "pipelines.cluster.autoScale.minWorkers": "1",
[agent:result]             "pipelines.cluster.autoScale.maxWorkers": "2",
[agent:result]             "pipelines.cluster.autoscale.enabled": "true",
[agent:result]             "pipelines.cluster.spark_version": "14.3.x-scala2.12"
[agent:result]         }},
[agent:result]         clusters=[
[agent:result]             pipelines.PipelineCluster(
[agent:result]                 label="default",
[agent:result]                 num_workers=1,
[agent:result]                 node_type_id="i3.xlarge",
[agent:result]                 custom_tags={{
[agent:result]                     "project": PREFIX
[agent:result]                 }}
[agent:result]             )
[agent:result]         ],
[agent:result]         libraries=[
[agent:result]             pipelines.PipelineLibrary(
[agent:result]                 notebook=pipelines.NotebookLibrary(
[agent:result]                     path=f"/Users/{{user}}/{PREFIX}/dlt_pipeline_notebook"
[agent:result]                 )
[agent:result]             )
[agent:result]         ],
[agent:result]         continuous=False,
[agent:result]         development=True,
[agent:result]         photon=True,
[agent:result]         catalog=SCHEMA.split(".")[0],
[agent:result]         target=SCHEMA.split(".")[1],
[agent:result]         edition="ADVANCED",
[agent:result]         channel="CURRENT"
[agent:result]     )
[agent:result]     
[agent:result]     # Create a notebook with the pipeline spec
[agent:result]     notebook_path = f"/Users/{{user}}/{PREFIX}/dlt_pipeline_notebook"
[agent:result]     w.workspace.mkdirs(os.path.dirname(notebook_path))
[agent:result]     w.workspace.upload(notebook_path, pipeline_spec.encode("utf-8"), format=pipelines.WorkspaceFormat.AUTO, overwrite=True)
[agent:result]     
[agent:result]     # Run the pipeline
