[agent] I will now create a DLT pipeline script to transform the data into the required feature table. The script will:
[agent] 1. Read the transactions and fx_rates data.
[agent] 2. Join them to compute `amount_usd`.
[agent] 3. Compute `is_weekend` using the `event_time`.
[agent] 4. Compute `amount_7d` as the 7-day rolling sum for each account.
[agent] 5. Output the table in the specified Unity Catalog schema.
[agent] I will write the DLT pipeline script to a file named `feature_pipeline.py`.
[agent:write] ?
[agent:result] path: /Users/wolffbe/workspace/banter/testbed/results/20_db-full-cli-sdk-skills-mistral-large/mistral-large-3/databricks/cli/1.3.0/no-skills/feature/mit/1/task/feature_pipeline.py
[agent:result] bytes_written: 2386
[agent:result] content: # Databricks DLT Pipeline for Feature Engineering
[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col, expr, sum as spark_sum, window
[agent:result] from pyspark.sql.types import IntegerType
[agent:result] 
[agent:result] # Read transactions data
[agent:result] transactions = dlt.read("transactions")\
[agent:result]     .option("header", "true")\
[agent:result]     .option("inferSchema", "true")\
[agent:result]     .csv("file:/workspace/data/transactions.csv")
[agent:result] 
[agent:result] # Read fx_rates data
[agent:result] fx_rates = dlt.read("fx_rates")\
[agent:result]     .option("header", "true")\
[agent:result]     .option("inferSchema", "true")\
[agent:result]     .csv("file:/workspace/data/fx_rates.csv")
[agent:result] 
[agent:result] # Join transactions with fx_rates to compute amount_usd
[agent:result] joined_df = transactions.join(fx_rates, "currency", "left")\
[agent:result]     .withColumn("amount_usd", col("amount") * col("fx_rate"))\
[agent:result]     .withColumn("event_time", (col("event_time") / 1000).cast("timestamp"))
[agent:result] 
[agent:result] # Compute is_weekend
[agent:result] joined_df = joined_df.withColumn(
[agent:result]     "is_weekend",
[agent:result]     expr("CASE WHEN dayofweek(event_time) IN (1, 7) THEN 1 ELSE 0 END").cast(IntegerType())
[agent:result] )
[agent:result] 
[agent:result] # Compute amount_7d (7-day rolling sum for each account)
[agent:result] window_spec = (
[agent:result]     window(col("event_time"), "7 days")
[agent:result]     .partitionBy("account_id")
[agent:result]     .orderBy(col("event_time").cast("long"))
[agent:result] )
[agent:result] 
[agent:result] features_df = joined_df.withWatermark("event_time", "7 days")\
[agent:result]     .groupBy("account_id", "row_id", "event_time", "amount_usd", "is_weekend", window_spec)\
[agent:result]     .agg(spark_sum("amount").alias("amount_7d"))\
[agent:result]     .select(
[agent:result]         "row_id",
[agent:result]         "account_id",
[agent:result]         (col("event_time").cast("long") * 1000).alias("event_time"),
[agent:result]         "amount_usd",
[agent:result]         "is_weekend",
[agent:result]         "amount_7d"
[agent:result]     )
[agent:result] 
[agent:result] # Create the target table
[agent:result] dlt.create_target_table(
[agent:result]     name="featuresfbc05f",
[agent:result]     schema_="row_id STRING, account_id STRING, event_time LONG, amount_usd DOUBLE, is_weekend INT, amount_7d DOUBLE",
[agent:result]     table_properties={
[agent:result]         "quality": "gold",
[agent:result]         "delta.autoOptimize.optimizeWrite": "true",
[agent:result]         "delta.autoOptimize.autoCompact": "true"
[agent:result]     },
[agent:result]     expect="valid_features",
[agent:result]     expect_or_drop="amount_usd IS NOT NULL AND amount_7d IS NOT NULL"
[agent:result] )
[agent:result] 
[agent:result] # Write the features to the target table
[agent:result] dlt.apply_changes(
[agent:result]     target="featuresfbc05f",
[agent:result]     source=features_df,
[agent:result]     keys=["row_id"],
[agent:result]     sequence_by="event_time",
[agent:result]     apply_as_deletes=None,
[agent:result]     except_column_list=["window"]
[agent:result] )
[agent:result] 
[agent:result] # Enable online access for low-latency lookup
[agent:result] dlt.create_online_table(
[agent:result]     name="featuresfbc05f_online",
[agent:result]     source="featuresfbc05f",
[agent:result]     primary_key="row_id"
[agent:result] )
