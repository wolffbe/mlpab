[agent:result] content: # Databricks notebook source
[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col
[agent:result] 
[agent:result] # Read the raw events
[agent:result] raw_events = spark.read.csv("file:/Workspace/Repos/${MLPAB_DATABRICKS_PREFIX}/task/data/events.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Define the contract rules
[agent:result] valid_categories = ["grocery", "travel", "salary", "rent", "other"]
[agent:result] 
[agent:result] # Filter rows that satisfy the contract
[agent:result] filtered_events = raw_events.filter(
[agent:result]     (col("amount").isNotNull()) &
[agent:result]     (col("amount") >= 0) &
[agent:result]     (col("amount") <= 10000) &
[agent:result]     (col("category").isin(valid_categories))
[agent:result] )
[agent:result] 
[agent:result] # Register the feature table
[agent:result] @dlt.table(
[agent:result]     name="events45bd4b",
[agent:result]     comment="Filtered events table with only valid rows per contract",
[agent:result]     table_properties={
[agent:result]         "quality": "gold",
[agent:result]         "pipelines.autoOptimize.managed": "true"
[agent:result]     }
[agent:result] )
[agent:result] def create_events_table():
[agent:result]     return filtered_events
[agent:result] 
[agent:result] # Enable online table for low-latency lookup
[agent:result] dlt.create_streaming_live_table(
[agent:result]     name="events45bd4b_online",
[agent:result]     comment="Online table for low-latency lookup of events45bd4b",
[agent:result]     table_properties={
[agent:result]         "pipelines.autoOptimize.managed": "true"
[agent:result]     }
[agent:result] )
[agent:result] 
