{
  "name": "${MLPAB_DATABRICKS_PREFIX}_deploy_scorer",
  "tasks": [
    {
      "task_key": "upload_scorer",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      },
      "spark_python_task": {
        "python_file": "dbfs:/FileStore/${MLPAB_DATABRICKS_PREFIX}/upload_scorer.py"
      }
    },
    {
      "task_key": "register_model",
      "depends_on": [
        {
          "task_key": "upload_scorer"
        }
      ],
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      },
      "spark_python_task": {
        "python_file": "dbfs:/FileStore/${MLPAB_DATABRICKS_PREFIX}/register_model.py"
      }
    },
    {
      "task_key": "create_endpoint",
      "depends_on": [
        {
          "task_key": "register_model"
        }
      ],
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      },
      "spark_python_task": {
        "python_file": "dbfs:/FileStore/${MLPAB_DATABRICKS_PREFIX}/create_endpoint.py"
      }
    },
    {
      "task_key": "invoke_endpoint",
      "depends_on": [
        {
          "task_key": "create_endpoint"
        }
      ],
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      },
      "spark_python_task": {
        "python_file": "dbfs:/FileStore/${MLPAB_DATABRICKS_PREFIX}/invoke_endpoint.py"
      }
    }
  ],
  "format": "MULTI_TASK"
}