[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ### DLT Pipeline: Deduplicate Accounts Batches
[agent:result] # MAGIC 
[agent:result] # MAGIC This pipeline ingests three batches of the `accounts` table, deduplicates them by `row_id`, and keeps the latest revision (highest `updated_at`).
[agent:result] # MAGIC The result is registered as a feature table named `accounts7b3169` in Unity Catalog.
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col, row_number
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Read the three batch files from the Volume
[agent:result] catalog = "workspace"
[agent:result] schema = "mlpabe71ee4"
[agent:result] volume = "accounts_data"
[agent:result] 
[agent:result] batch_1_path = f"/Volumes/{catalog}/{schema}/{volume}/batch_1.csv"
[agent:result] batch_2_path = f"/Volumes/{catalog}/{schema}/{volume}/batch_2.csv"
[agent:result] batch_3_path = f"/Volumes/{catalog}/{schema}/{volume}/batch_3.csv"
[agent:result] 
[agent:result] batch_1 = spark.read.format("csv").option("header", "true").load(batch_1_path)
[agent:result] batch_2 = spark.read.format("csv").option("header", "true").load(batch_2_path)
[agent:result] batch_3 = spark.read.format("csv").option("header", "true").load(batch_3_path)
[agent:result] 
[agent:result] # Union all batches
[agent:result] all_batches = batch_1.union(batch_2).union(batch_3)
[agent:result] 
[agent:result] # Deduplicate by row_id, keeping the latest updated_at
[agent:result] window = Window.partitionBy("row_id").orderBy(col("updated_at").desc())
[agent:result] deduplicated = all_batches.withColumn("rank", row_number().over(window)).filter(col("rank") == 1).drop("rank")
[agent:result] 
[agent:result] # Register as a feature table in the specified schema
[agent:result] feature_table_name = f"{catalog}.{schema}.accounts7b3169"
[agent:result] dlt.create_streaming_table(name=feature_table_name)
[agent:result] 
[agent:result] dlt.apply_changes(
[agent:result]     target = feature_table_name,
[agent:result]     source = deduplicated,
[agent:result]     keys = ["row_id"],
[agent:result]     sequence_by = col("updated_at"),
[agent:result]     apply_as_deletes = None,
[agent:result]     except_column_list = ["rank"]
[agent:result] )
[agent:result] 
[agent:result] # Enable online access for low-latency lookup
[agent:result] spark.sql(f"CREATE FEATURE TABLE IF NOT EXISTS {feature_table_name} AS SELECT * FROM LIVE.{feature_table_name}")
[agent:result] spark.sql(f"CREATE OR REFRESH ONLINE TABLE {feature_table_name}_online AS SELECT * FROM {feature_table_name}")
