{
    "name": "mlpabf81e30_feature_drift_dashboard",
    "displayName": "Feature Drift Dashboard",
    "serializedDashboard": {
        "version": "1.0",
        "layout": {
            "version": "1.0",
            "widgets": [
                {
                    "id": "feature_trends",
                    "title": "Feature Mean Trends",
                    "visualization": {
                        "type": "line_chart",
                        "query": {
                            "query": "SELECT CAST(event_time AS DATE) AS event_date, AVG(f1) AS f1_mean, AVG(f2) AS f2_mean, AVG(f3) AS f3_mean, AVG(f4) AS f4_mean, AVG(f5) AS f5_mean, AVG(f6) AS f6_mean FROM workspace.mlpabf81e30.mlpabf81e30_features GROUP BY CAST(event_time AS DATE) ORDER BY event_date",
                            "data_source_id": "workspace.mlpabf81e30.mlpabf81e30_features"
                        },
                        "encoding": {
                            "x": {
                                "field": "event_date",
                                "type": "temporal"
                            },
                            "y": {
                                "field": ["f1_mean", "f2_mean", "f3_mean", "f4_mean", "f5_mean", "f6_mean"],
                                "type": "quantitative"
                            }
                        }
                    }
                }
            ]
        }
    }
}