[agent:result] # Compute means and stds from training data only
[agent:result] from pyspark.sql.functions import avg, stddev_pop
[agent:result] stats = train_df.select(
[agent:result]     avg("f1").alias("mean_f1"),
[agent:result]     avg("f2").alias("mean_f2"),
[agent:result]     avg("f3").alias("mean_f3"),
[agent:result]     avg("f4").alias("mean_f4"),
[agent:result]     stddev_pop("f1").alias("std_f1"),
[agent:result]     stddev_pop("f2").alias("std_f2"),
