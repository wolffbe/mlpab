[agent:result] path: /Users/wolffbe/workspace/banter/testbed/results/20_db-full-cli-sdk-skills-mistral-large/mistral-large-3/databricks/cli/1.3.0/no-skills/inference/recsys/1/task/recommendations.py
[agent:result] bytes_written: 4541
[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # Compute Top-5 Recommendations for Every User
[agent:result] 
[agent:result] This notebook computes the top-5 recommended items for every user using dot product similarity between user and item embeddings, excluding items the user has already interacted with.
[agent:result] 
[agent:result] The results are written to a feature table named `recse3a36e` with the schema:
[agent:result] - `rec_id`: `<user_id>#<rank>` (e.g., "U0003#1")
[agent:result] - `user_id`: The user ID
[agent:result] - `rank`: Integer 1..5
[agent:result] - `item_id`: The recommended item ID
[agent:result] 
[agent:result] Low-latency lookup is enabled for the feature table.
[agent:result] 
[agent:result] ---
[agent:result] 
[agent:result] ### Setup
[agent:result] 
[agent:result] Read the input data from the specified paths and register them as temporary views.
[agent:result] 
[agent:result] ```
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.types import StructType, StructField, StringType, DoubleType
[agent:result] import os
[agent:result] 
[agent:result] # Define schema for input files
[agent:result] user_schema = StructType([
[agent:result]     StructField("user_id", StringType(), False),
[agent:result]     StructField("e1", DoubleType(), True),
[agent:result]     StructField("e2", DoubleType(), True),
[agent:result]     StructField("e3", DoubleType(), True),
[agent:result]     StructField("e4", DoubleType(), True),
[agent:result]     StructField("e5", DoubleType(), True),
[agent:result]     StructField("e6", DoubleType(), True),
[agent:result]     StructField("e7", DoubleType(), True),
[agent:result]     StructField("e8", DoubleType(), True)
[agent:result] ])
[agent:result] 
[agent:result] item_schema = StructType([
[agent:result]     StructField("item_id", StringType(), False),
[agent:result]     StructField("e1", DoubleType(), True),
[agent:result]     StructField("e2", DoubleType(), True),
[agent:result]     StructField("e3", DoubleType(), True),
[agent:result]     StructField("e4", DoubleType(), True),
[agent:result]     StructField("e5", DoubleType(), True),
[agent:result]     StructField("e6", DoubleType(), True),
[agent:result]     StructField("e7", DoubleType(), True),
[agent:result]     StructField("e8", DoubleType(), True)
[agent:result] ])
[agent:result] 
[agent:result] interactions_schema = StructType([
[agent:result]     StructField("user_id", StringType(), False),
[agent:result]     StructField("item_id", StringType(), False)
[agent:result] ])
[agent:result] 
[agent:result] # Read input files
[agent:result] user_embeddings_df = spark.read.csv("file:/Workspace/Users/${MLPAB_DATABRICKS_PREFIX}/data/user_embeddings.csv", header=True, schema=user_schema)
[agent:result] item_embeddings_df = spark.read.csv("file:/Workspace/Users/${MLPAB_DATABRICKS_PREFIX}/data/item_embeddings.csv", header=True, schema=item_schema)
[agent:result] interactions_df = spark.read.csv("file:/Workspace/Users/${MLPAB_DATABRICKS_PREFIX}/data/interactions.csv", header=True, schema=interactions_schema)
[agent:result] 
[agent:result] # Register temporary views
[agent:result] user_embeddings_df.createOrReplaceTempView("user_embeddings")
[agent:result] item_embeddings_df.createOrReplaceTempView("item_embeddings")
[agent:result] interactions_df.createOrReplaceTempView("interactions")
[agent:result] ```
[agent:result] 
[agent:result] ---
[agent:result] 
[agent:result] ### Compute Recommendations
[agent:result] 
[agent:result] For each user, compute the dot product between their embedding and all item embeddings, exclude items they have already interacted with, and rank the top-5 items.
[agent:result] 
[agent:result] ```
[agent:result] # Compute dot product between user and item embeddings
[agent:result] recommendations_df = spark.sql("""
[agent:result]     SELECT
[agent:result]         u.user_id,
[agent:result]         i.item_id,
[agent:result]         (u.e1 * i.e1 + u.e2 * i.e2 + u.e3 * i.e3 + u.e4 * i.e4 + 
[agent:result]          u.e5 * i.e5 + u.e6 * i.e6 + u.e7 * i.e7 + u.e8 * i.e8) AS score
[agent:result]     FROM user_embeddings u
[agent:result]     CROSS JOIN item_embeddings i
[agent:result]     WHERE i.item_id NOT IN (
[agent:result]         SELECT item_id FROM interactions WHERE user_id = u.user_id
[agent:result]     )
[agent:result] """)
[agent:result] 
[agent:result] # Rank items by score (descending) and item_id (ascending for ties)
[agent:result] window_spec = Window.partitionBy("user_id").orderBy(F.desc("score"), F.asc("item_id"))
[agent:result] ranked_recommendations_df = recommendations_df.withColumn("rank", F.row_number().over(window_spec))
[agent:result] 
[agent:result] # Filter top-5 recommendations per user
[agent:result] top_5_recommendations_df = ranked_recommendations_df.filter(F.col("rank") <= 5)
[agent:result] 
[agent:result] # Format the output as specified
[agent:result] output_df = top_5_recommendations_df.select(
[agent:result]     F.concat(F.col("user_id"), F.lit("#"), F.col("rank")).alias("rec_id"),
[agent:result]     F.col("user_id"),
[agent:result]     F.col("rank").cast("int"),
[agent:result]     F.col("item_id")
[agent:result] )
[agent:result] 
[agent:result] # Show the output
[agent:result] output_df.show()
[agent:result] ```
[agent:result] 
[agent:result] ---
[agent:result] 
[agent:result] ### Write to Feature Table
[agent:result] 
[agent:result] Write the results to a feature table named `recse3a36e` in the specified schema and enable low-latency lookup.
[agent:result] 
[agent:result] ```
[agent:result] # Define the schema for the feature table
[agent:result] schema = "${MLPAB_DATABRICKS_SCHEMA}"  # e.g., workspace.<run-id>
[agent:result] feature_table_name = "recse3a36e"
[agent:result] 
[agent:result] # Write the feature table
[agent:result] output_df.write.mode("overwrite").saveAsTable(f"{schema}.{feature_table_name}", format="delta")
[agent:result] 
[agent:result] # Enable low-latency lookup for the feature table
[agent:result] spark.sql(f"""
[agent:result]     CREATE OR REFRESH LIVE TABLE {schema}.{feature_table_name}_online
[agent:result]     AS SELECT * FROM {schema}.{feature_table_name}
[agent:result] """)
[agent:result] 
[agent:result] # Verify the feature table
[agent:result] print(f"Feature table {schema}.{feature_table_name} created successfully.")
[agent:result] spark.sql(f"SELECT * FROM {schema}.{feature_table_name} LIMIT 10").show()
[agent:result] ```
