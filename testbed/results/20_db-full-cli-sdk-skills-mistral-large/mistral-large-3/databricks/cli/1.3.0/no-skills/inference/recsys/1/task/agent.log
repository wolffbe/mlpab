[agent:result] path: /Users/wolffbe/workspace/banter/testbed/results/20_db-full-cli-sdk-skills-mistral-large/mistral-large-3/databricks/cli/1.3.0/no-skills/inference/recsys/1/task/recsys_feature_store_script.py
[agent:result] bytes_written: 1948
[agent:result] content: from databricks.feature_store import FeatureStoreClient
[agent:result] from pyspark.sql import SparkSession
[agent:result] from pyspark.sql.functions import col, concat, row_number, lit
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Initialize Spark session
[agent:result] spark = SparkSession.builder.getOrCreate()
[agent:result] 
[agent:result] # Initialize Feature Store client
[agent:result] fs = FeatureStoreClient()
[agent:result] 
[agent:result] # Read input tables
[agent:result] user_embeddings = spark.table("workspace.mlpab5a0819.user_embeddings")
[agent:result] item_embeddings = spark.table("workspace.mlpab5a0819.item_embeddings")
[agent:result] interactions = spark.table("workspace.mlpab5a0819.interactions")
[agent:result] 
[agent:result] # Compute dot product for all user-item pairs
[agent:result] user_item_scores = (
[agent:result]     user_embeddings
[agent:result]     .crossJoin(item_embeddings)
[agent:result]     .withColumn(
[agent:result]         "score",
[agent:result]         col("e1") * col("e1") + col("e2") * col("e2") + col("e3") * col("e3") +
[agent:result]         col("e4") * col("e4") + col("e5") * col("e5") + col("e6") * col("e6") +
[agent:result]         col("e7") * col("e7") + col("e8") * col("e8")
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] # Exclude already interacted items
[agent:result] filtered_scores = (
[agent:result]     user_item_scores
[agent:result]     .join(
[agent:result]         interactions,
[agent:result]         ["user_id", "item_id"],
[agent:result]         "left_anti"
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] # Rank items by score (desc) and item_id (asc)
[agent:result] window = Window.partitionBy("user_id").orderBy(col("score").desc(), col("item_id").asc())
[agent:result] ranked_scores = (
[agent:result]     filtered_scores
[agent:result]     .withColumn("rank", row_number().over(window))
[agent:result] )
[agent:result] 
[agent:result] # Select top-5 recommendations
[agent:result] result = (
[agent:result]     ranked_scores
[agent:result]     .filter(col("rank") <= 5)
[agent:result]     .select(
[agent:result]         concat(col("user_id"), lit("#"), col("rank")).alias("rec_id"),
[agent:result]         col("user_id"),
[agent:result]         col("rank"),
[agent:result]         col("item_id")
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] # Write to Delta table
[agent:result] result.write.format("delta").mode("overwrite").saveAsTable("workspace.mlpab5a0819.recse3a36e")
[agent:result] 
[agent:result] # Create Feature Store table and enable online serving
[agent:result] fs.create_table(
[agent:result]     name="workspace.mlpab5a0819.recse3a36e_feature",
[agent:result]     primary_keys=["rec_id"],
[agent:result]     df=result,
[agent:result]     description="Top-5 recommendations for every user",
[agent:result]     online_store=True
[agent:result] )
