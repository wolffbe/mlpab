[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] import pyspark.sql.functions as F
[agent:result] from pyspark.sql.types import DoubleType
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read input files
[agent:result] requests_df = spark.read.csv("/dbfs/mnt/data/requests.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv("/dbfs/mnt/data/profiles.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Join requests and profiles on account_id
[agent:result] joined_df = requests_df.join(profiles_df, "account_id", "inner")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute distance_deg and score
[agent:result] distance_udf = F.udf(
[agent:result]     lambda req_lat, req_lon, home_lat, home_lon: round(((req_lat - home_lat) ** 2 + (req_lon - home_lon) ** 2) ** 0.5, 6), 
[agent:result]     DoubleType()
[agent:result] )
[agent:result] 
[agent:result] scored_df = joined_df.withColumn(
[agent:result]     "distance_deg", 
[agent:result]     distance_udf(F.col("request_lat"), F.col("request_lon"), F.col("home_lat"), F.col("home_lon"))
[agent:result] ).withColumn(
[agent:result]     "score", 
[agent:result]     F.round(F.col("base_score") - 0.1 * F.col("distance_deg"), 6)
[agent:result] ).select(
[agent:result]     "request_id", 
[agent:result]     "account_id", 
[agent:result]     "distance_deg", 
[agent:result]     "score"
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Write to feature table
