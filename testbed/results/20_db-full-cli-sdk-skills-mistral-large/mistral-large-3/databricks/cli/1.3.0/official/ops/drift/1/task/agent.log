[agent] The daily statistics are computed. I will now compute the z-scores for each feature's daily average compared to the previous day and identify the feature with the largest change.
[agent:bash] QUERY="WITH daily_stats AS (
[agent:bash]   SELECT
[agent:bash]     CAST(event_time AS DATE) AS day,
[agent:bash]     AVG(f1) AS avg_f1, STDDEV(f1) AS std_f1,
[agent:bash]     AVG(f2) AS avg_f2, STDDEV(f2) AS std_f2,
[agent:bash]     AVG(f3) AS avg_f3, STDDEV(f3) AS std_f3,
[agent:bash]     AVG(f4) AS avg_f4, STDDEV(f4) AS std_f4,
[agent:bash]     AVG(f5) AS avg_f5, STDDEV(f5) AS std_f5,
[agent:bash]     AVG(f6) AS avg_f6, STDDEV(f6) AS std_f6
[agent:bash]   FROM ${MLPAB_DATABRICKS_PREFIX}_features
[agent:bash]   GROUP BY CAST(event_time AS DATE)
[agent:bash] ),
[agent:bash] comparison AS (
[agent:bash]   SELECT
[agent:bash]     day,
[agent:bash]     ABS(avg_f1 - LAG(avg_f1) OVER (ORDER BY day)) / NULLIF(LAG(std_f1) OVER (ORDER BY day), 0) AS z_f1,
[agent:bash]     ABS(avg_f2 - LAG(avg_f2) OVER (ORDER BY day)) / NULLIF(LAG(std_f2) OVER (ORDER BY day), 0) AS z_f2,
[agent:bash]     ABS(avg_f3 - LAG(avg_f3) OVER (ORDER BY day)) / NULLIF(LAG(std_f3) OVER (ORDER BY day), 0) AS z_f3,
[agent:bash]     ABS(avg_f4 - LAG(avg_f4) OVER (ORDER BY day)) / NULLIF(LAG(std_f4) OVER (ORDER BY day), 0) AS z_f4,
[agent:bash]     ABS(avg_f5 - LAG(avg_f5) OVER (ORDER BY day)) / NULLIF(LAG(std_f5) OVER (ORDER BY day), 0) AS z_f5,
[agent:bash]     ABS(avg_f6 - LAG(avg_f6) OVER (ORDER BY day)) / NULLIF(LAG(std_f6) OVER (ORDER BY day), 0) AS z_f6
[agent:bash]   FROM daily_stats
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   day AS onset,
[agent:bash]   'f1' AS feature,
[agent:bash]   z_f1 AS z_score
[agent:bash] FROM comparison
[agent:bash] WHERE z_f1 = (SELECT MAX(z_f1) FROM comparison WHERE z_f1 IS NOT NULL)
[agent:bash] UNION ALL
[agent:bash] SELECT
[agent:bash]   day AS onset,
[agent:bash]   'f2' AS feature,
[agent:bash]   z_f2 AS z_score
[agent:bash] FROM comparison
[agent:bash] WHERE z_f2 = (SELECT MAX(z_f2) FROM comparison WHERE z_f2 IS NOT NULL)
[agent:bash] UNION ALL
[agent:bash] SELECT
[agent:bash]   day AS onset,
[agent:bash]   'f3' AS feature,
[agent:bash]   z_f3 AS z_score
[agent:bash] FROM comparison
[agent:bash] WHERE z_f3 = (SELECT MAX(z_f3) FROM comparison WHERE z_f3 IS NOT NULL)
[agent:bash] UNION ALL
[agent:bash] SELECT
[agent:bash]   day AS onset,
[agent:bash]   'f4' AS feature,
[agent:bash]   z_f4 AS z_score
[agent:bash] FROM comparison
[agent:bash] WHERE z_f4 = (SELECT MAX(z_f4) FROM comparison WHERE z_f4 IS NOT NULL)
[agent:bash] UNION ALL
[agent:bash] SELECT
[agent:bash]   day AS onset,
[agent:bash]   'f5' AS feature,
[agent:bash]   z_f5 AS z_score
[agent:bash] FROM comparison
[agent:bash] WHERE z_f5 = (SELECT MAX(z_f5) FROM comparison WHERE z_f5 IS NOT NULL)
[agent:bash] UNION ALL
[agent:bash] SELECT
[agent:bash]   day AS onset,
[agent:bash]   'f6' AS feature,
[agent:bash]   z_f6 AS z_score
[agent:bash] FROM comparison
[agent:bash] WHERE z_f6 = (SELECT MAX(z_f6) FROM comparison WHERE z_f6 IS NOT NULL)
[agent:bash] ORDER BY z_score DESC
[agent:bash] LIMIT 1"
