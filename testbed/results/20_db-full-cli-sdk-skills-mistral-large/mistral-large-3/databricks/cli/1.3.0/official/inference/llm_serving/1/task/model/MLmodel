flavors:
  python_function:
    python_version: "3.9"
    model_module: scorer
    model_class: score
    env:
      conda_env: conda.yaml
    loader_module: mlflow.pyfunc
model:
  name: scorer
  implementation: scorer
  inputs:
    - type: string
      name: text
      description: "Input text to score"
  outputs:
    - type: dict
      name: score
      description: "Dictionary containing the score key"