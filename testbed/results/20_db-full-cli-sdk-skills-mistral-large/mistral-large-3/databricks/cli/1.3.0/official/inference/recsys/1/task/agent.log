[agent] ### Step 2: Create a Databricks Notebook
[agent] I will create a Python notebook that:
[agent] 1. Loads the input data.
[agent] 2. Computes the dot product between user and item embeddings.
[agent] 3. Excludes items the user has already interacted with.
[agent] 4. Ranks the remaining items by relevance, breaking ties by `item_id`.
[agent] 5. Creates the feature table `recse3a36e` with the specified schema and enables online access.
[agent] I will use the `databricks` CLI to upload and execute this notebook.
[agent:write] ?
[agent:result] path: /Users/wolffbe/workspace/banter/testbed/results/20_db-full-cli-sdk-skills-mistral-large/mistral-large-3/databricks/cli/1.3.0/official/inference/recsys/1/task/recommendations.py
[agent:result] bytes_written: 3143
[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # Compute Top-5 Recommendations for Every User
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.types import StructType, StructField, StringType, IntegerType, FloatType
[agent:result] import os
[agent:result] 
[agent:result] # Define schema for the output table
[agent:result] schema = StructType([
[agent:result]     StructField("rec_id", StringType(), False),
[agent:result]     StructField("user_id", StringType(), False),
[agent:result]     StructField("rank", IntegerType(), False),
[agent:result]     StructField("item_id", StringType(), False)
[agent:result] ])
[agent:result] 
[agent:result] # Load input data
[agent:result] interactions_df = spark.read.csv("file:/databricks/driver/data/interactions.csv", header=True, inferSchema=True)
[agent:result] user_embeddings_df = spark.read.csv("file:/databricks/driver/data/user_embeddings.csv", header=True, inferSchema=True)
[agent:result] item_embeddings_df = spark.read.csv("file:/databricks/driver/data/item_embeddings.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Extract embedding columns for users and items
[agent:result] embedding_cols = ["e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8"]
[agent:result] 
[agent:result] # Compute dot product between user and item embeddings
[agent:result] # Cross join users and items, then compute dot product
[agent:result] user_item_df = user_embeddings_df.crossJoin(item_embeddings_df)
[agent:result] 
[agent:result] for col in embedding_cols:
[agent:result]     user_item_df = user_item_df.withColumn(f"dot_{col}", F.col(f"user_embeddings_df.{col}") * F.col(f"item_embeddings_df.{col}"))
[agent:result] 
[agent:result] # Sum the dot products to get the relevance score
[agent:result] relevance_df = user_item_df.withColumn(
[agent:result]     "relevance",
[agent:result]     sum(F.col(f"dot_{col}") for col in embedding_cols)
[agent:result] )
[agent:result] 
[agent:result] # Drop intermediate columns
[agent:result] for col in embedding_cols:
[agent:result]     relevance_df = relevance_df.drop(f"dot_{col}")
[agent:result] 
[agent:result] # Select relevant columns
[agent:result] relevance_df = relevance_df.select(
[agent:result]     F.col("user_embeddings_df.user_id").alias("user_id"),
[agent:result]     F.col("item_embeddings_df.item_id").alias("item_id"),
[agent:result]     F.col("relevance")
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Exclude items the user has already interacted with
[agent:result] excluded_interactions_df = relevance_df.join(
[agent:result]     interactions_df,
[agent:result]     ["user_id", "item_id"],
[agent:result]     "left_anti"
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Rank items by relevance, breaking ties by ascending item_id
[agent:result] window_spec = Window.partitionBy("user_id").orderBy(F.desc("relevance"), F.asc("item_id"))
[agent:result] ranked_df = excluded_interactions_df.withColumn("rank", F.row_number().over(window_spec))
[agent:result] 
[agent:result] # Filter top-5 recommendations per user
[agent:result] top_5_df = ranked_df.filter(F.col("rank") <= 5)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create rec_id column
[agent:result] result_df = top_5_df.withColumn("rec_id", F.concat(F.col("user_id"), F.lit("#"), F.col("rank")))
[agent:result] 
[agent:result] # Select and order columns as specified
[agent:result] result_df = result_df.select("rec_id", "user_id", "rank", "item_id")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Define the schema name from environment variables
[agent:result] schema_name = os.environ.get("MLPAB_DATABRICKS_SCHEMA")
[agent:result] 
[agent:result] # Write the result to a feature table
[agent:result] result_df.write.saveAsTable(f"{schema_name}.recse3a36e", mode="overwrite")
[agent:result] 
[agent:result] # Enable online access for the feature table
[agent:result] spark.sql(f"CREATE TABLE IF NOT EXISTS {schema_name}.recse3a36e ONLINE USING DELTA SHARE (FEATURE_STORE ON)")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Verify the table was created
