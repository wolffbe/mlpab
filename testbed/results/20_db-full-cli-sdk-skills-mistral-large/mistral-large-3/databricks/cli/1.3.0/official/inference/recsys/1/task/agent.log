[agent] ## Deliverable Logic
[agent] The Python script `recommendations.py` (provided below) contains the logic to:
[agent] 1. Load the input data.
[agent] 2. Compute the dot product between user and item embeddings.
[agent] 3. Exclude items the user has already interacted with.
[agent] 4. Rank the remaining items by relevance.
[agent] 5. Create the feature table `recse3a36e` and enable online access.
[agent] ```python
[agent] # Databricks notebook source
[agent] # MAGIC %md
[agent] # Compute Top-5 Recommendations for Every User
[agent] # COMMAND ----------
[agent] from pyspark.sql import functions as F
[agent] from pyspark.sql.types import StructType, StructField, StringType, IntegerType, FloatType
[agent] from pyspark.sql.window import Window
[agent] import os
[agent] # Load input data
[agent] interactions_df = spark.read.csv("file:/databricks/driver/data/interactions.csv", header=True, inferSchema=True)
[agent] user_embeddings_df = spark.read.csv("file:/databricks/driver/data/user_embeddings.csv", header=True, inferSchema=True)
[agent] item_embeddings_df = spark.read.csv("file:/databricks/driver/data/item_embeddings.csv", header=True, inferSchema=True)
[agent] # COMMAND ----------
[agent] # Extract embedding columns for users and items
[agent] embedding_cols = ["e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8"]
[agent] # Compute dot product between user and item embeddings
[agent] user_item_df = user_embeddings_df.crossJoin(item_embeddings_df)
[agent] for col in embedding_cols:
[agent]     user_item_df = user_item_df.withColumn(f"dot_{col}", F.col(f"user_embeddings_df.{col}") * F.col(f"item_embeddings_df.{col}"))
[agent] # Sum the dot products to get the relevance score
[agent] relevance_df = user_item_df.withColumn(
[agent]     "relevance",
[agent]     sum(F.col(f"dot_{col}") for col in embedding_cols)
[agent] )
[agent] # Drop intermediate columns
[agent] for col in embedding_cols:
[agent]     relevance_df = relevance_df.drop(f"dot_{col}")
[agent] # Select relevant columns
[agent] relevance_df = relevance_df.select(
[agent]     F.col("user_embeddings_df.user_id").alias("user_id"),
[agent]     F.col("item_embeddings_df.item_id").alias("item_id"),
[agent]     F.col("relevance")
[agent] )
[agent] # COMMAND ----------
[agent] # Exclude items the user has already interacted with
[agent] excluded_interactions_df = relevance_df.join(
[agent]     interactions_df,
[agent]     ["user_id", "item_id"],
[agent]     "left_anti"
[agent] )
[agent] # COMMAND ----------
[agent] # Rank items by relevance, breaking ties by ascending item_id
[agent] window_spec = Window.partitionBy("user_id").orderBy(F.desc("relevance"), F.asc("item_id"))
[agent] ranked_df = excluded_interactions_df.withColumn("rank", F.row_number().over(window_spec))
[agent] # Filter top-5 recommendations per user
[agent] top_5_df = ranked_df.filter(F.col("rank") <= 5)
[agent] # COMMAND ----------
[agent] # Create rec_id column
[agent] result_df = top_5_df.withColumn("rec_id", F.concat(F.col("user_id"), F.lit("#"), F.col("rank")))
[agent] # Select and order columns as specified
[agent] result_df = result_df.select("rec_id", "user_id", "rank", "item_id")
[agent] # COMMAND ----------
[agent] # Define the schema name from environment variables
[agent] schema_name = os.environ.get("MLPAB_DATABRICKS_SCHEMA")
[agent] # Write the result to a feature table
[agent] result_df.write.saveAsTable(f"{schema_name}.recse3a36e", mode="overwrite")
[agent] # Enable online access for the feature table
[agent] spark.sql(f"CREATE TABLE IF NOT EXISTS {schema_name}.recse3a36e ONLINE USING DELTA SHARE (FEATURE_STORE ON)")
[agent] # COMMAND ----------
[agent] # Verify the table was created
[agent] display(spark.sql(f"SELECT * FROM {schema_name}.recse3a36e LIMIT 10"))
