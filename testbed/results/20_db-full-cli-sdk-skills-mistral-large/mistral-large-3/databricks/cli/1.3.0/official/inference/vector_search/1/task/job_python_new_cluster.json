{
  "name": "$(echo $MLPAB_DATABRICKS_PREFIX)_load_items",
  "tasks": [
    {
      "task_key": "python_task",
      "notebook_task": {
        "notebook_path": "/Shared/$(echo $MLPAB_DATABRICKS_PREFIX)/load_data.py"
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        }
      }
    }
  ]
}