[agent:result] -- Read raw data from Volume
[agent:result] CREATE OR REPLACE TABLE workspace.mlpab858a9e.featuresfbc05f AS
[agent:result] WITH transactions AS (
[agent:result]   SELECT
[agent:result]     row_id,
[agent:result]     account_id,
[agent:result]     CAST(event_time AS BIGINT) / 1000 AS event_time_seconds,
[agent:result]     amount,
[agent:result]     currency
[agent:result]   FROM csv."/Volumes/workspace/mlpab858a9e/raw/transactions.csv"
[agent:result]   WITH (
[agent:result]     header => true,
[agent:result]     inferSchema => true
[agent:result]   )
[agent:result] ),
[agent:result] fx_rates AS (
[agent:result]   SELECT
[agent:result]     currency,
[agent:result]     fx_rate
[agent:result]   FROM csv."/Volumes/workspace/mlpab858a9e/raw/fx_rates.csv"
[agent:result]   WITH (
[agent:result]     header => true,
[agent:result]     inferSchema => true
[agent:result]   )
[agent:result] ),
[agent:result] joined AS (
[agent:result]   SELECT
[agent:result]     t.row_id,
[agent:result]     t.account_id,
[agent:result]     t.event_time_seconds * 1000 AS event_time,
[agent:result]     t.amount,
[agent:result]     t.currency,
[agent:result]     f.fx_rate,
[agent:result]     t.amount * f.fx_rate AS amount_usd,
[agent:result]     CASE WHEN dayofweek(from_unixtime(t.event_time_seconds)) IN (1, 7) THEN 1 ELSE 0 END AS is_weekend
[agent:result]   FROM transactions t
[agent:result]   LEFT JOIN fx_rates f ON t.currency = f.currency
[agent:result] ),
[agent:result] windowed AS (
[agent:result]   SELECT
[agent:result]     row_id,
[agent:result]     account_id,
[agent:result]     event_time,
[agent:result]     amount_usd,
[agent:result]     is_weekend,
[agent:result]     SUM(amount) OVER (
[agent:result]       PARTITION BY account_id
[agent:result]       ORDER BY event_time
[agent:result]       RANGE BETWEEN INTERVAL 7 DAYS PRECEDING AND CURRENT ROW
[agent:result]     ) AS amount_7d
[agent:result]   FROM joined
[agent:result] )
[agent:result] SELECT
[agent:result]   row_id,
[agent:result]   account_id,
[agent:result]   event_time,
[agent:result]   amount_usd,
[agent:result]   is_weekend,
[agent:result]   amount_7d
[agent:result] FROM windowed
