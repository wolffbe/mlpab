[agent:result] # MAGIC %md
[agent:result] # Generate Training Dataset: churntrainingaf8b21, version 1
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] import time
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read raw data from the volume
[agent:result] volume_path = f"/Volumes/workspace/mlpab674210/{dbutils.widgets.get("prefix")}_raw_data"
[agent:result] 
[agent:result] labels_df = spark.read.csv(f"{volume_path}/labels.csv", header=True, inferSchema=True)
[agent:result] transactions_df = spark.read.csv(f"{volume_path}/transactions.csv", header=True, inferSchema=True)
[agent:result] transactions_late_df = spark.read.csv(f"{volume_path}/transactions_late.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv(f"{volume_path}/profiles.csv", header=True, inferSchema=True)
[agent:result] activity_df = spark.read.csv(f"{volume_path}/activity.csv", header=True, inferSchema=True)
[agent:result] account_health_df = spark.read.csv(f"{volume_path}/account_health.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Merge transactions and transactions_late
[agent:result] transactions_merged_df = transactions_df.union(transactions_late_df)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # For each (account_id, label_time), get the most recent feature values at or before label_time
[agent:result] # Define a window for each account_id, ordered by event_time descending
[agent:result] window_spec = Window.partitionBy("account_id").orderBy(F.col("event_time").desc())
[agent:result] 
[agent:result] # Filter and get the most recent row for each feature table
[agent:result] transactions_filtered_df = (
[agent:result]     transactions_merged_df
[agent:result]     .withColumn("rank", F.row_number().over(window_spec))
[agent:result]     .filter(F.col("rank") == 1)
[agent:result]     .drop("rank")
[agent:result] )
[agent:result] 
[agent:result] profiles_filtered_df = (
[agent:result]     profiles_df
[agent:result]     .withColumn("rank", F.row_number().over(window_spec))
[agent:result]     .filter(F.col("rank"] == 1)
[agent:result]     .drop("rank")
[agent:result] )
[agent:result] 
[agent:result] activity_filtered_df = (
[agent:result]     activity_df
[agent:result]     .withColumn("rank", F.row_number().over(window_spec))
[agent:result]     .filter(F.col("rank") == 1)
[agent:result]     .drop("rank")
[agent:result] )
[agent:result] 
[agent:result] account_health_filtered_df = (
[agent:result]     account_health_df
[agent:result]     .withColumn("rank", F.row_number().over(window_spec))
[agent:result]     .filter(F.col("rank") == 1)
[agent:result]     .drop("rank")
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Join all features to labels_df
[agent:result] # First, join labels with transactions_filtered_df on account_id and event_time <= label_time
[agent:result] joined_df = (
[agent:result]     labels_df
[agent:result]     .join(
[agent:result]         transactions_filtered_df,
[agent:result]         [
[agent:result]             labels_df.account_id == transactions_filtered_df.account_id,
[agent:result]             transactions_filtered_df.event_time <= labels_df.label_time
[agent:result]         ],
[agent:result]         "left"
[agent:result]     )
[agent:result]     .join(
[agent:result]         profiles_filtered_df,
[agent:result]         [
[agent:result]             labels_df.account_id == profiles_filtered_df.account_id,
[agent:result]             profiles_filtered_df.event_time <= labels_df.label_time
[agent:result]         ],
[agent:result]         "left"
[agent:result]     )
[agent:result]     .join(
[agent:result]         activity_filtered_df,
[agent:result]         [
[agent:result]             labels_df.account_id == activity_filtered_df.account_id,
[agent:result]             activity_filtered_df.event_time <= labels_df.label_time
[agent:result]         ],
[agent:result]         "left"
[agent:result]     )
[agent:result]     .join(
[agent:result]         account_health_filtered_df,
[agent:result]         [
[agent:result]             labels_df.account_id == account_health_filtered_df.account_id,
[agent:result]             account_health_filtered_df.event_time <= labels_df.label_time
[agent:result]         ],
[agent:result]         "left"
[agent:result]     )
[agent:result]     .select(
