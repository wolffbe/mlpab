[agent:result]     l.churned
[agent:result] FROM labels l
[agent:result] LEFT JOIN (
[agent:result]     SELECT 
[agent:result]         t.account_id,
[agent:result]         t.event_time,
[agent:result]         t.amount,
[agent:result]         t.balance,
[agent:result]         l.label_time
[agent:result]     FROM labels l
[agent:result]     JOIN transactions t ON t.account_id = l.account_id AND t.event_time <= l.label_time
[agent:result]     QUALIFY ROW_NUMBER() OVER (PARTITION BY t.account_id, l.label_time ORDER BY t.event_time DESC) = 1
[agent:result] ) t ON l.account_id = t.account_id AND l.label_time = t.label_time
[agent:result] LEFT JOIN (
[agent:result]     SELECT 
[agent:result]         p.account_id,
[agent:result]         p.event_time,
[agent:result]         p.credit_score,
[agent:result]         p.tier,
[agent:result]         l.label_time
[agent:result]     FROM labels l
[agent:result]     JOIN profiles p ON p.account_id = l.account_id AND p.event_time <= l.label_time
[agent:result]     QUALIFY ROW_NUMBER() OVER (PARTITION BY p.account_id, l.label_time ORDER BY p.event_time DESC) = 1
[agent:result] ) p ON l.account_id = p.account_id AND l.label_time = p.label_time
[agent:result] LEFT JOIN (
[agent:result]     SELECT 
[agent:result]         a.account_id,
[agent:result]         a.event_time,
[agent:result]         a.sessions_7d,
[agent:result]         l.label_time
[agent:result]     FROM labels l
[agent:result]     JOIN activity a ON a.account_id = l.account_id AND a.event_time <= l.label_time
[agent:result]     QUALIFY ROW_NUMBER() OVER (PARTITION BY a.account_id, l.label_time ORDER BY a.event_time DESC) = 1
[agent:result] ) a ON l.account_id = a.account_id AND l.label_time = a.label_time
[agent:result] LEFT JOIN (
[agent:result]     SELECT 
[agent:result]         h.account_id,
[agent:result]         h.event_time,
[agent:result]         h.health_score,
[agent:result]         l.label_time
[agent:result]     FROM labels l
[agent:result]     JOIN account_health h ON h.account_id = l.account_id AND h.event_time <= l.label_time
[agent:result]     QUALIFY ROW_NUMBER() OVER (PARTITION BY h.account_id, l.label_time ORDER BY h.event_time DESC) = 1
[agent:result] ) h ON l.account_id = h.account_id AND l.label_time = h.label_time
[agent:result] """
