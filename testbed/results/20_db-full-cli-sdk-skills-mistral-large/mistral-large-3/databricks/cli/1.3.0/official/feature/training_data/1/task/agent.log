[agent:result]         labels_df.label_time,
[agent:result]         transactions_filtered_df.amount,
[agent:result]         transactions_filtered_df.balance,
[agent:result]         profiles_filtered_df.credit_score,
[agent:result]         profiles_filtered_df.tier,
[agent:result]         activity_filtered_df.sessions_7d,
[agent:result]         account_health_filtered_df.health_score,
[agent:result]         labels_df.churned
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
