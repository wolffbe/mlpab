[agent:result] def calculate_7d_sum(group):
[agent:result]     # Sort by event_time within the group
[agent:result]     group = group.sort_values('event_time')
[agent:result]     # Calculate rolling sum with 7-day window (inclusive)
[agent:result]     # Convert event_time to datetime for comparison
[agent:result]     group['event_time_dt'] = pd.to_datetime(group['event_time'], unit='ms')
[agent:result]     
[agent:result]     # Use rolling with custom window
[agent:result]     # We need to find for each row, all rows where event_time is within [current - 7 days, current]
[agent:result]     amounts = []
[agent:result]     times = group['event_time_dt'].values
[agent:result]     
[agent:result]     for i, current_time in enumerate(times):
[agent:result]         # Find all indices where time is within 7 days (inclusive)
[agent:result]         mask = (times >= (current_time - timedelta(days=7))) & (times <= current_time)
[agent:result]         window_sum = group.loc[mask, 'amount'].sum()
[agent:result]         amounts.append(window_sum)
[agent:result]     
[agent:result]     group['amount_7d'] = amounts
[agent:result]     return group
[agent:result] 
