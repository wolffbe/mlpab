[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Register feature table 'transactionse6da16' v1 from the two export CSV files.
[agent:result] Deduplicates by row_id (keeping first occurrence) and loads all unique rows.
[agent:result] """
[agent:result] import os
[agent:result] import pandas as pd
[agent:result] import hopsworks
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] hopsworks.login()
[agent:result] fs = hopsworks.feature_store()
[agent:result] 
[agent:result] # Read both CSV files
[agent:result] print("Reading CSV files...")
[agent:result] df1 = pd.read_csv("data/transactions_export_1.csv")
[agent:result] df2 = pd.read_csv("data/transactions_export_2.csv")
[agent:result] 
[agent:result] print(f"File 1: {len(df1)} rows")
[agent:result] print(f"File 2: {len(df2)} rows")
[agent:result] 
[agent:result] # Concatenate and deduplicate by row_id, keeping first occurrence
[agent:result] print("Deduplicating by row_id...")
[agent:result] df_combined = pd.concat([df1, df2], ignore_index=True)
[agent:result] df_deduped = df_combined.drop_duplicates(subset=["row_id"], keep="first")
[agent:result] 
[agent:result] print(f"Combined (before dedup): {len(df_combined)} rows")
[agent:result] print(f"Deduplicated: {len(df_deduped)} rows")
[agent:result] 
[agent:result] # Verify we have all unique row_ids
[agent:result] print(f"Unique row_ids: {df_deduped['row_id'].nunique()}")
[agent:result] 
[agent:result] # Register the feature table
[agent:result] print("\nRegistering feature table 'transactionse6da16' v1...")
[agent:result] 
[agent:result] # Create the feature group
[agent:result] fg_name = "transactionse6da16"
[agent:result] version = 1
[agent:result] 
[agent:result] # Check if feature group already exists
[agent:result] try:
[agent:result]     fg = fs.get_feature_group(fg_name, version=version)
[agent:result]     print(f"Feature group {fg_name} v{version} already exists")
[agent:result] except:
[agent:result]     # Create new feature group
[agent:result]     fg = fs.create_feature_group(
[agent:result]         name=fg_name,
[agent:result]         version=version,
[agent:result]         description="Transactions feature table from export files",
[agent:result]         primary_key=["row_id"],
[agent:result]         event_time_column="event_time",
[agent:result]         online_enabled=True,
[agent:result]     )
[agent:result]     print(f"Created feature group {fg_name} v{version}")
[agent:result] 
[agent:result] # Get the feature group to work with it
[agent:result] fg = fs.get_feature_group(fg_name, version=version)
[agent:result] 
[agent:result] # Insert the data
[agent:result] print(f"\nInserting {len(df_deduped)} rows into feature table...")
[agent:result] fg.insert(df_deduped, write_options={"wait_for_job": True})
[agent:result] 
[agent:result] print("\nDone! Feature table registered and data loaded.")
[agent:result] 
[agent:result] # Verify the data was loaded
[agent:result] fg = fs.get_feature_group(fg_name, version=version)
[agent:result] print(f"\nFeature group info:")
[agent:result] print(f"  Name: {fg.name}")
[agent:result] print(f"  Version: {fg.version}")
[agent:result] print(f"  Online enabled: {fg.online_enabled}")
[agent:result] 
