[agent:result]         primary_key=["account_id"],
[agent:result]         description="Batch scores for all accounts as of T=1773406800000",
[agent:result]         online_enabled=True  # Enable online access
[agent:result]     )
[agent:result]     
[agent:result]     print(f"Feature group created. Online enabled: {fg.online_enabled}")
[agent:result]     
