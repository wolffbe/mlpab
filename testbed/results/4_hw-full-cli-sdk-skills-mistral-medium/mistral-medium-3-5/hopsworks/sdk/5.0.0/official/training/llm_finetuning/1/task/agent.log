[agent:result] content:         1→"""Provided fine-tuning script — deterministic LoRA-style adapter update.
[agent:result]         2→
[agent:result]         3→Reads base_model.npz (bigram logits + vocab), finetune.txt and eval.txt from
[agent:result]         4→its working directory. The base logits stay FROZEN; only a rank-4 additive
[agent:result]         5→adapter delta = A @ B is trained by plain full-batch gradient descent
[agent:result]         6→(learning rate 2.0, exactly 400 iterations; B initialized to zero so the
[agent:result]         7→adapter delta starts at zero, A to a fixed 0.5-scaled tiled identity).
[agent:result]         8→Writes finetuned_model.npz and metrics.json with the fine-tuned and unadapted
[agent:result]         9→cross-entropy on eval.txt (both rounded to 4 decimals). Fully deterministic —
[agent:result]        10→do NOT modify it; run it as-is.
[agent:result]        11→"""
[agent:result]        12→import json
[agent:result]        13→
[agent:result]        14→import numpy as np
[agent:result]        15→
[agent:result]        16→RANK = 4
[agent:result]        17→LEARNING_RATE = 2.0
[agent:result]        18→ITERATIONS = 400
[agent:result]        19→ADAPTER_SCALE = 0.5
[agent:result]        20→
[agent:result]        21→
[agent:result]        22→def bigram_counts(text, vocab):
[agent:result]        23→    index = {ch: i for i, ch in enumerate(vocab)}
[agent:result]        24→    idx = np.array([index[ch] for ch in text], dtype=int)
[agent:result]        25→    counts = np.zeros((len(vocab), len(vocab)), dtype=float)
[agent:result]        26→    np.add.at(counts, (idx[:-1], idx[1:]), 1.0)
[agent:result]        27→    return counts
[agent:result]        28→
[agent:result]        29→
[agent:result]        30→def cross_entropy(logits, counts):
[agent:result]        31→    logp = logits - logits.max(axis=1, keepdims=True)
[agent:result]        32→    logp = logp - np.log(np.exp(logp).sum(axis=1, keepdims=True))
[agent:result]        33→    return -(counts * logp).sum() / counts.sum()
[agent:result]        34→
[agent:result]        35→
[agent:result]        36→def main():
[agent:result]        37→    ckpt = np.load("base_model.npz")
[agent:result]        38→    base_logits = ckpt["logits"].astype(float)
[agent:result]        39→    vocab = [str(ch) for ch in ckpt["vocab"]]
[agent:result]        40→    ft_counts = bigram_counts(open("finetune.txt").read(), vocab)
[agent:result]        41→    eval_counts = bigram_counts(open("eval.txt").read(), vocab)
[agent:result]        42→
[agent:result]        43→    n_vocab = base_logits.shape[0]
[agent:result]        44→    A = np.zeros((n_vocab, RANK), dtype=float)
[agent:result]        45→    for i in range(n_vocab):
[agent:result]        46→        A[i, i % RANK] = ADAPTER_SCALE
[agent:result]        47→    B = np.zeros((RANK, n_vocab), dtype=float)
[agent:result]        48→    n = ft_counts.sum()
[agent:result]        49→    row_totals = ft_counts.sum(axis=1, keepdims=True)
[agent:result]        50→    for _ in range(ITERATIONS):
[agent:result]        51→        logits = base_logits + A @ B
[agent:result]        52→        e = np.exp(logits - logits.max(axis=1, keepdims=True))
[agent:result]        53→        p = e / e.sum(axis=1, keepdims=True)
[agent:result]        54→        g = (row_totals * p - ft_counts) / n
[agent:result]        55→        A, B = A - LEARNING_RATE * (g @ B.T), B - LEARNING_RATE * (A.T @ g)
[agent:result]        56→
[agent:result]        57→    np.savez("finetuned_model.npz", logits=base_logits + A @ B,
[agent:result]        58→             adapter_a=A, adapter_b=B)
[agent:result]        59→    metrics = {
[agent:result]        60→        "eval_loss": round(float(cross_entropy(base_logits + A @ B, eval_counts)), 4),
[agent:result]        61→        "base_eval_loss": round(float(cross_entropy(base_logits, eval_counts)), 4),
[agent:result]        62→    }
[agent:result]        63→    json.dump(metrics, open("metrics.json", "w"), indent=2)
[agent:result]        64→
[agent:result]        65→
[agent:result]        66→if __name__ == "__main__":
[agent:result]        67→    main()
