[agent:result] rejected_ids = []
[agent:result] 
[agent:result] for row in rows:
[agent:result]     row_id = row['row_id']
[agent:result]     amount_str = row['amount']
[agent:result]     category = row['category']
[agent:result]     
[agent:result]     # Rule 1: amount must be present
[agent:result]     if amount_str is None or amount_str.strip() == '':
[agent:result]         rejected_ids.append(row_id)
[agent:result]         continue
[agent:result]     
[agent:result]     # Rule 2: amount must be within [0, 10000]
[agent:result]     try:
[agent:result]         amount = float(amount_str)
[agent:result]     except ValueError:
[agent:result]         rejected_ids.append(row_id)
[agent:result]         continue
[agent:result]     
[agent:result]     if amount < 0 or amount > 10000:
[agent:result]         rejected_ids.append(row_id)
[agent:result]         continue
[agent:result]     
[agent:result]     # Rule 3: category must be valid
[agent:result]     if category not in VALID_CATEGORIES:
[agent:result]         rejected_ids.append(row_id)
[agent:result]         continue
[agent:result]     
[agent:result]     # All rules passed
