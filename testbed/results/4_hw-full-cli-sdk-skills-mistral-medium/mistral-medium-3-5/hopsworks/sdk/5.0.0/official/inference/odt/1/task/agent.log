[agent:result] requests_df = pd.read_csv('data/requests.csv')
[agent:result] profiles_df = pd.read_csv('data/profiles.csv')
[agent:result] 
[agent:result] # Merge requests with profiles on account_id
[agent:result] merged_df = pd.merge(requests_df, profiles_df, on='account_id', how='left')
[agent:result] 
[agent:result] # Compute distance_deg and score
[agent:result] def compute_distance_deg(row):
[agent:result]     lat_diff = row['request_lat'] - row['home_lat']
[agent:result]     lon_diff = row['request_lon'] - row['home_lon']
[agent:result]     distance = math.sqrt(lat_diff**2 + lon_diff**2)
[agent:result]     return round(distance, 6)
[agent:result] 
[agent:result] def compute_score(row):
[agent:result]     distance = row['distance_deg']
[agent:result]     score = row['base_score'] - 0.1 * distance
[agent:result]     return round(score, 6)
[agent:result] 
[agent:result] # Calculate features
[agent:result] merged_df['distance_deg'] = merged_df.apply(compute_distance_deg, axis=1)
[agent:result] merged_df['score'] = merged_df.apply(compute_score, axis=1)
[agent:result] 
[agent:result] # Select the required columns
[agent:result] result_df = merged_df[['request_id', 'account_id', 'distance_deg', 'score']]
[agent:result] 
