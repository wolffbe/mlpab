[agent:result] def engineer_features(df, is_training=True):
[agent:result]     """Engineer fraud detection features."""
[agent:result]     df = df.copy()
[agent:result]     
[agent:result]     # Basic features
[agent:result]     df['hour_of_day'] = df['datetime'].dt.hour
[agent:result]     df['day_of_week'] = df['datetime'].dt.dayofweek
[agent:result]     df['day_of_month'] = df['datetime'].dt.day
[agent:result]     df['month'] = df['datetime'].dt.month
[agent:result]     
[agent:result]     # Amount features
[agent:result]     df['amount_log'] = np.log1p(df['amount'])
[agent:result]     df['amount_std'] = df.groupby('cc_num')['amount'].transform('std')
[agent:result]     df['amount_mean'] = df.groupby('cc_num')['amount'].transform('mean')
[agent:result]     df['amount_zscore'] = (df['amount'] - df['amount_mean']) / (df['amount_std'] + 1e-6)
[agent:result]     
[agent:result]     # Time-based features (velocity)
[agent:result]     df['time_since_last_tx'] = df.groupby('cc_num')['datetime'].diff().dt.total_seconds() / 3600  # hours
[agent:result]     df['tx_count_last_1h'] = df.groupby('cc_num')['datetime'].transform(
[agent:result]         lambda x: x.rolling('1h', closed='left').count()
[agent:result]     )
[agent:result]     df['tx_count_last_24h'] = df.groupby('cc_num')['datetime'].transform(
[agent:result]         lambda x: x.rolling('24h', closed='left').count()
[agent:result]     )
[agent:result]     df['amount_last_1h'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling('1h', closed='left').sum()
[agent:result]     )
[agent:result]     df['amount_last_24h'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling('24h', closed='left').sum()
[agent:result]     )
[agent:result]     
[agent:result]     # Merchant and category features
[agent:result]     df['merchant_freq'] = df.groupby('merchant').size().transform(lambda x: x / len(df))
[agent:result]     df['category_freq'] = df.groupby('category').size().transform(lambda x: x / len(df))
[agent:result]     df['cc_merchant_freq'] = df.groupby(['cc_num', 'merchant']).size().transform(lambda x: x / df.groupby('cc_num').size().transform('max'))
[agent:result]     
[agent:result]     # Geo features
[agent:result]     df['lat_long_ratio'] = df['lat'] / (df['long'].abs() + 1e-6)
[agent:result]     
[agent:result]     # Card-level statistics
[agent:result]     df['cc_tx_count'] = df.groupby('cc_num').cumcount()
[agent:result]     df['cc_avg_amount'] = df.groupby('cc_num')['amount'].transform('mean')
[agent:result]     df['cc_std_amount'] = df.groupby('cc_num')['amount'].transform('std')
[agent:result]     
[agent:result]     # Category amount stats per card
[agent:result]     df['cc_cat_avg'] = df.groupby(['cc_num', 'category'])['amount'].transform('mean')
[agent:result]     df['cc_cat_std'] = df.groupby(['cc_num', 'category'])['amount'].transform('std')
[agent:result]     
[agent:result]     # Time since first transaction for this card
[agent:result]     df['time_since_first_tx'] = (df['datetime'] - df.groupby('cc_num')['datetime'].transform('min')).dt.total_seconds() / 3600
[agent:result]     
[agent:result]     # Rolling average amount per card
[agent:result]     df['rolling_avg_amount'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling(window=5, min_periods=1).mean()
[agent:result]     )
[agent:result]     
[agent:result]     # Rolling std amount per card
[agent:result]     df['rolling_std_amount'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling(window=5, min_periods=1).std()
[agent:result]     )
[agent:result]     
[agent:result]     # Geo distance from card's mean location
[agent:result]     card_mean_loc = df.groupby('cc_num')[['lat', 'long']].transform('mean')
[agent:result]     df['lat_diff'] = df['lat'] - card_mean_loc['lat']
[agent:result]     df['long_diff'] = df['long'] - card_mean_loc['long']
[agent:result]     df['geo_distance'] = np.sqrt(df['lat_diff']**2 + df['long_diff']**2)
[agent:result]     
[agent:result]     # Interaction features
