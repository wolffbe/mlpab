[agent:result]        22→def _user_label(value: Any) -> str:
[agent:result]        23→    """Render a Hopsworks user reference (dict / str / object) as one string.
[agent:result]        24→
[agent:result]        25→    The REST API returns ``creator`` as a dict (``{username, firstname, ...}``)
[agent:result]        26→    on some endpoints and as a username string on others. Pick the most useful
[agent:result]        27→    field; fall back to ``"-"`` rather than the dict's repr.
[agent:result]        28→    """
[agent:result]        29→    if not value:
[agent:result]        30→        return "-"
[agent:result]        31→    if isinstance(value, str):
[agent:result]        32→        return value
[agent:result]        33→    if isinstance(value, dict):
[agent:result]        34→        return (
[agent:result]        35→            value.get("username")
[agent:result]        36→            or value.get("email")
[agent:result]        37→            or f"{value.get('firstname', '')} {value.get('lastname', '')}".strip()
[agent:result]        38→            or "-"
[agent:result]        39→        )
[agent:result]        40→    return getattr(value, "username", None) or getattr(value, "email", None) or "-"
[agent:result]        41→
[agent:result]        42→
[agent:result]        43→def _ts_label(value: Any) -> str:
[agent:result]        44→    """Render a Hopsworks timestamp (epoch ms / ISO string / None) as ISO-8601.
[agent:result]        45→
[agent:result]        46→    Job endpoints return ``creationTime`` as epoch milliseconds; some other
[agent:result]        47→    endpoints return ISO strings. Normalize to ISO-8601 UTC for display.
[agent:result]        48→    """
[agent:result]        49→    if value in (None, "", "-"):
[agent:result]        50→        return "-"
[agent:result]        51→    if isinstance(value, (int, float)):
[agent:result]        52→        seconds = value / 1000 if value > 10**12 else value
[agent:result]        53→        from datetime import datetime as _dt  # noqa: PLC0415
[agent:result]        54→        from datetime import timezone as _tz
[agent:result]        55→
[agent:result]        56→        return _dt.fromtimestamp(seconds, tz=_tz.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
[agent:result]        57→    return str(value)
