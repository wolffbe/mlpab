[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Full FTI pipeline for credit card fraud detection on Hopsworks platform.
[agent:result] Creates feature group cctxnee3558, training dataset cctdee3558, 
[agent:result] model ccmodelee3558, and predictions table ccpredee3558.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from datetime import datetime
[agent:result] import os
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] print("Connecting to Hopsworks...")
[agent:result] hopsworks.login()
[agent:result] fs = hopsworks.feature_store()
[agent:result] 
[agent:result] # Read the data
[agent:result] print("Reading data...")
[agent:result] transactions_df = pd.read_csv("data/transactions.csv")
[agent:result] score_df = pd.read_csv("data/score_transactions.csv")
[agent:result] 
[agent:result] print(f"Transactions: {len(transactions_df)} rows")
[agent:result] print(f"Score transactions: {len(score_df)} rows")
[agent:result] 
[agent:result] # Feature Engineering
[agent:result] print("\nEngineering features...")
[agent:result] 
[agent:result] def haversine_distance(lat1, lon1, lat2, lon2):
[agent:result]     """Calculate haversine distance between two points in km"""
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     
[agent:result]     lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])
[agent:result]     dlat = lat2 - lat1
[agent:result]     dlon = lon2 - lon1
[agent:result]     
[agent:result]     a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
[agent:result]     c = 2 * np.arcsin(np.sqrt(a))
[agent:result]     return R * c
[agent:result] 
[agent:result] def engineer_features(df):
[agent:result]     """Engineer fraud detection features"""
[agent:result]     df = df.copy()
[agent:result]     
[agent:result]     # Parse datetime
[agent:result]     df['datetime'] = pd.to_datetime(df['datetime'])
[agent:result]     df['hour'] = df['datetime'].dt.hour
[agent:result]     df['day_of_week'] = df['datetime'].dt.dayofweek
[agent:result]     df['day_of_month'] = df['datetime'].dt.day
[agent:result]     df['month'] = df['datetime'].dt.month
[agent:result]     
[agent:result]     # Time since first transaction per card
[agent:result]     df['txn_order'] = df.groupby('cc_num').cumcount()
[agent:result]     df['time_since_first_txn'] = df.groupby('cc_num')['datetime'].transform(
[agent:result]         lambda x: (x - x.min()).dt.total_seconds() / 3600  # hours
[agent:result]     )
[agent:result]     
[agent:result]     # Transaction velocity features
[agent:result]     df['amount_per_hour'] = df['amount'] / (df['time_since_first_txn'] + 1)
[agent:result]     
[agent:result]     # Rolling window features (last 5 transactions per card)
[agent:result]     df['rolling_avg_amount_5'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling(5, min_periods=1).mean()
[agent:result]     )
[agent:result]     df['rolling_std_amount_5'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling(5, min_periods=1).std()
[agent:result]     )
[agent:result]     df['rolling_count_5'] = df.groupby('cc_num')['amount'].transform(
[agent:result]         lambda x: x.rolling(5, min_periods=1).count()
[agent:result]     )
[agent:result]     
[agent:result]     # Time since last transaction per card
[agent:result]     df['time_since_last_txn'] = df.groupby('cc_num')['datetime'].diff().dt.total_seconds() / 3600
[agent:result]     df['time_since_last_txn'] = df['time_since_last_txn'].fillna(999)  # First txn
[agent:result]     
[agent:result]     # Card-level aggregates
[agent:result]     df['card_avg_amount'] = df.groupby('cc_num')['amount'].transform('mean')
[agent:result]     df['card_std_amount'] = df.groupby('cc_num')['amount'].transform('std')
[agent:result]     df['card_total_amount'] = df.groupby('cc_num')['amount'].transform('sum')
[agent:result]     df['card_txn_count'] = df.groupby('cc_num')['amount'].transform('count')
[agent:result]     
[agent:result]     # Category encoding
[agent:result]     category_dummies = pd.get_dummies(df['category'], prefix='cat')
[agent:result]     for col in category_dummies.columns:
[agent:result]         df[col] = category_dummies[col].astype(int)
[agent:result]     
[agent:result]     # Merchant frequency
[agent:result]     df['merchant_freq'] = df.groupby('merchant')['merchant'].transform('count')
[agent:result]     
[agent:result]     # Geo features - calculate distance from card's mean location
[agent:result]     df['card_mean_lat'] = df.groupby('cc_num')['lat'].transform('mean')
[agent:result]     df['card_mean_long'] = df.groupby('cc_num')['long'].transform('mean')
[agent:result]     df['card_std_lat'] = df.groupby('cc_num')['lat'].transform('std')
[agent:result]     df['card_std_long'] = df.groupby('cc_num')['long'].transform('std')
[agent:result]     
[agent:result]     # Distance from card's mean location
[agent:result]     df['distance_from_mean_km'] = haversine_distance(
[agent:result]         df['lat'], df['long'], 
[agent:result]         df['card_mean_lat'], df['card_mean_long']
[agent:result]     )
[agent:result]     
[agent:result]     # Distance from previous transaction location (per card)
[agent:result]     df['prev_lat'] = df.groupby('cc_num')['lat'].shift(1)
[agent:result]     df['prev_long'] = df.groupby('cc_num')['long'].shift(1)
[agent:result]     df['distance_from_prev_km'] = haversine_distance(
[agent:result]         df['lat'], df['long'], 
[agent:result]         df['prev_lat'], df['prev_long']
[agent:result]     )
[agent:result]     df['distance_from_prev_km'] = df['distance_from_prev_km'].fillna(0)
[agent:result]     
[agent:result]     # Amount ratios
[agent:result]     df['amount_ratio_to_avg'] = df['amount'] / (df['card_avg_amount'] + 0.01)
[agent:result]     df['amount_ratio_to_std'] = df['amount'] / (df['card_std_amount'] + 0.01)
[agent:result]     
[agent:result]     # Time-based velocity
[agent:result]     df['txn_per_hour'] = df.groupby('cc_num')['txn_order'].transform(
[agent:result]         lambda x: x.count() / ((x.max() - x.min()) / 3600 + 1)
[agent:result]     )
[agent:result]     
[agent:result]     # High-risk signals
[agent:result]     df['is_high_amount'] = (df['amount'] > df['card_avg_amount'] * 3).astype(int)
[agent:result]     df['is_far_from_mean'] = (df['distance_from_mean_km'] > 100).astype(int)
[agent:result]     df['is_rapid_txn'] = (df['time_since_last_txn'] < 1).astype(int)
[agent:result]     
[agent:result]     return df
[agent:result] 
[agent:result] # Engineer features for training data
[agent:result] print("Engineering training features...")
[agent:result] engineered_train = engineer_features(transactions_df)
[agent:result] 
[agent:result] # Select features to use (excluding raw columns that won't help)
[agent:result] feature_columns = [
[agent:result]     'amount', 'hour', 'day_of_week', 'day_of_month', 'month',
[agent:result]     'txn_order', 'time_since_first_txn', 'amount_per_hour',
[agent:result]     'rolling_avg_amount_5', 'rolling_std_amount_5', 'rolling_count_5',
[agent:result]     'time_since_last_txn', 'card_avg_amount', 'card_std_amount',
[agent:result]     'card_total_amount', 'card_txn_count', 'merchant_freq',
[agent:result]     'card_mean_lat', 'card_mean_long', 'card_std_lat', 'card_std_long',
[agent:result]     'distance_from_mean_km', 'distance_from_prev_km',
[agent:result]     'amount_ratio_to_avg', 'amount_ratio_to_std',
[agent:result]     'is_high_amount', 'is_far_from_mean', 'is_rapid_txn'
[agent:result] ]
[agent:result] 
[agent:result] # Add category one-hot columns
[agent:result] cat_cols = [c for c in engineered_train.columns if c.startswith('cat_')]
[agent:result] feature_columns.extend(cat_cols)
[agent:result] 
[agent:result] print(f"Total features: {len(feature_columns)}")
[agent:result] 
[agent:result] # Create feature group
[agent:result] print("\nCreating feature group cctxnee3558...")
[agent:result] fg_name = "cctxnee3558"
[agent:result] fg_version = 1
