[agent:result]         event_time="datetime"
[agent:result]     )
[agent:result]     print(f"Created feature group {fg_name} v{fg_version}")
[agent:result] 
[agent:result] # Prepare data for feature group insertion
[agent:result] # We need to include the primary key and event time
[agent:result] train_fg_data = engineered_train[['transaction_id', 'datetime'] + feature_columns + ['is_fraud']].copy()
[agent:result] 
[agent:result] # Insert into feature group
[agent:result] print("Inserting training data into feature group...")
[agent:result] fg.insert(train_fg_data, write_options={"wait_for_job": True})
