[agent:result]       127→def _deployment_status_live(d: Any) -> str:
[agent:result]       128→    """Status for a single deployment, fetching live state when available.
[agent:result]       129→
[agent:result]       130→    Unlike the list view, ``info`` can afford the REST call ``get_state()``
[agent:result]       131→    makes, so the Status reflects reality. The cached attributes are usually
[agent:result]       132→    empty (which rendered "-"); fall back to them only if the call fails.
[agent:result]       133→
[agent:result]       134→    Args:
[agent:result]       135→        d: Deployment instance.
[agent:result]       136→
[agent:result]       137→    Returns:
[agent:result]       138→        A short human-readable status label.
[agent:result]       139→    """
[agent:result]       140→    try:
[agent:result]       141→        state = d.get_state()
[agent:result]       142→    except Exception:  # noqa: BLE001 - degrade to the cached attributes
[agent:result]       143→        state = None
[agent:result]       144→    status = getattr(state, "status", None) if state is not None else None
[agent:result]       145→    return str(status) if status else _deployment_status(d)
