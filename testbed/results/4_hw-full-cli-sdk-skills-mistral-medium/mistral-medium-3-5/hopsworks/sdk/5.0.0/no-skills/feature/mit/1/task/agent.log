[agent:result] content: #!/usr/bin/env python3
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] 
[agent:result] # Login to Hopsworks
[agent:result] hopsworks.login()
[agent:result] 
[agent:result] # Load the data locally
[agent:result] transactions = pd.read_csv('data/transactions.csv')
[agent:result] fx_rates = pd.read_csv('data/fx_rates.csv')
[agent:result] 
[agent:result] # Create fx_rate mapping
[agent:result] fx_map = fx_rates.set_index('currency')['fx_rate'].to_dict()
[agent:result] 
[agent:result] # Compute amount_usd
[agent:result] transactions['amount_usd'] = transactions.apply(
[agent:result]     lambda row: row['amount'] * fx_map[row['currency']], axis=1
[agent:result] )
[agent:result] 
[agent:result] # Compute is_weekend (UTC)
[agent:result] transactions['event_time_dt'] = pd.to_datetime(transactions['event_time'], unit='ms', utc=True)
[agent:result] transactions['is_weekend'] = transactions['event_time_dt'].dt.dayofweek.isin([5, 6]).astype(int)
[agent:result] 
[agent:result] # Compute amount_7d: sum of amount for same account over [event_time - 7 days, event_time]
[agent:result] transactions = transactions.sort_values(['account_id', 'event_time'])
[agent:result] 
[agent:result] def compute_amount_7d(df):
[agent:result]     df['amount_7d'] = 0.0
[agent:result]     for idx, row in df.iterrows():
[agent:result]         mask = (df['account_id'] == row['account_id']) & \
[agent:result]                 (df['event_time'] >= row['event_time'] - 7 * 24 * 60 * 60 * 1000) & \
[agent:result]                 (df['event_time'] <= row['event_time'])
[agent:result]         df.loc[idx, 'amount_7d'] = df.loc[mask, 'amount'].sum()
[agent:result]     return df
[agent:result] 
[agent:result] transactions = transactions.groupby('account_id', group_keys=False, observed=True).apply(compute_amount_7d)
[agent:result] 
[agent:result] # Select the required columns
