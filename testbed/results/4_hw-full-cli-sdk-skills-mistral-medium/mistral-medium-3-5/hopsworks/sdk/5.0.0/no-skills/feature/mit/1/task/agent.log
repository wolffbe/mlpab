[agent:result]         description="Derived feature table with amount_usd, is_weekend, amount_7d",
[agent:result]         primary_key=["row_id"],
[agent:result]         event_time_column="event_time",
[agent:result]         online_enabled=True,
[agent:result]         time_travel_format="HUDI"
[agent:result]     )
[agent:result]     print(f"Created feature group {fg_name} version {fg_version}")
[agent:result] 
