[agent:result] content: #!/usr/bin/env python3
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Read the data
[agent:result] train_df = pd.read_csv('data/features_train.csv')
[agent:result] serve_df = pd.read_csv('data/features_serve.csv')
[agent:result] 
[agent:result] # Compute mean and population std from training data only
[agent:result] # Population std uses ddof=0 (no Bessel's correction)
[agent:result] features = ['f1', 'f2', 'f3', 'f4']
[agent:result] means = train_df[features].mean()
[agent:result] stds = train_df[features].std(ddof=0)
[agent:result] 
[agent:result] print("Training means:", means.to_dict())
[agent:result] print("Training stds (population):", stds.to_dict())
[agent:result] 
[agent:result] # Standardize both splits using training statistics
[agent:result] def standardize(df, split_name):
[agent:result]     df_std = df.copy()
[agent:result]     for feature in features:
[agent:result]         df_std[feature] = (df[feature] - means[feature]) / stds[feature]
[agent:result]     df_std['split'] = split_name
[agent:result]     return df_std
[agent:result] 
[agent:result] train_std = standardize(train_df, 'train')
[agent:result] serve_std = standardize(serve_df, 'serve')
[agent:result] 
[agent:result] # Round to 6 decimals
[agent:result] for feature in features:
[agent:result]     train_std[feature] = train_std[feature].round(6)
[agent:result]     serve_std[feature] = serve_std[feature].round(6)
[agent:result] 
[agent:result] # Combine both splits
[agent:result] combined = pd.concat([train_std, serve_std], ignore_index=True)
[agent:result] 
[agent:result] # Reorder columns: row_id, split, f1, f2, f3, f4
[agent:result] combined = combined[['row_id', 'split', 'f1', 'f2', 'f3', 'f4']]
[agent:result] 
[agent:result] print(f"\nCombined shape: {combined.shape}")
[agent:result] print(f"Combined columns: {combined.columns.tolist()}")
[agent:result] print(f"\nFirst few rows:")
[agent:result] print(combined.head())
[agent:result] print(f"\nLast few rows:")
[agent:result] print(combined.tail())
[agent:result] 
[agent:result] # Connect to Hopsworks and register the feature table
