[agent:result] items = []
[agent:result] with open("data/items.csv", "r") as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         items.append({
[agent:result]             "item_id": row["item_id"],
[agent:result]             "embedding": json.loads(row["embedding"]),
[agent:result]             "label": row["label"]
[agent:result]         })
[agent:result] 
[agent:result] print(f"Loaded {len(items)} items")
[agent:result] 
[agent:result] # Prepare data for insertion
[agent:result] # We need to flatten the embedding array into individual columns
[agent:result] print("Preparing data for insertion...")
[agent:result] feature_data = []
[agent:result] for item in items:
[agent:result]     row = {"item_id": [item["item_id"]], "label": [item["label"]]}
[agent:result]     for i, val in enumerate(item["embedding"]):
[agent:result]         row[f"embedding_{i}"] = [val]
[agent:result]     feature_data.append(row)
[agent:result] 
[agent:result] # Insert data into the feature group
[agent:result] print("Inserting data into feature group...")
[agent:result] fg.insert(feature_data, write_options={"wait_for_job": True})
[agent:result] print("Data inserted successfully")
[agent:result] 
[agent:result] # Now read queries.csv
[agent:result] print("\nReading queries.csv...")
[agent:result] queries = []
[agent:result] with open("data/queries.csv", "r") as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         queries.append({
[agent:result]             "query_id": row["query_id"],
[agent:result]             "embedding": json.loads(row["embedding"])
[agent:result]         })
[agent:result] 
[agent:result] print(f"Loaded {len(queries)} queries")
[agent:result] 
[agent:result] # Perform similarity search for each query using find_neighbors
[agent:result] print("\nPerforming similarity search...")
[agent:result] neighbors = {}
[agent:result] 
[agent:result] for query in queries:
[agent:result]     query_id = query["query_id"]
[agent:result]     query_embedding = query["embedding"]
[agent:result]     
[agent:result]     print(f"Processing query {query_id}...")
[agent:result]     
[agent:result]     try:
[agent:result]         # Perform similarity search
[agent:result]         # The find_neighbors method expects a list of floats
