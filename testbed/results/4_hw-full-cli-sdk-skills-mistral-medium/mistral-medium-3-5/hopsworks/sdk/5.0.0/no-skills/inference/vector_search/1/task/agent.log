[agent:result] emb_index = hsfs_embedding.EmbeddingIndex(
[agent:result]     index_name=store_name,
[agent:result]     features=[emb_feature],
[agent:result]     col_prefix=""
[agent:result] )
[agent:result] 
[agent:result] # Get or create the feature group with primary key and embedding index
[agent:result] fg = fs.get_or_create_feature_group(
[agent:result]     name=store_name,
[agent:result]     version=1,
[agent:result]     description="Vector store for items with embeddings",
[agent:result]     online_enabled=True,
[agent:result]     statistics_config=False,
[agent:result]     primary_key=["item_id"],
[agent:result]     embedding_index=emb_index
[agent:result] )
[agent:result] print(f"Feature group: {fg.name}")
[agent:result] 
