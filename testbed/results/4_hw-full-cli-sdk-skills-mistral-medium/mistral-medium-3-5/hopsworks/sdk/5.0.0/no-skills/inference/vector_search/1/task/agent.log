[agent:result] 
[agent:result] # Name for our vector store
[agent:result] store_name = "itemsb84082"
[agent:result] 
[agent:result] # Get or create the feature group
[agent:result] fg = fs.get_or_create_feature_group(
[agent:result]     name=store_name,
[agent:result]     version=1,
[agent:result]     description="Vector store for items with embeddings",
[agent:result]     online_enabled=True,
[agent:result]     statistics_config=False,
[agent:result]     event_time_computation_mode="none"
[agent:result] )
[agent:result] print(f"Feature group: {fg.name}")
[agent:result] 
[agent:result] # Read items.csv and load into the feature group
