[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Load item embeddings into Hopsworks vector store and perform similarity search.
[agent:result] """
[agent:result] import json
[agent:result] import time
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] import hopsworks
[agent:result] from hopsworks.hsfs import embedding as hsfs_embedding
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] hopsworks.login()
[agent:result] 
[agent:result] # Get the project
[agent:result] project = hopsworks.project.Project()
[agent:result] 
[agent:result] # Create or get the feature store
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Name for our vector store
[agent:result] store_name = "itemsb84082"
[agent:result] 
[agent:result] # Create embedding feature
[agent:result] emb_feature = hsfs_embedding.EmbeddingFeature(
[agent:result]     name="embedding",
[agent:result]     dimension=16,
[agent:result]     similarity_function_type=hsfs_embedding.SimilarityFunctionType.L2
[agent:result] )
[agent:result] 
[agent:result] # Create embedding index
[agent:result] emb_index = hsfs_embedding.EmbeddingIndex(
[agent:result]     index_name=store_name,
[agent:result]     features=[emb_feature],
[agent:result]     col_prefix=""
[agent:result] )
[agent:result] 
[agent:result] # Get or create the feature group with primary key and embedding index
[agent:result] fg = fs.get_or_create_feature_group(
[agent:result]     name=store_name,
[agent:result]     version=1,
[agent:result]     description="Vector store for items with embeddings",
[agent:result]     online_enabled=True,
[agent:result]     statistics_config=False,
[agent:result]     primary_key=["item_id"],
[agent:result]     embedding_index=emb_index
[agent:result] )
[agent:result] print(f"Feature group: {fg.name}")
[agent:result] 
[agent:result] # Read items.csv
[agent:result] print("\nReading items.csv...")
[agent:result] items_df = pd.read_csv("data/items.csv")
[agent:result] 
[agent:result] # Parse the embedding JSON strings into numpy float32 arrays
[agent:result] print("Parsing embeddings...")
[agent:result] items_df['embedding'] = items_df['embedding'].apply(lambda x: np.array(json.loads(x), dtype=np.float32))
[agent:result] 
[agent:result] print(f"DataFrame shape: {items_df.shape}")
[agent:result] 
[agent:result] # Insert data into the feature group
[agent:result] print("Inserting data into feature group...")
[agent:result] fg.insert(items_df, write_options={"wait_for_job": True})
[agent:result] print("Data inserted successfully")
[agent:result] 
[agent:result] # Wait for the index to be built
[agent:result] print("\nWaiting for vector index to be built...")
[agent:result] time.sleep(30)  # Wait 30 seconds for the index to be built
[agent:result] 
[agent:result] # Now read queries.csv
[agent:result] print("\nReading queries.csv...")
[agent:result] queries_df = pd.read_csv("data/queries.csv")
[agent:result] queries_df['embedding'] = queries_df['embedding'].apply(json.loads)
[agent:result] 
[agent:result] print(f"Loaded {len(queries_df)} queries")
[agent:result] 
[agent:result] # Perform similarity search for each query using find_neighbors
[agent:result] print("\nPerforming similarity search...")
[agent:result] neighbors = {}
[agent:result] 
[agent:result] for _, query_row in queries_df.iterrows():
[agent:result]     query_id = query_row["query_id"]
[agent:result]     query_embedding = query_row["embedding"]
[agent:result]     
[agent:result]     print(f"Processing query {query_id}...")
[agent:result]     
[agent:result]     try:
[agent:result]         # Perform similarity search
[agent:result]         result = fg.find_neighbors(
[agent:result]             embedding=list(query_embedding),
[agent:result]             k=5
[agent:result]         )
[agent:result]         
[agent:result]         # Extract item_ids from the result
[agent:result]         # Result is a list of tuples: (distance, row_data)
[agent:result]         # where row_data is a list: [item_id, embedding, label]
[agent:result]         item_ids = []
[agent:result]         for distance, row_data in result:
[agent:result]             if isinstance(row_data, list) and len(row_data) > 0:
[agent:result]                 item_ids.append(row_data[0])
[agent:result]             elif isinstance(row_data, dict) and 'item_id' in row_data:
[agent:result]                 item_ids.append(row_data['item_id'])
[agent:result]             else:
[agent:result]                 print(f"Warning: unexpected row_data format: {type(row_data)}, {row_data}")
[agent:result]         
[agent:result]         neighbors[query_id] = item_ids
[agent:result]         print(f"  Found {len(item_ids)} neighbors: {item_ids}")
[agent:result]         
[agent:result]     except Exception as e:
[agent:result]         print(f"Error processing query {query_id}: {e}")
[agent:result]         import traceback
[agent:result]         traceback.print_exc()
[agent:result]         neighbors[query_id] = []
[agent:result] 
[agent:result] # Write the results
[agent:result] output = {
[agent:result]     "store": store_name,
[agent:result]     "neighbors": neighbors
[agent:result] }
[agent:result] 
[agent:result] print("\nWriting results to submission/answers.json...")
[agent:result] with open("submission/answers.json", "w") as f:
[agent:result]     json.dump(output, f, indent=2)
[agent:result] 
[agent:result] print("Done!")
