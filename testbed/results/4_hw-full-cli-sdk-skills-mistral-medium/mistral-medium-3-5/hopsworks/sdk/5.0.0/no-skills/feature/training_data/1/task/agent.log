[agent:result]     if len(profiles[prof_mask]) > 0:
[agent:result]         prof_recent = profiles[prof_mask].sort_values('event_time', ascending=False).iloc[0]
[agent:result]         credit_score = prof_recent['credit_score']
[agent:result]         tier = prof_recent['tier']
[agent:result]     else:
[agent:result]         credit_score = None
[agent:result]         tier = None
[agent:result]     
[agent:result]     # Get most recent activity for this account at or before label_time
[agent:result]     act_mask = (activity['account_id'] == account_id) & (activity['event_time'] <= label_time)
[agent:result]     if len(activity[act_mask]) > 0:
[agent:result]         act_recent = activity[act_mask].sort_values('event_time', ascending=False).iloc[0]
[agent:result]         sessions_7d = act_recent['sessions_7d']
[agent:result]     else:
