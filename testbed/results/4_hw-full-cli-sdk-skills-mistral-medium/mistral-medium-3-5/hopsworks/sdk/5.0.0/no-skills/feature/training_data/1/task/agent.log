[agent:result] account_health = pd.read_csv('data/account_health.csv')
[agent:result] 
[agent:result] # Combine transactions and transactions_late
[agent:result] all_transactions = pd.concat([transactions, transactions_late], ignore_index=True)
[agent:result] 
[agent:result] print(f"Labels: {len(labels)} rows")
[agent:result] print(f"Transactions: {len(all_transactions)} rows")
[agent:result] 
[agent:result] # For each label, find the most recent feature values at or before label_time
[agent:result] result_rows = []
[agent:result] 
[agent:result] for idx, label_row in labels.iterrows():
[agent:result]     account_id = label_row['account_id']
[agent:result]     label_time = label_row['label_time']
[agent:result]     churned = label_row['churned']
[agent:result]     
[agent:result]     # Get most recent transaction for this account at or before label_time
[agent:result]     tx_mask = (all_transactions['account_id'] == account_id) & (all_transactions['event_time'] <= label_time)
[agent:result]     if len(all_transactions[tx_mask]) > 0:
[agent:result]         tx_recent = all_transactions[tx_mask].sort_values('event_time', ascending=False).iloc[0]
[agent:result]         amount = tx_recent['amount']
[agent:result]         balance = tx_recent['balance']
[agent:result]     else:
[agent:result]         amount = None
[agent:result]         balance = None
[agent:result]     
[agent:result]     # Get most recent profile for this account at or before label_time
[agent:result]     prof_mask = (profiles['account_id'] == account_id) & (profiles['event_time'] <= label_time)
[agent:result]     if len(profiles[prof_mask]) > 0:
[agent:result]         prof_recent = profiles[prof_mask].sort_values('event_time', ascending=False).iloc[0]
[agent:result]         credit_score = prof_recent['credit_score']
[agent:result]         tier = prof_recent['tier']
[agent:result]     else:
[agent:result]         credit_score = None
[agent:result]         tier = None
[agent:result]     
[agent:result]     # Get most recent activity for this account at or before label_time
[agent:result]     act_mask = (activity['account_id'] == account_id) & (activity['event_time'] <= label_time)
[agent:result]     if len(activity[act_mask]) > 0:
[agent:result]         act_recent = activity[act_mask].sort_values('event_time', ascending=False).iloc[0]
[agent:result]         sessions_7d = act_recent['sessions_7d']
[agent:result]     else:
[agent:result]         sessions_7d = None
[agent:result]     
[agent:result]     # Get most recent account_health for this account at or before label_time
