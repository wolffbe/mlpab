[agent:result]         tx_recent = all_transactions[tx_mask].sort_values('event_time', ascending=False).iloc[0]
[agent:result]         amount = tx_recent['amount']
[agent:result]         balance = tx_recent['balance']
[agent:result]     else:
[agent:result]         amount = None
[agent:result]         balance = None
[agent:result]     
[agent:result]     # Get most recent profile for this account at or before label_time
