[agent:result] content: #!/usr/bin/env python3
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] import hopsworks
[agent:result] import os
[agent:result] 
[agent:result] # Suppress warnings
[agent:result] os.environ['PYTHONWARNINGS'] = 'ignore'
[agent:result] import warnings
[agent:result] warnings.filterwarnings('ignore')
[agent:result] 
[agent:result] # Load data
[agent:result] print("Loading data...")
[agent:result] interactions = pd.read_csv('data/interactions.csv')
[agent:result] user_embeddings = pd.read_csv('data/user_embeddings.csv')
[agent:result] item_embeddings = pd.read_csv('data/item_embeddings.csv')
[agent:result] 
[agent:result] print(f"Users: {len(user_embeddings)}, Items: {len(item_embeddings)}, Interactions: {len(interactions)}")
[agent:result] 
[agent:result] # Get user and item IDs
[agent:result] user_ids = user_embeddings['user_id'].tolist()
[agent:result] item_ids = item_embeddings['item_id'].tolist()
[agent:result] 
[agent:result] # Extract embeddings as numpy arrays
[agent:result] user_embs = user_embeddings.iloc[:, 1:].values  # Skip user_id column
[agent:result] item_embs = item_embeddings.iloc[:, 1:].values  # Skip item_id column
[agent:result] 
[agent:result] print(f"User embeddings shape: {user_embs.shape}, Item embeddings shape: {item_embs.shape}")
[agent:result] 
[agent:result] # Compute dot products: for each user, compute dot product with all items
[agent:result] # Result: matrix of shape (num_users, num_items)
[agent:result] dot_products = np.dot(user_embs, item_embs.T)
[agent:result] 
[agent:result] print(f"Dot products shape: {dot_products.shape}")
[agent:result] 
[agent:result] # Build a lookup for user interactions
[agent:result] # Create a dict: user_id -> set of item_ids they've interacted with
[agent:result] user_interactions = {}
[agent:result] for _, row in interactions.iterrows():
[agent:result]     user_id = row['user_id']
[agent:result]     item_id = row['item_id']
[agent:result]     if user_id not in user_interactions:
[agent:result]         user_interactions[user_id] = set()
[agent:result]     user_interactions[user_id].add(item_id)
[agent:result] 
[agent:result] print(f"User interactions: {len(user_interactions)} users with interactions")
[agent:result] 
[agent:result] # For each user, get top-5 recommendations
[agent:result] recommendations = []
[agent:result] 
[agent:result] for i, user_id in enumerate(user_ids):
[agent:result]     # Get this user's dot products with all items
[agent:result]     user_dots = dot_products[i]
[agent:result]     
[agent:result]     # Get items this user has already interacted with
[agent:result]     interacted_items = user_interactions.get(user_id, set())
[agent:result]     
[agent:result]     # Create a list of (item_id, score) pairs, excluding interacted items
[agent:result]     candidates = []
[agent:result]     for j, item_id in enumerate(item_ids):
[agent:result]         if item_id not in interacted_items:
[agent:result]             candidates.append((item_id, user_dots[j]))
[agent:result]     
[agent:result]     # Sort by score descending, then by item_id ascending for ties
[agent:result]     candidates.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     top5 = candidates[:5]
[agent:result]     
[agent:result]     # Add to recommendations
[agent:result]     for rank, (item_id, score) in enumerate(top5, 1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             'rec_id': rec_id,
[agent:result]             'user_id': user_id,
[agent:result]             'rank': rank,
[agent:result]             'item_id': item_id
[agent:result]         })
[agent:result] 
[agent:result] print(f"Total recommendations: {len(recommendations)}")
[agent:result] 
[agent:result] # Create DataFrame
[agent:result] rec_df = pd.DataFrame(recommendations)
