[agent:result] history_df["pm25_rolling_7"] = history_df["pm25"].rolling(window=7, min_periods=1).mean()
[agent:result] history_df["temp_rolling_3"] = history_df["temperature"].rolling(window=3, min_periods=1).mean()
[agent:result] history_df["humidity_rolling_3"] = history_df["humidity"].rolling(window=3, min_periods=1).mean()
[agent:result] 
[agent:result] # Create datetime features
[agent:result] history_df["day_of_week"] = history_df["date"].dt.dayofweek
[agent:result] history_df["day_of_month"] = history_df["date"].dt.day
[agent:result] history_df["month"] = history_df["date"].dt.month
[agent:result] history_df["year"] = history_df["date"].dt.year
[agent:result] 
[agent:result] # Interaction terms
[agent:result] history_df["temp_humidity"] = history_df["temperature"] * history_df["humidity"]
[agent:result] history_df["wind_pressure"] = history_df["wind_speed"] * history_df["pressure"]
[agent:result] 
