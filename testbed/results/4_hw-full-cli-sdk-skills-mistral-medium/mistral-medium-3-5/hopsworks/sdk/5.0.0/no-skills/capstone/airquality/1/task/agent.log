[agent:result] """
[agent:result] Full FTI pipeline for air quality PM2.5 forecasting on Hopsworks platform.
[agent:result] Uses hsfs for feature store and hsml for model registry.
[agent:result] """
[agent:result] import os
[agent:result] import sys
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from datetime import datetime, timedelta
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] import hopsworks
[agent:result] import hsfs
[agent:result] import hsml
[agent:result] 
