[agent:result] bytes_written: 2444
[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Compute top-5 recommendations for each user using dot product of embeddings.
[agent:result] Exclude items the user has already interacted with.
[agent:result] """
[agent:result] 
[agent:result] import csv
[agent:result] import sys
[agent:result] 
[agent:result] # Read interactions
[agent:result] interactions = {}
[agent:result] with open('Resources/recsys_data/interactions.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         user_id = row['user_id']
[agent:result]         item_id = row['item_id']
[agent:result]         if user_id not in interactions:
[agent:result]             interactions[user_id] = set()
[agent:result]         interactions[user_id].add(item_id)
[agent:result] 
[agent:result] # Read user embeddings
[agent:result] user_embeddings = {}
[agent:result] with open('Resources/recsys_data/user_embeddings.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         user_id = row['user_id']
[agent:result]         embedding = [float(row[f'e{i}']) for i in range(1, 9)]
[agent:result]         user_embeddings[user_id] = embedding
[agent:result] 
[agent:result] # Read item embeddings
[agent:result] item_embeddings = {}
[agent:result] with open('Resources/recsys_data/item_embeddings.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         item_id = row['item_id']
[agent:result]         embedding = [float(row[f'e{i}']) for i in range(1, 9)]
[agent:result]         item_embeddings[item_id] = embedding
[agent:result] 
[agent:result] # Compute recommendations
[agent:result] recommendations = []
[agent:result] 
[agent:result] for user_id in sorted(user_embeddings.keys()):
[agent:result]     user_emb = user_embeddings[user_id]
[agent:result]     user_interacted = interactions.get(user_id, set())
[agent:result]     
[agent:result]     # Compute dot product for all items not interacted with
[agent:result]     scores = []
[agent:result]     for item_id in item_embeddings:
[agent:result]         if item_id in user_interacted:
[agent:result]             continue
[agent:result]         item_emb = item_embeddings[item_id]
[agent:result]         dot_product = sum(u * i for u, i in zip(user_emb, item_emb))
[agent:result]         scores.append((dot_product, item_id))
[agent:result]     
[agent:result]     # Sort by score descending, then by item_id ascending for ties
[agent:result]     scores.sort(key=lambda x: (-x[0], x[1]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     top5 = scores[:5]
[agent:result]     
[agent:result]     for rank, (score, item_id) in enumerate(top5, 1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             'rec_id': rec_id,
[agent:result]             'user_id': user_id,
[agent:result]             'rank': rank,
[agent:result]             'item_id': item_id
[agent:result]         })
[agent:result] 
[agent:result] # Write output CSV
[agent:result] with open('Resources/recsys_data/recommendations.csv', 'w', newline='') as f:
[agent:result]     fieldnames = ['rec_id', 'user_id', 'rank', 'item_id']
[agent:result]     writer = csv.DictWriter(f, fieldnames=fieldnames)
[agent:result]     writer.writeheader()
[agent:result]     for rec in recommendations:
[agent:result]         writer.writerow(rec)
[agent:result] 
[agent:result] print(f"Computed {len(recommendations)} recommendations")
