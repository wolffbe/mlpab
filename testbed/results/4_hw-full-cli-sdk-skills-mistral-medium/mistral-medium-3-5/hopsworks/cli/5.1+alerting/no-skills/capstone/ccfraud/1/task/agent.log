[agent:result] model = joblib.load(model_path)
[agent:result] print(f"Model loaded from {model_path}")
[agent:result] 
[agent:result] # Read score transactions
[agent:result] df_score = pd.read_csv("/hopsfs/Resources/score_transactions.csv")
[agent:result] print(f"Score transactions shape: {df_score.shape}")
[agent:result] 
[agent:result] # Feature engineering for score transactions
[agent:result] # We need to apply the same feature engineering as for the training data
[agent:result] 
[agent:result] # 1. Parse datetime
[agent:result] df_score['datetime'] = pd.to_datetime(df_score['datetime'])
[agent:result] df_score['datetime'] = df_score['datetime'].astype('int64') // 10**6  # Convert to milliseconds
[agent:result] 
[agent:result] # 2. Calculate time-based features
[agent:result] df_score['hour_of_day'] = pd.to_datetime(df_score['datetime'] * 10**6).dt.hour
[agent:result] df_score['day_of_week'] = pd.to_datetime(df_score['datetime'] * 10**6).dt.dayofweek
[agent:result] df_score['day_of_month'] = pd.to_datetime(df_score['datetime'] * 10**6).dt.day
[agent:result] 
[agent:result] # 3. Calculate transaction velocity per card
[agent:result] score_card_transactions = df_score.groupby('cc_num')
[agent:result] 
[agent:result] def calculate_velocity(group):
[agent:result]     group = group.sort_values('datetime')
[agent:result]     group['time_since_last_txn'] = group['datetime'].diff() / 3600000  # in hours (datetime is in ms)
[agent:result]     group['txn_velocity'] = 1.0 / (group['time_since_last_txn'] + 1e-6)
[agent:result]     return group
[agent:result] 
[agent:result] df_score = score_card_transactions.apply(calculate_velocity).reset_index(drop=True)
[agent:result] 
[agent:result] # 4. Calculate card's usual location from training data (we need to get this from the feature group)
[agent:result] # Read the training feature group to get card statistics
[agent:result] fg = fs.get_feature_group("cctxnee3558", version=1)
[agent:result] df_train = fg.read()
[agent:result] 
[agent:result] # Get card's usual location
[agent:result] card_locations = df_train.groupby('cc_num')[['lat', 'long']].mean().reset_index()
[agent:result] card_locations = card_locations.rename(columns={'lat': 'card_mean_lat', 'long': 'card_mean_long'})
[agent:result] df_score = df_score.merge(card_locations, on='cc_num', how='left')
[agent:result] 
[agent:result] # 5. Calculate geo distance from usual location
[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     from math import radians, sin, cos, sqrt, atan2
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])
[agent:result]     dlat = lat2 - lat1
[agent:result]     dlon = lon2 - lon1
[agent:result]     a = sin(dlat/2)**2 + cos(lat1) * cos(lat2) * sin(dlon/2)**2
[agent:result]     c = 2 * atan2(sqrt(a), sqrt(1-a))
[agent:result]     return R * c
[agent:result] 
[agent:result] def calc_distance(row):
[agent:result]     if pd.isna(row['card_mean_lat']) or pd.isna(row['card_mean_long']):
[agent:result]         return 0.0
[agent:result]     return haversine(row['lat'], row['long'], row['card_mean_lat'], row['card_mean_long'])
[agent:result] 
[agent:result] df_score['geo_distance_from_usual_km'] = df_score.apply(calc_distance, axis=1)
[agent:result] 
[agent:result] # 6. Calculate amount features using training data statistics
[agent:result] card_amount_mean = df_train.groupby('cc_num')['amount'].mean().to_dict()
[agent:result] df_score['rolling_amount_mean_5'] = np.nan
[agent:result] df_score['rolling_amount_std_5'] = np.nan
[agent:result] df_score['amount_ratio_to_avg'] = df_score.apply(
[agent:result]     lambda row: row['amount'] / card_amount_mean.get(row['cc_num'], row['amount']),
[agent:result]     axis=1
[agent:result] )
[agent:result] 
[agent:result] # 7. Category and merchant encoding from training
[agent:result] category_counts = df_train['category'].value_counts(normalize=True).to_dict()
[agent:result] merchant_counts = df_train['merchant'].value_counts(normalize=True).to_dict()
[agent:result] 
[agent:result] df_score['category_freq'] = df_score['category'].map(category_counts)
[agent:result] df_score['merchant_freq'] = df_score['merchant'].map(merchant_counts)
[agent:result] 
[agent:result] # 8. Time since first transaction for the card (from training)
[agent:result] card_first_txn = df_train.groupby('cc_num')['datetime'].min().to_dict()
[agent:result] df_score['card_first_txn_time'] = df_score['cc_num'].map(card_first_txn)
[agent:result] df_score['time_since_card_first_txn_hours'] = (df_score['datetime'] - df_score['card_first_txn_time']) / 3600000  # Convert ms to hours
[agent:result] 
[agent:result] # For cards not in training, use the score transaction time as first txn
[agent:result] df_score['card_first_txn_time'] = df_score['card_first_txn_time'].fillna(df_score['datetime'])
[agent:result] df_score['time_since_card_first_txn_hours'] = df_score['time_since_card_first_txn_hours'].fillna(0.0)
[agent:result] 
[agent:result] # 9. Transaction count per card up to this point
[agent:result] df_score['card_txn_count'] = df_score.groupby('cc_num').cumcount() + 1
[agent:result] 
