[agent:result]     'amount_ratio_to_avg',
[agent:result]     'category_freq',
[agent:result]     'merchant_freq',
[agent:result]     'time_since_card_first_txn_hours',
[agent:result]     'card_txn_count'
[agent:result] ]
[agent:result] 
[agent:result] X_score = df_score[feature_columns].copy()
[agent:result] 
