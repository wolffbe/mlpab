[agent:result] local_path_score = "score_transactions.csv"
[agent:result] fs.get_file("Resources/score_transactions.csv", local_path_score)
[agent:result] 
[agent:result] # Read data
[agent:result] df = pd.read_csv(local_path_transactions)
[agent:result] df_score = pd.read_csv(local_path_score)
[agent:result] 
[agent:result] print(f"Transactions shape: {df.shape}")
[agent:result] print(f"Score transactions shape: {df_score.shape}")
[agent:result] 
[agent:result] # Feature Engineering
[agent:result] 
[agent:result] # 1. Parse datetime
[agent:result] df['datetime'] = pd.to_datetime(df['datetime'])
[agent:result] df_score['datetime'] = pd.to_datetime(df_score['datetime'])
[agent:result] 
[agent:result] # 2. Calculate time-based features
[agent:result] df['hour_of_day'] = df['datetime'].dt.hour
[agent:result] df['day_of_week'] = df['datetime'].dt.dayofweek
[agent:result] df['day_of_month'] = df['datetime'].dt.day
[agent:result] 
[agent:result] df_score['hour_of_day'] = df_score['datetime'].dt.hour
[agent:result] df_score['day_of_week'] = df_score['datetime'].dt.dayofweek
[agent:result] df_score['day_of_month'] = df_score['datetime'].dt.day
[agent:result] 
[agent:result] # 3. Calculate transaction velocity per card (transactions per hour)
[agent:result] # For each card, calculate time between consecutive transactions
[agent:result] card_transactions = df.groupby('cc_num')
[agent:result] 
[agent:result] def calculate_velocity(group):
[agent:result]     group = group.sort_values('datetime')
[agent:result]     group['time_since_last_txn'] = group['datetime'].diff().dt.total_seconds() / 3600  # in hours
[agent:result]     group['txn_velocity'] = 1.0 / (group['time_since_last_txn'] + 1e-6)  # transactions per hour
[agent:result]     return group
[agent:result] 
[agent:result] df = card_transactions.apply(calculate_velocity).reset_index(drop=True)
[agent:result] 
[agent:result] # For score data
[agent:result] score_card_transactions = df_score.groupby('cc_num')
[agent:result] score_df_temp = score_card_transactions.apply(calculate_velocity).reset_index(drop=True)
[agent:result] df_score = score_df_temp
[agent:result] 
[agent:result] # 4. Calculate card's usual location (mean lat/long per card) from training data
[agent:result] card_locations = df.groupby('cc_num')[['lat', 'long']].mean().reset_index()
[agent:result] card_locations = card_locations.rename(columns={'lat': 'card_mean_lat', 'long': 'card_mean_long'})
[agent:result] 
[agent:result] # Merge back to get usual location for each transaction
[agent:result] df = df.merge(card_locations, on='cc_num', how='left')
[agent:result] df_score = df_score.merge(card_locations, on='cc_num', how='left')
[agent:result] 
[agent:result] # 5. Calculate geo distance from usual location (in km)
[agent:result] # Simple haversine formula
[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     from math import radians, sin, cos, sqrt, atan2
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])
[agent:result]     dlat = lat2 - lat1
[agent:result]     dlon = lon2 - lon1
[agent:result]     a = sin(dlat/2)**2 + cos(lat1) * cos(lat2) * sin(dlon/2)**2
[agent:result]     c = 2 * atan2(sqrt(a), sqrt(1-a))
[agent:result]     return R * c
[agent:result] 
[agent:result] def calc_distance(row):
[agent:result]     if pd.isna(row['card_mean_lat']) or pd.isna(row['card_mean_long']):
[agent:result]         return 0.0
[agent:result]     return haversine(row['lat'], row['long'], row['card_mean_lat'], row['card_mean_long'])
[agent:result] 
[agent:result] df['geo_distance_from_usual_km'] = df.apply(calc_distance, axis=1)
[agent:result] df_score['geo_distance_from_usual_km'] = df_score.apply(calc_distance, axis=1)
[agent:result] 
[agent:result] # 6. Calculate amount features
[agent:result] # Rolling mean of transaction amounts per card
[agent:result] df['rolling_amount_mean_5'] = card_transactions['amount'].transform(
[agent:result]     lambda x: x.rolling(5, min_periods=1).mean()
[agent:result] )
[agent:result] df['rolling_amount_std_5'] = card_transactions['amount'].transform(
[agent:result]     lambda x: x.rolling(5, min_periods=1).std()
[agent:result] )
[agent:result] 
[agent:result] # For score data, use card-level statistics from training
[agent:result] df_score['rolling_amount_mean_5'] = np.nan
[agent:result] df_score['rolling_amount_std_5'] = np.nan
[agent:result] 
[agent:result] # Amount relative to card's average
[agent:result] df['amount_ratio_to_avg'] = df['amount'] / df.groupby('cc_num')['amount'].transform('mean')
[agent:result] 
[agent:result] # For score, use training data statistics
[agent:result] card_amount_mean = df.groupby('cc_num')['amount'].mean().to_dict()
[agent:result] df_score['amount_ratio_to_avg'] = df_score.apply(
[agent:result]     lambda row: row['amount'] / card_amount_mean.get(row['cc_num'], row['amount']),
[agent:result]     axis=1
[agent:result] )
[agent:result] 
[agent:result] # 7. Category and merchant encoding (simple frequency encoding)
[agent:result] category_counts = df['category'].value_counts(normalize=True).to_dict()
[agent:result] merchant_counts = df['merchant'].value_counts(normalize=True).to_dict()
[agent:result] 
[agent:result] df['category_freq'] = df['category'].map(category_counts)
[agent:result] df['merchant_freq'] = df['merchant'].map(merchant_counts)
[agent:result] 
[agent:result] df_score['category_freq'] = df_score['category'].map(category_counts)
[agent:result] df_score['merchant_freq'] = df_score['merchant'].map(merchant_counts)
[agent:result] 
[agent:result] # 8. Time since first transaction for the card
[agent:result] df['card_first_txn_time'] = df.groupby('cc_num')['datetime'].transform('min')
[agent:result] df['time_since_card_first_txn_hours'] = (df['datetime'] - df['card_first_txn_time']).dt.total_seconds() / 3600
[agent:result] 
[agent:result] # For score data
[agent:result] card_first_txn = df.groupby('cc_num')['datetime'].min().to_dict()
[agent:result] df_score['card_first_txn_time'] = df_score['cc_num'].map(card_first_txn)
[agent:result] df_score['time_since_card_first_txn_hours'] = (df_score['datetime'] - df_score['card_first_txn_time']).dt.total_seconds() / 3600
[agent:result] 
[agent:result] # For cards not in training, use the score transaction time as first txn
[agent:result] df_score['card_first_txn_time'] = df_score['card_first_txn_time'].fillna(df_score['datetime'])
[agent:result] df_score['time_since_card_first_txn_hours'] = df_score['time_since_card_first_txn_hours'].fillna(0.0)
[agent:result] 
[agent:result] # 9. Transaction count per card up to this point
[agent:result] df['card_txn_count'] = df.groupby('cc_num').cumcount() + 1
[agent:result] df_score['card_txn_count'] = df_score.groupby('cc_num').cumcount() + 1
[agent:result] 
[agent:result] # Select features for the feature group
[agent:result] feature_columns = [
[agent:result]     'transaction_id',
[agent:result]     'cc_num',
[agent:result]     'datetime',
[agent:result]     'amount',
[agent:result]     'hour_of_day',
[agent:result]     'day_of_week',
[agent:result]     'day_of_month',
[agent:result]     'txn_velocity',
[agent:result]     'geo_distance_from_usual_km',
[agent:result]     'rolling_amount_mean_5',
[agent:result]     'rolling_amount_std_5',
[agent:result]     'amount_ratio_to_avg',
