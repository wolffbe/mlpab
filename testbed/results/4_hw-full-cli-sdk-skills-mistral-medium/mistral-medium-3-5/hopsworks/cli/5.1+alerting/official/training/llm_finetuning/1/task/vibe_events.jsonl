{"role": "tool", "content": "file_path: /Users/wolffbe/workspace/banter/testbed/results/4_hw-full-cli-sdk-skills-mistral-medium/mistral-medium-3-5/hopsworks/cli/5.1+alerting/official/training/llm_finetuning/1/task/data/finetune_model.py\ncontent:         1→\"\"\"Provided fine-tuning script — deterministic LoRA-style adapter update.\n        2→\n        3→Reads base_model.npz (bigram logits + vocab), finetune.txt and eval.txt from\n        4→its working directory. The base logits stay FROZEN; only a rank-4 additive\n        5→adapter delta = A @ B is trained by plain full-batch gradient descent\n        6→(learning rate 2.0, exactly 400 iterations; B initialized to zero so the\n        7→adapter delta starts at zero, A to a fixed 0.5-scaled tiled identity).\n        8→Writes finetuned_model.npz and metrics.json with the fine-tuned and unadapted\n        9→cross-entropy on eval.txt (both rounded to 4 decimals). Fully deterministic —\n       10→do NOT modify it; run it as-is.\n       11→\"\"\"\n       12→import json\n       13→\n       14→import numpy as np\n       15→\n       16→RANK = 4\n       17→LEARNING_RATE = 2.0\n       18→ITERATIONS = 400\n       19→ADAPTER_SCALE = 0.5\n       20→\n       21→\n       22→def bigram_counts(text, vocab):\n       23→    index = {ch: i for i, ch in enumerate(vocab)}\n       24→    idx = np.array([index[ch] for ch in text], dtype=int)\n       25→    counts = np.zeros((len(vocab), len(vocab)), dtype=float)\n       26→    np.add.at(counts, (idx[:-1], idx[1:]), 1.0)\n       27→    return counts\n       28→\n       29→\n       30→def cross_entropy(logits, counts):\n       31→    logp = logits - logits.max(axis=1, keepdims=True)\n       32→    logp = logp - np.log(np.exp(logp).sum(axis=1, keepdims=True))\n       33→    return -(counts * logp).sum() / counts.sum()\n       34→\n       35→\n       36→def main():\n       37→    ckpt = np.load(\"base_model.npz\")\n       38→    base_logits = ckpt[\"logits\"].astype(float)\n       39→    vocab = [str(ch) for ch in ckpt[\"vocab\"]]\n       40→    ft_counts = bigram_counts(open(\"finetune.txt\").read(), vocab)\n       41→    eval_counts = bigram_counts(open(\"eval.txt\").read(), vocab)\n       42→\n       43→    n_vocab = base_logits.shape[0]\n       44→    A = np.zeros((n_vocab, RANK), dtype=float)\n       45→    for i in range(n_vocab):\n       46→        A[i, i % RANK] = ADAPTER_SCALE\n       47→    B = np.zeros((RANK, n_vocab), dtype=float)\n       48→    n = ft_counts.sum()\n       49→    row_totals = ft_counts.sum(axis=1, keepdims=True)\n       50→    for _ in range(ITERATIONS):\n       51→        logits = base_logits + A @ B\n       52→        e = np.exp(logits - logits.max(axis=1, keepdims=True))\n       53→        p = e / e.sum(axis=1, keepdims=True)\n       54→        g = (row_totals * p - ft_counts) / n\n       55→        A, B = A - LEARNING_RATE * (g @ B.T), B - LEARNING_RATE * (A.T @ g)\n       56→\n       57→    np.savez(\"finetuned_model.npz\", logits=base_logits + A @ B,\n       58→             adapter_a=A, adapter_b=B)\n       59→    metrics = {\n       60→        \"eval_loss\": round(float(cross_entropy(base_logits + A @ B, eval_counts)), 4),\n       61→        \"base_eval_loss\": round(float(cross_entropy(base_logits, eval_counts)), 4),\n       62→    }\n       63→    json.dump(metrics, open(\"metrics.json\", \"w\"), indent=2)\n       64→\n       65→\n       66→if __name__ == \"__main__\":\n       67→    main()\nnum_lines: 67\nstart_line: 1\ntotal_lines: 67\nwas_truncated: False", "images": null, "injected": false, "reasoning_content": null, "reasoning_state": null, "reasoning_signature": null, "reasoning_message_id": null, "tool_calls": null, "name": "read", "tool_call_id": "8ZNXkKlMc", "message_id": null}
