{"timestamp": null, "session_id": null, "tool_name": "Write", "category": "write", "tool_input": {"path": "/Users/wolffbe/workspace/banter/testbed/results/4_hw-full-cli-sdk-skills-mistral-medium/mistral-medium-3-5/hopsworks/cli/5.1+alerting/official/feature/incremental_load/1/task/ingest_increment.py", "content": "#!/usr/bin/env python3\n\"\"\"\nJob script to ingest daily increment files into the incremental092284 feature group.\nThis script is designed to be run by a Hopsworks job on a daily schedule.\n\"\"\"\n\nimport hopsworks\nimport os\nimport glob\nimport pandas as pd\nfrom datetime import datetime, timedelta\n\n# Initialize Hopsworks\nproject = hopsworks.login()\nfs = project.get_feature_store()\n\n# Feature group name and version\nFG_NAME = \"incremental092284\"\nFG_VERSION = 1\n\n# Get the feature group\nfg = fs.get_feature_group(FG_NAME, version=FG_VERSION)\n\n# Define the data directory (this would be configured in the job)\n# For the job, we'll use a path that can be passed as an argument\nimport sys\n\ndef find_new_increment_files(data_dir):\n    \"\"\"Find increment files that haven't been processed yet.\"\"\"\n    # List all increment files\n    increment_files = sorted(glob.glob(os.path.join(data_dir, \"increment_*.csv\")))\n    return increment_files\n\ndef main():\n    # Get data directory from arguments or use default\n    if len(sys.argv) > 1:\n        data_dir = sys.argv[1]\n    else:\n        data_dir = \"/srv/data\"  # Default path\n    \n    print(f\"Looking for increment files in: {data_dir}\")\n    \n    # Find all increment files\n    increment_files = find_new_increment_files(data_dir)\n    \n    if not increment_files:\n        print(\"No increment files found to process.\")\n        return\n    \n    print(f\"Found {len(increment_files)} increment files to process\")\n    \n    # Process each file\n    for file_path in increment_files:\n        print(f\"Processing {file_path}\")\n        \n        # Read the CSV file\n        df = pd.read_csv(file_path)\n        \n        # Insert into feature group\n        fg.insert(df)\n        print(f\"Inserted {len(df)} rows from {file_path}\")\n    \n    print(\"All increment files processed successfully.\")\n\nif __name__ == \"__main__\":\n    main()\n"}}
