[agent:result] def haversine_distance(lat1, lon1, lat2, lon2):
[agent:result]     R = 6371
[agent:result]     lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])
[agent:result]     dlat = lat2 - lat1
[agent:result]     dlon = lon2 - lon1
[agent:result]     a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
[agent:result]     c = 2 * np.arcsin(np.sqrt(a))
[agent:result]     return R * c
[agent:result] 
[agent:result] def engineer_features(df):
[agent:result]     df['datetime'] = pd.to_datetime(df['datetime'])
[agent:result]     df = df.sort_values(['cc_num', 'datetime'])
[agent:result]     
[agent:result]     card_avg = df.groupby('cc_num')['amount'].transform('mean')
[agent:result]     df['amount_rel_to_avg'] = df['amount'] / (card_avg + 1e-6)
[agent:result]     
[agent:result]     card_max = df.groupby('cc_num')['amount'].transform('max')
[agent:result]     df['amount_rel_to_max'] = df['amount'] / (card_max + 1e-6)
[agent:result]     
[agent:result]     df['time_since_last_txn'] = df.groupby('cc_num')['datetime'].diff().dt.total_seconds() / 60
[agent:result]     df['time_since_last_txn'] = df['time_since_last_txn'].fillna(99999)
[agent:result]     
[agent:result]     df['txn_count_1h'] = df.groupby('cc_num').apply(
[agent:result]         lambda x: x['datetime'].rolling('1h', on='datetime').count().values
[agent:result]     ).reset_index(level=0, drop=True)
[agent:result]     df['txn_count_1h'] = df['txn_count_1h'].fillna(0)
[agent:result]     
[agent:result]     df['txn_count_24h'] = df.groupby('cc_num').apply(
[agent:result]         lambda x: x['datetime'].rolling('24h', on='datetime').count().values
[agent:result]     ).reset_index(level=0, drop=True)
[agent:result]     df['txn_count_24h'] = df['txn_count_24h'].fillna(0)
[agent:result]     
[agent:result]     df['amount_24h'] = df.groupby('cc_num').apply(
[agent:result]         lambda x: x['amount'].rolling('24h', on='datetime').sum().values
[agent:result]     ).reset_index(level=0, drop=True)
[agent:result]     df['amount_24h'] = df['amount_24h'].fillna(0)
[agent:result]     
[agent:result]     card_mean_lat = df.groupby('cc_num')['lat'].transform('mean')
[agent:result]     card_mean_lon = df.groupby('cc_num')['long'].transform('mean')
[agent:result]     df['geo_distance_from_mean'] = haversine_distance(
[agent:result]         df['lat'], df['long'], card_mean_lat, card_mean_lon
[agent:result]     )
[agent:result]     
[agent:result]     df['geo_distance_from_prev'] = df.groupby('cc_num').apply(
[agent:result]         lambda x: haversine_distance(
[agent:result]             x['lat'].shift(1), x['long'].shift(1),
[agent:result]             x['lat'], x['long']
[agent:result]         ).values
[agent:result]     ).reset_index(level=0, drop=True)
[agent:result]     df['geo_distance_from_prev'] = df['geo_distance_from_prev'].fillna(0)
[agent:result]     
[agent:result]     df['hour_of_day'] = df['datetime'].dt.hour
[agent:result]     df['day_of_week'] = df['datetime'].dt.dayofweek
[agent:result]     df['is_weekend'] = (df['day_of_week'] >= 5).astype(int)
[agent:result]     
[agent:result]     cat_counts = df['category'].value_counts(normalize=True)
[agent:result]     df['category_freq'] = df['category'].map(cat_counts).fillna(0)
[agent:result]     
[agent:result]     merchant_counts = df['merchant'].value_counts(normalize=True)
[agent:result]     df['merchant_freq'] = df['merchant'].map(merchant_counts).fillna(0)
[agent:result]     
[agent:result]     card_std = df.groupby('cc_num')['amount'].transform('std')
[agent:result]     df['amount_std'] = card_std.fillna(0)
[agent:result]     df['amount_zscore'] = (df['amount'] - card_avg) / (card_std + 1e-6)
[agent:result]     df['amount_zscore'] = df['amount_zscore'].fillna(0)
[agent:result]     
[agent:result]     return df
