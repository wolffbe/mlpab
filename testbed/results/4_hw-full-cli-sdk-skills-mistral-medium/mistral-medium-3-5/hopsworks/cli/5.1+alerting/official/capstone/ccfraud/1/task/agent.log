[agent:bash] def haversine_distance(lat1, lon1, lat2, lon2):
[agent:bash]     R = 6371
[agent:bash]     lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])
[agent:bash]     dlat = lat2 - lat1
[agent:bash]     dlon = lon2 - lon1
[agent:bash]     a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
[agent:bash]     c = 2 * np.arcsin(np.sqrt(a))
[agent:bash]     return R * c
