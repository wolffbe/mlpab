# Copy to .env and fill in. `.env` is gitignored and is the source of truth for
# credentials at run time (mlpab loads it and OVERRIDES the shell). Interface
# configs declare key NAMES only (`keys: [HOPSWORKS_API_KEY, ...]`); the values
# resolve from here, never from the YAML.

# --- Agent auth (per engine; the model id picks the engine) ---
MLPAB_AUTH=api-key                 # api-key | login
ANTHROPIC_API_KEY=sk-ant-...        # Claude engine (claude-* models); required when MLPAB_AUTH=api-key
#OPENAI_API_KEY=sk-...              # Codex engine (gpt-*/codex models); or a host `codex login`
#MISTRAL_API_KEY=...                # Mistral Vibe engine (mistral-* models)

# --- Hopsworks (real cluster) ---
HOPSWORKS_HOST=10.0.0.0             # cluster host/IP (no scheme needed)
HOPSWORKS_API_KEY=...               # Hopsworks API key (secret)

# --- Amazon SageMaker (dedicated AWS account/region — teardown sweeps it!) ---
AWS_ACCESS_KEY_ID=...               # secret
AWS_SECRET_ACCESS_KEY=...           # secret
AWS_REGION=us-east-1
# OPTIONAL — normally leave unset: setup.py creates/finds the execution role
# (mlpab-sagemaker-execution-role) each run and exports its ARN into the
# agent's env automatically. Set only to force a pre-provisioned role.
#SAGEMAKER_ROLE_ARN=arn:aws:iam::<account>:role/my-role

# --- Databricks (dedicated workspace — teardown sweeps the token user's resources!) ---
DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=...                # secret — personal access token

# --- Azure ML (dedicated resource group — teardown sweeps it!) ---
# Service principal: DefaultAzureCredential reads the tenant/client/secret triple.
AZURE_TENANT_ID=...                  # service-principal tenant
AZURE_CLIENT_ID=...                  # service-principal app (client) id
AZURE_CLIENT_CERTIFICATE_PATH=.azure/azure-sp.pem  # ABSOLUTE path to PEM cert+key in testbed/.azure/ (gitignored; tenant disallows SP secrets)
AZURE_SUBSCRIPTION_ID=...
AZURE_RESOURCE_GROUP=...             # RG holding the workspace
AZUREML_WORKSPACE_NAME=...           # the Azure ML workspace (pre-provisioned)
AZURE_LOCATION=eastus                # region; setup.py uses it to create the feature store
# OPTIONAL — normally leave unset: setup.py ensures the managed feature store
# (default `mlpabfs`) and exports AZUREML_FEATURE_STORE_NAME into the agent env.
#AZUREML_FEATURE_STORE_NAME=mlpabfs

# --- GCP / Gemini Enterprise Agent Platform (dedicated project — teardown sweeps it!) ---
GCP_PROJECT=...                      # project id
GCP_LOCATION=us-central1             # region
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/sa-key.json  # service-account key file (ADC)
GCP_BQ_DATASET=mlpab                # BigQuery dataset backing the feature store (setup.py ensures it)