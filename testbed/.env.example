# Copy to .env and fill in. `.env` is gitignored and is the source of truth for
# credentials at run time (banter loads it and OVERRIDES the shell). Interface
# configs declare key NAMES only (`keys: [HOPSWORKS_API_KEY, ...]`); the values
# resolve from here, never from the YAML.

# --- Engineer/researcher auth (Claude) ---
BANTER_AUTH=api-key                 # api-key | oauth
ANTHROPIC_API_KEY=sk-ant-...        # required when BANTER_AUTH=api-key

# --- mlkit fake-AutoML smoke project ---
# Fixed, non-secret test key — `mlkit login` 401s if empty. Keep as "mlkit" so
# `banter test platforms/mlkit/*` works on a fresh checkout.
MLKIT_API_KEY=mlkit

# --- Hopsworks (real cluster) ---
HOPSWORKS_HOST=10.0.0.0             # cluster host/IP (no scheme needed)
HOPSWORKS_API_KEY=...               # Hopsworks API key (secret)
