fg create requests --primary-key request_id --event-time requested_at --features "request_id:string,account_id:string,request_lat:double,request_lon:double,requested_at:timestamp" --description "Scoring requests"
fg create profiles --primary-key account_id --features "account_id:string,home_lat:double,home_lon:double,base_score:double" --description "Account profiles"
