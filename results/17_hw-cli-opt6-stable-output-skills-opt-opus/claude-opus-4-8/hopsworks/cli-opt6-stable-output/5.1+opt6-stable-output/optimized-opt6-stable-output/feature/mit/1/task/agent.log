[agent] 700 distinct rows, is_weekend ∈ {0,1}. Let me independently verify `amount_7d` with a correlated subquery (different method than the window) to confirm correctness.
[agent:bash] hops sql --catalog delta --schema mlpab6dffb7_featurestore --no-verify --json --limit 0 "
[agent:bash] WITH win AS (
[agent:bash]   SELECT t.row_id, t.account_id, t.event_time, t.amount,
[agent:bash]     SUM(t.amount) OVER (PARTITION BY t.account_id ORDER BY t.event_time RANGE BETWEEN 604800000 PRECEDING AND CURRENT ROW) AS w
[agent:bash]   FROM transactions_raw_1 t
[agent:bash] ),
[agent:bash] sub AS (
[agent:bash]   SELECT a.row_id,
[agent:bash]     (SELECT SUM(b.amount) FROM transactions_raw_1 b
[agent:bash]       WHERE b.account_id=a.account_id AND b.event_time BETWEEN a.event_time-604800000 AND a.event_time) AS s
[agent:bash]   FROM transactions_raw_1 a
[agent:bash] )
[agent:bash] SELECT count(*) AS mismatches
[agent:bash] FROM win JOIN sub USING(row_id)
[agent:bash] WHERE abs(win.w - sub.s) > 0.0001
[agent:bash] " 2>/dev/null | tail -8
[agent:bash] echo "=== cross-check stored table vs recomputed window ==="
[agent:bash] hops sql --catalog delta --schema mlpab6dffb7_featurestore --no-verify --json --limit 0 "
[agent:bash] WITH expect AS (
[agent:bash]   SELECT t.row_id,
[agent:bash]     t.amount*f.fx_rate AS amount_usd,
[agent:bash]     CASE WHEN day_of_week(from_unixtime(t.event_time/1000,'UTC')) IN (6,7) THEN 1 ELSE 0 END AS is_weekend,
[agent:bash]     SUM(t.amount) OVER (PARTITION BY t.account_id ORDER BY t.event_time RANGE BETWEEN 604800000 PRECEDING AND CURRENT ROW) AS amount_7d
[agent:bash]   FROM transactions_raw_1 t JOIN fx_rates_raw_1 f ON t.currency=f.currency
[agent:bash] )
[agent:bash] SELECT count(*) AS bad
[agent:bash] FROM features4018d5_1 g JOIN expect e USING(row_id)
[agent:bash] WHERE abs(g.amount_usd-e.amount_usd)>0.0001 OR g.is_weekend<>e.is_weekend OR abs(g.amount_7d-e.amount_7d)>0.0001
[agent:bash] " 2>/dev/null | tail -8
