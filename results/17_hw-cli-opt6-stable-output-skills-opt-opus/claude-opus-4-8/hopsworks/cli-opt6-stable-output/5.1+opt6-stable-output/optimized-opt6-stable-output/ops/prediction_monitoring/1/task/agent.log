[agent] Project is empty. I'll ingest the prediction log into a feature group, then compute per-day statistics platform-side to locate the shift. Let me write the ingestion script using the SDK.
[agent:bash] mkdir -p submission .tmp; cat > .tmp/ingest.py <<'PY'
[agent:bash] import hopsworks, pandas as pd
[agent:bash] proj = hopsworks.login()
[agent:bash] fs = proj.get_feature_store()
[agent:bash] df = pd.read_csv("data/prediction_log.csv")
[agent:bash] df["ts"] = pd.to_datetime(df["ts"], utc=True)
[agent:bash] df = df.sort_values("ts").reset_index(drop=True)
[agent:bash] df["id"] = df.index.astype("int64")
[agent:bash] df["prediction"] = df["prediction"].astype("double") if hasattr(df["prediction"],"astype") else df["prediction"]
[agent:bash] df["prediction"] = df["prediction"].astype(float)
[agent:bash] print("rows", len(df), "range", df.ts.min(), df.ts.max())
[agent:bash] fg = fs.get_or_create_feature_group(
[agent:bash]     name="prediction_log", version=1,
[agent:bash]     primary_key=["id"], event_time="ts",
[agent:bash]     online_enabled=False,
[agent:bash]     description="Deployed model logged predictions (ts, prediction)",
[agent:bash] )
[agent:bash] fg.insert(df, write_options={"wait_for_job": True})
[agent:bash] print("INSERT_DONE id", fg.id)
