[agent:result] def filter_data():
[agent:result]     """Filter the CSV to only include valid rows and return the filtered data."""
[agent:result]     valid_categories = {'grocery', 'travel', 'salary', 'rent', 'other'}
[agent:result]     valid_rows = []
[agent:result]     rejected_rows = []
[agent:result]     
[agent:result]     with open('data/events.csv', 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             row_id = row['row_id']
[agent:result]             amount_str = row['amount']
[agent:result]             category = row['category']
[agent:result]             
[agent:result]             # Rule 1: amount is present (not null/empty)
[agent:result]             if amount_str.strip() == '':
[agent:result]                 rejected_rows.append(row_id)
[agent:result]                 continue
[agent:result]             
[agent:result]             # Rule 2: amount is within [0, 10000] (inclusive)
[agent:result]             try:
[agent:result]                 amount = float(amount_str)
[agent:result]                 if amount < 0 or amount > 10000:
[agent:result]                     rejected_rows.append(row_id)
[agent:result]                     continue
[agent:result]             except ValueError:
[agent:result]                 rejected_rows.append(row_id)
[agent:result]                 continue
[agent:result]             
[agent:result]             # Rule 3: category is one of the valid ones
[agent:result]             if category not in valid_categories:
[agent:result]                 rejected_rows.append(row_id)
[agent:result]                 continue
[agent:result]             
[agent:result]             # If we get here, the row is valid
[agent:result]             valid_rows.append(row)
[agent:result]     
[agent:result]     return valid_rows, rejected_rows
[agent:result] 
