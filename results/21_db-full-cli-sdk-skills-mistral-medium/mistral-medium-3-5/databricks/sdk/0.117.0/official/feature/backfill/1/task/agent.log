[agent:result] # Upload the CSV files to DBFS so we can read them
[agent:result] # We'll use dbfs:/FileStore/tables/ as a temporary location
[agent:result] import tempfile
[agent:result] import uuid
[agent:result] 
[agent:result] # Create a unique temp directory in DBFS
[agent:result] temp_dbfs_path = f"dbfs:/FileStore/mlpab_temp_{uuid.uuid4().hex[:8]}/"
[agent:result] 
[agent:result] # Upload files to DBFS
[agent:result] for batch_file in ['batch_1.csv', 'batch_2.csv', 'batch_3.csv']:
[agent:result]     local_path = f"data/{batch_file}"
[agent:result]     dbfs_dest = f"{temp_dbfs_path}{batch_file}"
[agent:result]     
[agent:result]     # Read local file
[agent:result]     with open(local_path, 'r') as f:
