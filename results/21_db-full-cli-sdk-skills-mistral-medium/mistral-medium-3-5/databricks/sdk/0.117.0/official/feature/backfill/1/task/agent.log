[agent:result]             all_rows.append(row)
[agent:result]     print(f"  Read {len(all_rows)} rows from {batch_file}")
[agent:result] 
[agent:result] # Step 3: Deduplicate in Python - keep latest updated_at per row_id
[agent:result] print("\nDeduplicating...")
[agent:result] latest_rows = {}
[agent:result] for row in all_rows:
[agent:result]     row_id = row['row_id']
[agent:result]     updated_at = row['updated_at']
[agent:result]     
[agent:result]     if row_id not in latest_rows or updated_at > latest_rows[row_id]['updated_at']:
[agent:result]         latest_rows[row_id] = row
