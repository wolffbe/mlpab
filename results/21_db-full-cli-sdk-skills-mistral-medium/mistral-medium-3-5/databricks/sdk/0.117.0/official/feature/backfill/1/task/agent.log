[agent:result]     
[agent:result]     # Write to DBFS
[agent:result]     w.dbfs.put(dbfs_dest, content.encode('utf-8'), overwrite=True)
[agent:result]     print(f"Uploaded {batch_file} to {dbfs_dest}")
[agent:result] 
[agent:result] # Now create a SQL query that:
[agent:result] # 1. Reads all three CSV files
[agent:result] # 2. Combines them
[agent:result] # 3. For each row_id, keeps only the row with the latest updated_at
[agent:result] 
[agent:result] query = f"""
[agent:result] WITH all_data AS (
[agent:result]   SELECT *, 'batch_1' as source FROM csv.`{temp_dbfs_path}batch_1.csv`
[agent:result]   UNION ALL
[agent:result]   SELECT *, 'batch_2' as source FROM csv.`{temp_dbfs_path}batch_2.csv`
[agent:result]   UNION ALL
[agent:result]   SELECT *, 'batch_3' as source FROM csv.`{temp_dbfs_path}batch_3.csv`
[agent:result] ),
[agent:result] ranked AS (
[agent:result]   SELECT 
[agent:result]     row_id,
[agent:result]     status,
[agent:result]     balance,
[agent:result]     updated_at,
[agent:result]     source,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY updated_at DESC) as rn
[agent:result]   FROM all_data
[agent:result] )
[agent:result] SELECT row_id, status, balance, updated_at
[agent:result] FROM ranked
[agent:result] WHERE rn = 1
[agent:result] """
