[agent:result]     create_feature_table_sql = f"""
[agent:result]     CREATE OR REPLACE TABLE {catalog_name}.{schema_part}.features7ab995 
[agent:result]     COMMENT 'Feature table with computed features' 
[agent:result]     AS
[agent:result]     SELECT 
[agent:result]         row_id,
[agent:result]         account_id,
[agent:result]         event_time,
[agent:result]         amount_usd,
[agent:result]         is_weekend,
[agent:result]         (
[agent:result]             SELECT SUM(amount)
[agent:result]             FROM (
[agent:result]                 {union_sql}
[agent:result]             ) t2
[agent:result]             WHERE t2.account_id_7d = t1.account_id
