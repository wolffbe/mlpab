[agent:result]     
[agent:result]     # Step 3: Create the feature table directly with CTAS using VALUES in a single statement
[agent:result]     print("Creating feature table...")
[agent:result]     
[agent:result]     # Build VALUES clauses for transactions with all needed data
[agent:result]     values_clauses = []
[agent:result]     for t in transactions:
[agent:result]         row_id = t['row_id']
[agent:result]         account_id = t['account_id']
[agent:result]         event_time = t['event_time']
[agent:result]         amount = t['amount']
[agent:result]         currency = t['currency']
[agent:result]         fx_rate = fx_rates[currency]
[agent:result]         
[agent:result]         values_clauses.append(f"('{row_id}', '{account_id}', {event_time}, {amount}, '{currency}', {fx_rate})")
[agent:result]     
[agent:result]     # Split into batches to avoid SQL length limits
[agent:result]     batch_size = 50  # Smaller batch size to be safe
[agent:result]     batches = [values_clauses[i:i + batch_size] for i in range(0, len(values_clauses), batch_size)]
[agent:result]     
[agent:result]     print(f"Created {len(batches)} batches")
[agent:result]     
