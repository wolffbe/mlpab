[agent:result]     # We'll use a UNION ALL approach to combine all batches in one statement
[agent:result]     union_selects = []
[agent:result]     for i, batch in enumerate(batches):
[agent:result]         union_selects.append(f"""
[agent:result]         SELECT 
[agent:result]             t.row_id,
[agent:result]             t.account_id,
[agent:result]             t.event_time,
[agent:result]             t.amount * t.fx_rate AS amount_usd,
[agent:result]             CASE 
