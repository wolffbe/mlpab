[agent:result]                 ELSE 0
[agent:result]             END AS is_weekend,
[agent:result]             t.amount,
[agent:result]             t.account_id AS account_id_7d,
[agent:result]             t.event_time AS event_time_7d
[agent:result]         FROM (
[agent:result]             SELECT * FROM VALUES
[agent:result]             {', '.join(batch)}
[agent:result]             AS t(row_id, account_id, event_time, amount, currency, fx_rate)
[agent:result]         ) t
[agent:result]         """)
[agent:result]     
[agent:result]     # Combine all selects with UNION ALL
[agent:result]     union_sql = " UNION ALL ".join(union_selects)
