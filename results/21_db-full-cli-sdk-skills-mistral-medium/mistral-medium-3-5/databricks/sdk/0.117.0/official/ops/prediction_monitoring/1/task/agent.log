[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Script to upload prediction log data to Databricks and analyze it for distribution shift.
[agent:result] """
[agent:result] import os
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] 
[agent:result] # Initialize workspace client
[agent:result] wc = WorkspaceClient()
[agent:result] 
[agent:result] # Environment variables
[agent:result] SCHEMA = os.environ.get("MLPAB_DATABRICKS_SCHEMA", "workspace.mlpab379c4e")
[agent:result] PREFIX = os.environ.get("MLPAB_DATABRICKS_PREFIX", "mlpab379c4e")
[agent:result] 
[agent:result] # Path to data file
[agent:result] DATA_FILE = "data/prediction_log.csv"
[agent:result] 
[agent:result] # Upload CSV to DBFS
[agent:result] print("Uploading prediction log to DBFS...")
[agent:result] dbfs_path = f"dbfs:/tmp/{PREFIX}_prediction_log.csv"
[agent:result] wc.dbfs.upload(DATA_FILE, dbfs_path, overwrite=True)
[agent:result] print(f"Uploaded to {dbfs_path}")
[agent:result] 
[agent:result] # Create a table from the CSV
[agent:result] # First, let's create a Delta table
[agent:result] catalog_schema = SCHEMA
[agent:result] TABLE_NAME = f"{PREFIX}_prediction_log"
[agent:result] FULL_TABLE_NAME = f"{catalog_schema}.{TABLE_NAME}"
[agent:result] 
[agent:result] print(f"Creating table {FULL_TABLE_NAME}...")
[agent:result] 
[agent:result] # Use SQL to create the table
[agent:result] sql_create = f"""
[agent:result] CREATE TABLE IF NOT EXISTS {FULL_TABLE_NAME} 
[agent:result] USING CSV
[agent:result] OPTIONS (
[agent:result]   path "{dbfs_path}",
[agent:result]   header "true",
[agent:result]   inferSchema "true"
[agent:result] )
[agent:result] """
[agent:result] 
[agent:result] try:
[agent:result]     wc.statement_execution.execute_statement(
[agent:result]         warehouse_id=wc.config.warehouse_id,
[agent:result]         catalog_name="workspace",
[agent:result]         schema_name=SCHEMA.split('.')[1],
[agent:result]         statement=sql_create,
[agent:result]         timeout_seconds=60
[agent:result]     )
[agent:result]     print(f"Table {FULL_TABLE_NAME} created successfully")
[agent:result] except Exception as e:
[agent:result]     print(f"Error creating table: {e}")
[agent:result]     # Try alternative approach - use files API to upload to workspace
[agent:result]     print("Trying alternative approach...")
[agent:result] 
[agent:result] # Now analyze the data to find the distribution shift
[agent:result] # We'll look for the first date where predictions consistently shift
[agent:result] print("\nAnalyzing data for distribution shift...")
[agent:result] 
[agent:result] sql_analyze = f"""
[agent:result] WITH daily_stats AS (
[agent:result]   SELECT 
[agent:result]     DATE(ts) as date,
[agent:result]     AVG(prediction) as avg_prediction,
[agent:result]     STDDEV(prediction) as std_prediction,
[agent:result]     MIN(prediction) as min_prediction,
[agent:result]     MAX(prediction) as max_prediction,
[agent:result]     COUNT(*) as count
[agent:result]   FROM {FULL_TABLE_NAME}
[agent:result]   GROUP BY DATE(ts)
[agent:result]   ORDER BY date
[agent:result] ),
[agent:result] shift_detection AS (
[agent:result]   SELECT 
[agent:result]     date,
[agent:result]     avg_prediction,
[agent:result]     std_prediction,
[agent:result]     min_prediction,
[agent:result]     max_prediction,
[agent:result]     count,
[agent:result]     LAG(avg_prediction, 1) OVER (ORDER BY date) as prev_avg,
[agent:result]     LAG(std_prediction, 1) OVER (ORDER BY date) as prev_std,
[agent:result]     -- Calculate the difference in means
[agent:result]     avg_prediction - LAG(avg_prediction, 1) OVER (ORDER BY date) as avg_diff,
[agent:result]     -- Calculate the difference in std
[agent:result]     std_prediction - LAG(std_prediction, 1) OVER (ORDER BY date) as std_diff
