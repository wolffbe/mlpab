[agent:result]         i.item_id,
[agent:result]         u.e1 * i.e1 + u.e2 * i.e2 + u.e3 * i.e3 + u.e4 * i.e4 + 
[agent:result]         u.e5 * i.e5 + u.e6 * i.e6 + u.e7 * i.e7 + u.e8 * i.e8 as dot_product
[agent:result]     FROM {CATALOG}.{SCHEMA_NAME}.user_embeddings u
[agent:result]     CROSS JOIN {CATALOG}.{SCHEMA_NAME}.item_embeddings i
[agent:result] ),
[agent:result] filtered_pairs AS (
[agent:result]     SELECT 
[agent:result]         ap.user_id,
[agent:result]         ap.item_id,
[agent:result]         ap.dot_product
[agent:result]     FROM all_pairs ap
[agent:result]     LEFT JOIN interacted i ON ap.user_id = i.user_id AND ap.item_id = i.item_id
[agent:result]     WHERE i.item_id IS NULL
[agent:result] ),
