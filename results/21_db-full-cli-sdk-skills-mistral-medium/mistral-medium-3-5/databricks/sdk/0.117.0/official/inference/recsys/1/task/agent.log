[agent:result] # Step 3: Compute recommendations using SQL
[agent:result] # We need to:
[agent:result] # 1. For each user, compute dot product with all items
[agent:result] # 2. Exclude items the user has already interacted with
[agent:result] # 3. Rank by dot product descending, break ties by item_id ascending
[agent:result] # 4. Take top 5 per user
[agent:result] 
[agent:result] print("Computing recommendations...")
[agent:result] 
[agent:result] # First, let's create a cross join of users and items with their embeddings
[agent:result] # Then compute dot products
[agent:result] # Then filter out interacted items
[agent:result] # Then rank and take top 5
[agent:result] 
[agent:result] create_recs_sql = f"""
[agent:result] WITH user_emb AS (
[agent:result]     SELECT 
[agent:result]         user_id,
[agent:result]         ARRAY(e1, e2, e3, e4, e5, e6, e7, e8) as user_vec
[agent:result]     FROM {CATALOG}.{SCHEMA_NAME}.user_embeddings_temp
[agent:result] ),
[agent:result] item_emb AS (
[agent:result]     SELECT 
[agent:result]         item_id,
[agent:result]         ARRAY(e1, e2, e3, e4, e5, e6, e7, e8) as item_vec
[agent:result]     FROM {CATALOG}.{SCHEMA_NAME}.item_embeddings_temp
[agent:result] ),
[agent:result] interacted AS (
[agent:result]     SELECT DISTINCT user_id, item_id
[agent:result]     FROM {CATALOG}.{SCHEMA_NAME}.interactions_temp
[agent:result] ),
[agent:result] all_pairs AS (
[agent:result]     SELECT 
[agent:result]         u.user_id,
[agent:result]         i.item_id,
[agent:result]         AGGREGATE(u.user_vec, i.item_vec, (acc, x) -> acc + x[0] * x[1]) as dot_product
[agent:result]     FROM user_emb u
[agent:result]     CROSS JOIN item_emb i
[agent:result] ),
[agent:result] filtered_pairs AS (
[agent:result]     SELECT 
[agent:result]         ap.user_id,
[agent:result]         ap.item_id,
[agent:result]         ap.dot_product
[agent:result]     FROM all_pairs ap
[agent:result]     LEFT JOIN interacted i ON ap.user_id = i.user_id AND ap.item_id = i.item_id
[agent:result]     WHERE i.item_id IS NULL
[agent:result] ),
[agent:result] ranked AS (
[agent:result]     SELECT 
[agent:result]         user_id,
[agent:result]         item_id,
[agent:result]         dot_product,
[agent:result]         ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY dot_product DESC, item_id ASC) as rank
[agent:result]     FROM filtered_pairs
[agent:result] )
[agent:result] SELECT 
[agent:result]     CONCAT(user_id, '#', rank) as rec_id,
[agent:result]     user_id,
[agent:result]     rank,
[agent:result]     item_id
[agent:result] FROM ranked
[agent:result] WHERE rank <= 5
[agent:result] ORDER BY user_id, rank
[agent:result] """
[agent:result] 
[agent:result] # Execute the query and create the feature table
[agent:result] wc.statement_execution.execute_statement(
[agent:result]     statement=f"""
[agent:result]     CREATE OR REPLACE TABLE {CATALOG}.{SCHEMA_NAME}.recs02400f 
[agent:result]     COMMENT 'Recommendation table version 1'
[agent:result]     AS {create_recs_sql}
[agent:result]     """,
[agent:result]     warehouse_id=warehouse_id,
[agent:result]     wait_timeout="60s"
[agent:result] )
[agent:result] 
