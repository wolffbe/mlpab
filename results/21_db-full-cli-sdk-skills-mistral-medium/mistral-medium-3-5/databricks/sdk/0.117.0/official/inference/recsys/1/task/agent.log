[agent:result] create_recs_sql = f"""
[agent:result] WITH interacted AS (
[agent:result]     SELECT DISTINCT user_id, item_id
[agent:result]     FROM {CATALOG}.{SCHEMA_NAME}.interactions
[agent:result] ),
[agent:result] all_pairs AS (
