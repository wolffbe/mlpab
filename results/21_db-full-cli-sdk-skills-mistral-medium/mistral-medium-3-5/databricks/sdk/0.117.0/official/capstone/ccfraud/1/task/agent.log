[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     from math import radians, sin, cos, sqrt, asin
[agent:result]     R = 6371
[agent:result]     dLat = radians(lat2 - lat1)
[agent:result]     dLon = radians(lon2 - lon1)
[agent:result]     a = sin(dLat/2)**2 + cos(radians(lat1)) * cos(radians(lat2)) * sin(dLon/2)**2
[agent:result]     return 2 * R * asin(sqrt(a))
[agent:result] 
[agent:result] haversine_udf = udf(haversine, DoubleType())
[agent:result] 
