[agent:result] # Step 3: Feature Engineering - Create feature group cctxn0f323c
[agent:result] # ============================================================
[agent:result] print("\n=== Step 3: Feature Engineering ===")
[agent:result] 
[agent:result] # Feature engineering SQL
[agent:result] feature_engineering_sql = f"""
[agent:result] WITH card_stats AS (
[agent:result]   SELECT 
[agent:result]     cc_num,
[agent:result]     AVG(lat) as avg_lat,
[agent:result]     AVG(long) as avg_long,
[agent:result]     STDDEV(lat) as lat_std,
[agent:result]     STDDEV(long) as long_std,
[agent:result]     COUNT(*) as total_txns,
[agent:result]     AVG(amount) as avg_amount,
[agent:result]     STDDEV(amount) as amount_std
[agent:result]   FROM {RAW_TRANSACTIONS}
[agent:result]   GROUP BY cc_num
[agent:result] ),
[agent:result] card_category_stats AS (
[agent:result]   SELECT 
[agent:result]     cc_num,
[agent:result]     category,
[agent:result]     COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY cc_num) as category_pct
[agent:result]   FROM {RAW_TRANSACTIONS}
[agent:result]   GROUP BY cc_num, category
[agent:result] )
[agent:result] SELECT 
[agent:result]   t.transaction_id,
[agent:result]   t.cc_num,
[agent:result]   t.datetime,
[agent:result]   t.amount,
[agent:result]   t.merchant,
[agent:result]   t.category,
[agent:result]   t.lat,
[agent:result]   t.long,
[agent:result]   t.is_fraud,
[agent:result]   EXTRACT(HOUR FROM t.datetime) as hour_of_day,
[agent:result]   EXTRACT(DAYOFWEEK FROM t.datetime) as day_of_week,
[agent:result]   COUNT(*) OVER (PARTITION BY t.cc_num ORDER BY t.datetime RANGE BETWEEN INTERVAL 1 HOUR PRECEDING AND CURRENT ROW) as txn_count_1h,
[agent:result]   SUM(t.amount) OVER (PARTITION BY t.cc_num ORDER BY t.datetime RANGE BETWEEN INTERVAL 1 HOUR PRECEDING AND CURRENT ROW) as amount_sum_1h,
[agent:result]   AVG(t.amount) OVER (PARTITION BY t.cc_num ORDER BY t.datetime RANGE BETWEEN INTERVAL 1 HOUR PRECEDING AND CURRENT ROW) as amount_avg_1h,
[agent:result]   CASE 
[agent:result]     WHEN LAG(t.datetime) OVER (PARTITION BY t.cc_num ORDER BY t.datetime) IS NULL THEN 999999.0
[agent:result]     ELSE EXTRACT(EPOCH FROM t.datetime - LAG(t.datetime) OVER (PARTITION BY t.cc_num ORDER BY t.datetime))
[agent:result]   END as seconds_since_last_txn,
[agent:result]   CASE 
[agent:result]     WHEN cs.avg_lat IS NULL OR cs.avg_long IS NULL THEN 0.0
[agent:result]     ELSE 6371.0 * 2 * ASIN(SQRT(POWER(SIN((RADIANS(t.lat) - RADIANS(cs.avg_lat)) / 2), 2) + COS(RADIANS(t.lat)) * COS(RADIANS(cs.avg_lat)) * POWER(SIN((RADIANS(t.long) - RADIANS(cs.avg_long)) / 2), 2)))
[agent:result]   END as geo_distance_km,
[agent:result]   CASE 
[agent:result]     WHEN cs.avg_amount IS NULL OR cs.avg_amount = 0 THEN 0.0
[agent:result]     ELSE (t.amount - cs.avg_amount) / NULLIF(cs.avg_amount, 0)
[agent:result]   END as amount_zscore,
[agent:result]   COALESCE(MAX(CASE WHEN ccs.category = t.category THEN ccs.category_pct ELSE 0 END), 0.0) as category_pct,
[agent:result]   COALESCE(cs.total_txns, 0) as card_total_txns,
[agent:result]   COALESCE(cs.amount_std, 0.0) as card_amount_std,
[agent:result]   COALESCE(cs.lat_std, 0.0) as card_lat_std,
[agent:result]   COALESCE(cs.long_std, 0.0) as card_long_std
[agent:result] FROM {RAW_TRANSACTIONS} t
[agent:result] LEFT JOIN card_stats cs ON t.cc_num = cs.cc_num
[agent:result] LEFT JOIN card_category_stats ccs ON t.cc_num = ccs.cc_num AND t.category = ccs.category
[agent:result] GROUP BY t.transaction_id, t.cc_num, t.datetime, t.amount, t.merchant, t.category, t.lat, t.long, t.is_fraud, cs.avg_lat, cs.avg_long, cs.lat_std, cs.long_std, cs.avg_amount, cs.amount_std, cs.total_txns
[agent:result] """
[agent:result] 
[agent:result] result = wc.statement_execution.execute_statement(
[agent:result]     statement=f"CREATE OR REPLACE TABLE {FG_TABLE} AS {feature_engineering_sql}",
[agent:result]     warehouse_id=WAREHOUSE_ID,
