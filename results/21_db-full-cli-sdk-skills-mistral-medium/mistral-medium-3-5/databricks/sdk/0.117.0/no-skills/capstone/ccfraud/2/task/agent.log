[agent:result] 
[agent:result] import os
[agent:result] import zipfile
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] from pyspark.sql.types import FloatType
[agent:result] import math
[agent:result] 
[agent:result] # Extract CSV files from zip archives
[agent:result] zip_files = [
[agent:result]     (WORKSPACE_PATH + "/transactions.zip", WORKSPACE_PATH + "/transactions.csv"),
[agent:result]     (WORKSPACE_PATH + "/score_transactions.zip", WORKSPACE_PATH + "/score_transactions.csv")
[agent:result] ]
[agent:result] 
[agent:result] for zip_path, csv_path in zip_files:
[agent:result]     if os.path.exists(zip_path) and not os.path.exists(csv_path):
[agent:result]         with zipfile.ZipFile(zip_path, 'r') as zip_ref:
[agent:result]             zip_ref.extractall(os.path.dirname(zip_path))
[agent:result]         print("Extracted", zip_path, "to", csv_path)
[agent:result] 
[agent:result] # Load data
[agent:result] print("Loading training data...")
[agent:result] train_df = spark.read.csv(WORKSPACE_PATH + "/transactions.csv", header=True, inferSchema=True)
[agent:result] print("Training data:", train_df.count(), "rows,", len(train_df.columns), "columns")
[agent:result] 
[agent:result] print("Loading scoring data...")
[agent:result] score_df = spark.read.csv(WORKSPACE_PATH + "/score_transactions.csv", header=True, inferSchema=True)
[agent:result] print("Scoring data:", score_df.count(), "rows,", len(score_df.columns), "columns")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Step 2: Feature Engineering
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Parse datetime
[agent:result] train_df = train_df.withColumn("datetime", F.to_timestamp("datetime"))
[agent:result] score_df = score_df.withColumn("datetime", F.to_timestamp("datetime"))
[agent:result] 
[agent:result] # Time features
[agent:result] for df in [train_df, score_df]:
[agent:result]     df = df.withColumn("hour_of_day", F.hour("datetime"))
[agent:result]     df = df.withColumn("day_of_week", F.dayofweek("datetime"))
[agent:result]     df = df.withColumn("day_of_month", F.dayofmonth("datetime"))
[agent:result]     df = df.withColumn("month", F.month("datetime"))
[agent:result] 
[agent:result] # Haversine distance UDF
[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     dLat = math.radians(lat2 - lat1)
[agent:result]     dLon = math.radians(lon2 - lon1)
[agent:result]     a = math.sin(dLat/2)**2 + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dLon/2)**2
[agent:result]     c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))
[agent:result]     return R * c
[agent:result] 
[agent:result] haversine_udf = F.udf(haversine, FloatType())
[agent:result] 
[agent:result] # Card statistics from training data only
[agent:result] card_stats = train_df.groupBy("cc_num").agg(
[agent:result]     F.avg("lat").alias("card_mean_lat"),
[agent:result]     F.avg("long").alias("card_mean_long"),
[agent:result]     F.avg("amount").alias("card_avg_amount"),
[agent:result]     F.stddev("amount").alias("card_std_amount"),
[agent:result]     F.count("*").alias("card_txn_count")
[agent:result] )
[agent:result] 
[agent:result] # Merchant and category statistics from training data only
[agent:result] merchant_stats = train_df.groupBy("merchant").agg(F.count("*").alias("merchant_txn_count"))
[agent:result] category_stats = train_df.groupBy("category").agg(F.count("*").alias("category_txn_count"))
[agent:result] 
[agent:result] # Join statistics with training data
[agent:result] train_df = train_df.join(card_stats, "cc_num", "left") \\
[agent:result]     .join(merchant_stats, "merchant", "left") \\
[agent:result]     .join(category_stats, "category", "left")
[agent:result] 
[agent:result] # Join statistics with scoring data
[agent:result] score_df = score_df.join(card_stats, "cc_num", "left") \\
[agent:result]     .join(merchant_stats, "merchant", "left") \\
[agent:result]     .join(category_stats, "category", "left")
[agent:result] 
[agent:result] # Window for time-based features
[agent:result] window_spec_card = Window.partitionBy("cc_num").orderBy("datetime")
[agent:result] 
[agent:result] # Time since last transaction
[agent:result] for df in [train_df, score_df]:
[agent:result]     df = df.withColumn("time_since_last_txn", 
[agent:result]         F.coalesce(F.unix_timestamp("datetime") - F.lag(F.unix_timestamp("datetime")).over(window_spec_card), F.lit(0)))
[agent:result] 
[agent:result] # Transaction count in recent history (approximate)
[agent:result] for df in [train_df, score_df]:
[agent:result]     df = df.withColumn("txn_count_recent", 
[agent:result]         F.count("*").over(window_spec_card.rowsBetween(-10, 0)) - 1)
[agent:result] 
[agent:result] # Geo distance from card mean location
[agent:result] for df in [train_df, score_df]:
[agent:result]     df = df.withColumn("geo_distance", 
[agent:result]         haversine_udf(F.col("lat"), F.col("long"), F.col("card_mean_lat"), F.col("card_mean_long")))
[agent:result] 
[agent:result] # Amount features
[agent:result] for df in [train_df, score_df]:
[agent:result]     df = df.withColumn("amount_rel_to_avg", 
[agent:result]         F.col("amount") / F.coalesce(F.col("card_avg_amount"), F.lit(1.0)))
[agent:result]     df = df.withColumn("amount_zscore", 
[agent:result]         (F.col("amount") - F.col("card_avg_amount")) / F.coalesce(F.col("card_std_amount"), F.lit(1.0)))
[agent:result] 
[agent:result] print("Feature engineering complete!")
[agent:result] 
