[agent:result]     full_table_name = f'{catalog_name}.{schema_name_only}.{table_name}'
[agent:result]     
[agent:result]     # Get warehouse ID
[agent:result]     warehouses = list(wc.warehouses.list())
[agent:result]     warehouse_id = warehouses[0].id
[agent:result]     
[agent:result]     print(f"Using warehouse: {warehouse_id}")
[agent:result]     print(f"Creating table: {full_table_name}")
[agent:result]     
[agent:result]     # Read CSV files
[agent:result]     requests = []
[agent:result]     with open('data/requests.csv', 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             requests.append(row)
[agent:result]     
[agent:result]     profiles = []
[agent:result]     with open('data/profiles.csv', 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             profiles.append(row)
[agent:result]     
[agent:result]     # Create a dict for profiles by account_id
[agent:result]     profile_dict = {p['account_id']: p for p in profiles}
[agent:result]     
[agent:result]     # Create the feature table using SQL
[agent:result]     create_feature_table_sql = f"""
[agent:result]     CREATE TABLE IF NOT EXISTS {catalog_name}.{schema_name_only}.{table_name} (
[agent:result]         request_id STRING,
[agent:result]         account_id STRING,
[agent:result]         distance_deg DOUBLE,
[agent:result]         score DOUBLE
[agent:result]     ) USING DELTA
[agent:result]     """
[agent:result]     
[agent:result]     wc.statement_execution.execute_statement(
[agent:result]         statement=create_feature_table_sql,
[agent:result]         warehouse_id=warehouse_id,
[agent:result]         wait_timeout='10s'
[agent:result]     )
[agent:result]     print(f"Created feature table {table_name}")
[agent:result]     
[agent:result]     # Insert data into the feature table using multiple INSERT statements
[agent:result]     # This avoids the VALUES clause size limit
[agent:result]     batch_size = 50
[agent:result]     for i in range(0, len(requests), batch_size):
[agent:result]         batch = requests[i:i+batch_size]
[agent:result]         insert_statements = []
[agent:result]         
[agent:result]         for req in batch:
[agent:result]             account_id = req['account_id']
[agent:result]             profile = profile_dict.get(account_id)
[agent:result]             if profile is None:
[agent:result]                 continue
[agent:result]             
[agent:result]             # Compute distance_deg
[agent:result]             lat_diff = float(req['request_lat']) - float(profile['home_lat'])
[agent:result]             lon_diff = float(req['request_lon']) - float(profile['home_lon'])
[agent:result]             distance_deg = round((lat_diff**2 + lon_diff**2) ** 0.5, 6)
[agent:result]             
[agent:result]             # Compute score
[agent:result]             base_score = float(profile['base_score'])
[agent:result]             score = round(base_score - 0.1 * distance_deg, 6)
[agent:result]             
[agent:result]             insert_statements.append(
[agent:result]                 f"('{req['request_id']}', '{account_id}', {distance_deg}, {score})"
[agent:result]             )
[agent:result]         
[agent:result]         if insert_statements:
[agent:result]             insert_sql = f"""
[agent:result]             INSERT INTO {catalog_name}.{schema_name_only}.{table_name}
[agent:result]             SELECT * FROM VALUES
[agent:result]                 {',\n                '.join(insert_statements)}
[agent:result]             AS t(request_id, account_id, distance_deg, score)
