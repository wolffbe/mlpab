[agent:result]     
[agent:result]     if not online_stores:
[agent:result]         # Create an online store
[agent:result]         from databricks.sdk.service.ml import OnlineStore
[agent:result]         online_store_name = f"{os.environ['MLPAB_DATABRICKS_PREFIX']}_online_store"
[agent:result]         online_store = OnlineStore(
[agent:result]             name=online_store_name,
[agent:result]             capacity='SMALL'
[agent:result]         )
[agent:result]         wc.feature_store.create_online_store(online_store)
[agent:result]         print(f"Created online store: {online_store_name}")
[agent:result]     else:
[agent:result]         online_store_name = online_stores[0].name
[agent:result]         print(f"Using existing online store: {online_store_name}")
[agent:result]     
[agent:result]     # Publish the table to the online store
[agent:result]     from databricks.sdk.service.ml import PublishSpec, PublishSpecPublishMode
