[agent:result] FEATURE_TABLE_NAME = "scores076684"
[agent:result] ONLINE_TABLE_NAME = f"{FEATURE_TABLE_NAME}_online"
[agent:result] ONLINE_STORE_NAME = f"{PREFIX}_online_store"
[agent:result] WAREHOUSE_ID = "4dfab06c923fe3cc"
[agent:result] PREFIX = "mlpabc24aad"  # From MLPAB_DATABRICKS_PREFIX
[agent:result] 
[agent:result] # Model parameters from model.json
[agent:result] W_F1 = 0.3214
[agent:result] W_F2 = -0.0402
[agent:result] W_F3 = 0.6782
[agent:result] BIAS = 0.0617
[agent:result] 
[agent:result] def main():
[agent:result]     wc = WorkspaceClient()
[agent:result]     
[agent:result]     # Step 1: Read the CSV
[agent:result]     print("Reading feature_history.csv...")
[agent:result]     rows = []
[agent:result]     with open("data/feature_history.csv", "r") as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         for row in reader:
[agent:result]             rows.append({
[agent:result]                 "account_id": row["account_id"],
[agent:result]                 "event_time": int(row["event_time"]),
[agent:result]                 "f1": float(row["f1"]),
[agent:result]                 "f2": float(row["f2"]),
[agent:result]                 "f3": float(row["f3"])
[agent:result]             })
[agent:result]     print(f"Read {len(rows)} rows")
[agent:result]     
[agent:result]     # Step 2: Create a staging table in the target schema
[agent:result]     print("Creating staging table...")
[agent:result]     
[agent:result]     create_staging_sql = f"""
[agent:result]     CREATE OR REPLACE TABLE {CATALOG}.{SCHEMA}.staging_feature_history (
[agent:result]       account_id STRING,
[agent:result]       event_time BIGINT,
[agent:result]       f1 DOUBLE,
[agent:result]       f2 DOUBLE,
[agent:result]       f3 DOUBLE
[agent:result]     )
[agent:result]     """
[agent:result]     
[agent:result]     result = wc.statement_execution.execute_statement(
[agent:result]         statement=create_staging_sql,
[agent:result]         warehouse_id=WAREHOUSE_ID,
[agent:result]         wait_timeout="10s"
[agent:result]     )
[agent:result]     print(f"Created staging table: {result.status.state}")
[agent:result]     if hasattr(result.status, 'error') and result.status.error:
[agent:result]         print(f"Error: {result.status.error}")
[agent:result]     
[agent:result]     # Step 3: Insert data in batches
[agent:result]     print("Inserting data...")
[agent:result]     batch_size = 20
[agent:result]     for i in range(0, len(rows), batch_size):
[agent:result]         batch = rows[i:i+batch_size]
[agent:result]         insert_sql = f"INSERT INTO {CATALOG}.{SCHEMA}.staging_feature_history VALUES "
[agent:result]         values_clauses = []
[agent:result]         for row in batch:
[agent:result]             values_clauses.append(
[agent:result]                 f"('{row['account_id']}', {row['event_time']}, {row['f1']}, {row['f2']}, {row['f3']})"
[agent:result]             )
[agent:result]         insert_sql += ", ".join(values_clauses)
[agent:result]         
[agent:result]         result = wc.statement_execution.execute_statement(
[agent:result]             statement=insert_sql,
[agent:result]             warehouse_id=WAREHOUSE_ID,
[agent:result]             wait_timeout="10s"
[agent:result]         )
[agent:result]         print(f"Inserted batch {i//batch_size + 1}: {result.status.state}")
[agent:result]         if hasattr(result.status, 'error') and result.status.error:
[agent:result]             print(f"Error: {result.status.error}")
[agent:result]     
[agent:result]     # Step 4: Create the feature table with scores from the staging table
[agent:result]     print("Computing scores and creating feature table...")
[agent:result]     
[agent:result]     create_feature_table_sql = f"""
[agent:result]     CREATE OR REPLACE TABLE {CATALOG}.{SCHEMA}.{FEATURE_TABLE_NAME} 
[agent:result]     COMMENT 'Batch-scored account features at T={T}'
[agent:result]     AS
[agent:result]     WITH latest_features AS (
[agent:result]       SELECT 
[agent:result]         account_id,
[agent:result]         f1,
[agent:result]         f2,
[agent:result]         f3,
[agent:result]         event_time,
[agent:result]         ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY event_time DESC) as rn
[agent:result]       FROM {CATALOG}.{SCHEMA}.staging_feature_history
[agent:result]       WHERE event_time <= {T}
[agent:result]     )
[agent:result]     SELECT 
[agent:result]       account_id,
[agent:result]       ROUND(1.0 / (1.0 + EXP(-({W_F1} * f1 + {W_F2} * f2 + {W_F3} * f3 + {BIAS}))), 6) as score
[agent:result]     FROM latest_features
[agent:result]     WHERE rn = 1
[agent:result]     """
[agent:result]     
[agent:result]     result = wc.statement_execution.execute_statement(
[agent:result]         statement=create_feature_table_sql,
[agent:result]         warehouse_id=WAREHOUSE_ID,
[agent:result]         wait_timeout="45s"
[agent:result]     )
[agent:result]     print(f"Created feature table: {result.status.state}")
[agent:result]     if hasattr(result.status, 'error') and result.status.error:
[agent:result]         print(f"Error: {result.status.error}")
[agent:result]     
[agent:result]     # Step 5: Create an online store and publish the table
[agent:result]     print("Creating online store...")
[agent:result]     try:
