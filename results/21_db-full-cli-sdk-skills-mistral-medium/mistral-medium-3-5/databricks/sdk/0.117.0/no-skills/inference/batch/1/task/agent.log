[agent:result]             online_store=OnlineStore(
[agent:result]                 name=ONLINE_STORE_NAME
[agent:result]             )
[agent:result]         )
[agent:result]         print(f"Created online store: {online_store.name}")
[agent:result]         
[agent:result]         # Publish the table to the online store
[agent:result]         print("Publishing table to online store...")
[agent:result]         source_table_full_name = f"{CATALOG}.{SCHEMA}.{FEATURE_TABLE_NAME}"
[agent:result]         publish_response = wc.feature_store.publish_table(
[agent:result]             source_table_name=source_table_full_name,
[agent:result]             publish_spec=PublishSpec(
[agent:result]                 online_store=ONLINE_STORE_NAME,
[agent:result]                 online_table_name=ONLINE_TABLE_NAME,
[agent:result]                 publish_mode=PublishSpecPublishMode.AUTO
[agent:result]             )
[agent:result]         )
[agent:result]         print(f"Published table to online store: {publish_response}")
[agent:result]     except Exception as e:
[agent:result]         print(f"Error creating online store or publishing: {e}")
