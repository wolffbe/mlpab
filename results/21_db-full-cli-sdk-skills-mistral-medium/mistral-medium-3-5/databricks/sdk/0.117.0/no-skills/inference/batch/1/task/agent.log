[agent:result]       ROUND(1.0 / (1.0 + EXP(-({W_F1} * f1 + {W_F2} * f2 + {W_F3} * f3 + {BIAS}))), 6) as score
[agent:result]     FROM latest_features
[agent:result]     WHERE rn = 1
[agent:result]     """
[agent:result]     
