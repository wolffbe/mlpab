[agent:result]     
[agent:result]     # Create index spec
[agent:result]     index_spec = DeltaSyncVectorIndexSpecRequest(
[agent:result]         source_table=table_name,
[agent:result]         columns_to_index=["item_id", "label"],
[agent:result]         columns_to_sync=["item_id", "label"],
[agent:result]         embedding_vector_columns=[
[agent:result]             EmbeddingVectorColumn(
