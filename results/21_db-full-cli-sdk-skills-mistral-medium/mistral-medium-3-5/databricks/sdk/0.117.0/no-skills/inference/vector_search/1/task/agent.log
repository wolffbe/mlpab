[agent:result]             endpoint_name=ENDPOINT_NAME,
[agent:result]             primary_key="item_id",
[agent:result]             index_type=VectorIndexType.DELTA_SYNC,
[agent:result]             index_subtype=IndexSubtype.VECTOR,
[agent:result]             delta_sync_index_spec=index_spec
[agent:result]         )
