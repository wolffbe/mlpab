[agent:result]         embedding_str = item["embedding"]
[agent:result]         # Convert to proper JSON array format
[agent:result]         embedding_list = json.loads(embedding_str)
[agent:result]         embedding_array_str = "[" + ", ".join(str(x) for x in embedding_list) + "]"
[agent:result]         insert_values.append(f"('{item['item_id']}', {embedding_array_str}, '{item['label']}')")
[agent:result]     
[agent:result]     # Batch insert (Databricks SQL has limits, so we'll do it in chunks)
[agent:result]     batch_size = 50
[agent:result]     for i in range(0, len(insert_values), batch_size):
[agent:result]         batch = insert_values[i:i+batch_size]
[agent:result]         insert_sql = f"""
[agent:result]         INSERT INTO {TABLE_NAME} (item_id, embedding, label)
[agent:result]         VALUES {', '.join(batch)}
[agent:result]         """
[agent:result]         print(f"Inserting batch {i//batch_size + 1}/{(len(insert_values)+batch_size-1)//batch_size}")
[agent:result]         client.statement_execution.execute_statement(
[agent:result]             statement=insert_sql,
[agent:result]             warehouse_id="default"
[agent:result]         )
[agent:result]     
[agent:result]     print(f"Inserted {len(items)} items into {TABLE_NAME}")
[agent:result]     
