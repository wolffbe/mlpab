[agent:result]     
[agent:result]     print(f"Total rows: {len(valid_rows) + len(rejected_rows)}")
[agent:result]     print(f"Valid rows: {len(valid_rows)}")
[agent:result]     print(f"Rejected rows: {len(rejected_rows)}")
[agent:result]     
