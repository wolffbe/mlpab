[agent:result]     _c0 as row_id,
[agent:result]     _c1 as account_id,
[agent:result]     CAST(_c2 AS BIGINT) as event_time,
[agent:result]     CAST(_c3 AS DOUBLE) as amount,
[agent:result]     _c4 as category
[agent:result]   FROM csv.`{CSV_PATH_2}`
[agent:result] ),
[agent:result] deduped AS (
[agent:result]   SELECT * FROM raw_data 
[agent:result]   QUALIFY ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY event_time DESC) = 1
[agent:result] )
[agent:result] SELECT 
[agent:result]   row_id,
[agent:result]   account_id,
[agent:result]   event_time,
[agent:result]   amount,
[agent:result]   category
[agent:result] FROM deduped
[agent:result] """
