[agent:result]     wait_timeout="30s"
[agent:result] )
[agent:result] print(f"  Status: {response.status.state}")
[agent:result] 
[agent:result] # Step 2: Create the Delta table with deduplicated data
[agent:result] print("\n2. Creating Delta table...")
[agent:result] create_table_sql = f"""
[agent:result] CREATE OR REPLACE TABLE {FULL_TABLE_NAME} 
[agent:result] USING DELTA
[agent:result] AS 
[agent:result] WITH raw_data AS (
[agent:result]   SELECT 
[agent:result]     _c0 as row_id,
[agent:result]     _c1 as account_id,
[agent:result]     CAST(_c2 AS BIGINT) as event_time,
