[agent:result] # Create SQL to process the data and create the training dataset
[agent:result] # We need to:
[agent:result] # 1. Read all the CSV files
[agent:result] # 2. For each (account_id, label_time) in labels, get the most recent feature values at or before label_time
[agent:result] # 3. Create the final training dataset
[agent:result] 
[agent:result] sql_query = f"""
[agent:result] -- Create temporary tables from the uploaded CSV files
[agent:result] CREATE OR REPLACE TEMPORARY VIEW transactions_raw AS
[agent:result] SELECT * FROM csv.`{dbfs_data_path}/transactions.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW transactions_late_raw AS
[agent:result] SELECT * FROM csv.`{dbfs_data_path}/transactions_late.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW profiles_raw AS
[agent:result] SELECT * FROM csv.`{dbfs_data_path}/profiles.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW activity_raw AS
[agent:result] SELECT * FROM csv.`{dbfs_data_path}/activity.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW account_health_raw AS
[agent:result] SELECT * FROM csv.`{dbfs_data_path}/account_health.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW labels_raw AS
[agent:result] SELECT * FROM csv.`{dbfs_data_path}/labels.csv`;
[agent:result] 
[agent:result] -- Combine transactions from both files
[agent:result] CREATE OR REPLACE TEMPORARY VIEW transactions_combined AS
[agent:result] SELECT account_id, event_time, amount, balance FROM transactions_raw
[agent:result] UNION ALL
[agent:result] SELECT account_id, event_time, amount, balance FROM transactions_late_raw;
[agent:result] 
[agent:result] -- For each feature table, get the most recent value at or before each label_time
[agent:result] -- We'll use window functions with PARTITION BY account_id and ORDER BY event_time
[agent:result] 
[agent:result] -- Get most recent amount and balance for each (account_id, label_time)
[agent:result] WITH feature_data AS (
[agent:result]   SELECT 
[agent:result]     l.account_id,
[agent:result]     l.label_time,
[agent:result]     l.churned,
[agent:result]     -- Most recent transaction data
[agent:result]     t.amount,
[agent:result]     t.balance,
[agent:result]     -- Most recent profile data  
[agent:result]     p.credit_score,
[agent:result]     p.tier,
[agent:result]     -- Most recent activity data
[agent:result]     a.sessions_7d,
[agent:result]     -- Most recent health data
[agent:result]     h.health_score
[agent:result]   FROM labels_raw l
[agent:result]   LEFT JOIN LATERAL (
[agent:result]     SELECT amount, balance 
[agent:result]     FROM transactions_combined t
[agent:result]     WHERE t.account_id = l.account_id AND t.event_time <= l.label_time
[agent:result]     ORDER BY t.event_time DESC
[agent:result]     LIMIT 1
[agent:result]   ) t ON true
[agent:result]   LEFT JOIN LATERAL (
[agent:result]     SELECT credit_score, tier
[agent:result]     FROM profiles_raw p
[agent:result]     WHERE p.account_id = l.account_id AND p.event_time <= l.label_time
[agent:result]     ORDER BY p.event_time DESC
[agent:result]     LIMIT 1
[agent:result]   ) p ON true
[agent:result]   LEFT JOIN LATERAL (
[agent:result]     SELECT sessions_7d
[agent:result]     FROM activity_raw a
[agent:result]     WHERE a.account_id = l.account_id AND a.event_time <= l.label_time
[agent:result]     ORDER BY a.event_time DESC
[agent:result]     LIMIT 1
[agent:result]   ) a ON true
[agent:result]   LEFT JOIN LATERAL (
[agent:result]     SELECT health_score
[agent:result]     FROM account_health_raw h
[agent:result]     WHERE h.account_id = l.account_id AND h.event_time <= l.label_time
[agent:result]     ORDER BY h.event_time DESC
[agent:result]     LIMIT 1
[agent:result]   ) h ON true
[agent:result] )
[agent:result] SELECT 
[agent:result]   account_id,
[agent:result]   label_time,
[agent:result]   amount,
[agent:result]   balance,
[agent:result]   credit_score,
[agent:result]   tier,
[agent:result]   sessions_7d,
[agent:result]   health_score,
[agent:result]   churned
[agent:result] FROM feature_data
[agent:result] ORDER BY account_id, label_time;
[agent:result] """
