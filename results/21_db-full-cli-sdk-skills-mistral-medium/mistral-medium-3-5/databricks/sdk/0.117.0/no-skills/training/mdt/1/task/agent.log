[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Simplified script to register a feature table.
[agent:result] """
[agent:result] 
[agent:result] import os
[agent:result] import csv
[agent:result] import databricks.sdk
[agent:result] from databricks.sdk.service.ml import PublishSpec, PublishSpecPublishMode
[agent:result] 
[agent:result] def read_csv(file_path):
[agent:result]     """Read CSV file and return list of dicts."""
[agent:result]     with open(file_path, 'r') as f:
[agent:result]         reader = csv.DictReader(f)
[agent:result]         return list(reader)
[agent:result] 
[agent:result] def compute_statistics(train_data):
[agent:result]     """Compute mean and population std for each feature from training data."""
[agent:result]     features = ['f1', 'f2', 'f3', 'f4']
[agent:result]     n = len(train_data)
[agent:result]     
[agent:result]     sums = {f: 0.0 for f in features}
[agent:result]     sum_sq = {f: 0.0 for f in features}
[agent:result]     
[agent:result]     for row in train_data:
[agent:result]         for f in features:
[agent:result]             val = float(row[f])
[agent:result]             sums[f] += val
[agent:result]             sum_sq[f] += val * val
[agent:result]     
[agent:result]     stats = {}
[agent:result]     for f in features:
[agent:result]         mean = sums[f] / n
[agent:result]         variance = (sum_sq[f] / n) - (mean * mean)
[agent:result]         std = variance ** 0.5
[agent:result]         stats[f] = {'mean': mean, 'std': std}
[agent:result]     
[agent:result]     return stats
[agent:result] 
[agent:result] def standardize_value(val, mean, std):
[agent:result]     """Standardize a single value: (x - mean) / std, rounded to 6 decimals."""
[agent:result]     if std == 0:
[agent:result]         return 0.0
[agent:result]     return round((float(val) - mean) / std, 6)
[agent:result] 
[agent:result] def standardize_data(data, stats, split_name):
[agent:result]     """Standardize data using precomputed statistics and add split column."""
[agent:result]     features = ['f1', 'f2', 'f3', 'f4']
[agent:result]     standardized = []
[agent:result]     
[agent:result]     for row in data:
[agent:result]         std_row = {
[agent:result]             'row_id': row['row_id'],
[agent:result]             'split': split_name
[agent:result]         }
[agent:result]         for f in features:
[agent:result]             std_row[f] = standardize_value(row[f], stats[f]['mean'], stats[f]['std'])
[agent:result]         standardized.append(std_row)
[agent:result]     
[agent:result]     return standardized
[agent:result] 
[agent:result] def main():
[agent:result]     # Read environment variables
[agent:result]     schema_name = os.environ['MLPAB_DATABRICKS_SCHEMA']
[agent:result]     prefix = os.environ['MLPAB_DATABRICKS_PREFIX']
[agent:result]     
[agent:result]     parts = schema_name.split('.')
[agent:result]     catalog_name = parts[0]
[agent:result]     schema_part = '.'.join(parts[1:])
[agent:result]     
[agent:result]     print(f"Catalog: {catalog_name}, Schema: {schema_part}, Prefix: {prefix}")
[agent:result]     
[agent:result]     # Read and process data
[agent:result]     print("Reading and processing data...")
[agent:result]     train_data = read_csv('data/features_train.csv')
[agent:result]     serve_data = read_csv('data/features_serve.csv')
[agent:result]     
[agent:result]     stats = compute_statistics(train_data)
[agent:result]     train_std = standardize_data(train_data, stats, 'train')
[agent:result]     serve_std = standardize_data(serve_data, stats, 'serve')
[agent:result]     
[agent:result]     all_data = train_std + serve_std
[agent:result]     print(f"Total rows: {len(all_data)}")
[agent:result]     
