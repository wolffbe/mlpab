[agent:result] def compute_statistics(train_data):
[agent:result]     features = ['f1', 'f2', 'f3', 'f4']
[agent:result]     n = len(train_data)
[agent:result]     sums = {f: 0.0 for f in features}
[agent:result]     sum_sq = {f: 0.0 for f in features}
[agent:result]     for row in train_data:
