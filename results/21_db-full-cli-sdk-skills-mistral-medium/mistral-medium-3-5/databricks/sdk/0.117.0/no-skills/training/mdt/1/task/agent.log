[agent:result]     
[agent:result]     # Create table
[agent:result]     full_table_name = f"{catalog_name}.{schema_part}.scaleda1a1c9"
[agent:result]     
[agent:result]     # Build a single CREATE TABLE AS SELECT statement with all data
[agent:result]     # This is more efficient than multiple INSERT statements
[agent:result]     values_clauses = []
