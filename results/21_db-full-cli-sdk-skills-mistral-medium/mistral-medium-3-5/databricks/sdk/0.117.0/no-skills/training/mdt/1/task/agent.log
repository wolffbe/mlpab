[agent:result]             f"('{row['row_id']}', '{row['split']}', {row['f1']}, {row['f2']}, {row['f3']}, {row['f4']})"
[agent:result]         )
[agent:result]     
[agent:result]     # Split into batches to avoid SQL statement being too long
[agent:result]     batch_size = 100
[agent:result]     for i in range(0, len(values_clauses), batch_size):
[agent:result]         batch = values_clauses[i:i+batch_size]
[agent:result]         
[agent:result]         if i == 0:
[agent:result]             # First batch: create table
[agent:result]             sql = f"""
