[agent:result] def compute_statistics(train_data):
[agent:result]     """Compute mean and population std for each feature from training data."""
[agent:result]     features = ['f1', 'f2', 'f3', 'f4']
[agent:result]     n = len(train_data)
[agent:result]     
[agent:result]     # Initialize sums
[agent:result]     sums = {f: 0.0 for f in features}
[agent:result]     sum_sq = {f: 0.0 for f in features}
[agent:result]     
[agent:result]     # Compute sums and sum of squares
[agent:result]     for row in train_data:
[agent:result]         for f in features:
[agent:result]             val = float(row[f])
[agent:result]             sums[f] += val
[agent:result]             sum_sq[f] += val * val
[agent:result]     
[agent:result]     # Compute mean and population std
[agent:result]     stats = {}
[agent:result]     for f in features:
[agent:result]         mean = sums[f] / n
[agent:result]         # Population std (no Bessel's correction)
[agent:result]         variance = (sum_sq[f] / n) - (mean * mean)
[agent:result]         std = variance ** 0.5
[agent:result]         stats[f] = {'mean': mean, 'std': std}
[agent:result]     
[agent:result]     return stats
[agent:result] 
[agent:result] def standardize_value(val, mean, std):
[agent:result]     """Standardize a single value: (x - mean) / std, rounded to 6 decimals."""
[agent:result]     if std == 0:
[agent:result]         return 0.0  # Avoid division by zero
[agent:result]     return round((float(val) - mean) / std, 6)
[agent:result] 
[agent:result] def standardize_data(data, stats, split_name):
[agent:result]     """Standardize data using precomputed statistics and add split column."""
[agent:result]     features = ['f1', 'f2', 'f3', 'f4']
[agent:result]     standardized = []
[agent:result]     
[agent:result]     for row in data:
[agent:result]         std_row = {
[agent:result]             'row_id': row['row_id'],
[agent:result]             'split': split_name
[agent:result]         }
[agent:result]         for f in features:
[agent:result]             std_row[f] = standardize_value(row[f], stats[f]['mean'], stats[f]['std'])
[agent:result]         standardized.append(std_row)
[agent:result]     
[agent:result]     return standardized
