[agent:result]     data = list(reader)
[agent:result] 
[agent:result] print(f"Read {len(data)} rows")
[agent:result] 
[agent:result] # Group by date and calculate statistics
[agent:result] daily_stats = {}
[agent:result] for row in data:
[agent:result]     date = row['ts'][:10]  # Extract YYYY-MM-DD
[agent:result]     prediction = float(row['prediction'])
[agent:result]     
[agent:result]     if date not in daily_stats:
[agent:result]         daily_stats[date] = {'predictions': [], 'count': 0, 'sum': 0, 'sum_sq': 0}
[agent:result]     
[agent:result]     daily_stats[date]['predictions'].append(prediction)
[agent:result]     daily_stats[date]['count'] += 1
[agent:result]     daily_stats[date]['sum'] += prediction
[agent:result]     daily_stats[date]['sum_sq'] += prediction * prediction
[agent:result] 
[agent:result] # Calculate mean and std for each day
[agent:result] for date in sorted(daily_stats.keys()):
[agent:result]     stats = daily_stats[date]
[agent:result]     mean = stats['sum'] / stats['count']
[agent:result]     variance = (stats['sum_sq'] / stats['count']) - (mean ** 2)
[agent:result]     std = variance ** 0.5 if variance > 0 else 0
[agent:result]     daily_stats[date]['mean'] = mean
[agent:result]     daily_stats[date]['std'] = std
[agent:result]     print(f"{date}: mean={mean:.3f}, std={std:.3f}, count={stats['count']}")
[agent:result] 
[agent:result] # Find the shift
[agent:result] sorted_dates = sorted(daily_stats.keys())
[agent:result] onset_date = None
[agent:result] 
[agent:result] # Look for the first day where the mean jumps significantly
[agent:result] for i in range(1, len(sorted_dates)):
[agent:result]     prev_date = sorted_dates[i-1]
[agent:result]     curr_date = sorted_dates[i]
[agent:result]     prev_mean = daily_stats[prev_date]['mean']
[agent:result]     curr_mean = daily_stats[curr_date]['mean']
[agent:result]     diff = abs(curr_mean - prev_mean)
[agent:result]     
[agent:result]     # Use a threshold based on the standard deviation
[agent:result]     threshold = 1.5
[agent:result]     prev_std = daily_stats[prev_date]['std'] if daily_stats[prev_date]['std'] > 0 else 1
[agent:result]     curr_std = daily_stats[curr_date]['std'] if daily_stats[curr_date]['std'] > 0 else 1
[agent:result]     
[agent:result]     if diff > threshold * max(prev_std, curr_std):
[agent:result]         onset_date = curr_date
[agent:result]         print(f"\nShift detected on {onset_date}: mean changed from {prev_mean:.3f} to {curr_mean:.3f} (diff={diff:.3f})")
[agent:result]         break
[agent:result] 
[agent:result] if onset_date is None:
[agent:result]     # Fallback: find the day with the maximum jump
[agent:result]     max_diff = 0
[agent:result]     for i in range(1, len(sorted_dates)):
