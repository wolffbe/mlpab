[agent:result]     "import mlflow.pyfunc\n",
[agent:result]     "\n",
[agent:result]     "# Change to the data directory\n",
[agent:result]     "os.chdir('/Workspace/Users/benedict@logicalclocks.com/mlpabcd9b07/data')\n",
[agent:result]     "\n",
[agent:result]     "# Load the metrics\n",
[agent:result]     "with open('metrics.json', 'r') as f:\n",
[agent:result]     "    metrics = json.load(f)\n",
[agent:result]     "\n",
[agent:result]     "print(f'Metrics loaded: {metrics}')\n",
[agent:result]     "\n",
[agent:result]     "# Load the model data - extract arrays to avoid pickling issues\n",
[agent:result]     "with np.load('finetuned_model.npz') as data:\n",
[agent:result]     "    logits = data['logits'].copy()\n",
[agent:result]     "    adapter_a = data['adapter_a'].copy()\n",
[agent:result]     "    adapter_b = data['adapter_b'].copy()\n",
[agent:result]     "\n",
[agent:result]     "print(f'Logits shape: {logits.shape}')\n",
[agent:result]     "\n",
[agent:result]     "# Create a simple model class\n",
[agent:result]     "class NpzModel(mlflow.pyfunc.PythonModel):\n",
[agent:result]     "    def __init__(self, logits, adapter_a, adapter_b):\n",
[agent:result]     "        self.logits = logits\n",
[agent:result]     "        self.adapter_a = adapter_a\n",
[agent:result]     "        self.adapter_b = adapter_b\n",
[agent:result]     "    \n",
[agent:result]     "    def load_context(self, context):\n",
[agent:result]     "        pass\n",
[agent:result]     "    \n",
[agent:result]     "    def predict(self, context, model_input):\n",
[agent:result]     "        return self.logits\n",
[agent:result]     "\n",
[agent:result]     "# Set the registry URI for Unity Catalog\n",
[agent:result]     "mlflow.set_registry_uri('databricks-uc')\n",
[agent:result]     "\n",
[agent:result]     "# Start a run\n",
[agent:result]     "with mlflow.start_run() as run:\n",
[agent:result]     "    # Log metrics\n",
[agent:result]     "    mlflow.log_metrics(metrics)\n",
[agent:result]     "    \n",
[agent:result]     "    # Create and log the model\n",
[agent:result]     "    model = NpzModel(logits, adapter_a, adapter_b)\n",
[agent:result]     "    mlflow.pyfunc.log_model(\n",
[agent:result]     "        artifact_path='model',\n",
[agent:result]     "        python_model=model\n",
[agent:result]     "    )\n",
[agent:result]     "    \n",
[agent:result]     "    # Register the model in Unity Catalog\n",
[agent:result]     "    model_uri = f'runs:/{run.info.run_id}/model'\n",
[agent:result]     "    mv = mlflow.register_model(\n",
[agent:result]     "        model_uri=model_uri,\n",
[agent:result]     "        name='workspace.mlpabcd9b07.ftmodel65e929'\n",
[agent:result]     "    )\n",
[agent:result]     "    \n",
[agent:result]     "    print(f'Model version: {mv.version}')\n",
[agent:result]     "    print(f'Run ID: {run.info.run_id}')\n",
