[agent:result] # Feature Engineering
[agent:result] def engineer_features(df, is_forecast=False):
[agent:result]     df = df.copy()
[agent:result]     df['date'] = pd.to_datetime(df['date'])
[agent:result]     df['day_of_week'] = df['date'].dt.dayofweek
[agent:result]     df['day_of_month'] = df['date'].dt.day
[agent:result]     df['month'] = df['date'].dt.month
[agent:result]     df['year'] = df['date'].dt.year
[agent:result]     df['is_weekend'] = df['day_of_week'].isin([5, 6]).astype(int)
[agent:result]     
[agent:result]     # Sort by date for rolling calculations
[agent:result]     df = df.sort_values('date')
[agent:result]     
[agent:result]     # Rolling features for weather variables
[agent:result]     df['temp_rolling_mean_3'] = df['temperature'].rolling(window=3, min_periods=1).mean()
[agent:result]     df['temp_rolling_std_3'] = df['temperature'].rolling(window=3, min_periods=1).std()
[agent:result]     df['humidity_rolling_mean_3'] = df['humidity'].rolling(window=3, min_periods=1).mean()
[agent:result]     df['wind_rolling_mean_3'] = df['wind_speed'].rolling(window=3, min_periods=1).mean()
[agent:result]     df['pressure_rolling_mean_3'] = df['pressure'].rolling(window=3, min_periods=1).mean()
[agent:result]     
[agent:result]     # Interaction features
[agent:result]     df['temp_humidity_interaction'] = df['temperature'] * df['humidity']
[agent:result]     df['temp_wind_interaction'] = df['temperature'] * df['wind_speed']
[agent:result]     df['humidity_wind_interaction'] = df['humidity'] * df['wind_speed']
[agent:result]     
[agent:result]     # Lag features
[agent:result]     if not is_forecast:
[agent:result]         df['pm25_lag2'] = df['pm25'].shift(1)
[agent:result]     else:
[agent:result]         # For forecast, use pm25_lag1 as pm25_lag2
[agent:result]         df['pm25_lag2'] = df['pm25_lag1']
[agent:result]     
[agent:result]     df['temp_lag1'] = df['temperature'].shift(1)
[agent:result]     df['humidity_lag1'] = df['humidity'].shift(1)
[agent:result]     
[agent:result]     return df
[agent:result] 
[agent:result] history_fe = engineer_features(history_df, is_forecast=False)
[agent:result] forecast_fe = engineer_features(forecast_df, is_forecast=True)
