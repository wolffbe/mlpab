[agent:result] )
[agent:result] 
[agent:result] # Read score transactions (no labels)
[agent:result] score_df = spark.read.csv(
[agent:result]     workspace_path + "score_transactions.csv",
[agent:result]     header=True,
[agent:result]     inferSchema=True,
[agent:result]     timestampFormat="yyyy-MM-dd'T'HH:mm:ss'Z'"
[agent:result] )
[agent:result] 
[agent:result] print(f"Transactions: {transactions_df.count()} rows")
[agent:result] print(f"Score transactions: {score_df.count()} rows")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %md ### Feature Engineering
[agent:result] 
[agent:result] # COMMAND ----------
