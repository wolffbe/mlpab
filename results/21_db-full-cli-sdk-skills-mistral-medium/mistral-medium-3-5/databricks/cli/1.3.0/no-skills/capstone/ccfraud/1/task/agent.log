[agent:result] # Haversine distance UDF
[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     lat1, lon1, lat2, lon2 = map(math.radians, [lat1, lon1, lat2, lon2])
[agent:result]     dlat = lat2 - lat1
[agent:result]     dlon = lon2 - lon1
[agent:result]     a = math.sin(dlat/2)**2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon/2)**2
[agent:result]     c = 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))
[agent:result]     return R * c
[agent:result] 
[agent:result] haversine_udf = F.udf(haversine, T.DoubleType())
[agent:result] 
[agent:result] # Parse datetime
[agent:result] transactions_df = transactions_df.withColumn(
[agent:result]     "datetime", F.to_timestamp("datetime", "yyyy-MM-dd'T'HH:mm:ss'Z'")
[agent:result] )
[agent:result] score_df = score_df.withColumn(
[agent:result]     "datetime", F.to_timestamp("datetime", "yyyy-MM-dd'T'HH:mm:ss'Z'")
[agent:result] )
[agent:result] 
[agent:result] # Time-based features
[agent:result] for df in [transactions_df, score_df]:
[agent:result]     df = df.withColumn("hour", F.hour("datetime"))
[agent:result]     df = df.withColumn("day_of_week", F.dayofweek("datetime"))
[agent:result]     df = df.withColumn("is_weekend", F.when(F.dayofweek("datetime").isin([1, 7]), 1).otherwise(0))
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Card-level statistics
[agent:result] card_stats = transactions_df.groupBy("cc_num").agg(
[agent:result]     F.count("*").alias("card_transaction_count"),
[agent:result]     F.avg("amount").alias("card_avg_amount"),
[agent:result]     F.stddev("amount").alias("card_std_amount"),
[agent:result]     F.min("amount").alias("card_min_amount"),
[agent:result]     F.max("amount").alias("card_max_amount"),
[agent:result]     F.avg("lat").alias("card_avg_lat"),
[agent:result]     F.avg("long").alias("card_avg_long"),
[agent:result]     F.stddev("lat").alias("card_std_lat"),
[agent:result]     F.stddev("long").alias("card_std_long"),
[agent:result]     F.countDistinct("category").alias("card_category_count"),
[agent:result]     F.countDistinct("merchant").alias("card_merchant_count"),
[agent:result] )
[agent:result] 
[agent:result] # Hourly velocity
[agent:result] hourly_velocity = transactions_df.groupBy("cc_num", "hour").agg(
[agent:result]     F.count("*").alias("hourly_transaction_count"),
[agent:result]     F.sum("amount").alias("hourly_amount_sum"),
[agent:result]     F.avg("amount").alias("hourly_avg_amount")
[agent:result] )
[agent:result] 
[agent:result] # Join to transactions
[agent:result] transactions_df = transactions_df.join(card_stats, "cc_num", "left")
[agent:result] transactions_df = transactions_df.join(hourly_velocity, ["cc_num", "hour"], "left").fillna({
[agent:result]     "hourly_transaction_count": 0,
[agent:result]     "hourly_amount_sum": 0.0,
[agent:result]     "hourly_avg_amount": 0.0
[agent:result] })
[agent:result] 
[agent:result] # Time since last transaction
[agent:result] window_spec = Window.partitionBy("cc_num").orderBy("datetime")
[agent:result] transactions_df = transactions_df.withColumn(
[agent:result]     "time_since_last_txn",
[agent:result]     F.coalesce(
[agent:result]         F.unix_timestamp("datetime") - F.lag(F.unix_timestamp("datetime")).over(window_spec),
[agent:result]         0.0
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] # Geo distance
[agent:result] transactions_df = transactions_df.withColumn(
[agent:result]     "geo_distance_from_avg",
[agent:result]     haversine_udf(F.col("lat"), F.col("long"), F.col("card_avg_lat"), F.col("card_avg_long"))
[agent:result] )
[agent:result] 
[agent:result] # Amount deviation
[agent:result] transactions_df = transactions_df.withColumn(
[agent:result]     "amount_z_score",
[agent:result]     F.when((F.col("card_std_amount").isNotNull()) & (F.col("card_std_amount") > 0),
[agent:result]            (F.col("amount") - F.col("card_avg_amount")) / F.col("card_std_amount")).otherwise(0.0)
[agent:result] )
[agent:result] transactions_df = transactions_df.withColumn(
[agent:result]     "amount_ratio_to_avg",
[agent:result]     F.when((F.col("card_avg_amount").isNotNull()) & (F.col("card_avg_amount") > 0),
[agent:result]            F.col("amount") / F.col("card_avg_amount")).otherwise(0.0)
[agent:result] )
[agent:result] 
[agent:result] # Category and merchant frequency
[agent:result] category_freq = transactions_df.groupBy("cc_num", "category").agg(F.count("*").alias("category_freq"))
[agent:result] merchant_freq = transactions_df.groupBy("cc_num", "merchant").agg(F.count("*").alias("merchant_freq"))
[agent:result] transactions_df = transactions_df.join(category_freq, ["cc_num", "category"], "left").fillna({"category_freq": 0})
[agent:result] transactions_df = transactions_df.join(merchant_freq, ["cc_num", "merchant"], "left").fillna({"merchant_freq": 0})
[agent:result] 
[agent:result] # Rolling window
[agent:result] window_spec_5 = Window.partitionBy("cc_num").orderBy("datetime").rowsBetween(-4, 0)
