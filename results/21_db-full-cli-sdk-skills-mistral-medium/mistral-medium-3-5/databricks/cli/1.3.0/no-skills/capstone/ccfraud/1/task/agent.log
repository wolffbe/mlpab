[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read from workspace files
[agent:result] workspace_path = f"/Workspace/Users/benedict@hopsworks.ai/{MLPAB_DATABRICKS_PREFIX}/"
[agent:result] 
[agent:result] # Read transactions with labels
[agent:result] transactions_df = spark.read.csv(
[agent:result]     workspace_path + "transactions.csv",
