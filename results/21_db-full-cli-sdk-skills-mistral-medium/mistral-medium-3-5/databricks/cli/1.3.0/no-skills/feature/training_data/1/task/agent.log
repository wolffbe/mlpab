[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Create Churn Training Dataset
[agent:result] # MAGIC 
[agent:result] # MAGIC This notebook creates a versioned training dataset for churn prediction.
[agent:result] # MAGIC It processes the raw CSV files to create the final dataset with the most recent
[agent:result] # MAGIC feature values for each (account_id, label_time) pair.
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Import necessary libraries
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from pyspark.sql import SparkSession
[agent:result] from pyspark.sql.functions import col, lit, max as spark_max
[agent:result] from pyspark.sql.window import Window
[agent:result] import pyspark.sql.functions as F
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read the CSV files
[agent:result] transactions_df = spark.read.csv("/dbfs/FileStore/data/transactions.csv", header=True, inferSchema=True)
[agent:result] transactions_late_df = spark.read.csv("/dbfs/FileStore/data/transactions_late.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv("/dbfs/FileStore/data/profiles.csv", header=True, inferSchema=True)
[agent:result] activity_df = spark.read.csv("/dbfs/FileStore/data/activity.csv", header=True, inferSchema=True)
[agent:result] account_health_df = spark.read.csv("/dbfs/FileStore/data/account_health.csv", header=True, inferSchema=True)
[agent:result] labels_df = spark.read.csv("/dbfs/FileStore/data/labels.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Combine transactions
[agent:result] all_transactions = transactions_df.unionByName(transactions_late_df)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # For each feature table, find the most recent value for each account_id at or before each label_time
[agent:result] # This is an "as-of" join problem
[agent:result] 
[agent:result] # First, let's create a function to get the most recent values for each account
[agent:result] # We'll use window functions to find the most recent event_time <= label_time for each account
[agent:result] 
[agent:result] # Strategy: For each label row, join with each feature table and find the most recent event_time <= label_time
[agent:result] 
[agent:result] # Let's start by broadcasting the labels since it's small
[agent:result] labels_broadcast = labels_df.collect()
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Alternative approach: Use Spark SQL with window functions
[agent:result] # Create a cross join between labels and each feature table, then filter and find max event_time <= label_time
[agent:result] 
[agent:result] # Register the DataFrames as temp views
[agent:result] all_transactions.createOrReplaceTempView("transactions")
[agent:result] profiles_df.createOrReplaceTempView("profiles")
[agent:result] activity_df.createOrReplaceTempView("activity")
[agent:result] account_health_df.createOrReplaceTempView("account_health")
[agent:result] labels_df.createOrReplaceTempView("labels")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # For transactions - get most recent amount and balance for each account_id at or before label_time
[agent:result] transactions_result = spark.sql("""
[agent:result] WITH ranked_transactions AS (
[agent:result]   SELECT 
[agent:result]     t.account_id,
[agent:result]     t.event_time,
[agent:result]     t.amount,
[agent:result]     t.balance,
[agent:result]     l.label_time,
[agent:result]     l.churned,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY t.account_id, l.label_time ORDER BY t.event_time DESC) as rn
[agent:result]   FROM transactions t
[agent:result]   JOIN labels l ON t.account_id = l.account_id
[agent:result]   WHERE t.event_time <= l.label_time
[agent:result] )
[agent:result] SELECT account_id, label_time, amount, balance, churned
[agent:result] FROM ranked_transactions
[agent:result] WHERE rn = 1
[agent:result] """)
