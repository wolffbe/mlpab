[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Create accounts9ad208 feature table
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read all three batch files from DBFS
[agent:result] batch1_path = "/tmp/mlpab8061c6/batch_1.csv"
[agent:result] batch2_path = "/tmp/mlpab8061c6/batch_2.csv"
[agent:result] batch3_path = "/tmp/mlpab8061c6/batch_3.csv"
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read batch 1
[agent:result] df1 = spark.read.csv(batch1_path, header=True, inferSchema=True)
[agent:result] print(f"Batch 1: {df1.count()} rows")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read batch 2
[agent:result] df2 = spark.read.csv(batch2_path, header=True, inferSchema=True)
[agent:result] print(f"Batch 2: {df2.count()} rows")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read batch 3
[agent:result] df3 = spark.read.csv(batch3_path, header=True, inferSchema=True)
[agent:result] print(f"Batch 3: {df3.count()} rows")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Union all batches
[agent:result] all_df = df1.unionByName(df2).unionByName(df3)
[agent:result] print(f"Total rows before deduplication: {all_df.count()}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Show schema
[agent:result] all_df.printSchema()
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Deduplicate: keep only the latest row per row_id (based on updated_at)
[agent:result] from pyspark.sql.window import Window
[agent:result] from pyspark.sql.functions import row_number, col
[agent:result] 
[agent:result] window_spec = Window.partitionBy("row_id").orderBy(col("updated_at").desc())
[agent:result] 
[agent:result] # Add row number within each row_id group, ordered by updated_at descending
[agent:result] dedup_df = all_df.withColumn("row_num", row_number().over(window_spec)) \
[agent:result]     .filter(col("row_num") == 1) \
[agent:result]     .drop("row_num")
[agent:result] 
[agent:result] print(f"Total rows after deduplication: {dedup_df.count()}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create the table in Unity Catalog
[agent:result] catalog_name = "workspace"
[agent:result] schema_name = "mlpab8061c6"
[agent:result] table_name = "accounts9ad208"
[agent:result] 
[agent:result] full_table_name = f"{catalog_name}.{schema_name}.{table_name}"
[agent:result] 
[agent:result] # Write as Delta table
[agent:result] dedup_df.write.format("delta").mode("overwrite").saveAsTable(full_table_name)
[agent:result] 
[agent:result] print(f"Table created: {full_table_name}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Verify the table
[agent:result] df_result = spark.sql(f"SELECT * FROM {full_table_name} ORDER BY row_id LIMIT 10")
[agent:result] df_result.show()
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Count total rows
[agent:result] total_rows = spark.sql(f"SELECT COUNT(*) FROM {full_table_name}").collect()[0][0]
[agent:result] print(f"Final table row count: {total_rows}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create online table for low-latency access
[agent:result] online_table_name = f"{catalog_name}.{schema_name}.accounts9ad208_online"
[agent:result] 
[agent:result] # Create online table from the Delta table
[agent:result] spark.sql(f"""
[agent:result] CREATE ONLINE TABLE {online_table_name} 
[agent:result] SOURCE TABLE {full_table_name}
[agent:result] """)
[agent:result] 
