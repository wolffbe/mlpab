[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Batch Scoring Notebook
[agent:result] # MAGIC 
[agent:result] # MAGIC This notebook performs batch scoring for all accounts using feature values valid at T = 1773568800000
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] import json
[agent:result] 
[agent:result] # Read feature history from the data directory
[agent:result] # First upload the files to DBFS
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read the CSV files
[agent:result] dbfs_feature_path = "/FileStore/tables/feature_history.csv"
[agent:result] dbfs_model_path = "/FileStore/tables/model.json"
[agent:result] 
[agent:result] # Read feature history
[agent:result] feature_history = spark.read.csv(dbfs_feature_path, header=True, inferSchema=True)
[agent:result] feature_history_pd = feature_history.toPandas()
[agent:result] 
[agent:result] # Read model
[agent:result] with open(dbfs_model_path, "r") as f:
[agent:result]     model = json.load(f)
[agent:result] 
[agent:result] weights = model["weights"]
[agent:result] bias = model["bias"]
[agent:result] 
[agent:result] # T from scoring request
[agent:result] T = 1773568800000
[agent:result] 
[agent:result] # For each account, find the most recent revision at or before T
[agent:result] feature_history_pd["event_time"] = feature_history_pd["event_time"].astype("int64")
[agent:result] filtered = feature_history_pd[feature_history_pd["event_time"] <= T]
[agent:result] 
[agent:result] # Get the latest features for each account at or before T
[agent:result] latest_features = filtered.sort_values("event_time").groupby("account_id").last().reset_index()
[agent:result] 
[agent:result] # Calculate scores using sigmoid
[agent:result] w_f1 = weights["f1"]
[agent:result] w_f2 = weights["f2"]
[agent:result] w_f3 = weights["f3"]
[agent:result] 
[agent:result] def sigmoid(x):
[agent:result]     return 1 / (1 + np.exp(-x))
[agent:result] 
[agent:result] latest_features["linear"] = latest_features["f1"] * w_f1 + latest_features["f2"] * w_f2 + latest_features["f3"] * w_f3 + bias
[agent:result] latest_features["score"] = latest_features["linear"].apply(sigmoid)
[agent:result] latest_features["score"] = latest_features["score"].round(6)
[agent:result] 
[agent:result] # Select only account_id and score
[agent:result] result = latest_features[["account_id", "score"]]
[agent:result] 
[agent:result] # Write to Delta table in Unity Catalog
[agent:result] catalog_schema = "workspace.mlpab258088"
[agent:result] table_name = "scores076684"
[agent:result] 
[agent:result] # Create the table
[agent:result] result_df = spark.createDataFrame(result)
[agent:result] result_df.write.format("delta").mode("overwrite").saveAsTable(f"{catalog_schema}.{table_name}")
[agent:result] 
[agent:result] print("Scoring complete!")
[agent:result] print(f"Created table: {catalog_schema}.{table_name}")
[agent:result] print(f"Number of accounts scored: {len(result)}")
