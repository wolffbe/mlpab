[agent:bash]   SELECT * FROM feature_history_raw
[agent:bash]   WHERE event_time <= 1773568800000
[agent:bash] ),
[agent:bash] ranked AS (
[agent:bash]   SELECT 
[agent:bash]     account_id, f1, f2, f3, event_time,
[agent:bash]     ROW_NUMBER() OVER (PARTITION BY account_id ORDER BY event_time DESC) as rn
[agent:bash]   FROM filtered
[agent:bash] )
