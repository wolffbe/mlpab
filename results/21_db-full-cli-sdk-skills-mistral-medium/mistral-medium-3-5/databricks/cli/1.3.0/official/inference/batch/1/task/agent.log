[agent:bash] CREATE OR REPLACE TEMPORARY VIEW feature_history_raw
[agent:bash] USING csv
[agent:bash] OPTIONS (
[agent:bash]   path '/Volumes/workspace/mlpab258088/mlpab258088_data/feature_history.csv',
