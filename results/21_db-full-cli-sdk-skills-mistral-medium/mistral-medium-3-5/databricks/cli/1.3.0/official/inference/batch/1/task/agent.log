[agent:result] 
[agent:result] # Load model
[agent:result] with open('/Workspace/Users/benedict@logicalclocks.com/mlpab258088/model.json', 'r') as f:
[agent:result]     model = json.load(f)
[agent:result] 
[agent:result] print(f"Model loaded: {model}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Load feature history
[agent:result] df = pd.read_csv('/Workspace/Users/benedict@logicalclocks.com/mlpab258088/feature_history.csv')
[agent:result] print(f"Loaded {len(df)} rows")
[agent:result] print(df.head())
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] T = 1773568800000
[agent:result] 
[agent:result] # Filter and find latest revision for each account at or before T
[agent:result] df_filtered = df[df['event_time'] <= T]
[agent:result] print(f"Filtered to {len(df_filtered)} rows")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Sort by event_time and get latest for each account
[agent:result] df_latest = df_filtered.sort_values('event_time').groupby('account_id').last().reset_index()
[agent:result] print(f"Latest revisions for {len(df_latest)} accounts")
[agent:result] print(df_latest[['account_id', 'event_time']].head())
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute scores
[agent:result] def sigmoid(x):
[agent:result]     return 1 / (1 + np.exp(-x))
[agent:result] 
[agent:result] w_f1, w_f2, w_f3 = model['weights']['f1'], model['weights']['f2'], model['weights']['f3']
[agent:result] bias = model['bias']
[agent:result] 
[agent:result] print(f"Weights: f1={w_f1}, f2={w_f2}, f3={w_f3}, bias={bias}")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] df_latest['linear_comb'] = w_f1 * df_latest['f1'] + w_f2 * df_latest['f2'] + w_f3 * df_latest['f3'] + bias
[agent:result] df_latest['score'] = df_latest['linear_comb'].apply(sigmoid).round(6)
[agent:result] 
[agent:result] result_df = df_latest[['account_id', 'score']]
[agent:result] print("Scores computed:")
[agent:result] print(result_df.head(10))
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create Spark DataFrame and save as Delta table
[agent:result] catalog_name = "workspace"
[agent:result] schema_name = "mlpab258088"
[agent:result] table_name = "scores076684"
[agent:result] 
[agent:result] spark_df = spark.createDataFrame(result_df)
[agent:result] spark_df.write.format("delta").mode("overwrite").saveAsTable(f"{catalog_name}.{schema_name}.{table_name}")
[agent:result] 
