[agent:result] from databricks.feature_store import FeatureStoreClient
[agent:result] import pandas as pd
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] prefix = "mlpab58867e"
[agent:result] user = "benedict@logicalclocks.com"
[agent:result] 
[agent:result] # Read the CSV files
[agent:result] train_df = spark.read.csv(f"/Workspace/Users/{user}/{prefix}/features_train.csv", header=True, inferSchema=True)
[agent:result] serve_df = spark.read.csv(f"/Workspace/Users/{user}/{prefix}/features_serve.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Collect training data to compute statistics
[agent:result] train_local = train_df.collect()
[agent:result] 
[agent:result] # Compute mean and std for each feature
[agent:result] features = ['f1', 'f2', 'f3', 'f4']
[agent:result] means = {}
[agent:result] stds = {}
[agent:result] 
[agent:result] for feature in features:
[agent:result]     values = [row[feature] for row in train_local]
[agent:result]     mean_val = sum(values) / len(values)
[agent:result]     std_val = (sum((x - mean_val) ** 2 for x in values) / len(values)) ** 0.5
[agent:result]     means[feature] = mean_val
[agent:result]     stds[feature] = std_val
[agent:result] 
[agent:result] print("Means:", means)
[agent:result] print("Std devs:", stds)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Standardize the data using Spark
[agent:result] from pyspark.sql.functions import col, lit
[agent:result] 
[agent:result] # Add split column
[agent:result] train_df = train_df.withColumn("split", lit("train"))
[agent:result] serve_df = serve_df.withColumn("split", lit("serve"))
[agent:result] 
[agent:result] # Standardize features
[agent:result] for feature in features:
[agent:result]     mean_val = means[feature]
[agent:result]     std_val = stds[feature]
[agent:result]     train_df = train_df.withColumn(feature, ((col(feature) - lit(mean_val)) / lit(std_val)).cast("double"))
[agent:result]     serve_df = serve_df.withColumn(feature, ((col(feature) - lit(mean_val)) / lit(std_val)).cast("double"))
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Round to 6 decimals
[agent:result] from pyspark.sql.functions import round as spark_round
[agent:result] 
[agent:result] for feature in features:
[agent:result]     train_df = train_df.withColumn(feature, spark_round(col(feature), 6))
[agent:result]     serve_df = serve_df.withColumn(feature, spark_round(col(feature), 6))
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Union both splits
[agent:result] combined_df = train_df.unionByName(serve_df)
[agent:result] 
[agent:result] # Select columns in order: row_id, split, f1, f2, f3, f4
[agent:result] combined_df = combined_df.select("row_id", "split", "f1", "f2", "f3", "f4")
[agent:result] 
