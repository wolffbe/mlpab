[agent:result] all_data = batch1.union(batch2).union(batch3)
[agent:result] 
[agent:result] # For each row_id, keep only the latest revision based on updated_at
[agent:result] from pyspark.sql.functions import col, row_number
[agent:result] from pyspark.sql.window import Window
