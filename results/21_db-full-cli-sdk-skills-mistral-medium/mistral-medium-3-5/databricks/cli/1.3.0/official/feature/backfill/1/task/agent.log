[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Create Feature Table accounts9ad208
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Load the CSV files from workspace
[agent:result] batch1_path = "/Workspace/Users/benedict@logicalclocks.com/mlpab37b986/batch_1.csv"
[agent:result] batch2_path = "/Workspace/Users/benedict@logicalclocks.com/mlpab37b986/batch_2.csv"
[agent:result] batch3_path = "/Workspace/Users/benedict@logicalclocks.com/mlpab37b986/batch_3.csv"
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read all batches
[agent:result] df1 = spark.read.csv(batch1_path, header=True, inferSchema=True)
[agent:result] df2 = spark.read.csv(batch2_path, header=True, inferSchema=True)
[agent:result] df3 = spark.read.csv(batch3_path, header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Union all dataframes
[agent:result] all_df = df1.union(df2).union(df3)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # For each row_id, keep only the row with the latest updated_at
[agent:result] from pyspark.sql.window import Window
[agent:result] from pyspark.sql.functions import row_number, col
[agent:result] 
[agent:result] window_spec = Window.partitionBy("row_id").orderBy(col("updated_at").desc())
[agent:result] latest_df = all_df.withColumn("rank", row_number().over(window_spec)) \
[agent:result]                 .filter(col("rank") == 1) \
[agent:result]                 .drop("rank")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Write to Delta table in Unity Catalog
[agent:result] catalog_name = "workspace"
[agent:result] schema_name = "mlpab37b986"
[agent:result] table_name = "accounts9ad208"
[agent:result] 
[agent:result] output_path = f"/Volumes/{catalog_name}/{schema_name}/{table_name}"
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Save as Delta table
[agent:result] latest_df.write.format("delta").mode("overwrite").save(output_path)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create the table in Unity Catalog
