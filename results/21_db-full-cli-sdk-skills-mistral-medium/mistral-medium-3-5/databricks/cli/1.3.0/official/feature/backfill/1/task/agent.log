[agent:result] content: # Load the CSV files from volume
[agent:result] batch1_path = "/Volumes/workspace/mlpab37b986/accounts9ad208_volume/batch_1.csv"
[agent:result] batch2_path = "/Volumes/workspace/mlpab37b986/accounts9ad208_volume/batch_2.csv"
[agent:result] batch3_path = "/Volumes/workspace/mlpab37b986/accounts9ad208_volume/batch_3.csv"
[agent:result] 
[agent:result] print("Reading CSV files...")
[agent:result] df1 = spark.read.csv(batch1_path, header=True, inferSchema=True)
[agent:result] df2 = spark.read.csv(batch2_path, header=True, inferSchema=True)
[agent:result] df3 = spark.read.csv(batch3_path, header=True, inferSchema=True)
[agent:result] 
[agent:result] print("Unioning...")
[agent:result] all_df = df1.union(df2).union(df3)
[agent:result] 
[agent:result] print("Deduplicating...")
[agent:result] from pyspark.sql.window import Window
[agent:result] from pyspark.sql.functions import row_number, col
[agent:result] 
[agent:result] window_spec = Window.partitionBy("row_id").orderBy(col("updated_at").desc())
[agent:result] latest_df = all_df.withColumn("rank", row_number().over(window_spec)) \
[agent:result]                 .filter(col("rank") == 1) \
[agent:result]                 .drop("rank")
[agent:result] 
[agent:result] print(f"Total rows after deduplication: {latest_df.count()}")
[agent:result] 
[agent:result] print("Saving as table...")
[agent:result] # Save as table in Unity Catalog
[agent:result] latest_df.write.format("delta").mode("overwrite").saveAsTable("workspace.mlpab37b986.accounts9ad208")
[agent:result] print("Saved as table workspace.mlpab37b986.accounts9ad208")
[agent:result] 
