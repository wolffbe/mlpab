[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # Create Training Dataset using SQL
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %sql
[agent:result] # Create temporary views from the CSV files
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # First, let's read the CSV files and create temporary views
[agent:result] # We'll use the workspace files
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] import os
[agent:result] 
[agent:result] # Get environment variables
[agent:result] schema_name = os.environ.get('MLPAB_DATABRICKS_SCHEMA', 'workspace.mlpaba01c0d')
[agent:result] prefix = os.environ.get('MLPAB_DATABRICKS_PREFIX', 'mlpaba01c0d')
[agent:result] workspace_path = f"/Workspace/Users/benedict@logicalclocks.com/{prefix}/data"
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read CSV files and create temp views
[agent:result] labels_df = spark.read.csv(f"{workspace_path}/labels.csv", header=True, inferSchema=True)
[agent:result] labels_df.createOrReplaceTempView("labels")
[agent:result] 
[agent:result] transactions_df = spark.read.csv(f"{workspace_path}/transactions.csv", header=True, inferSchema=True)
[agent:result] transactions_late_df = spark.read.csv(f"{workspace_path}/transactions_late.csv", header=True, inferSchema=True)
[agent:result] all_transactions = transactions_df.unionByName(transactions_late_df)
[agent:result] all_transactions.createOrReplaceTempView("all_transactions")
[agent:result] 
[agent:result] profiles_df = spark.read.csv(f"{workspace_path}/profiles.csv", header=True, inferSchema=True)
[agent:result] profiles_df.createOrReplaceTempView("profiles")
[agent:result] 
[agent:result] activity_df = spark.read.csv(f"{workspace_path}/activity.csv", header=True, inferSchema=True)
[agent:result] activity_df.createOrReplaceTempView("activity")
[agent:result] 
[agent:result] account_health_df = spark.read.csv(f"{workspace_path}/account_health.csv", header=True, inferSchema=True)
[agent:result] account_health_df.createOrReplaceTempView("account_health")
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # MAGIC %sql
[agent:result] # Create the training dataset using SQL
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Extract catalog and schema
[agent:result] if '.' in schema_name:
[agent:result]     catalog, schema = schema_name.split('.', 1)
[agent:result] else:
[agent:result]     catalog = 'workspace'
[agent:result]     schema = schema_name
[agent:result] 
[agent:result] table_name = 'churntraining580502'
[agent:result] full_table_name = f'{catalog}.{schema}.{table_name}'
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Use SQL to create the final dataset
[agent:result] query = f"""
[agent:result] WITH 
[agent:result] -- Get most recent transaction for each (account_id, label_time)
[agent:result] recent_transactions AS (
[agent:result]   SELECT 
[agent:result]     l.account_id,
[agent:result]     l.label_time,
[agent:result]     t.amount,
[agent:result]     t.balance,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY t.event_time DESC) as rn
[agent:result]   FROM labels l
[agent:result]   JOIN all_transactions t ON l.account_id = t.account_id AND t.event_time <= l.label_time
[agent:result] ),
[agent:result] 
[agent:result] -- Get most recent profile for each (account_id, label_time)
[agent:result] recent_profiles AS (
[agent:result]   SELECT 
[agent:result]     l.account_id,
[agent:result]     l.label_time,
[agent:result]     p.credit_score,
[agent:result]     p.tier,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY p.event_time DESC) as rn
[agent:result]   FROM labels l
[agent:result]   JOIN profiles p ON l.account_id = p.account_id AND p.event_time <= l.label_time
[agent:result] ),
[agent:result] 
[agent:result] -- Get most recent activity for each (account_id, label_time)
[agent:result] recent_activity AS (
[agent:result]   SELECT 
[agent:result]     l.account_id,
[agent:result]     l.label_time,
[agent:result]     a.sessions_7d,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY a.event_time DESC) as rn
[agent:result]   FROM labels l
[agent:result]   JOIN activity a ON l.account_id = a.account_id AND a.event_time <= l.label_time
[agent:result] ),
[agent:result] 
[agent:result] -- Get most recent health for each (account_id, label_time)
[agent:result] recent_health AS (
[agent:result]   SELECT 
[agent:result]     l.account_id,
[agent:result]     l.label_time,
[agent:result]     h.health_score,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY l.account_id, l.label_time ORDER BY h.event_time DESC) as rn
[agent:result]   FROM labels l
[agent:result]   JOIN account_health h ON l.account_id = h.account_id AND h.event_time <= l.label_time
[agent:result] )
[agent:result] 
[agent:result] SELECT 
[agent:result]   l.account_id,
[agent:result]   l.label_time,
[agent:result]   rt.amount,
[agent:result]   rt.balance,
[agent:result]   rp.credit_score,
[agent:result]   rp.tier,
[agent:result]   ra.sessions_7d,
[agent:result]   rh.health_score,
[agent:result]   l.churned
[agent:result] FROM labels l
[agent:result] LEFT JOIN recent_transactions rt ON l.account_id = rt.account_id AND l.label_time = rt.label_time AND rt.rn = 1
[agent:result] LEFT JOIN recent_profiles rp ON l.account_id = rp.account_id AND l.label_time = rp.label_time AND rp.rn = 1
[agent:result] LEFT JOIN recent_activity ra ON l.account_id = ra.account_id AND l.label_time = ra.label_time AND ra.rn = 1
[agent:result] LEFT JOIN recent_health rh ON l.account_id = rh.account_id AND l.label_time = rh.label_time AND rh.rn = 1
[agent:result] """
[agent:result] 
[agent:result] # Execute the query
[agent:result] result_df = spark.sql(query)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Save as Unity Catalog table
[agent:result] result_df.writeTo(f'{catalog}.{schema}.{table_name}').create()
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] print(f"Training dataset created: {full_table_name}")
[agent:result] print(f"Row count: {result_df.count()}")
[agent:result] print(f"Expected row count: {labels_df.count()}")
[agent:result] 
[agent:result] # Verify we have the correct number of rows
[agent:result] assert result_df.count() == labels_df.count(), f"Row count mismatch: {result_df.count()} != {labels_df.count()}"
[agent:result] 
[agent:result] # Add version comment
[agent:result] spark.sql(f"COMMENT ON TABLE {full_table_name} IS 'Version 1 - Churn training dataset'")
[agent:result] 
