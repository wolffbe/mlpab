[agent:result] # Function to get most recent features for each (account_id, label_time)
[agent:result] def get_most_recent_features(feature_df, feature_columns, label_df, join_col='account_id', time_col='event_time'):
[agent:result]     """
[agent:result]     For each (account_id, label_time) in label_df, get the most recent feature values 
[agent:result]     from feature_df where event_time <= label_time.
[agent:result]     """
[agent:result]     # Join feature_df with label_df on account_id
[agent:result]     joined = feature_df.join(label_df, on=join_col)
[agent:result]     
[agent:result]     # Filter to event_time <= label_time
[agent:result]     filtered = joined.filter(F.col(time_col) <= F.col('label_time'))
[agent:result]     
[agent:result]     # For each (account_id, label_time), get the most recent row based on event_time
[agent:result]     window_spec = Window.partitionBy(join_col, 'label_time').orderBy(F.col(time_col).desc())
[agent:result]     ranked = filtered.withColumn('row_num', F.row_number().over(window_spec))
[agent:result]     
[agent:result]     # Get only the most recent row
[agent:result]     most_recent = ranked.filter(F.col('row_num') == 1).drop('row_num', time_col)
[agent:result]     
[agent:result]     # Select the columns we need
[agent:result]     result_cols = [join_col, 'label_time'] + feature_columns
[agent:result]     result = most_recent.select(*result_cols)
[agent:result]     
[agent:result]     return result
[agent:result] 
