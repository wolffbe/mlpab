[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Create Feature Table features7ab995
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read the data from workspace
[agent:result] transactions_df = spark.read.csv("/Workspace/transactions.csv", header=True, inferSchema=True)
[agent:result] fx_rates_df = spark.read.csv("/Workspace/fx_rates.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql.functions import broadcast
[agent:result] 
[agent:result] # Join with fx_rates to get amount_usd
[agent:result] transactions_with_fx = transactions_df.join(
[agent:result]     broadcast(fx_rates_df), 
[agent:result]     transactions_df.currency == fx_rates_df.currency,
[agent:result]     "left"
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql.functions import col, lit, when, to_timestamp, date_format, sum as _sum
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Calculate amount_usd
[agent:result] result_df = transactions_with_fx.withColumn(
[agent:result]     "amount_usd", 
[agent:result]     col("amount") * col("fx_rate")
[agent:result] )
[agent:result] 
[agent:result] # Calculate is_weekend (1 if Saturday or Sunday UTC, else 0)
[agent:result] from pyspark.sql.functions import dayofweek
[agent:result] 
[agent:result] result_df = result_df.withColumn(
[agent:result]     "event_time_timestamp", 
[agent:result]     to_timestamp(col("event_time") / 1000)
[agent:result] )
[agent:result] 
[agent:result] # dayofweek() returns 1=Sunday, 2=Monday, ..., 7=Saturday
[agent:result] result_df = result_df.withColumn(
[agent:result]     "day_of_week", 
[agent:result]     dayofweek(col("event_time_timestamp"))
[agent:result] )
[agent:result] 
[agent:result] # is_weekend = 1 if day_of_week is 1 (Sunday) or 7 (Saturday), else 0
[agent:result] result_df = result_df.withColumn(
[agent:result]     "is_weekend", 
[agent:result]     when(col("day_of_week").isin([1, 7]), lit(1)).otherwise(lit(0))
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Calculate amount_7d: sum of THIS account's amount over the 7 days up to and including the row's event_time
