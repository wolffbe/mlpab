[agent:result] all_data = batch1.union(batch2).union(batch3)
[agent:result] 
[agent:result] # For each row_id, keep only the latest revision based on updated_at
[agent:result] from pyspark.sql.functions import col, row_number
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] window_spec = Window.partitionBy("row_id").orderBy(col("updated_at").desc())
[agent:result] latest_data = all_data.withColumn("rank", row_number().over(window_spec)) \
[agent:result]     .filter(col("rank") == 1) \
[agent:result]     .drop("rank")
[agent:result] 
[agent:result] # Write to the existing Delta table
