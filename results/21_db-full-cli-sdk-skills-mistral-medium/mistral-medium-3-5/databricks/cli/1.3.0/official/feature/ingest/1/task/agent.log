[agent:result] # Read all three batch files from /Workspace
[agent:result] batch1 = spark.read.csv("/Workspace/batch_1.csv", header=True, inferSchema=True)
[agent:result] batch2 = spark.read.csv("/Workspace/batch_2.csv", header=True, inferSchema=True)
