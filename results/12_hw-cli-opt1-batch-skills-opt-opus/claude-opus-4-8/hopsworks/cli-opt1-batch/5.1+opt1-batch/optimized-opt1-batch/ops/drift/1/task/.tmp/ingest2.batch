fg delete drift_features --version 1
fg create drift_features --version 1 --primary-key entity_id --features "entity_id:string,event_time:string,f1:double,f2:double,f3:double,f4:double,f5:double,f6:double" --description "daily feature stream for drift investigation"
fg insert drift_features --version 1 --file data/features.csv
fg preview drift_features --version 1 --n 5
