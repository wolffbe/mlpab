[agent:bash] python3 -c "
[agent:bash] import pandas as pd
[agent:bash] import numpy as np
[agent:bash] 
[agent:bash] # Load data
[agent:bash] df = pd.read_csv('data/airquality_history.csv', parse_dates=['date'])
[agent:bash] 
[agent:bash] # Sort by date to compute lags and rolling features
[agent:bash] df = df.sort_values('date').reset_index(drop=True)
[agent:bash] 
[agent:bash] # Lag features
[agent:bash] df['pm25_lag2'] = df['pm25'].shift(2)
[agent:bash] df['pm25_lag3'] = df['pm25'].shift(3)
[agent:bash] 
[agent:bash] # Rolling features
[agent:bash] df['pm25_rolling_3d'] = df['pm25'].rolling(3, min_periods=1).mean()
[agent:bash] df['pm25_rolling_7d'] = df['pm25'].rolling(7, min_periods=1).mean()
[agent:bash] 
[agent:bash] # Interaction feature
[agent:bash] df['temp_humidity_interaction'] = df['temperature'] * df['humidity']
[agent:bash] 
[agent:bash] # Drop rows with NaN (due to lags)
[agent:bash] df = df.dropna()
[agent:bash] 
[agent:bash] # Save enriched data
[agent:bash] df.to_csv('data/airquality_history_enriched.csv', index=False)
[agent:bash] "
