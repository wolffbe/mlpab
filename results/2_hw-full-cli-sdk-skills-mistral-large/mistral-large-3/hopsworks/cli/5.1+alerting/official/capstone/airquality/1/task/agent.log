[agent:result]     name="airqpred2408fa",
[agent:result]     version=1,
[agent:result]     description="Predictions for PM2.5 forecasting",
[agent:result]     primary_key=["date"],
[agent:result]     online_enabled=True,
[agent:result] )
[agent:result] 
[agent:result] # Insert predictions
[agent:result] fg_pred.insert(forecast_df[["date", "pm25_pred"]], write_options={"wait_for_job": True})
