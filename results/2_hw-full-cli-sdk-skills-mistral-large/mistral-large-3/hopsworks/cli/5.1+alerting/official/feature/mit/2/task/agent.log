[agent:bash] hops sql """
[agent:bash] -- Create temporary views for the input files
[agent:bash] CREATE OR REPLACE VIEW transactions_view AS
[agent:bash] SELECT * FROM hive.`mlpabe7ae20_featurestore`.`resources`
[agent:bash] WHERE name = 'transactions.csv';
[agent:bash] 
[agent:bash] CREATE OR REPLACE VIEW fx_rates_view AS
[agent:bash] SELECT * FROM hive.`mlpabe7ae20_featurestore`.`resources`
[agent:bash] WHERE name = 'fx_rates.csv';
[agent:bash] 
[agent:bash] -- Compute the derived features and insert into the feature group
[agent:bash] INSERT INTO feature_store.features13a256_1
[agent:bash] WITH joined_data AS (
[agent:bash]   SELECT
[agent:bash]     t.row_id,
[agent:bash]     t.account_id,
[agent:bash]     t.event_time,
[agent:bash]     t.amount,
[agent:bash]     t.currency,
[agent:bash]     f.fx_rate,
[agent:bash]     -- amount_usd = amount * fx_rate
[agent:bash]     t.amount * f.fx_rate AS amount_usd,
[agent:bash]     -- is_weekend = 1 if event_time is Saturday/Sunday (UTC), else 0
[agent:bash]     CASE
[agent:bash]       WHEN dayofweek(from_unixtime(t.event_time / 1000)) IN (1, 7) THEN 1
[agent:bash]       ELSE 0
[agent:bash]     END AS is_weekend
[agent:bash]   FROM transactions_view t
[agent:bash]   JOIN fx_rates_view f ON t.currency = f.currency
[agent:bash] ),
[agent:bash] -- Compute amount_7d: sum of THIS account's amount over the last 7 days (inclusive)
[agent:bash] windowed_data AS (
[agent:bash]   SELECT
[agent:bash]     row_id,
[agent:bash]     account_id,
[agent:bash]     event_time,
[agent:bash]     amount,
[agent:bash]     currency,
[agent:bash]     fx_rate,
[agent:bash]     amount_usd,
[agent:bash]     is_weekend,
[agent:bash]     SUM(amount) OVER (
[agent:bash]       PARTITION BY account_id
[agent:bash]       ORDER BY event_time
[agent:bash]       RANGE BETWEEN INTERVAL '7' DAY PRECEDING AND CURRENT ROW
[agent:bash]     ) AS amount_7d
[agent:bash]   FROM joined_data
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   row_id,
[agent:bash]   account_id,
[agent:bash]   event_time,
[agent:bash]   amount_usd,
[agent:bash]   is_weekend,
[agent:bash]   amount_7d
[agent:bash] FROM windowed_data;
[agent:bash] """
