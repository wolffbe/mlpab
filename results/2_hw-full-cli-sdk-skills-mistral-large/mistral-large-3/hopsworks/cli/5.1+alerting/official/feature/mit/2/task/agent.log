[agent] Now, I will use the Hopsworks CLI (`hops`) to create the feature group `features13a256`, version 1, with the required schema and transformations. The feature group will be configured for both offline and online access.
[agent:bash] hops feature-group create --name features13a256 --version 1 --description "Derived feature table for transactions with USD conversion, weekend flag, and 7-day rolling sum." --primary-key row_id --event-time event_time --online-enabled true --features row_id:STRING,account_id:STRING,event_time:BIGINT,amount_usd:DOUBLE,is_weekend:INT,amount_7d:DOUBLE --transformations """
[agent:bash] {
[agent:bash]   "amount_usd": {
[agent:bash]     "type": "js",
[agent:bash]     "script": "function transform(row) {
[agent:bash]       const fxRates = {\"EUR\": 1.09, \"SEK\": 0.095, \"GBP\": 1.27, \"USD\": 1.0};
[agent:bash]       const fxRate = fxRates[row.currency] || 1.0;
[agent:bash]       return row.amount * fxRate;
[agent:bash]     }"
[agent:bash]   },
[agent:bash]   "is_weekend": {
[agent:bash]     "type": "js",
[agent:bash]     "script": "function transform(row) {
[agent:bash]       const eventTime = new Date(row.event_time);
[agent:bash]       const dayOfWeek = eventTime.getUTCDay();
[agent:bash]       return (dayOfWeek === 6 || dayOfWeek === 0) ? 1 : 0;
[agent:bash]     }"
[agent:bash]   },
[agent:bash]   "amount_7d": {
[agent:bash]     "type": "window_aggregation",
[agent:bash]     "window": "7d",
[agent:bash]     "aggregation": "sum",
[agent:bash]     "feature": "amount",
[agent:bash]     "group_by": ["account_id"]
[agent:bash]   }
[agent:bash] }
[agent:bash] """ --input "data/transactions.csv" --input "data/fx_rates.csv"
