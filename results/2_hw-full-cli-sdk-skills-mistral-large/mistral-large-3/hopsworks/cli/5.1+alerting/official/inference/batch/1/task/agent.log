[agent:result] # Filter for most recent revision at or before T
[agent:result] T = 1773496800000
[agent:result] filtered = feature_history[feature_history["event_time"] <= T]
[agent:result] filtered = filtered.sort_values("event_time").groupby("account_id").last().reset_index()
[agent:result] 
