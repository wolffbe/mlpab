[agent:result] bytes_written: 2343
[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Compute top-5 recommendations for every user and save to a CSV.
[agent:result] This script runs on Hopsworks.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Download input files
[agent:result] dataset_api = project.get_dataset_api()
[agent:result] 
[agent:result] dataset_api.download("Resources/interactions.csv")
[agent:result] dataset_api.download("Resources/user_embeddings.csv")
[agent:result] dataset_api.download("Resources/item_embeddings.csv")
[agent:result] 
[agent:result] # Load data
[agent:result] interactions = pd.read_csv("interactions.csv")
[agent:result] user_embeddings = pd.read_csv("user_embeddings.csv")
[agent:result] item_embeddings = pd.read_csv("item_embeddings.csv")
[agent:result] 
[agent:result] # Extract embedding columns (e1..e8)
[agent:result] embedding_cols = [f"e{i}" for i in range(1, 9)]
[agent:result] user_embeddings_values = user_embeddings[embedding_cols].values
[agent:result] item_embeddings_values = item_embeddings[embedding_cols].values
[agent:result] 
[agent:result] # Prepare output
[agent:result] recommendations = []
[agent:result] 
[agent:result] # For each user
[agent:result] for idx, user_row in user_embeddings.iterrows():
[agent:result]     user_id = user_row["user_id"]
[agent:result]     user_embedding = user_embeddings_values[idx]
[agent:result]     
[agent:result]     # Get items the user has already interacted with
[agent:result]     interacted_items = set(interactions[interactions["user_id"] == user_id]["item_id"])
[agent:result]     
[agent:result]     # Compute dot products for all items
[agent:result]     scores = []
[agent:result]     for item_idx, item_row in item_embeddings.iterrows():
[agent:result]         item_id = item_row["item_id"]
[agent:result]         if item_id in interacted_items:
[agent:result]             continue
[agent:result]         item_embedding = item_embeddings_values[item_idx]
[agent:result]         score = np.dot(user_embedding, item_embedding)
[agent:result]         scores.append((item_id, score))
[agent:result]     
[agent:result]     # Sort by descending score, ascending item_id for ties
[agent:result]     scores.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
[agent:result]     # Take top-5
[agent:result]     top_5 = scores[:5]
[agent:result]     
[agent:result]     # Add to recommendations
[agent:result]     for rank, (item_id, _) in enumerate(top_5, start=1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             "rec_id": rec_id,
[agent:result]             "user_id": user_id,
[agent:result]             "rank": rank,
[agent:result]             "item_id": item_id
[agent:result]         })
[agent:result] 
[agent:result] # Convert to DataFrame
[agent:result] recommendations_df = pd.DataFrame(recommendations)
[agent:result] 
[agent:result] # Save to CSV
[agent:result] output_path = "recommendations.csv"
[agent:result] recommendations_df.to_csv(output_path, index=False)
[agent:result] 
[agent:result] # Upload to Hopsworks
[agent:result] dataset_api.upload(output_path, "Resources", overwrite=True)
[agent:result] 
[agent:result] print("Recommendations saved and uploaded to Hopsworks.")
