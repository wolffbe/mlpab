[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Batch-score every account using the feature values valid at time T.
[agent:result] Produces a feature table named `scores770373`, version 1, with schema (account_id, score).
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] import json
[agent:result] 
[agent:result] # As-of timestamp T (epoch milliseconds)
[agent:result] T = 1773496800000
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Read the feature history and model
[agent:result] feature_history_path = project.get_resource_files().download("feature_history.csv")
[agent:result] model_path = project.get_resource_files().download("model.json")
[agent:result] 
[agent:result] with open(model_path, "r") as f:
[agent:result]     model = json.load(f)
[agent:result] 
[agent:result] weights = model["weights"]
[agent:result] bias = model["bias"]
[agent:result] 
[agent:result] df = pd.read_csv(feature_history_path)
[agent:result] # Convert event_time to numeric (in case it's read as string)
[agent:result] df["event_time"] = pd.to_numeric(df["event_time"])
[agent:result] 
[agent:result] # Filter to the most recent revision per account_id at or before T
[agent:result] df = df[df["event_time"] <= T]
[agent:result] df = df.sort_values("event_time", ascending=False).drop_duplicates("account_id")
[agent:result] 
[agent:result] # Compute the score: sigmoid(w_f1*f1 + w_f2*f2 + w_f3*f3 + bias)
[agent:result] logits = (
[agent:result]     weights["f1"] * df["f1"] +
[agent:result]     weights["f2"] * df["f2"] +
[agent:result]     weights["f3"] * df["f3"] +
[agent:result]     bias
[agent:result] )
[agent:result] scores = 1 / (1 + np.exp(-logits))
[agent:result] df["score"] = scores.round(6)
[agent:result] 
[agent:result] # Keep only account_id and score
[agent:result] df = df[["account_id", "score"]]
[agent:result] 
[agent:result] # Create the target feature group
[agent:result] fg = fs.create_feature_group(
[agent:result]     name="scores770373",
[agent:result]     version=1,
[agent:result]     primary_key=["account_id"],
[agent:result]     description="Batch scores for every account as of T=1773496800000 (2026-03-14T14:00:00Z).",
[agent:result]     online=True,
[agent:result] )
[agent:result] 
[agent:result] # Insert the data
[agent:result] fg.insert(df, write_options={"wait_for_job": True})
[agent] ---
