[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Compute top-5 recommendations for every user:
[agent:result] - relevance = dot product of user embedding and item embedding
[agent:result] - exclude items the user has already interacted with
[agent:result] - rank 1 = highest relevance; break ties by ascending item_id
[agent:result] - write to feature group `recsc757d5`, version 1, with schema:
[agent:result]   rec_id (key), user_id, rank (1..5), item_id
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Read data
[agent:result] interactions_df = pd.read_csv("/Projects/mlpabb9d930/Resources/recsys_data/interactions.csv")
[agent:result] user_embeddings_df = pd.read_csv("/Projects/mlpabb9d930/Resources/recsys_data/user_embeddings.csv")
[agent:result] item_embeddings_df = pd.read_csv("/Projects/mlpabb9d930/Resources/recsys_data/item_embeddings.csv")
[agent:result] 
[agent:result] # Melt embeddings for dot product
[agent:result] user_embeddings = user_embeddings_df.set_index("user_id")[["e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8"]].values
[agent:result] item_embeddings = item_embeddings_df.set_index("item_id")[["e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8"]].values
[agent:result] 
[agent:result] # Compute dot products for all user-item pairs
[agent:result] all_items = item_embeddings_df["item_id"].values
[agent:result] all_users = user_embeddings_df["user_id"].values
[agent:result] 
[agent:result] # Broadcast dot product
[agent:result] user_embeddings_bc = user_embeddings[:, np.newaxis, :]  # (U, 1, 8)
[agent:result] item_embeddings_bc = item_embeddings[np.newaxis, :, :]  # (1, I, 8)
[agent:result] dot_products = np.sum(user_embeddings_bc * item_embeddings_bc, axis=2)  # (U, I)
[agent:result] 
[agent:result] # Build DataFrame for ranking
[agent:result] dot_df = pd.DataFrame(dot_products, index=all_users, columns=all_items)
[agent:result] 
[agent:result] # Exclude interacted items
[agent:result] interacted_items = interactions_df.groupby("user_id")["item_id"].apply(set)
[agent:result] for user_id in all_users:
[agent:result]     interacted = interacted_items.get(user_id, set())
[agent:result]     dot_df.loc[user_id, list(interacted)] = -np.inf
[agent:result] 
[agent:result] # Rank: top-5 by descending dot product, ascending item_id for ties
[agent:result] def rank_items(row):
[agent:result]     ranked = row.sort_values(ascending=False).reset_index()
[agent:result]     ranked.columns = ["item_id", "score"]
[agent:result]     ranked["rank"] = ranked["score"].rank(method="first", ascending=False).astype(int)
[agent:result]     ranked = ranked.sort_values(["rank", "item_id"]).head(5)
[agent:result]     ranked["user_id"] = row.name
[agent:result]     return ranked
[agent:result] 
[agent:result] ranked_dfs = []
[agent:result] for user_id in all_users:
[agent:result]     ranked_dfs.append(rank_items(dot_df.loc[user_id]))
[agent:result] 
[agent:result] result_df = pd.concat(ranked_dfs)
