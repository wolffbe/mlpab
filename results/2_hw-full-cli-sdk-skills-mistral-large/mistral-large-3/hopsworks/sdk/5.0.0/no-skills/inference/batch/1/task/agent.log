[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Batch-score every account using feature values valid at time T.
[agent:result] Produces a feature table named `scores770373`, version 1, on Hopsworks.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] 
[agent:result] # As-of timestamp (epoch milliseconds)
[agent:result] T = 1773496800000
[agent:result] 
[agent:result] # Model weights and bias
[agent:result] model = {
[agent:result]     "weights": {
[agent:result]         "f1": -0.1231,
[agent:result]         "f2": 0.8633,
[agent:result]         "f3": -0.0404
[agent:result]     },
[agent:result]     "bias": -0.4371
[agent:result] }
[agent:result] 
[agent:result] # Sigmoid function
[agent:result] def sigmoid(x):
[agent:result]     return 1 / (1 + np.exp(-x))
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Load feature history
[agent:result] feature_history_df = pd.read_csv("data/feature_history.csv")
[agent:result] 
[agent:result] # Convert event_time to numeric (in case it's read as string)
[agent:result] feature_history_df["event_time"] = pd.to_numeric(feature_history_df["event_time"])
[agent:result] 
[agent:result] # Filter: most recent revision at or before T for each account
[agent:result] filtered_df = (
[agent:result]     feature_history_df[feature_history_df["event_time"] <= T]
[agent:result]     .sort_values("event_time", ascending=False)
[agent:result]     .drop_duplicates("account_id", keep="first")
[agent:result]     .copy()
[agent:result] )
[agent:result] 
[agent:result] # Compute score: sigmoid(w_f1*f1 + w_f2*f2 + w_f3*f3 + bias)
[agent:result] filtered_df["score"] = sigmoid(
[agent:result]     model["weights"]["f1"] * filtered_df["f1"] +
[agent:result]     model["weights"]["f2"] * filtered_df["f2"] +
[agent:result]     model["weights"]["f3"] * filtered_df["f3"] +
[agent:result]     model["bias"]
[agent:result] )
[agent:result] 
[agent:result] # Round to 6 decimal places
[agent:result] filtered_df["score"] = filtered_df["score"].round(6)
[agent:result] 
[agent:result] # Prepare the final DataFrame for the feature table
[agent:result] scores_df = filtered_df[["account_id", "score"]].reset_index(drop=True)
[agent:result] 
[agent:result] # Create feature table
[agent:result] scores_fg = fs.create_feature_group(
[agent:result]     name="scores770373",
[agent:result]     version=1,
[agent:result]     description="Batch scores for accounts as of T=1773496800000",
[agent:result]     primary_key=["account_id"],
[agent:result]     online_enabled=True,  # Enable low-latency lookup
[agent:result] )
[agent:result] 
[agent:result] # Insert data
[agent:result] scores_fg.insert(scores_df)
[agent:result] 
[agent:result] print("Feature table 'scores770373', version 1, created successfully.")
