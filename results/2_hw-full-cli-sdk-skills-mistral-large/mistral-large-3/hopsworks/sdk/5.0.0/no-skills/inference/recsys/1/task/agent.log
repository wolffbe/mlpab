[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Generate recommendations for every user and upload to Hopsworks.
[agent:result] """
[agent:result] 
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] import hopsworks
[agent:result] 
[agent:result] # Load data
[agent:result] interactions_df = pd.read_csv("data/interactions.csv")
[agent:result] user_embeddings_df = pd.read_csv("data/user_embeddings.csv")
[agent:result] item_embeddings_df = pd.read_csv("data/item_embeddings.csv")
[agent:result] 
[agent:result] # Parse embeddings
[agent:result] user_embeddings = {}
[agent:result] for _, row in user_embeddings_df.iterrows():
[agent:result]     user_id = row["user_id"]
[agent:result]     embedding = row["e1":"e8"].values.astype(np.float32)
[agent:result]     user_embeddings[user_id] = embedding
[agent:result] 
[agent:result] item_embeddings = {}
[agent:result] for _, row in item_embeddings_df.iterrows():
[agent:result]     item_id = row["item_id"]
[agent:result]     embedding = row["e1":"e8"].values.astype(np.float32)
[agent:result]     item_embeddings[item_id] = embedding
[agent:result] 
[agent:result] # Get all unique user_ids and item_ids
[agent:result] user_ids = list(user_embeddings.keys())
[agent:result] item_ids = list(item_embeddings.keys())
[agent:result] 
[agent:result] # Generate recommendations
[agent:result] recommendations = []
[agent:result] for user_id in user_ids:
[agent:result]     # Get user embedding
[agent:result]     user_embedding = user_embeddings[user_id]
[agent:result]     
[agent:result]     # Get items the user has already interacted with
[agent:result]     interacted_items = interactions_df[interactions_df["user_id"] == user_id]["item_id"].tolist()
[agent:result]     
[agent:result]     # Compute dot products for all items
[agent:result]     scores = []
[agent:result]     for item_id in item_ids:
[agent:result]         if item_id in interacted_items:
[agent:result]             continue
[agent:result]         item_embedding = item_embeddings[item_id]
[agent:result]         score = np.dot(user_embedding, item_embedding)
[agent:result]         scores.append((item_id, score))
[agent:result]     
[agent:result]     # Sort by score (descending) and item_id (ascending for ties)
[agent:result]     scores.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     top_items = scores[:5]
[agent:result]     
[agent:result]     # Format recommendations
[agent:result]     for rank, (item_id, score) in enumerate(top_items, start=1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             "rec_id": rec_id,
[agent:result]             "user_id": user_id,
[agent:result]             "rank": rank,
[agent:result]             "item_id": item_id
[agent:result]         })
[agent:result] 
[agent:result] # Convert to DataFrame
[agent:result] recommendations_df = pd.DataFrame(recommendations)
[agent:result] 
[agent:result] # Upload to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Create feature group
[agent:result] fg = fs.create_feature_group(
[agent:result]     name="recsc757d5",
[agent:result]     version=1,
[agent:result]     description="Top-5 recommendations for every user, ranked by relevance (dot product).",
[agent:result]     primary_key=["rec_id"],
[agent:result]     online_enabled=True,
[agent:result]     expectation_suite=None
[agent:result] )
[agent:result] 
[agent:result] # Upload data
[agent:result] fg.insert(recommendations_df, write_options={"wait_for_job": True})
[agent:result] 
[agent:result] print("Recommendations uploaded successfully.")
