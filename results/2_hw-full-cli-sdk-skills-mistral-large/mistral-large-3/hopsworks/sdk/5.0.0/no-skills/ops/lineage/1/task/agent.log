[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Script to create feature groups on Hopsworks platform and derive a new feature group.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import os
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Read source data
[agent:result] raw_a = pd.read_csv("data/raw_a.csv")
[agent:result] raw_b = pd.read_csv("data/raw_b.csv")
[agent:result] 
[agent:result] # Create feature groups for raw tables
[agent:result] rawa_fg = fs.create_feature_group(
[agent:result]     name="rawa7b4d0b",
[agent:result]     version=1,
[agent:result]     description="Raw feature group from raw_a.csv",
[agent:result]     primary_key=["row_id"],
[agent:result]     online_enabled=True,
