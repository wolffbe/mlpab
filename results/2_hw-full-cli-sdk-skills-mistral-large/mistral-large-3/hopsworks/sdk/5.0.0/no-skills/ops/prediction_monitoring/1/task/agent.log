[agent:bash] python3 -c "
[agent:bash] import hopsworks
[agent:bash] import pandas as pd
[agent:bash] 
[agent:bash] # Connect to Hopsworks
[agent:bash] project = hopsworks.login()
[agent:bash] fs = project.get_feature_store()
[agent:bash] 
[agent:bash] # Read the prediction log
[agent:bash] prediction_log = pd.read_csv('data/prediction_log.csv')
[agent:bash] 
[agent:bash] # Create a feature group for the prediction logs
[agent:bash] fg = fs.create_feature_group(
[agent:bash]     name='prediction_logs',
[agent:bash]     version=1,
[agent:bash]     description='Logged predictions from a deployed model',
[agent:bash]     primary_key=['ts'],
[agent:bash]     event_time='ts',
[agent:bash]     online_enabled=False,
[agent:bash]     statistics_config={'enabled': True, 'histograms': True, 'correlations': True}
[agent:bash] )
[agent:bash] 
[agent:bash] # Save the data to the feature group
[agent:bash] fg.save(prediction_log)
[agent:bash] 
[agent:bash] # Enable monitoring for distribution shift
