[agent:result] def validate_row(row):
[agent:result]     """Validate a single row against the contract rules."""
[agent:result]     # Rule 1: amount is present
[agent:result]     if pd.isna(row["amount"]) or row["amount"] == "":
[agent:result]         return False
[agent:result]     
[agent:result]     # Rule 2: amount is within [0, 10000]
[agent:result]     try:
[agent:result]         amount = float(row["amount"])
[agent:result]         if not (MIN_AMOUNT <= amount <= MAX_AMOUNT):
[agent:result]             return False
[agent:result]     except (ValueError, TypeError):
[agent:result]         return False
[agent:result]     
[agent:result]     # Rule 3: category is one of the allowed values
[agent:result]     if row["category"] not in VALID_CATEGORIES:
[agent:result]         return False
[agent:result]     
[agent:result]     return True
