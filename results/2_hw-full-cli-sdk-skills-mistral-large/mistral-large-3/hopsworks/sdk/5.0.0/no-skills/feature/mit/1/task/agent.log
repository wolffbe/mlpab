[agent:result]         description='Derived feature table with transaction features',
[agent:result]         primary_key=['row_id'],
[agent:result]         event_time='event_time',
[agent:result]         online_enabled=True,  # Enable online/real-time access
[agent:result]         features=features
[agent:result]     )
[agent:result]     
[agent:result]     # Insert data
