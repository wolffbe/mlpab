[agent:result]     
[agent:result]     # Define feature group schema
[agent:result]     features = [
[agent:result]         Feature('row_id', 'String', description='Unique row identifier', primary=True),
[agent:result]         Feature('account_id', 'String', description='Account identifier'),
[agent:result]         Feature('event_time', 'BigInt', description='Event timestamp in epoch milliseconds'),
[agent:result]         Feature('amount_usd', 'Float', description='Transaction amount in USD'),
[agent:result]         Feature('is_weekend', 'Int32', description='1 if event is on weekend, else 0'),
[agent:result]         Feature('amount_7d', 'Float', description='7-day rolling sum of amount for this account')
[agent:result]     ]
[agent:result]     
