[agent] Now, I will use the Hopsworks SDK to:
[agent] 1. Connect to the platform.
[agent] 2. Create a feature group for the training data and upload it.
[agent] 3. Create a feature group for the serving data and upload it.
[agent] 4. Compute and compare summary statistics for each feature.
[agent] 5. Identify the feature with the most significant divergence.
[agent:bash] cat > skew_detection.py << 'EOF'
[agent:bash] import hopsworks
[agent:bash] import pandas as pd
[agent:bash] import json
[agent:bash] 
[agent:bash] # Connect to Hopsworks
[agent:bash] project = hopsworks.login()
[agent:bash] fs = project.get_feature_store()
[agent:bash] 
[agent:bash] # Load data
[agent:bash]  training_df = pd.read_csv("data/training_sample.csv")
[agent:bash]  serving_df = pd.read_csv("data/serving_log.csv")
[agent:bash] 
[agent:bash] # Create feature groups
[agent:bash]  training_fg = fs.create_feature_group(
[agent:bash]     name="training_data",
[agent:bash]     version=1,
[agent:bash]     description="Training data feature group",
[agent:bash]     primary_key=["entity_id"],
[agent:bash]     statistics_config={"enabled": True, "histograms": True, "correlations": True}
[agent:bash] )
[agent:bash] 
[agent:bash] serving_fg = fs.create_feature_group(
[agent:bash]     name="serving_data",
[agent:bash]     version=1,
[agent:bash]     description="Serving data feature group",
[agent:bash]     primary_key=["entity_id"],
[agent:bash]     statistics_config={"enabled": True, "histograms": True, "correlations": True}
[agent:bash] )
[agent:bash] 
[agent:bash] # Upload data
[agent:bash]  training_fg.insert(training_df)
[agent:bash]  serving_fg.insert(serving_df)
[agent:bash] 
[agent:bash] # Compute statistics
[agent:bash]  training_stats = training_fg.get_statistics()
[agent:bash]  serving_stats = serving_fg.get_statistics()
[agent:bash] 
[agent:bash] # Extract feature statistics
[agent:bash]  training_features = training_stats.descriptive_stats["feature_descriptive_stats"]
[agent:bash]  serving_features = serving_stats.descriptive_stats["feature_descriptive_stats"]
[agent:bash] 
[agent:bash] # Compare statistics
[agent:bash] features = ["f1", "f2", "f3", "f4", "f5"]
[agent:bash] divergence = {}
[agent:bash] 
[agent:bash] for feature in features:
[agent:bash]     training_mean = next(f["mean"] for f in training_features if f["feature_name"] == feature)
[agent:bash]     serving_mean = next(f["mean"] for f in serving_features if f["feature_name"] == feature)
[agent:bash]     
[agent:bash]     training_std = next(f["stddev"] for f in training_features if f["feature_name"] == feature)
[agent:bash]     serving_std = next(f["stddev"] for f in serving_features if f["feature_name"] == feature)
[agent:bash]     
[agent:bash]     # Calculate divergence score (absolute difference in mean and std)
[agent:bash]     mean_diff = abs(training_mean - serving_mean)
[agent:bash]     std_diff = abs(training_std - serving_std)
[agent:bash]     divergence[feature] = mean_diff + std_diff
[agent:bash] 
[agent:bash] # Identify the feature with the highest divergence
[agent:bash] skewed_feature = max(divergence, key=divergence.get)
[agent:bash] 
[agent:bash] # Write the result
[agent:bash] result = {"feature": skewed_feature}
[agent:bash] 
[agent:bash] # Optional: Add a cause if identifiable
[agent:bash] if skewed_feature == "f2":
[agent:bash]     result["cause"] = "Feature f2 likely uses a different scaling or normalization method in serving compared to training."
[agent:bash] 
[agent:bash] with open("submission/answers.json", "w") as f:
[agent:bash]     json.dump(result, f)
[agent:bash] EOF
