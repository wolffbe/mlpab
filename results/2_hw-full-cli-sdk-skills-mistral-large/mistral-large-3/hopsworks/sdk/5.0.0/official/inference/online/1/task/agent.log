[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Ingest feature profiles into Hopsworks and retrieve feature vectors for lookup keys.
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import json
[agent:result] import os
[agent:result] 
[agent:result] # Load data
[agent:result] features_df = pd.read_csv("data/features.csv")
[agent:result] with open("data/lookup_keys.txt", "r") as f:
[agent:result]     lookup_keys = [line.strip() for line in f.readlines()]
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Create feature group
[agent:result] feature_group = fs.create_feature_group(
[agent:result]     name="profiles1daac7",
[agent:result]     version=1,
[agent:result]     description="Account feature profiles",
[agent:result]     primary_key=["account_id"],
[agent:result]     online_enabled=True,
[agent:result] )
[agent:result] 
[agent:result] # Ingest data
[agent:result] feature_group.insert(features_df, write_options={"wait_for_job": True})
[agent:result] 
[agent:result] # Retrieve feature vectors via online API
[agent:result] feature_view = fs.create_feature_view(
[agent:result]     name="profiles1daac7_fv",
[agent:result]     version=1,
[agent:result]     query=feature_group.select_all()
[agent:result] )
[agent:result] 
[agent:result] # Fetch feature vectors for lookup keys
[agent:result] vectors = {}
[agent:result] for account_id in lookup_keys:
[agent:result]     try:
[agent:result]         feature_vector = feature_view.get_feature_vector(
[agent:result]             entry={"account_id": account_id},
[agent:result]             return_type="dict"
[agent:result]         )
[agent:result]         vectors[account_id] = [
[agent:result]             feature_vector["f1"],
[agent:result]             feature_vector["f2"],
[agent:result]             feature_vector["f3"],
[agent:result]             feature_vector["f4"]
[agent:result]         ]
[agent:result]     except Exception as e:
[agent:result]         print(f"Failed to fetch features for {account_id}: {e}")
[agent:result] 
[agent:result] # Write results
[agent:result] with open("submission/answers.json", "w") as f:
[agent:result]     json.dump({"vectors": vectors}, f, indent=2)
[agent:result] 
[agent:result] print("Done.")
