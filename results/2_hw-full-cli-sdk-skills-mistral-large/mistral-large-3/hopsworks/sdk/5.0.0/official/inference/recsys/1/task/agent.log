[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Compute top-5 recommendations for every user and upload to Hopsworks as a feature table.
[agent:result] """
[agent:result] 
[agent:result] import os
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] import hopsworks
[agent:result] 
[agent:result] 
[agent:result] def main():
[agent:result]     # Load data
[agent:result]     interactions = pd.read_csv("data/interactions.csv")
[agent:result]     user_embeddings = pd.read_csv("data/user_embeddings.csv")
[agent:result]     item_embeddings = pd.read_csv("data/item_embeddings.csv")
[agent:result]     
[agent:result]     # Extract embedding columns (e1..e8)
[agent:result]     user_emb_cols = [f"e{i}" for i in range(1, 9)]
[agent:result]     item_emb_cols = [f"e{i}" for i in range(1, 9)]
[agent:result]     
[agent:result]     # Convert embeddings to numpy arrays
[agent:result]     user_embeddings_array = user_embeddings[user_emb_cols].values
[agent:result]     item_embeddings_array = item_embeddings[item_emb_cols].values
[agent:result]     
[agent:result]     # Prepare output DataFrame
[agent:result]     output_rows = []
[agent:result]     
[agent:result]     # Iterate over each user
[agent:result]     for idx, user_row in user_embeddings.iterrows():
[agent:result]         user_id = user_row["user_id"]
[agent:result]         user_emb = user_embeddings_array[idx]
[agent:result]         
[agent:result]         # Get items the user has already interacted with
[agent:result]         interacted_items = interactions[interactions["user_id"] == user_id]["item_id"].tolist()
[agent:result]         
[agent:result]         # Compute dot products for all items
[agent:result]         scores = []
[agent:result]         for item_idx, item_row in item_embeddings.iterrows():
[agent:result]             item_id = item_row["item_id"]
[agent:result]             if item_id in interacted_items:
[agent:result]                 continue
[agent:result]             item_emb = item_embeddings_array[item_idx]
[agent:result]             score = np.dot(user_emb, item_emb)
[agent:result]             scores.append((item_id, score))
[agent:result]         
[agent:result]         # Sort by descending score, then ascending item_id for ties
[agent:result]         scores.sort(key=lambda x: (-x[1], x[0]))
[agent:result]         
[agent:result]         # Select top 5
[agent:result]         top_5 = scores[:5]
[agent:result]         
[agent:result]         # Format output rows
[agent:result]         for rank, (item_id, _) in enumerate(top_5, start=1):
[agent:result]             rec_id = f"{user_id}#{rank}"
[agent:result]             output_rows.append({
[agent:result]                 "rec_id": rec_id,
[agent:result]                 "user_id": user_id,
[agent:result]                 "rank": rank,
[agent:result]                 "item_id": item_id
[agent:result]             })
[agent:result]     
[agent:result]     # Create output DataFrame
[agent:result]     output_df = pd.DataFrame(output_rows)
[agent:result]     
[agent:result]     # Connect to Hopsworks
[agent:result]     project = hopsworks.login()
[agent:result]     fs = project.get_feature_store()
[agent:result]     
[agent:result]     # Create feature group
[agent:result]     rec_fg = fs.create_feature_group(
[agent:result]         name="recsc757d5",
[agent:result]         version=1,
[agent:result]         description="Top-5 recommended items for every user, ranked by dot-product relevance.",
[agent:result]         primary_key=["rec_id"],
[agent:result]         online_enabled=True,
[agent:result]     )
[agent:result]     
[agent:result]     # Upload data
[agent:result]     rec_fg.insert(output_df)
[agent:result]     
[agent:result]     print("Feature table 'recsc757d5', version 1, created successfully.")
[agent:result] 
[agent:result] 
[agent:result] if __name__ == "__main__":
[agent:result]     main()
