[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Full FTI pipeline for credit-card fraud detection on Hopsworks.
[agent:result] 1. Engineer fraud features into feature group `cctxnc444ca`.
[agent:result] 2. Assemble training dataset `cctdc444ca`.
[agent:result] 3. Train and register classifier `ccmodelc444ca` with metrics (remote job).
[agent:result] 4. Score `score_transactions.csv` into feature table `ccpredc444ca` (remote job).
[agent:result] """
[agent:result] 
[agent:result] import hopsworks
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Load data
[agent:result] transactions_df = pd.read_csv("data/transactions.csv", parse_dates=["datetime"])
[agent:result] score_transactions_df = pd.read_csv("data/score_transactions.csv", parse_dates=["datetime"])
[agent:result] 
[agent:result] # --- Feature Engineering ---
[agent:result] def engineer_features(df):
[agent:result]     # Transaction velocity: count of transactions in the last 1 hour
[agent:result]     df = df.sort_values(by=["cc_num", "datetime"])
[agent:result]     df["transaction_velocity_1h"] = df.groupby("cc_num")["transaction_id"].transform(
[agent:result]         lambda x: x.rolling("1h", on="datetime").count()
[agent:result]     )
[agent:result]     
[agent:result]     # Transaction velocity: count of transactions in the last 24 hours
[agent:result]     df["transaction_velocity_24h"] = df.groupby("cc_num")["transaction_id"].transform(
[agent:result]         lambda x: x.rolling("24h", on="datetime").count()
[agent:result]     )
[agent:result]     
[agent:result]     # Amount statistics: rolling mean and std of transaction amounts in the last 24 hours
[agent:result]     df["amount_mean_24h"] = df.groupby("cc_num")["amount"].transform(
[agent:result]         lambda x: x.rolling("24h", on="datetime").mean()
[agent:result]     )
[agent:result]     df["amount_std_24h"] = df.groupby("cc_num")["amount"].transform(
[agent:result]         lambda x: x.rolling("24h", on="datetime").std()
[agent:result]     )
[agent:result]     
[agent:result]     # Geo distance: distance from the card's first transaction location
[agent:result]     df["first_lat"] = df.groupby("cc_num")["lat"].transform("first")
[agent:result]     df["first_long"] = df.groupby("cc_num")["long"].transform("first")
[agent:result]     df["geo_distance"] = np.sqrt(
[agent:result]         (df["lat"] - df["first_lat"]) ** 2 + (df["long"] - df["first_long"]) ** 2
[agent:result]     )
[agent:result]     
[agent:result]     # Time since last transaction
[agent:result]     df["time_since_last_tx"] = df.groupby("cc_num")["datetime"].diff().dt.total_seconds() / 3600
[agent:result]     
[agent:result]     # Fill NaN values (first transactions for a card)
[agent:result]     df = df.fillna({
[agent:result]         "transaction_velocity_1h": 1,
[agent:result]         "transaction_velocity_24h": 1,
[agent:result]         "amount_mean_24h": df["amount"],
[agent:result]         "amount_std_24h": 0,
[agent:result]         "geo_distance": 0,
[agent:result]         "time_since_last_tx": 24,
[agent:result]     })
[agent:result]     
[agent:result]     return df
[agent:result] 
