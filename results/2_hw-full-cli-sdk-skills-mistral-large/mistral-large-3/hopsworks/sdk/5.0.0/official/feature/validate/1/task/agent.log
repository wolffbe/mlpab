[agent:bash]     for row in reader:
[agent:bash]         row_id = row['row_id']
[agent:bash]         amount = row['amount']
[agent:bash]         category = row['category'].strip().lower()
[agent:bash]         
[agent:bash]         # Rule 1: amount is present
[agent:bash]         if not amount or amount.strip() == '':
[agent:bash]             rejected.append(row_id)
[agent:bash]             continue
[agent:bash]             
[agent:bash]         try:
[agent:bash]             amount_float = float(amount)
[agent:bash]         except ValueError:
[agent:bash]             rejected.append(row_id)
[agent:bash]             continue
[agent:bash]         
[agent:bash]         # Rule 2: amount is within [0, 10000]
[agent:bash]         if not (0 <= amount_float <= 10000):
[agent:bash]             rejected.append(row_id)
[agent:bash]             continue
[agent:bash]         
[agent:bash]         # Rule 3: category is valid
[agent:bash]         if category not in valid_categories:
[agent:bash]             rejected.append(row_id)
[agent:bash]             continue
[agent:bash]         
[agent:bash]         valid_rows.append(row)
[agent:bash] 
[agent:bash] # Write rejected row IDs to submission/answers.json
[agent:bash] with open('submission/answers.json', 'w') as f:
[agent:bash]     json.dump({'rejected': rejected}, f, indent=2)
[agent:bash] 
[agent:bash] # Write valid rows to a temporary CSV for Hopsworks ingestion
[agent:bash] with open('submission/valid_events.csv', 'w') as f:
[agent:bash]     if valid_rows:
[agent:bash]         writer = csv.DictWriter(f, fieldnames=valid_rows[0].keys())
[agent:bash]         writer.writeheader()
[agent:bash]         writer.writerows(valid_rows)
[agent:bash] "
