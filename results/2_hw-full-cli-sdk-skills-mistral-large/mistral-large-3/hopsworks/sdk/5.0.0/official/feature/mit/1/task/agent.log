[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Ingest transformed transaction data into Hopsworks Feature Group.
[agent:result] """
[agent:result] import os
[agent:result] import pandas as pd
[agent:result] import hopsworks
[agent:result] from datetime import datetime, timedelta
[agent:result] 
[agent:result] # Connect to Hopsworks
[agent:result] project = hopsworks.login()
[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Load data
[agent:result] transactions = pd.read_csv("data/transactions.csv")
[agent:result] fx_rates = pd.read_csv("data/fx_rates.csv")
[agent:result] 
[agent:result] # Join transactions with fx_rates
[agent:result] transactions = transactions.merge(fx_rates, on="currency", how="left")
[agent:result] transactions["amount_usd"] = transactions["amount"] * transactions["fx_rate"]
[agent:result] 
[agent:result] # Convert event_time to datetime (epoch milliseconds)
[agent:result] transactions["event_time_dt"] = pd.to_datetime(transactions["event_time"], unit="ms", utc=True)
[agent:result] 
[agent:result] # Compute is_weekend
[agent:result] transactions["is_weekend"] = transactions["event_time_dt"].dt.weekday.apply(
[agent:result]     lambda x: 1 if x >= 5 else 0
[agent:result] )
[agent:result] 
[agent:result] # Compute amount_7d (7-day rolling sum for each account)
[agent:result] def rolling_7d_sum(group):
[agent:result]     return group.rolling("7D", on="event_time_dt")["amount"].sum()
[agent:result] 
[agent:result] transactions["amount_7d"] = (
[agent:result]     transactions
[agent:result]     .sort_values("event_time_dt")
[agent:result]     .groupby("account_id", group_keys=False)
[agent:result]     .apply(rolling_7d_sum)
[agent:result] )
[agent:result] 
[agent:result] # Prepare the final DataFrame for ingestion
[agent:result] feature_df = transactions[["row_id", "account_id", "event_time", "amount_usd", "is_weekend", "amount_7d"]]
[agent:result] 
[agent:result] # Create or get the Feature Group
[agent:result] feature_group = fs.get_or_create_feature_group(
[agent:result]     name="features1af3ec",
[agent:result]     version=1,
[agent:result]     description="Transaction features for account-level analysis",
[agent:result]     primary_key=["row_id"],
[agent:result]     event_time="event_time",
[agent:result]     online_enabled=True,  # Enable online (low-latency) access
[agent:result] )
[agent:result] 
[agent:result] # Ingest data
[agent:result] feature_group.insert(feature_df, write_options={"wait_for_job": True})
[agent:result] 
[agent:result] print("Feature Group 'features1af3ec', version 1, created and ingested successfully.")
