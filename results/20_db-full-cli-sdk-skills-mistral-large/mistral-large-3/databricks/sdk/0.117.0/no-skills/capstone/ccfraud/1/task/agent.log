ng ---\n# Index categorical columns\ncategory_indexer = StringIndexer(inputCol=\"category\", outputCol=\"category_idx\")\nmerchant_indexer = StringIndexer(inputCol=\"merchant\", outputCol=\"merchant_idx\")\n\n# Assemble features\nfeature_cols = [\n    \"amount\", \"txn_velocity_1h\", \"txn_velocity_24h\", \n    \"amount_velocity_1h\", \"amount_velocity_24h\", \n    \"geo_distance_km\", \"amount_zscore\", \n    \"category_idx\", \"merchant_idx\"\n]\nassembler = VectorAssembler(inputCols=feature_cols, outputCol=\"features\")\n\n# --- Model ---\nrf = RandomForestClassifier(\n    labelCol=\"is_fraud\",\n    featuresCol=\"features\",\n    numTrees=100,\n    maxDepth=5,\n    seed=42\n)\n\n# --- Pipeline ---\npipeline = Pipeline(stages=[category_indexer, merchant_indexer, assembler, rf])\n\n# --- Train/Test Split ---\ntrain_data, test_data = df.randomSplit([0.8, 0.2], seed=42)\n\n# --- Train ---\nmodel = pipeline.fit(train_data)\n\n# --- Evaluate ---\npredictions = model.transform(test_data)\nevaluator = BinaryClassificationEvaluator(\n    labelCol=\"is_fraud\",\n    rawPredictionCol=\"rawPrediction\",\n    metricName=\"areaUnderROC\"\n)\nroc_auc = evaluator.evaluate(predictions)\n\n# --- Log Metrics and Register Model ---\nmlflow.set_experiment(f\"/Users/{args.schema.split('.')[1]}/{args.model_name}\")\n\nwith mlflow.start_run():\n    mlflow.log_metric(\"roc_auc\", roc_auc)\n    mlflow.spark.log_model(model, \"model\")\n    mlflow.set_tag(\"schema\", args.schema)\n    mlflow.set_tag(\"training_table\", args.training_table)\n    \n    # Register the model\n    mlflow.register_model(\n        f\"runs:/{mlflow.active_run().info.run_id}/model\",\n        f\"{args.schema}.{args.model_name}\"\n    )\n\nprint(f\"Model {args.schema}.{args.model_name} trained and registered with ROC AUC: {roc_auc:.4f}\")"}
