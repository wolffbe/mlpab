[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Feature Engineering for Fraud Detection
[agent:result] # MAGIC 
[agent:result] # MAGIC This notebook engineers fraud-specific features from transaction data:
[agent:result] # MAGIC - Transaction velocity (1h, 24h)
[agent:result] # MAGIC - Amount velocity (1h, 24h)
[agent:result] # MAGIC - Geo distance from card's usual location
[agent:result] # MAGIC - Amount z-score
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] import math
[agent:result] 
[agent:result] # --- Input/Output ---
[agent:result] input_path = spark.conf.get("input.path")
[agent:result] output_table = spark.conf.get("output.table")
[agent:result] 
[agent:result] # --- Read Data ---
[agent:result] df = spark.read.csv(input_path, header=True, inferSchema=True)
[agent:result] 
[agent:result] # --- Feature Engineering ---
[agent:result] # 1. Transaction Velocity (1h, 24h)
[agent:result] window_1h = Window.partitionBy("cc_num").orderBy("datetime").rangeBetween(-3600, 0)
[agent:result] window_24h = Window.partitionBy("cc_num").orderBy("datetime").rangeBetween(-86400, 0)
[agent:result] 
[agent:result] df = df.withColumn("txn_velocity_1h", F.count("*").over(window_1h) - 1)
[agent:result] 
[agent:result] df = df.withColumn("txn_velocity_24h", F.count("*").over(window_24h) - 1)
[agent:result] 
[agent:result] # 2. Amount Velocity (1h, 24h)
[agent:result] df = df.withColumn("amount_velocity_1h", F.sum("amount").over(window_1h) - F.col("amount"))
[agent:result] 
[agent:result] df = df.withColumn("amount_velocity_24h", F.sum("amount").over(window_24h) - F.col("amount"))
[agent:result] 
[agent:result] # 3. Geo Distance (Haversine formula)
[agent:result] def haversine(lat1, lon1, lat2, lon2):
[agent:result]     """Calculate the great-circle distance between two points on the Earth."""
[agent:result]     R = 6371  # Earth radius in km
[agent:result]     dLat = math.radians(lat2 - lat1)
[agent:result]     dLon = math.radians(lon2 - lon1)
[agent:result]     a = (math.sin(dLat / 2) * math.sin(dLat / 2) +
[agent:result]          math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) *
[agent:result]          math.sin(dLon / 2) * math.sin(dLon / 2))
[agent:result]     c = 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))
[agent:result]     return R * c
[agent:result] 
[agent:result] haversine_udf = F.udf(haversine)
[agent:result] 
[agent:result] # Calculate the card's usual location (median lat/long)
[agent:result] usual_location = df.groupBy("cc_num").agg(
[agent:result]     F.median("lat").alias("usual_lat"),
[agent:result]     F.median("long").alias("usual_long")
[agent:result] )
[agent:result] 
[agent:result] df = df.join(usual_location, on="cc_num", how="left")
[agent:result] 
[agent:result] df = df.withColumn("geo_distance_km", haversine_udf(F.col("usual_lat"), F.col("usual_long"), F.col("lat"), F.col("long")))
[agent:result] 
[agent:result] # 4. Amount Z-Score (per card)
[agent:result] stats = df.groupBy("cc_num").agg(
[agent:result]     F.mean("amount").alias("mean_amount"),
[agent:result]     F.stddev("amount").alias("std_amount")
[agent:result] )
[agent:result] 
[agent:result] df = df.join(stats, on="cc_num", how="left")
[agent:result] 
[agent:result] df = df.withColumn("amount_zscore", (F.col("amount") - F.col("mean_amount")) / F.col("std_amount"))
[agent:result] 
[agent:result] # --- Write to Feature Table ---
[agent:result] (df.write
[agent:result]    .format("delta")
[agent:result]    .mode("overwrite")
[agent:result]    .saveAsTable(output_table))
