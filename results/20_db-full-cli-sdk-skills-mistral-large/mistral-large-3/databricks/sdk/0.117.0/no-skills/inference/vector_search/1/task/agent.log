[agent:result] def create_source_table():
[agent:result]     """Create a Delta table to hold the item embeddings."""
[agent:result]     table_name = f"{DATABRICKS_SCHEMA}.items568016_source_table"
[agent:result]     
[agent:result]     # Read items.csv and prepare data for ingestion
[agent:result]     items = []
[agent:result]     with open("data/items.csv", "r") as f:
[agent:result]         lines = f.readlines()[1:]  # Skip header
[agent:result]         for line in lines:
[agent:result]             parts = line.strip().split(",", 2)
[agent:result]             item_id = parts[0]
[agent:result]             embedding = parts[1].strip('"')
[agent:result]             items.append({"item_id": item_id, "embedding": embedding})
[agent:result]     
[agent:result]     # Create a DataFrame and save as a Delta table
[agent:result]     spark = w.spark_session
[agent:result]     df = spark.createDataFrame(items)
[agent:result]     df.write.saveAsTable(table_name, mode="overwrite")
[agent:result]     print(f"Created source table {table_name}.")
[agent:result] 
[agent:result] 
[agent:result] def sync_index():
[agent:result]     """Sync the vector search index with the source table."""
[agent:result]     index = w.vector_search_indexes.get_index(ENDPOINT_NAME, INDEX_NAME)
[agent:result]     index.sync_index_and_wait()
[agent:result]     print("Index synced.")
[agent:result] 
[agent:result] 
[agent:result] def perform_searches():
[agent:result]     """Perform vector similarity searches for all queries."""
[agent:result]     index = w.vector_search_indexes.get_index(ENDPOINT_NAME, INDEX_NAME)
[agent:result]     
[agent:result]     # Read queries.csv
[agent:result]     queries = []
[agent:result]     with open("data/queries.csv", "r") as f:
[agent:result]         lines = f.readlines()[1:]  # Skip header
[agent:result]         for line in lines:
[agent:result]             parts = line.strip().split(",", 1)
[agent:result]             query_id = parts[0]
[agent:result]             embedding = json.loads(parts[1].strip('"'))
[agent:result]             queries.append({"query_id": query_id, "embedding": embedding})
[agent:result]     
[agent:result]     # Perform searches
[agent:result]     neighbors = {}
[agent:result]     for query in queries:
[agent:result]         results = index.similarity_search(
[agent:result]             query_vector=query["embedding"],
[agent:result]             columns=["item_id"],
[agent:result]             num_results=5
[agent:result]         )
[agent:result]         neighbor_ids = [result["item_id"] for result in results.result.data_array]
[agent:result]         neighbors[query["query_id"]] = neighbor_ids
[agent:result]     
[agent:result]     return neighbors
[agent:result] 
[agent:result] 
[agent:result] def main():
[agent:result]     """Main workflow."""
[agent:result]     # Create resources
[agent:result]     create_vector_search_endpoint()
[agent:result]     create_source_table()
[agent:result]     create_vector_search_index()
[agent:result]     sync_index()
[agent:result]     
[agent:result]     # Perform searches
[agent:result]     neighbors = perform_searches()
[agent:result]     
[agent:result]     # Write results
[agent:result]     result = {
[agent:result]         "store": INDEX_NAME,
[agent:result]         "neighbors": neighbors
[agent:result]     }
[agent:result]     with open("submission/answers.json", "w") as f:
[agent:result]         json.dump(result, f, indent=2)
