[agent:result] def brute_force_search():
[agent:result]     """Perform brute-force search locally."""
[agent:result]     items, item_embeddings, queries, query_embeddings = load_embeddings()
[agent:result]     
[agent:result]     neighbors = {}
[agent:result]     for i, query_embedding in enumerate(query_embeddings):
[agent:result]         distances = np.linalg.norm(item_embeddings - query_embedding, axis=1)
[agent:result]         nearest_indices = np.argsort(distances)[:5]
[agent:result]         nearest_items = [items[idx] for idx in nearest_indices]
[agent:result]         neighbors[queries[i]] = nearest_items
[agent:result]     
[agent:result]     return neighbors
