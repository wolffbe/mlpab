[agent:result] def retrieve_online_features(account_ids):
[agent:result]     """Retrieve feature vectors for the given account_ids via the online store."""
[agent:result]     full_table_name = f"{SCHEMA}.{FEATURE_TABLE_NAME}"
[agent:result]     online_table_name = f"{PREFIX}_online_{FEATURE_TABLE_NAME}"
[agent:result]     
[agent:result]     # Get the online table
[agent:result]     online_table = w.online_tables.get(online_table_name)
[agent:result]     
[agent:result]     # Retrieve feature vectors
[agent:result]     vectors = {}
[agent:result]     for account_id in account_ids:
[agent:result]         try:
[agent:result]             row = w.online_tables.query(
[agent:result]                 online_table_name=online_table_name,
[agent:result]                 keys=[account_id]
[agent:result]             )
[agent:result]             if row and row.data_array:
[agent:result]                 # Extract feature values in order f1, f2, f3, f4
[agent:result]                 feature_values = [
[agent:result]                     row.data_array[0].values[1],  # f1
[agent:result]                     row.data_array[0].values[2],  # f2
[agent:result]                     row.data_array[0].values[3],  # f3
[agent:result]                     row.data_array[0].values[4]   # f4
[agent:result]                 ]
[agent:result]                 vectors[account_id] = feature_values
[agent:result]         except Exception as e:
[agent:result]             print(f"Error retrieving features for {account_id}: {e}")
[agent:result]     
[agent:result]     return vectors
