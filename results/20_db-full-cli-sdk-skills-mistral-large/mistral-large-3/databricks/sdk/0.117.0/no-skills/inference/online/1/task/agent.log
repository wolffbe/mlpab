[agent:result] 
[agent:result] 
[agent:result] def create_feature_table():
[agent:result]     """Create a feature table in Unity Catalog and enable online access."""
[agent:result]     full_table_name = f"{SCHEMA}.{FEATURE_TABLE_NAME}"
[agent:result]     
[agent:result]     # Check if the table already exists
[agent:result]     try:
[agent:result]         w.tables.get(full_table_name)
[agent:result]         print(f"Table {full_table_name} already exists. Skipping creation.")
[agent:result]         return full_table_name
[agent:result]     except Exception:
[agent:result]         pass
[agent:result]     
[agent:result]     # Create a temporary volume to stage the CSV
[agent:result]     volume_name = f"{PREFIX}_temp_volume"
[agent:result]     full_volume_name = f"{SCHEMA}.{volume_name}"
[agent:result]     
[agent:result]     try:
[agent:result]         w.volumes.create(
[agent:result]             catalog_name=SCHEMA.split(".")[0],
[agent:result]             schema_name=SCHEMA.split(".")[1],
[agent:result]             name=volume_name,
[agent:result]             volume_type=catalog.VolumeType.MANAGED
[agent:result]         )
[agent:result]     except Exception as e:
[agent:result]         print(f"Volume may already exist: {e}")
[agent:result]     
[agent:result]     # Upload the CSV to the volume
[agent:result]     volume_path = f"/Volumes/{SCHEMA.split('.')[0]}/{SCHEMA.split('.')[1]}/{volume_name}"
[agent:result]     dbfs_path = f"{volume_path}/features.csv"
[agent:result]     
[agent:result]     w.dbfs.upload(data_path, dbfs_path, overwrite=True)
[agent:result]     
[agent:result]     # Create the feature table using SQL
[agent:result]     create_table_sql = f"""
[agent:result]     CREATE TABLE {full_table_name} (
[agent:result]         account_id STRING,
[agent:result]         f1 DOUBLE,
[agent:result]         f2 DOUBLE,
[agent:result]         f3 DOUBLE,
[agent:result]         f4 DOUBLE
[agent:result]     )
[agent:result]     USING DELTA
[agent:result]     LOCATION '{volume_path}/feature_table'
[agent:result]     AS SELECT * FROM csv.`{dbfs_path}`
[agent:result]     """
[agent:result]     
[agent:result]     w.statement_execution.execute_statement(
[agent:result]         warehouse_id=w.warehouses.list()[0].id,
[agent:result]         catalog=SCHEMA.split(".")[0],
[agent:result]         schema=SCHEMA.split(".")[1],
[agent:result]         statement=create_table_sql
[agent:result]     ).result()
[agent:result]     
[agent:result]     # Enable online table for low-latency access
[agent:result]     online_table_name = f"{PREFIX}_online_{FEATURE_TABLE_NAME}"
[agent:result]     
[agent:result]     w.online_tables.create(
[agent:result]         name=online_table_name,
[agent:result]         primary_key_columns=[RECORD_KEY],
[agent:result]         source_table_full_name=full_table_name,
[agent:result]         run_triggered=True
[agent:result]     )
[agent:result]     
[agent:result]     return full_table_name
[agent:result] 
