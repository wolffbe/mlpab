[agent:bash] python3 -c "
[agent:bash] import os
[agent:bash] import json
[agent:bash] import databricks.sdk
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service import catalog, sql
[agent:bash] 
[agent:bash] # Load environment variables
[agent:bash] schema_name = os.getenv('MLPAB_DATABRICKS_SCHEMA')
[agent:bash] prefix = os.getenv('MLPAB_DATABRICKS_PREFIX')
[agent:bash] 
[agent:bash] if not schema_name:
[agent:bash]     raise ValueError('MLPAB_DATABRICKS_SCHEMA environment variable not set')
[agent:bash] 
[agent:bash] # Initialize WorkspaceClient
[agent:bash] w = WorkspaceClient()
[agent:bash] 
[agent:bash] # Extract catalog and schema from schema_name (format: 'catalog.schema')
[agent:bash] catalog_name, schema_name = schema_name.split('.')
[agent:bash] 
[agent:bash] # Create schema if it doesn't exist
[agent:bash] try:
[agent:bash]     w.schemas.create(catalog_name=catalog_name, name=schema_name)
[agent:bash] except Exception as e:
[agent:bash]     if 'already exists' not in str(e):
[agent:bash]         raise
[agent:bash] 
[agent:bash] # Define table names
[agent:bash] table_raw_a = 'rawa9a7eb8'
[agent:bash] table_raw_b = 'rawb9a7eb8'
[agent:bash] table_derived = 'derived9a7eb8'
[agent:bash] 
[agent:bash] # Create raw tables from CSV files
[agent:bash] def create_table_from_csv(table_name, csv_path, column_spec):
