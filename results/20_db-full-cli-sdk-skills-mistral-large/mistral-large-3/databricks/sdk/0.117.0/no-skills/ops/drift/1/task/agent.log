[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Detect feature drift by reading data/features.csv locally and computing statistics.
[agent:result] """
[agent:result] import os
[agent:result] import json
[agent:result] import pandas as pd
[agent:result] from datetime import datetime
[agent:result] 
[agent:result] # Read the data
[agent:result] print("Reading data...")
[agent:result] df = pd.read_csv("data/features.csv")
[agent:result] df['event_time'] = pd.to_datetime(df['event_time'])
[agent:result] df['day'] = df['event_time'].dt.date
[agent:result] 
[agent:result] # Compute daily statistics
[agent:result] daily_stats = df.groupby('day').agg({
[agent:result]     'f1': 'mean',
[agent:result]     'f2': 'mean',
[agent:result]     'f3': 'mean',
[agent:result]     'f4': 'mean',
[agent:result]     'f5': 'mean',
[agent:result]     'f6': 'mean'
[agent:result] }).reset_index()
[agent:result] 
[agent:result] # Compute baseline (first day)
[agent:result] baseline = daily_stats.iloc[0]
[agent:result] 
[agent:result] # Compute relative change for each feature
[agent:result] daily_stats['f1_change'] = abs(daily_stats['f1'] - baseline['f1']) / abs(baseline['f1'])
[agent:result] daily_stats['f2_change'] = abs(daily_stats['f2'] - baseline['f2']) / abs(baseline['f2'])
[agent:result] daily_stats['f3_change'] = abs(daily_stats['f3'] - baseline['f3']) / abs(baseline['f3'])
[agent:result] daily_stats['f4_change'] = abs(daily_stats['f4'] - baseline['f4']) / abs(baseline['f4'])
[agent:result] daily_stats['f5_change'] = abs(daily_stats['f5'] - baseline['f5']) / abs(baseline['f5'])
[agent:result] daily_stats['f6_change'] = abs(daily_stats['f6'] - baseline['f6']) / abs(baseline['f6'])
[agent:result] 
[agent:result] # Find the feature with the largest change
[agent:result] drifted_feature = None
[agent:result] onset_date = None
[agent:result] max_change = 0.0
[agent:result] 
[agent:result] for _, row in daily_stats.iterrows():
[agent:result]     for feature in ["f1", "f2", "f3", "f4", "f5", "f6"]:
[agent:result]         change = row[f"{feature}_change"]
[agent:result]         if change > max_change:
[agent:result]             max_change = change
[agent:result]             drifted_feature = feature
[agent:result]             onset_date = str(row['day'])
[agent:result] 
[agent:result] # Write the result to submission/answers.json
[agent:result] if drifted_feature and onset_date:
[agent:result]     answer = {
[agent:result]         "feature": drifted_feature,
[agent:result]         "onset": onset_date
[agent:result]     }
[agent:result]     os.makedirs("submission", exist_ok=True)
[agent:result]     with open("submission/answers.json", "w") as f:
[agent:result]         json.dump(answer, f)
[agent:result]     print(f"Drift detected: {answer}")
[agent:result] else:
[agent:result]     print("No drift detected or insufficient data.")
