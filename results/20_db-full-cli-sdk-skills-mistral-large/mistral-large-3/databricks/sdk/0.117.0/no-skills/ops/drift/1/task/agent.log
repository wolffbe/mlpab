[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Detect feature drift by computing rolling statistics using SQL.
[agent:result] """
[agent:result] import os
[agent:result] import json
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] 
[agent:result] # Initialize WorkspaceClient
[agent:result] w = WorkspaceClient()
[agent:result] 
[agent:result] # Environment variables
[agent:result] schema_name = os.getenv("MLPAB_DATABRICKS_SCHEMA")  # workspace.<run-id>
[agent:result] catalog_name, schema = schema_name.split(".")
[agent:result] table_name = f"{os.getenv('MLPAB_DATABRICKS_PREFIX')}_features"
[agent:result] 
[agent:result] # Compute rolling statistics for each feature
[agent:result] print("Computing rolling statistics...")
[agent:result] query = f"""
[agent:result] WITH daily_stats AS (
[agent:result]     SELECT
[agent:result]         DATE(event_time) AS day,
[agent:result]         AVG(f1) AS f1_mean,
[agent:result]         AVG(f2) AS f2_mean,
[agent:result]         AVG(f3) AS f3_mean,
[agent:result]         AVG(f4) AS f4_mean,
