[agent:result] """
[agent:result] Detect feature drift in the ingested table using Databricks' monitoring capabilities.
[agent:result] """
[agent:result] import os
[agent:result] import json
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service import catalog
[agent:result] 
[agent:result] # Initialize WorkspaceClient
[agent:result] w = WorkspaceClient()
[agent:result] 
[agent:result] # Environment variables
[agent:result] schema_name = os.getenv("MLPAB_DATABRICKS_SCHEMA")  # workspace.<run-id>
[agent:result] catalog_name, schema = schema_name.split(".")
[agent:result] table_name = f"{os.getenv('MLPAB_DATABRICKS_PREFIX')}_features"
[agent:result] 
[agent:result] # Create a monitor for the table
[agent:result] print(f"Creating monitor for table {catalog_name}.{schema}.{table_name}...")
[agent:result] monitor = w.quality_monitors.create(
[agent:result]     table_name=f"{catalog_name}.{schema}.{table_name}",
[agent:result]     assets_dir=f"/Users/{os.getenv('USER')}/{os.getenv('MLPAB_DATABRICKS_PREFIX')}/monitors",
[agent:result]     output_schema_name=schema,
[agent:result]     time_series=
[agent:result]         catalog.MonitorTimeSeries(
[agent:result]             timestamp_col="event_time",
[agent:result]             granularities=["1 day"]
[agent:result]         ),
[agent:result]     metrics=catalog.MonitorMetricType.ALL_METRICS,
[agent:result]     baseline=catalog.MonitorBaseline(
[agent:result]         baseline_type=catalog.MonitorBaselineType.AUTO,
[agent:result]     ),
[agent:result]     schedule=catalog.MonitorCronSchedule(
[agent:result]         quartz_cron_expression="0 0 0 * * ?",  # Daily at midnight
[agent:result]         timezone_id="UTC",
[agent:result]         pause_status=catalog.MonitorCronSchedulePauseStatus.UNPAUSED,
[agent:result]     )
[agent:result] )
[agent:result] 
[agent:result] print(f"Monitor created with ID: {monitor.id}")
[agent:result] 
[agent:result] # Wait for the monitor to compute metrics
[agent:result] print("Waiting for monitor to compute metrics...")
[agent:result] import time
[agent:result] for _ in range(12):  # Wait up to 2 minutes
[agent:result]     monitor_info = w.quality_monitors.get(table_name=f"{catalog_name}.{schema}.{table_name}")
[agent:result]     if monitor_info.status == catalog.MonitorInfoStatus.MONITOR_STATUS_ACTIVE:
[agent:result]         break
[agent:result]     time.sleep(10)
[agent:result] else:
[agent:result]     print("Monitor did not become active in time. Proceeding with available data.")
[agent:result] 
[agent:result] # Retrieve the monitor results
[agent:result] print("Retrieving monitor results...")
[agent:result] results = w.statement_execution.execute_statement(
[agent:result]     catalog=catalog_name,
[agent:result]     schema=schema,
[agent:result]     warehouse_id=list(w.warehouses.list())[0].id,
[agent:result]     statement=f"SELECT * FROM {catalog_name}.{schema}.{table_name}_monitor ORDER BY event_time DESC"
[agent:result] )
[agent:result] 
[agent:result] # Fetch the results
[agent:result] result_data = w.statement_execution.get_statement_result(results.statement_id)
[agent:result] 
[agent:result] # Analyze the results to find the drifted feature and onset date
[agent:result] drifted_feature = None
[agent:result] onset_date = None
[agent:result] max_change = 0.0
[agent:result] 
[agent:result] # Iterate through the results to find the feature with the largest change in mean
[agent:result] for row in result_data.result.data_array:
[agent:result]     feature = row[1]  # feature_name
[agent:result]     event_time = row[2]  # event_time
[agent:result]     mean = row[4]  # mean
[agent:result]     baseline_mean = row[5]  # baseline_mean
[agent:result]     
[agent:result]     if baseline_mean is not None and mean is not None and baseline_mean != 0:
[agent:result]         change = abs(mean - baseline_mean) / abs(baseline_mean)
[agent:result]         if change > max_change:
[agent:result]             max_change = change
[agent:result]             drifted_feature = feature
[agent:result]             onset_date = str(event_time.date())
[agent:result] 
[agent:result] # Write the result to submission/answers.json
[agent:result] if drifted_feature and onset_date:
[agent:result]     answer = {
