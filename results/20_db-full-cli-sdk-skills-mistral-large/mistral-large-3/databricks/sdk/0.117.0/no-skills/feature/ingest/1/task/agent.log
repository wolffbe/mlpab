[agent:result]         volume_type=catalog.VolumeType.MANAGED,
[agent:result]     )
[agent:result] except Exception as e:
[agent:result]     print(f"Volume creation failed (may already exist): {e}")
[agent:result] 
[agent:result] # Upload CSV files to the volume
[agent:result] volume_path = f"/Volumes/workspace/{SCHEMA.split('.')[1]}/{VOLUME_NAME}"
[agent:result] for file_name in ["transactions_export_1.csv", "transactions_export_2.csv"]:
[agent:result]     file_path = f"./data/{file_name}"
[agent:result]     with open(file_path, "rb") as f:
[agent:result]         w.files.upload(f"{volume_path}/{file_name}", f, overwrite=True)
[agent:result] 
[agent:result] # Create a Delta table from the CSV files, deduplicating by row_id
[agent:result] spark_sql = f"""
[agent:result] CREATE TABLE IF NOT EXISTS {FEATURE_TABLE_FULL_NAME} (
[agent:result]     row_id STRING,
[agent:result]     account_id STRING,
[agent:result]     event_time BIGINT,
[agent:result]     amount DOUBLE,
[agent:result]     category STRING
[agent:result] ) USING DELTA;
[agent:result] 
[agent:result] -- Load data from both CSV files, deduplicating by row_id
[agent:result] CREATE OR REPLACE TEMP VIEW transactions_temp AS
[agent:result] SELECT * FROM (
[agent:result]     SELECT * FROM read.csv("{volume_path}/transactions_export_1.csv", header => true, inferSchema => true)
[agent:result]     UNION ALL
[agent:result]     SELECT * FROM read.csv("{volume_path}/transactions_export_2.csv", header => true, inferSchema => true)
[agent:result] );
[agent:result] 
[agent:result] -- Deduplicate by row_id (keep the first occurrence)
[agent:result] INSERT INTO {FEATURE_TABLE_FULL_NAME}
[agent:result] SELECT * FROM (
[agent:result]     SELECT *, ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY event_time) as rn
[agent:result]     FROM transactions_temp
[agent:result] )
[agent:result] WHERE rn = 1;
[agent:result] """
