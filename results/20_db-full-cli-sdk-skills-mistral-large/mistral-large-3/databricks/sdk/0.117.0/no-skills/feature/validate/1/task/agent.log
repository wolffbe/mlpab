[agent:bash] 
[agent:bash] # Filter the CSV
[agent:bash] valid_rows = []
[agent:bash] rejected_row_ids = []
[agent:bash] 
[agent:bash] with open('data/events.csv', 'r') as f:
[agent:bash]     reader = csv.DictReader(f)
[agent:bash]     for row in reader:
[agent:bash]         amount = row['amount']
[agent:bash]         category = row['category']
[agent:bash]         
[agent:bash]         # Check for null/empty amount
[agent:bash]         if not amount or amount.strip() == '':
[agent:bash]             rejected_row_ids.append(row['row_id'])
[agent:bash]             continue
[agent:bash]             
[agent:bash]         try:
[agent:bash]             amount_float = float(amount)
[agent:bash]         except ValueError:
[agent:bash]             rejected_row_ids.append(row['row_id'])
[agent:bash]             continue
[agent:bash]             
[agent:bash]         # Check amount range
[agent:bash]         if not (0 <= amount_float <= 10000):
[agent:bash]             rejected_row_ids.append(row['row_id'])
[agent:bash]             continue
[agent:bash]             
[agent:bash]         # Check category
[agent:bash]         if category not in valid_categories:
[agent:bash]             rejected_row_ids.append(row['row_id'])
[agent:bash]             continue
[agent:bash]             
[agent:bash]         valid_rows.append(row)
[agent:bash] 
[agent:bash] # Write rejected row IDs to submission/answers.json
[agent:bash] with open('submission/answers.json', 'w') as f:
[agent:bash]     json.dump({'rejected': rejected_row_ids}, f)
[agent:bash] 
[agent:bash] # Initialize Databricks WorkspaceClient
[agent:bash] w = WorkspaceClient()
[agent:bash] 
[agent:bash] # Get schema from environment
[agent:bash] schema_name = os.environ['MLPAB_DATABRICKS_SCHEMA']
[agent:bash] table_name = 'events45bd4b'
[agent:bash] 
[agent:bash] # Create a temporary Delta table in Unity Catalog
[agent:bash] temp_dir = '/tmp/events45bd4b'
[agent:bash] os.makedirs(temp_dir, exist_ok=True)
[agent:bash] 
[agent:bash] # Write valid rows to a temporary CSV
[agent:bash] temp_csv_path = os.path.join(temp_dir, 'valid_events.csv')
[agent:bash] with open(temp_csv_path, 'w') as f:
[agent:bash]     if valid_rows:
[agent:bash]         writer = csv.DictWriter(f, fieldnames=valid_rows[0].keys())
[agent:bash]         writer.writeheader()
[agent:bash]         writer.writerows(valid_rows)
[agent:bash] 
[agent:bash] # Upload the CSV to a volume in the schema
[agent:bash] volume_name = 'temp_volume'
[agent:bash] try:
