[agent:bash] import csv
[agent:bash] import json
[agent:bash] import os
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service.catalog import *
[agent:bash] 
[agent:bash] # Read the contract rules
