[agent:bash] import os
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service import catalog
[agent:bash] 
[agent:bash] SCHEMA = os.getenv('MLPAB_DATABRICKS_SCHEMA')
[agent:bash] PREFIX = os.getenv('MLPAB_DATABRICKS_PREFIX')
[agent:bash] FEATURE_TABLE_NAME = 'incrementalaccaa3'
[agent:bash] VOLUME_NAME = f'{PREFIX}_volume'
[agent:bash] CATALOG, SCHEMA_NAME = SCHEMA.split('.')
[agent:bash] 
[agent:bash] table_full_name = f'{CATALOG}.{SCHEMA_NAME}.{FEATURE_TABLE_NAME}'
[agent:bash] 
[agent:bash] w = WorkspaceClient()
[agent:bash] 
[agent:bash] # Upload increment files to the volume
[agent:bash] volume_path = f'/Volumes/{CATALOG}/{SCHEMA_NAME}/{VOLUME_NAME}'
[agent:bash] for i in range(1, 7):
[agent:bash]     file_name = f'increment_{i:02d}.csv'
[agent:bash]     local_path = f'data/{file_name}'
[agent:bash]     with open(local_path, 'rb') as f:
[agent:bash]         w.files.upload(f'{volume_path}/{file_name}', f, overwrite=True)
[agent:bash] 
[agent:bash] # Load data from the volume into the table
[agent:bash] for i in range(1, 7):
[agent:bash]     file_name = f'increment_{i:02d}.csv'
[agent:bash]     w.statement_execution.execute_statement(
[agent:bash]         warehouse_id=w.warehouses.list()[0].id,
[agent:bash]         catalog=CATALOG,
[agent:bash]         schema=SCHEMA_NAME,
[agent:bash]         statement=f'''COPY INTO {table_full_name}
[agent:bash]         FROM '{volume_path}/{file_name}'
[agent:bash]         FILEFORMAT = CSV
[agent:bash]         FORMAT_OPTIONS('header' = 'true', 'inferSchema' = 'true')'''
[agent:bash]     ).result()
[agent:bash] 
[agent:bash] # Register the feature table
[agent:bash] try:
[agent:bash]     w.table_features.get(table_full_name)
[agent:bash] except Exception:
[agent:bash]     w.table_features.create(
[agent:bash]         name=table_full_name,
[agent:bash]         primary_keys=['row_id'],
[agent:bash]         timestamp_keys=['event_time'],
[agent:bash]         description='Feature table for incremental ingestion of events data.'
[agent:bash]     )
[agent:bash] 
[agent:bash] # Enable online table for low-latency lookup
[agent:bash] try:
[agent:bash]     w.online_tables.get(table_full_name)
[agent:bash] except Exception:
[agent:bash]     w.online_tables.create(
[agent:bash]         name=table_full_name,
