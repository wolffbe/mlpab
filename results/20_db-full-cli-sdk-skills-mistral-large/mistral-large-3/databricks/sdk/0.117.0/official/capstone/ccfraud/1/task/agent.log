[agent:result] catalog_name = schema_name.split(".")[0]  # workspace
[agent:result] schema_name_only = schema_name.split(".")[1]  # mlpab21b96f
[agent:result] prefix = os.getenv("MLPAB_DATABRICKS_PREFIX")  # mlpab21b96f
[agent:result] 
[agent:result] # Feature Group, Dataset, Model, and Predictions Table Names
[agent:result] feature_group_name = "cctxne0b071"
[agent:result] training_dataset_name = "cctde0b071"
[agent:result] model_name = "ccmodele0b071"
[agent:result] predictions_table_name = "ccprede0b071"
[agent:result] 
[agent:result] # Paths
