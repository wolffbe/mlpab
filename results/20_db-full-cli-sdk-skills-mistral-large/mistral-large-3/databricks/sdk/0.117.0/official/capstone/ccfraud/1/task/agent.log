[agent:result] transactions_path = f"{volume_path}/transactions.csv"
[agent:result] score_path = f"{volume_path}/score_transactions.csv"
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] @dlt.table(
[agent:result]     name=feature_group_name,
[agent:result]     comment="Fraud feature group: transaction velocity, amount stats, geo distance."
[agent:result] )
[agent:result] def create_feature_group():
[agent:result]     # Read transactions
[agent:result]     transactions_df = spark.read.csv(transactions_path, header=True, inferSchema=True)
[agent:result]     
[agent:result]     # Feature Engineering
[agent:result]     transactions_df = transactions_df.withColumn("timestamp", unix_timestamp(col("datetime")))
[agent:result]     window_spec = Window.partitionBy("cc_num").orderBy("timestamp")
[agent:result]     
[agent:result]     # Feature 1: Transaction velocity (count per card in last 1 hour)
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "txn_velocity_1h",
[agent:result]         count("transaction_id").over(window_spec.rangeBetween(-3600, 0))
[agent:result]     )
[agent:result]     
[agent:result]     # Feature 2: Amount statistics (mean and stddev per card in last 24 hours)
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "amount_mean_24h",
[agent:result]         mean("amount").over(window_spec.rangeBetween(-86400, 0))
[agent:result]     )
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "amount_stddev_24h",
[agent:result]         stddev("amount").over(window_spec.rangeBetween(-86400, 0))
[agent:result]     )
[agent:result]     
[agent:result]     # Feature 3: Time since last transaction
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "time_since_last_txn",
[agent:result]         col("timestamp") - lag("timestamp").over(window_spec)
[agent:result]     )
[agent:result]     
[agent:result]     # Feature 4: Amount deviation from mean
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "amount_dev_from_mean",
[agent:result]         (col("amount") - col("amount_mean_24h")) / (col("amount_stddev_24h") + lit(1e-6))
[agent:result]     )
[agent:result]     
[agent:result]     # Feature 5: Geo distance from previous transaction
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "prev_lat", lag("lat").over(window_spec)
[agent:result]     ).withColumn(
[agent:result]         "prev_long", lag("long").over(window_spec)
[agent:result]     )
[agent:result]     transactions_df = transactions_df.withColumn(
[agent:result]         "geo_distance",
[agent:result]         when(
[agent:result]             (col("prev_lat").isNotNull()) & (col("prev_long").isNotNull()),
[agent:result]             ((col("lat") - col("prev_lat"))**2 + (col("long") - col("prev_long"))**2)**0.5
[agent:result]         ).otherwise(lit(0.0))
[agent:result]     )
[agent:result]     
[agent:result]     # Drop intermediate columns
[agent:result]     transactions_df = transactions_df.drop("prev_lat", "prev_long", "timestamp")
[agent:result]     
[agent:result]     return transactions_df
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] @dlt.table(
[agent:result]     name=training_dataset_name,
[agent:result]     comment="Training dataset for fraud classification."
[agent:result] )
