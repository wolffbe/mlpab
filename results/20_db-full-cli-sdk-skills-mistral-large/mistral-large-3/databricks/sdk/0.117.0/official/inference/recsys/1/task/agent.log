[agent:result] content: #!/usr/bin/env python3
[agent:result] """
[agent:result] Compute top-5 recommendations for every user using dot product of embeddings,
[agent:result] excluding items they have already interacted with. Create a feature table
[agent:result] `recse3a36e` in the specified Unity Catalog schema and enable online access.
[agent:result] """
[agent:result] 
[agent:result] import os
[agent:result] import csv
[agent:result] import numpy as np
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service.catalog import *
[agent:result] from databricks.sdk.service.sql import *
[agent:result] 
[agent:result] # Load data
[agent:result] interactions = []
[agent:result] with open('data/interactions.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         interactions.append(row)
[agent:result] 
[agent:result] user_embeddings = {}
[agent:result] with open('data/user_embeddings.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         user_id = row['user_id']
[agent:result]         embedding = np.array([float(row[f'e{i}']) for i in range(1, 9)])
[agent:result]         user_embeddings[user_id] = embedding
[agent:result] 
[agent:result] item_embeddings = {}
[agent:result] with open('data/item_embeddings.csv', 'r') as f:
[agent:result]     reader = csv.DictReader(f)
[agent:result]     for row in reader:
[agent:result]         item_id = row['item_id']
[agent:result]         embedding = np.array([float(row[f'e{i}']) for i in range(1, 9)])
[agent:result]         item_embeddings[item_id] = embedding
[agent:result] 
[agent:result] # Build user-item interaction set
[agent:result] user_interacted_items = {}
[agent:result] for interaction in interactions:
[agent:result]     user_id = interaction['user_id']
[agent:result]     item_id = interaction['item_id']
[agent:result]     if user_id not in user_interacted_items:
[agent:result]         user_interacted_items[user_id] = set()
[agent:result]     user_interacted_items[user_id].add(item_id)
[agent:result] 
[agent:result] # Compute recommendations
[agent:result] recommendations = []
[agent:result] for user_id, user_embedding in user_embeddings.items():
[agent:result]     scores = []
[agent:result]     interacted_items = user_interacted_items.get(user_id, set())
[agent:result]     
[agent:result]     for item_id, item_embedding in item_embeddings.items():
[agent:result]         if item_id in interacted_items:
[agent:result]             continue
[agent:result]         score = np.dot(user_embedding, item_embedding)
[agent:result]         scores.append((score, item_id))
[agent:result]     
[agent:result]     # Sort by score descending, then by item_id ascending for ties
[agent:result]     scores.sort(key=lambda x: (-x[0], x[1]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     for rank, (score, item_id) in enumerate(scores[:5], start=1):
[agent:result]         rec_id = f"{user_id}#{rank}"
[agent:result]         recommendations.append({
[agent:result]             "rec_id": rec_id,
[agent:result]             "user_id": user_id,
[agent:result]             "rank": rank,
[agent:result]             "item_id": item_id
[agent:result]         })
[agent:result] 
[agent:result] # Initialize Databricks SDK
[agent:result] w = WorkspaceClient()
[agent:result] 
[agent:result] # Schema and table names
[agent:result] schema_name = os.environ["MLPAB_DATABRICKS_SCHEMA"]
[agent:result] table_name = "recse3a36e"
[agent:result] full_table_name = f"{schema_name}.{table_name}"
[agent:result] 
[agent:result] # Create schema if not exists
[agent:result] try:
[agent:result]     w.schemas.create(name=schema_name, catalog_name="workspace")
[agent:result] except Exception as e:
[agent:result]     if "already exists" not in str(e):
[agent:result]         raise
[agent:result] 
[agent:result] # Create feature table
[agent:result] try:
[agent:result]     w.tables.create(
[agent:result]         name=table_name,
[agent:result]         catalog_name="workspace",
[agent:result]         schema_name=schema_name,
[agent:result]         table_type=TableType.FEATURE_TABLE,
[agent:result]         columns=[
[agent:result]             Column(name="rec_id", type_name=ColumnTypeName.STRING, nullable=False, comment="Record key: <user_id>#<rank>"),
[agent:result]             Column(name="user_id", type_name=ColumnTypeName.STRING, nullable=False, comment="User ID"),
[agent:result]             Column(name="rank", type_name=ColumnTypeName.INT, nullable=False, comment="Rank (1-5)"),
[agent:result]             Column(name="item_id", type_name=ColumnTypeName.STRING, nullable=False, comment="Recommended item ID")
[agent:result]         ],
[agent:result]         primary_key_columns=["rec_id"]
[agent:result]     )
[agent:result] except Exception as e:
[agent:result]     if "already exists" not in str(e):
[agent:result]         raise
[agent:result] 
[agent:result] # Write recommendations to a temporary CSV and upload
[agent:result] import tempfile
[agent:result] with tempfile.NamedTemporaryFile(mode='w', suffix='.csv', delete=False) as tmp:
[agent:result]     fieldnames = ["rec_id", "user_id", "rank", "item_id"]
[agent:result]     writer = csv.DictWriter(tmp, fieldnames=fieldnames)
[agent:result]     writer.writeheader()
[agent:result]     writer.writerows(recommendations)
[agent:result]     tmp_path = tmp.name
[agent:result] 
[agent:result] # Upload to DBFS
[agent:result] import pathlib
[agent:result] dbfs_path = f"dbfs:/tmp/{os.environ['MLPAB_DATABRICKS_PREFIX']}_recommendations.csv"
[agent:result] w.dbfs.upload(tmp_path, dbfs_path, overwrite=True)
[agent:result] 
[agent:result] # Load data into the feature table
[agent:result] w.statement_execution.execute_statement(
[agent:result]     warehouse_id=w.warehouses.list()[0].id,
[agent:result]     catalog="workspace",
[agent:result]     schema=schema_name,
[agent:result]     statement=f""
[agent:result]     COPY INTO {full_table_name}
[agent:result]     FROM '{dbfs_path}'
[agent:result]     FILEFORMAT = CSV
[agent:result]     FORMAT_OPTIONS ('header' = 'true', 'inferSchema' = 'false')
[agent:result]     VALIDATE ALL ROWS
[agent:result]     """
[agent:result] )
[agent:result] 
[agent:result] # Enable online table for low-latency access
[agent:result] w.online_tables.create(
[agent:result]     name=full_table_name,
[agent:result]     primary_key_columns=["rec_id"]
[agent:result] )
[agent:result] 
[agent:result] print(f"Feature table {full_table_name} created and online access enabled.")
