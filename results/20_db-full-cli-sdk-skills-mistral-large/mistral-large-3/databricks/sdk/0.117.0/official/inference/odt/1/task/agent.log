[agent:result] content: #!/usr/bin/env python3
[agent:result] 
[agent:result] import os
[agent:result] import pandas as pd
[agent:result] import numpy as np
[agent:result] from databricks.sdk import WorkspaceClient
[agent:result] from databricks.sdk.service import catalog, sql
[agent:result] 
[agent:result] # Read input files
[agent:result] requests_df = pd.read_csv("data/requests.csv")
[agent:result] profiles_df = pd.read_csv("data/profiles.csv")
[agent:result] 
[agent:result] # Merge requests and profiles on account_id
[agent:result] merged_df = pd.merge(requests_df, profiles_df, on="account_id", how="left")
[agent:result] 
[agent:result] # Compute distance_deg
[agent:result] def calculate_distance_deg(row):
[agent:result]     lat_diff = row["request_lat"] - row["home_lat"]
[agent:result]     lon_diff = row["request_lon"] - row["home_lon"]
[agent:result]     distance = np.sqrt(lat_diff**2 + lon_diff**2)
[agent:result]     return round(distance, 6)
[agent:result] 
[agent:result] merged_df["distance_deg"] = merged_df.apply(calculate_distance_deg, axis=1)
[agent:result] 
[agent:result] # Compute score
[agent:result] merged_df["score"] = merged_df.apply(
[agent:result]     lambda row: round(row["base_score"] - 0.1 * row["distance_deg"], 6), axis=1
[agent:result] )
[agent:result] 
[agent:result] # Select required columns
[agent:result] result_df = merged_df[["request_id", "account_id", "distance_deg", "score"]]
[agent:result] 
[agent:result] # Initialize Databricks WorkspaceClient
[agent:result] w = WorkspaceClient()
[agent:result] 
[agent:result] # Define schema and table name
[agent:result] schema_name = os.getenv("MLPAB_DATABRICKS_SCHEMA")
[agent:result] table_name = "scoreda4f6e2"
[agent:result] full_table_name = f"{schema_name}.{table_name}"
[agent:result] 
[agent:result] # Create schema if not exists
[agent:result] w.schemas.create(name=schema_name.split(".")[1], catalog_name=schema_name.split(".")[0])
[agent:result] 
[agent:result] # Write to Delta table
[agent:result] spark_df = w.create_dataframe(result_df)
[agent:result] spark_df.write.save_as_table(
[agent:result]     name=full_table_name,
[agent:result]     mode="overwrite",
[agent:result]     format="delta"
[agent:result] )
[agent:result] 
[agent:result] # Enable online table for low-latency lookup
[agent:result] online_table_name = f"{table_name}_online"
[agent:result] w.online_tables.create(
[agent:result]     name=online_table_name,
[agent:result]     spec=catalog.OnlineTableSpec(
[agent:result]         primary_key_columns=["request_id"],
[agent:result]         source_table_full_name=full_table_name,
