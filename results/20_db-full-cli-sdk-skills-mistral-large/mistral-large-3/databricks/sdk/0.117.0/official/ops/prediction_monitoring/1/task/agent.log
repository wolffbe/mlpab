[agent:result]             prev_mean = means[i-1]
[agent:result]             prev_std = stddevs[i-1]
[agent:result]             current_mean = means[i]
[agent:result]             
[agent:result]             if prev_std == 0:
[agent:result]                 continue
[agent:result]             
[agent:result]             z_score = abs(current_mean - prev_mean) / prev_std
[agent:result]             if z_score > 3.0:  # Significant shift
[agent:result]                 onset_date = dates[i]
[agent:result]                 break
[agent:result]         
[agent:result]         if onset_date is None:
[agent:result]             # Fallback: use the date with the largest mean change
[agent:result]             max_change = 0
[agent:result]             for i in range(1, len(means)):
[agent:result]                 change = abs(means[i] - means[i-1])
[agent:result]                 if change > max_change:
[agent:result]                     max_change = change
[agent:result]                     onset_date = dates[i]
[agent:result]         
[agent:result]         return onset_date.strftime("%Y-%m-%d")
