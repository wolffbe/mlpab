[agent:result] content: #!/usr/bin/env python3
[agent:result] 
[agent:result] from pyspark.sql import SparkSession
[agent:result] from pyspark.sql.functions import col, to_date, mean, stddev, count, lag, abs
[agent:result] from pyspark.sql.window import Window
[agent:result] import json
[agent:result] 
[agent:result] # Initialize Spark
[agent:result] spark = SparkSession.builder.getOrCreate()
[agent:result] 
[agent:result] # Read the data from the Volume
[agent:result] df = spark.read.csv("dbfs:/Volumes/workspace/mlpabf81e30/mlpabf81e30_volume/features.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Extract date from event_time
[agent:result] df = df.withColumn("event_date", to_date(col("event_time")))
[agent:result] 
[agent:result] # Compute daily statistics for each feature
[agent:result] features = ["f1", "f2", "f3", "f4", "f5", "f6"]
[agent:result] stats_df = df.groupBy("event_date").agg(
[agent:result]     *[mean(col(f)).alias(f"{f}_mean") for f in features],
[agent:result]     *[stddev(col(f)).alias(f"{f}_stddev") for f in features],
[agent:result]     count("*").alias("count")
[agent:result] ).orderBy("event_date")
[agent:result] 
[agent:result] # Define a window for rolling statistics
[agent:result] window = Window.orderBy("event_date")
[agent:result] 
[agent:result] # Compute rolling Z-scores for each feature
[agent:result] for f in features:
[agent:result]     stats_df = stats_df.withColumn(f"{f}_prev_mean", lag(col(f"{f}_mean"), 1).over(window))
[agent:result]     stats_df = stats_df.withColumn(f"{f}_prev_stddev", lag(col(f"{f}_stddev"), 1).over(window))
[agent:result]     stats_df = stats_df.withColumn(f"{f}_z_score", abs((col(f"{f}_mean") - col(f"{f}_prev_mean")) / col(f"{f}_prev_stddev")))
[agent:result] 
[agent:result] # Identify the feature with the highest Z-score and its onset date
[agent:result] max_z_scores = []
[agent:result] for f in features:
[agent:result]     max_z_score_row = stats_df.selectExpr(f"max({f}_z_score) as max_z_score", f"event_date as onset_date").orderBy(col("max_z_score").desc()).first()
[agent:result]     if max_z_score_row:
