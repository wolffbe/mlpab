[agent:write] ?
[agent:result] path: /Users/wolffbe/workspace/banter/testbed/results/20_db-full-cli-sdk-skills-mistral-large/mistral-large-3/databricks/cli/1.3.0/no-skills/ops/drift/1/task/drift_detection_notebook.py
[agent:result] bytes_written: 2968
[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Feature Drift Detection
[agent:result] # MAGIC 
[agent:result] # MAGIC This notebook:
[agent:result] # MAGIC 1. Creates a table from the feature data.
[agent:result] # MAGIC 2. Computes daily statistics for each feature.
[agent:result] # MAGIC 3. Identifies the feature with the most significant distribution shift.
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create the table from the CSV file in the Volume
[agent:result] spark.sql("""
[agent:result] CREATE TABLE IF NOT EXISTS workspace.mlpabf81e30.mlpabf81e30_features
[agent:result] USING CSV
[agent:result] OPTIONS (
[agent:result]     header = "true",
[agent:result]     path = "dbfs:/Volumes/workspace/mlpabf81e30/mlpabf81e30_volume/features.csv"
[agent:result] )
[agent:result] """)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Compute daily statistics for each feature
[agent:result] from pyspark.sql.functions import col, to_date, mean, stddev, count
[agent:result] 
[agent:result] # Read the data
[agent:result] df = spark.table("workspace.mlpabf81e30.mlpabf81e30_features")
[agent:result] 
[agent:result] # Extract date from event_time
[agent:result] df = df.withColumn("event_date", to_date(col("event_time")))
[agent:result] 
[agent:result] # Compute daily statistics for each feature
[agent:result] features = ["f1", "f2", "f3", "f4", "f5", "f6"]
[agent:result] stats_df = df.groupBy("event_date").agg(
[agent:result]     *[mean(col(f)).alias(f"{f}_mean") for f in features],
[agent:result]     *[stddev(col(f)).alias(f"{f}_stddev") for f in features],
[agent:result]     count("*").alias("count")
[agent:result] ).orderBy("event_date")
[agent:result] 
[agent:result] # Show the statistics
[agent:result] stats_df.display()
[agent:result] 
[agent:result] # COMMAND ----------
