[agent:result] 
[agent:result] # Load data
[agent:result] requests_df = spark.read.csv("/data/requests.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv("/data/profiles.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Join data
