[agent:result] 
[agent:result] labels_df = spark.read.csv(f"{volume_path}/labels.csv", header=True, inferSchema=True)
[agent:result] transactions_df = spark.read.csv(f"{volume_path}/transactions.csv", header=True, inferSchema=True)
[agent:result] transactions_late_df = spark.read.csv(f"{volume_path}/transactions_late.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv(f"{volume_path}/profiles.csv", header=True, inferSchema=True)
[agent:result] activity_df = spark.read.csv(f"{volume_path}/activity.csv", header=True, inferSchema=True)
