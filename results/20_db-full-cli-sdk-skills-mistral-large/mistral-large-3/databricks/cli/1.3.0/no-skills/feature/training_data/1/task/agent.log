[agent] ## Step 3: Create a Databricks Notebook
[agent] I will create a notebook to:
[agent] 1. Read the raw data from the volume.
[agent] 2. For each `(account_id, label_time)` in `labels.csv`, fetch the most recent feature values from all source tables at or before `label_time`.
[agent] 3. Write the result to a Delta table named `churntrainingaf8b21`, version 1, in the isolated schema.
[agent:write] ?
[agent:result] path: /Users/wolffbe/workspace/banter/testbed/results/20_db-full-cli-sdk-skills-mistral-large/mistral-large-3/databricks/cli/1.3.0/no-skills/feature/training_data/1/task/create_training_data.py
[agent:result] bytes_written: 3423
[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # MAGIC ## Create Training Dataset: churntrainingaf8b21 v1
[agent:result] # MAGIC 
[agent:result] # MAGIC For each `(account_id, label_time)` in `labels.csv`, fetch the most recent feature values from all source tables at or before `label_time`.
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from pyspark.sql import functions as F
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Read raw data from volume
[agent:result] volume_path = f"/Volumes/workspace/{spark.conf.get('spark.databricks.clusterUsageTags.schemaName')}/raw_data"
[agent:result] 
[agent:result] labels_df = spark.read.csv(f"{volume_path}/labels.csv", header=True, inferSchema=True)
[agent:result] transactions_df = spark.read.csv(f"{volume_path}/transactions.csv", header=True, inferSchema=True)
[agent:result] transactions_late_df = spark.read.csv(f"{volume_path}/transactions_late.csv", header=True, inferSchema=True)
[agent:result] profiles_df = spark.read.csv(f"{volume_path}/profiles.csv", header=True, inferSchema=True)
[agent:result] activity_df = spark.read.csv(f"{volume_path}/activity.csv", header=True, inferSchema=True)
[agent:result] health_df = spark.read.csv(f"{volume_path}/account_health.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Union transactions and transactions_late
[agent:result] transactions_all_df = transactions_df.union(transactions_late_df)
[agent:result] 
[agent:result] # For each table, filter rows where event_time <= label_time and get the most recent row per account_id
[agent:result] window_spec = Window.partitionBy("account_id").orderBy(F.col("event_time").desc())
[agent:result] 
[agent:result] # Join all features to labels
[agent:result] result_df = labels_df.alias("labels").join(
[agent:result]     transactions_all_df.alias("t"),
[agent:result]     (F.col("labels.account_id") == F.col("t.account_id")) &
[agent:result]     (F.col("t.event_time") <= F.col("labels.label_time")),
[agent:result]     "left"
[agent:result] ).join(
[agent:result]     profiles_df.alias("p"),
[agent:result]     (F.col("labels.account_id") == F.col("p.account_id")) &
[agent:result]     (F.col("p.event_time") <= F.col("labels.label_time")),
[agent:result]     "left"
[agent:result] ).join(
[agent:result]     activity_df.alias("a"),
[agent:result]     (F.col("labels.account_id") == F.col("a.account_id")) &
[agent:result]     (F.col("a.event_time") <= F.col("labels.label_time")),
[agent:result]     "left"
[agent:result] ).join(
[agent:result]     health_df.alias("h"),
[agent:result]     (F.col("labels.account_id") == F.col("h.account_id")) &
[agent:result]     (F.col("h.event_time") <= F.col("labels.label_time")),
[agent:result]     "left"
[agent:result] )
[agent:result] 
[agent:result] # For each feature table, select the most recent row per account_id at or before label_time
[agent:result] result_df = result_df.withColumn("t_rank", F.rank().over(window_spec))
[agent:result] result_df = result_df.withColumn("p_rank", F.rank().over(Window.partitionBy("p.account_id").orderBy(F.col("p.event_time").desc())))
[agent:result] result_df = result_df.withColumn("a_rank", F.rank().over(Window.partitionBy("a.account_id").orderBy(F.col("a.event_time").desc())))
[agent:result] result_df = result_df.withColumn("h_rank", F.rank().over(Window.partitionBy("h.account_id").orderBy(F.col("h.event_time").desc())))
[agent:result] 
[agent:result] result_df = result_df.filter(
[agent:result]     (F.col("t_rank") == 1) &
[agent:result]     (F.col("p_rank") == 1) &
[agent:result]     (F.col("a_rank") == 1) &
[agent:result]     (F.col("h_rank") == 1)
[agent:result] )
[agent:result] 
[agent:result] # Select the required columns
[agent:result] result_df = result_df.select(
[agent:result]     F.col("labels.account_id"),
[agent:result]     F.col("labels.label_time"),
[agent:result]     F.col("t.amount"),
[agent:result]     F.col("t.balance"),
[agent:result]     F.col("p.credit_score"),
[agent:result]     F.col("p.tier"),
[agent:result]     F.col("a.sessions_7d"),
[agent:result]     F.col("h.health_score"),
[agent:result]     F.col("labels.churned")
[agent:result] )
[agent:result] 
[agent:result] # Write to Delta table in the isolated schema
[agent:result] output_table = f"{spark.conf.get('spark.databricks.clusterUsageTags.schemaName')}.churntrainingaf8b21"
[agent:result] result_df.write.format("delta").mode("overwrite").saveAsTable(output_table)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] print(f"Training dataset written to {output_table}")
