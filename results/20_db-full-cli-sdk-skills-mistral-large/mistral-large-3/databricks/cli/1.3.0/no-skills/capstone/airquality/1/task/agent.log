[agent:result] content: # Databricks notebook source
[agent:result] # Read the CSV file from the volume
[agent:result] df = spark.read.csv("/Volumes/workspace/mlpab6e9823/data/airquality_history.csv", header=True, inferSchema=True)
[agent:result] 
[agent:result] # Feature engineering
[agent:result] from pyspark.sql.functions import lag, mean
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] window_spec = Window.orderBy("date")
[agent:result] 
[agent:result] # Lag features
[agent:result] for lag_days in [1, 2, 3, 7]:
[agent:result]     df = df.withColumn(f"pm25_lag{lag_days}", lag("pm25", lag_days).over(window_spec))
[agent:result] 
[agent:result] # Rolling statistics
[agent:result] rolling_window = Window.orderBy("date").rowsBetween(-6, 0)
[agent:result] df = df.withColumn("pm25_rolling_mean_7d", mean("pm25").over(rolling_window))
[agent:result] 
[agent:result] # Write to feature group
[agent:result] df.write.saveAsTable("workspace.mlpab6e9823.airqfcd91b")
