[agent:result] bytes_written: 804
[agent:result] content: # Databricks notebook source
[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col, lag, mean, datediff, to_date
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Read the raw data
[agent:result] raw_data_path = "/Volumes/{catalog}/{schema}/data/airquality_history.csv"
[agent:result] history_df = spark.read.csv(raw_data_path, header=True, inferSchema=True)
[agent:result] 
[agent:result] # Feature engineering
[agent:result] window_spec = Window.orderBy("date")
[agent:result] 
[agent:result] # Lag features
[agent:result] for lag_days in [1, 2, 3, 7]:
[agent:result]     history_df = history_df.withColumn(f"pm25_lag{lag_days}", lag("pm25", lag_days).over(window_spec))
[agent:result] 
[agent:result] # Rolling statistics
[agent:result] rolling_window = Window.orderBy("date").rowsBetween(-6, 0)
[agent:result] history_df = history_df.withColumn("pm25_rolling_mean_7d", mean("pm25").over(rolling_window))
[agent:result] 
[agent:result] # Write to feature group
[agent:result] @dlt.table(name="airqfcd91b")
[agent:result] def create_feature_group():
[agent:result]     return history_df
