[agent:result] 
[agent:result] # Pipeline
[agent:result] pipeline = Pipeline(stages=indexers + [assembler, rf])
[agent:result] 
[agent:result] # Train
[agent:result] model = pipeline.fit(train)
[agent:result] 
[agent:result] # Evaluate
