[agent:result] 
[agent:result] # Feature engineering
[agent:result] categorical_cols = ["merchant", "category"]
[agent:result] indexers = [StringIndexer(inputCol=col, outputCol=col+"_idx").fit(df) for col in categorical_cols]
[agent:result] 
[agent:result] assembler = VectorAssembler(
[agent:result]     inputCols=["amount", "lat", "long"] + [col+"_idx" for col in categorical_cols],
[agent:result]     outputCol="features"
[agent:result] )
[agent:result] 
[agent:result] # Train/test split
[agent:result] train, test = df.randomSplit([0.8, 0.2], seed=42)
[agent:result] 
[agent:result] # Model
