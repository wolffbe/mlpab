[agent] Let's first check the data to identify the shift point locally to guide our monitoring:
[agent:bash] python3 -c "
[agent:bash] import pandas as pd
[agent:bash] import numpy as np
[agent:bash] from datetime import datetime
[agent:bash] 
[agent:bash] # Load the data
[agent:bash] df = pd.read_csv('data/prediction_log.csv', parse_dates=['ts'])
[agent:bash] 
[agent:bash] # Resample to daily mean to see the shift clearly
[agent:bash] daily = df.set_index('ts').resample('D').mean()
[agent:bash] 
[agent:bash] # Calculate rolling mean and std to detect shift
[agent:bash] rolling_mean = daily['prediction'].rolling(window=7, center=True).mean()
[agent:bash] rolling_std = daily['prediction'].rolling(window=7, center=True).std()
[agent:bash] 
[agent:bash] # Find where the mean changes significantly
[agent:bash] mean_diff = rolling_mean.diff().abs()
[agent:bash] shift_point = mean_diff.idxmax()
[agent:bash] 
[agent:bash] print(f'Shift detected around: {shift_point.date()}')
[agent:bash] print(f'Mean before: {rolling_mean[shift_point - pd.Timedelta(days=7)]:.4f}')
[agent:bash] print(f'Mean after: {rolling_mean[shift_point + pd.Timedelta(days=7)]:.4f}')
[agent:bash] "
