[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col, round
[agent:result] 
[agent:result] # Load raw_a.csv into rawa9a7eb8
[agent:result] @dlt.table(
[agent:result]   name="rawa9a7eb8",
[agent:result]   comment="Feature table for raw_a.csv",
[agent:result]   table_properties={
[agent:result]     "quality": "raw"
