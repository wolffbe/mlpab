{"timestamp": null, "session_id": null, "tool_name": "Write", "category": "write", "tool_input": {"path": "dlt_pipeline.py", "content": "import dlt\nfrom pyspark.sql.functions import col, udf\nfrom pyspark.sql.types import DoubleType\n\n# Define the UDF for distance calculation\ndistance_udf = udf(\n    lambda req_lat, req_lon, home_lat, home_lon: round(((req_lat - home_lat) ** 2 + (req_lon - home_lon) ** 2) ** 0.5, 6),\n    DoubleType()\n)\n\n# Read input files\nrequests_df = spark.read.csv(\"/dbfs/tmp/mlpab3f631d/requests.csv\", header=True, inferSchema=True)\nprofiles_df = spark.read.csv(\"/dbfs/tmp/mlpab3f631d/profiles.csv\", header=True, inferSchema=True)\n\n# Join and compute features\njoined_df = requests_df.join(profiles_df, \"account_id\", \"inner\")\nscored_df = joined_df.withColumn(\n    \"distance_deg\", \n    distance_udf(col(\"request_lat\"), col(\"request_lon\"), col(\"home_lat\"), col(\"home_lon\"))\n).withColumn(\n    \"score\", \n    round(col(\"base_score\") - 0.1 * col(\"distance_deg\"), 6)\n).select(\n    \"request_id\", \n    \"account_id\", \n    \"distance_deg\", \n    \"score\"\n)\n\n# Write to feature table\n@dlt.table(\n    name=\"scoreda4f6e2\",\n    comment=\"Feature table for scored requests\",\n    table_properties={\n        \"quality\": \"gold\"\n    }\n)\ndef create_feature_table():\n    return scored_df\n\n# Enable online access\ndlt.online_table(\n    name=\"scoreda4f6e2_online\"\n)"}}
