[agent:bash] import numpy as np
[agent:bash] 
[agent:bash] RANK = 4
[agent:bash] LEARNING_RATE = 2.0
[agent:bash] ITERATIONS = 400
[agent:bash] ADAPTER_SCALE = 0.5
[agent:bash] 
[agent:bash] def bigram_counts(text, vocab):
[agent:bash]     index = {ch: i for i, ch in enumerate(vocab)}
[agent:bash]     idx = np.array([index[ch] for ch in text], dtype=int)
[agent:bash]     counts = np.zeros((len(vocab), len(vocab)), dtype=float)
[agent:bash]     np.add.at(counts, (idx[:-1], idx[1:]), 1.0)
[agent:bash]     return counts
[agent:bash] 
[agent:bash] def cross_entropy(logits, counts):
[agent:bash]     logp = logits - logits.max(axis=1, keepdims=True)
[agent:bash]     logp = logp - np.log(np.exp(logp).sum(axis=1, keepdims=True))
[agent:bash]     return -(counts * logp).sum() / counts.sum()
[agent:bash] 
[agent:bash] def main():
[agent:bash]     # Load data from volume
[agent:bash]     ckpt = np.load("/dbfs/Volumes/workspace/'"${MLPAB_DATABRICKS_SCHEMA#*.}"'/ftdata/base_model.npz")
[agent:bash]     base_logits = ckpt["logits"].astype(float)
[agent:bash]     vocab = [str(ch) for ch in ckpt["vocab"]]
[agent:bash]     
[agent:bash]     # Read training and evaluation data
[agent:bash]     with open("/dbfs/Volumes/workspace/'"${MLPAB_DATABRICKS_SCHEMA#*.}"'/ftdata/finetune.txt", "r") as f:
[agent:bash]         ft_text = f.read()
[agent:bash]     with open("/dbfs/Volumes/workspace/'"${MLPAB_DATABRICKS_SCHEMA#*.}"'/ftdata/eval.txt", "r") as f:
[agent:bash]         eval_text = f.read()
[agent:bash]     
[agent:bash]     ft_counts = bigram_counts(ft_text, vocab)
[agent:bash]     eval_counts = bigram_counts(eval_text, vocab)
[agent:bash] 
[agent:bash]     n_vocab = base_logits.shape[0]
[agent:bash]     A = np.zeros((n_vocab, RANK), dtype=float)
[agent:bash]     for i in range(n_vocab):
[agent:bash]         A[i, i % RANK] = ADAPTER_SCALE
[agent:bash]     B = np.zeros((RANK, n_vocab), dtype=float)
