[agent:bash] cat > /tmp/standardize.py << 'EOF'
[agent:bash] from pyspark.sql import SparkSession
[agent:bash] from pyspark.sql.functions import col, lit
[agent:bash] from pyspark.sql.types import DoubleType
[agent:bash] import numpy as np
[agent:bash] 
[agent:bash] spark = SparkSession.builder.getOrCreate()
[agent:bash] 
[agent:bash] # Read training data
[agent:bash] train = spark.read.csv("dbfs:/Volumes/workspace/mlpab8d41dc/mlpab8d41dc_volume/features_train.csv", header=True, inferSchema=True)
[agent:bash] 
[agent:bash] # Compute mean and std (population) for each feature
[agent:bash] stats = train.agg(
[agent:bash]     *[func(col(c)).alias(c) for c in ['f1', 'f2', 'f3', 'f4'] for func in [lambda x: x.mean(), lambda x: x.std()]]
[agent:bash] ).collect()[0]
[agent:bash] 
[agent:bash] means = {c: stats[f"avg({c})"] for c in ['f1', 'f2', 'f3', 'f4']}
[agent:bash] stds = {c: stats[f"stddev_pop({c})"] for c in ['f1', 'f2', 'f3', 'f4']}
[agent:bash] 
[agent:bash] # Standardize both splits
[agent:bash] def standardize(df, split_name):
[agent:bash]     for c in ['f1', 'f2', 'f3', 'f4']:
[agent:bash]         df = df.withColumn(c, ((col(c) - means[c]) / stds[c]).cast(DoubleType()))
[agent:bash]     return df.withColumn("split", lit(split_name))
[agent:bash] 
[agent:bash] # Process both splits
[agent:bash] train_std = standardize(train, "train")
[agent:bash] serve = spark.read.csv("dbfs:/Volumes/workspace/mlpab8d41dc/mlpab8d41dc_volume/features_serve.csv", header=True, inferSchema=True)
[agent:bash] serve_std = standardize(serve, "serve")
[agent:bash] 
[agent:bash] # Union and write to volume
[agent:bash] combined = train_std.unionByName(serve_std)
