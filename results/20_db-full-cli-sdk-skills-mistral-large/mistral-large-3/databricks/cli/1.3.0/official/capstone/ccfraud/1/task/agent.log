[agent:result] bytes_written: 2942
[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # Feature Engineering for Fraud Detection
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from databricks.feature_engineering import FeatureEngineeringClient
[agent:result] from pyspark.sql.functions import col, unix_timestamp, lag, count, sum, mean, stddev, abs, sqrt, pow, lit, when
[agent:result] from pyspark.sql.window import Window
[agent:result] import mlflow
[agent:result] 
[agent:result] # Initialize Feature Engineering Client
[agent:result] fe = FeatureEngineeringClient()
[agent:result] 
[agent:result] # Read raw data
[agent:result] raw_data_path = f"/Volumes/workspace/{dbutils.widgets.get('schema')}/raw/transactions.csv"
[agent:result] transactions_df = spark.read.csv(raw_data_path, header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Feature Engineering: Transaction velocity, geo distance, amount signals
[agent:result] # 1. Transaction velocity per card (count of transactions in the last 1 hour)
[agent:result] # 2. Average amount per card in the last 1 hour
[agent:result] # 3. Standard deviation of amount per card in the last 1 hour
[agent:result] # 4. Geo distance from the previous transaction
[agent:result] 
[agent:result] # Convert datetime to timestamp
[agent:result] transactions_df = transactions_df.withColumn("timestamp", unix_timestamp(col("datetime")))
[agent:result] 
[agent:result] # Window for time-based features (1 hour)
[agent:result] windowSpec = Window.partitionBy("cc_num").orderBy("timestamp").rangeBetween(-3600, 0)
[agent:result] 
[agent:result] # Feature 1: Transaction velocity (count in last 1 hour)
[agent:result] transactions_df = transactions_df.withColumn("txn_velocity_1h", count("*").over(windowSpec))
[agent:result] 
[agent:result] # Feature 2: Average amount in last 1 hour
[agent:result] transactions_df = transactions_df.withColumn("avg_amount_1h", mean("amount").over(windowSpec))
[agent:result] 
[agent:result] # Feature 3: Standard deviation of amount in last 1 hour
[agent:result] transactions_df = transactions_df.withColumn("std_amount_1h", stddev("amount").over(windowSpec))
[agent:result] 
[agent:result] # Feature 4: Geo distance from previous transaction
[agent:result] windowSpecPrev = Window.partitionBy("cc_num").orderBy("timestamp")
[agent:result] transactions_df = transactions_df.withColumn("prev_lat", lag("lat").over(windowSpecPrev))
[agent:result] transactions_df = transactions_df.withColumn("prev_long", lag("long").over(windowSpecPrev))
[agent:result] transactions_df = transactions_df.withColumn(
[agent:result]     "geo_distance",
[agent:result]     when(
[agent:result]         (col("prev_lat").isNotNull()) & (col("prev_long").isNotNull()),
[agent:result]         sqrt(pow(abs(col("lat") - col("prev_lat")) * 111.32, 2) + pow(abs(col("long") - col("prev_long")) * 111.32 * cos(radians(col("lat"))), 2))
[agent:result]     ).otherwise(lit(0.0))
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Create Feature Table
[agent:result] feature_table_name = f"workspace.{dbutils.widgets.get('schema')}.cctxne0b071"
[agent:result] 
[agent:result] # Write to Feature Store
[agent:result] fe.create_table(
[agent:result]     name=feature_table_name,
[agent:result]     primary_keys=["transaction_id"],
[agent:result]     df=transactions_df,
[agent:result]     partition_columns=[],
[agent:result]     description="Fraud detection features: transaction velocity, geo distance, amount statistics"
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Log the feature table in MLflow
[agent:result] with mlflow.start_run():
[agent:result]     mlflow.log_param("feature_table_name", feature_table_name)
[agent:result]     mlflow.log_param("primary_keys", ["transaction_id"])
[agent:result]     mlflow.log_param("features", ["txn_velocity_1h", "avg_amount_1h", "std_amount_1h", "geo_distance"])
