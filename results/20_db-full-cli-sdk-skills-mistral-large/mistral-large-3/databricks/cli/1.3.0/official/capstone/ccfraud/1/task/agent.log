[agent:result] content: # Databricks notebook source
[agent:result] # MAGIC %md
[agent:result] # Score Fraud Detection Model
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] from databricks.feature_engineering import FeatureEngineeringClient
[agent:result] from pyspark.sql.functions import col, lit
[agent:result] import mlflow
[agent:result] import pandas as pd
[agent:result] 
[agent:result] # Initialize Feature Engineering Client
[agent:result] fe = FeatureEngineeringClient()
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Read feature table and model
[agent:result] feature_table_name = f"workspace.{dbutils.widgets.get('schema')}.cctxne0b071"
[agent:result] model_name = f"workspace.{dbutils.widgets.get('schema')}.ccmodele0b071"
[agent:result] 
[agent:result] # Read scoring data
[agent:result] raw_data_path = f"/Volumes/workspace/{dbutils.widgets.get('schema')}/raw/score_transactions.csv"
[agent:result] score_df = spark.read.csv(raw_data_path, header=True, inferSchema=True)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Feature Engineering for scoring data (reuse logic from feature engineering)
[agent:result] from pyspark.sql.functions import unix_timestamp, lag, count, mean, stddev, abs, sqrt, pow, when
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Convert datetime to timestamp
[agent:result] score_df = score_df.withColumn("timestamp", unix_timestamp(col("datetime")))
[agent:result] 
[agent:result] # Window for time-based features (1 hour)
[agent:result] windowSpec = Window.partitionBy("cc_num").orderBy("timestamp").rangeBetween(-3600, 0)
[agent:result] 
[agent:result] # Feature 1: Transaction velocity (count in last 1 hour)
[agent:result] score_df = score_df.withColumn("txn_velocity_1h", count("*").over(windowSpec))
[agent:result] 
[agent:result] # Feature 2: Average amount in last 1 hour
[agent:result] score_df = score_df.withColumn("avg_amount_1h", mean("amount").over(windowSpec))
[agent:result] 
[agent:result] # Feature 3: Standard deviation of amount in last 1 hour
[agent:result] score_df = score_df.withColumn("std_amount_1h", stddev("amount").over(windowSpec))
[agent:result] 
[agent:result] # Feature 4: Geo distance from previous transaction
[agent:result] windowSpecPrev = Window.partitionBy("cc_num").orderBy("timestamp")
[agent:result] score_df = score_df.withColumn("prev_lat", lag("lat").over(windowSpecPrev))
[agent:result] score_df = score_df.withColumn("prev_long", lag("long").over(windowSpecPrev))
[agent:result] score_df = score_df.withColumn(
[agent:result]     "geo_distance",
[agent:result]     when(
[agent:result]         (col("prev_lat").isNotNull()) & (col("prev_long").isNotNull()),
[agent:result]         sqrt(pow(abs(col("lat") - col("prev_lat")) * 111.32, 2) + pow(abs(col("long") - col("prev_long")) * 111.32 * cos(radians(col("lat"))), 2))
[agent:result]     ).otherwise(lit(0.0))
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Load model
[agent:result] model_uri = f"models:/{model_name}/latest"
[agent:result] model = mlflow.sklearn.load_model(model_uri)
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Score data
[agent:result] pandas_score = score_df.toPandas()
[agent:result] X_score = pandas_score[["txn_velocity_1h", "avg_amount_1h", "std_amount_1h", "geo_distance"]]
[agent:result] 
[agent:result] fraud_probability = model.predict_proba(X_score)[:, 1]
[agent:result] pandas_score["fraud_probability"] = fraud_probability
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Write predictions to feature table
[agent:result] predictions_df = spark.createDataFrame(pandas_score[["transaction_id", "fraud_probability"]])
[agent:result] predictions_table_name = f"workspace.{dbutils.widgets.get('schema')}.ccprede0b071"
[agent:result] 
[agent:result] fe.create_table(
[agent:result]     name=predictions_table_name,
[agent:result]     primary_keys=["transaction_id"],
[agent:result]     df=predictions_df,
[agent:result]     description="Fraud probability predictions for transactions"
[agent:result] )
[agent:result] 
[agent:result] # COMMAND ----------
[agent:result] 
[agent:result] # Enable online lookup
[agent:result] fe.publish_table(predictions_table_name)
