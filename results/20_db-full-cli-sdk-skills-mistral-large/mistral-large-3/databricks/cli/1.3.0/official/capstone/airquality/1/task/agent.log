[agent:result] ### Step 2: Engineer Features
[agent:result] 
[agent:result] ```python
[agent:result] from pyspark.sql.functions import col, lag, avg
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Define a window for rolling calculations
[agent:result] window = Window.orderBy("date").rowsBetween(-7, 0)
[agent:result] 
[agent:result] # Engineer features
[agent:result] feature_df = spark_df.withColumn("pm25_lag7", lag("pm25", 7).over(Window.orderBy("date")))
[agent:result] feature_df = feature_df.withColumn("pm25_rolling_avg_7d", avg("pm25").over(window))
[agent:result] feature_df = feature_df.withColumn("temp_humidity_ratio", col("temperature") / col("humidity"))
[agent:result] 
[agent:result] # Drop rows with null values (due to lag features)
[agent:result] feature_df = feature_df.na.drop()
[agent:result] 
[agent:result] # Display the engineered features
[agent:result] feature_df.display()
[agent:result] ```
[agent:result] 
