[agent:result] content: # Databricks DLT pipeline to deduplicate and register the accounts feature table.
[agent:result] import dlt
[agent:result] from pyspark.sql.functions import col, row_number
[agent:result] from pyspark.sql.window import Window
[agent:result] 
[agent:result] # Read the three batches from the volume.
[agent:result] batch_1 = spark.read.format("csv").option("header", "true").load("/Volumes/workspace/mlpab58df8e/task_volume/batch_1.csv")
[agent:result] batch_2 = spark.read.format("csv").option("header", "true").load("/Volumes/workspace/mlpab58df8e/task_volume/batch_2.csv")
[agent:result] batch_3 = spark.read.format("csv").option("header", "true").load("/Volumes/workspace/mlpab58df8e/task_volume/batch_3.csv")
[agent:result] 
[agent:result] # Union all batches.
[agent:result] all_batches = batch_1.union(batch_2).union(batch_3)
[agent:result] 
[agent:result] # Deduplicate: keep the latest revision per row_id (using updated_at).
[agent:result] window = Window.partitionBy("row_id").orderBy(col("updated_at").desc())
[agent:result] deduped = all_batches.withColumn("rank", row_number().over(window)).filter(col("rank") == 1).drop("rank")
[agent:result] 
[agent:result] # Register as a feature table with record key and event-time column.
[agent:result] dlt.create_feature_table(
[agent:result]     name="accounts7b3169",
[agent:result]     primary_keys=["row_id"],
[agent:result]     timestamp_keys=["updated_at"],
[agent:result]     schema=deduped.schema
[agent:result] )
[agent:result] 
[agent:result] # Write the deduplicated data to the feature table.
[agent:result] dlt.apply_changes(
[agent:result]     target="accounts7b3169",
[agent:result]     source=deduped,
[agent:result]     keys=["row_id"],
[agent:result]     sequence_by="updated_at",
[agent:result]     apply_as_deletes=None,
[agent:result]     except_column_list=[],
[agent:result]     stored_as_scd_type=1
[agent:result] )
