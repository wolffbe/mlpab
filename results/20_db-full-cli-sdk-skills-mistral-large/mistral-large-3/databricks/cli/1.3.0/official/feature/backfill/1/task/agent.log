[agent:result] content: -- Databricks SQL notebook to deduplicate and register the accounts feature table.
[agent:result] 
[agent:result] -- Create a temporary view for each batch.
[agent:result] CREATE OR REPLACE TEMPORARY VIEW batch_1 AS
[agent:result] SELECT * FROM csv.`/Volumes/workspace/mlpab58df8e/task_volume/batch_1.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW batch_2 AS
[agent:result] SELECT * FROM csv.`/Volumes/workspace/mlpab58df8e/task_volume/batch_2.csv`;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW batch_3 AS
[agent:result] SELECT * FROM csv.`/Volumes/workspace/mlpab58df8e/task_volume/batch_3.csv`;
[agent:result] 
[agent:result] -- Union all batches and deduplicate: keep the latest revision per row_id.
[agent:result] CREATE OR REPLACE TEMPORARY VIEW all_batches AS
[agent:result] SELECT * FROM batch_1
[agent:result] UNION ALL
[agent:result] SELECT * FROM batch_2
[agent:result] UNION ALL
[agent:result] SELECT * FROM batch_3;
[agent:result] 
[agent:result] CREATE OR REPLACE TEMPORARY VIEW latest_revisions AS
[agent:result] WITH ranked AS (
[agent:result]   SELECT 
[agent:result]     *,
[agent:result]     ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY updated_at DESC) as rn
[agent:result]   FROM all_batches
[agent:result] )
[agent:result] SELECT row_id, status, balance, updated_at
[agent:result] FROM ranked
[agent:result] WHERE rn = 1;
[agent:result] 
[agent:result] -- Create or replace the feature table in the target schema.
[agent:result] CREATE OR REPLACE TABLE workspace.mlpab58df8e.accounts7b3169 AS
[agent:result] SELECT * FROM latest_revisions;
[agent:result] 
[agent:result] -- Register the table as a feature table with record key and event-time column.
[agent:result] CREATE FEATURE TABLE IF NOT EXISTS workspace.mlpab58df8e.accounts7b3169
[agent:result] AS SELECT * FROM workspace.mlpab58df8e.accounts7b3169
[agent:result] WITH PRIMARY KEY (row_id)
[agent:result] WITH TIMESTAMP KEY (updated_at);
