[agent:result] """Provided training script — deterministic logistic regression.
[agent:result] 
[agent:result] Reads train.csv and score.csv from its working directory, trains by plain
[agent:result] gradient descent (learning rate 0.1, exactly 300 iterations, weights and bias
[agent:result] initialized to zero) and writes predictions.csv with columns row_id, score
[agent:result] (rounded to 6 decimals). Fully deterministic — do NOT modify it; run it as-is.
[agent:result] """
[agent:result] import numpy as np
[agent:result] import pandas as pd
[agent:result] 
[agent:result] FEATURES = ["f1", "f2", "f3", "f4", "f5"]
[agent:result] LEARNING_RATE = 0.1
[agent:result] ITERATIONS = 300
[agent:result] 
[agent:result] 
[agent:result] def main():
[agent:result]     train = pd.read_csv("train.csv")
[agent:result]     score = pd.read_csv("score.csv")
[agent:result]     X = train[FEATURES].to_numpy(dtype=float)
[agent:result]     y = train["label"].to_numpy(dtype=float)
[agent:result]     w = np.zeros(X.shape[1], dtype=float)
[agent:result]     b = 0.0
[agent:result]     for _ in range(ITERATIONS):
[agent:result]         p = 1.0 / (1.0 + np.exp(-(X @ w + b)))
[agent:result]         g = p - y
[agent:result]         w = w - LEARNING_RATE * (X.T @ g) / len(y)
[agent:result]         b = b - LEARNING_RATE * g.mean()
[agent:result]     Xs = score[FEATURES].to_numpy(dtype=float)
[agent:result]     preds = 1.0 / (1.0 + np.exp(-(Xs @ w + b)))
[agent:result]     out = pd.DataFrame({"row_id": score["row_id"], "score": np.round(preds, 6)})
[agent:result]     out.to_csv("predictions.csv", index=False)
[agent:result] 
[agent:result] 
[agent:result] if __name__ == "__main__":
[agent:result]     main()
