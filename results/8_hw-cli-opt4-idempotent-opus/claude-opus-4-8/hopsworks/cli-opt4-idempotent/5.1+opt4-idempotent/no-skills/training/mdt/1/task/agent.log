[agent:bash] WITH stats AS (
[agent:bash]   SELECT avg(f1) m1, avg(f2) m2, avg(f3) m3, avg(f4) m4,
[agent:bash]          stddev_pop(f1) s1, stddev_pop(f2) s2, stddev_pop(f3) s3, stddev_pop(f4) s4
[agent:bash]   FROM scaled3effa1_train_raw_1
[agent:bash] ),
[agent:bash] both AS (
[agent:bash]   SELECT row_id, 'train' AS split, f1,f2,f3,f4 FROM scaled3effa1_train_raw_1
[agent:bash]   UNION ALL
[agent:bash]   SELECT row_id, 'serve' AS split, f1,f2,f3,f4 FROM scaled3effa1_serve_raw_1
[agent:bash] )
[agent:bash] SELECT b.row_id, b.split,
[agent:bash]   round((b.f1 - s.m1)/s.s1, 6) AS f1,
[agent:bash]   round((b.f2 - s.m2)/s.s2, 6) AS f2,
[agent:bash]   round((b.f3 - s.m3)/s.s3, 6) AS f3,
[agent:bash]   round((b.f4 - s.m4)/s.s4, 6) AS f4
[agent:bash] FROM both b CROSS JOIN stats s
