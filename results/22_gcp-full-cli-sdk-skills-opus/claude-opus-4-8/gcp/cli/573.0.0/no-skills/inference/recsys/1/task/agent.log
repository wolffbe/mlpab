[agent] Data loaded. Now compute the recommendations in BigQuery and materialize the `recs75dfad` table.
[agent:bash] cd "$(pwd)"
[agent:bash] SQL="CREATE OR REPLACE TABLE \`${GCP_PROJECT}.${GCP_BQ_DATASET}.recs75dfad\` AS
[agent:bash] WITH scores AS (
[agent:bash]   SELECT
[agent:bash]     u.user_id,
[agent:bash]     i.item_id,
[agent:bash]     (u.e1*i.e1 + u.e2*i.e2 + u.e3*i.e3 + u.e4*i.e4 + u.e5*i.e5 + u.e6*i.e6 + u.e7*i.e7 + u.e8*i.e8) AS score
[agent:bash]   FROM \`${GCP_BQ_DATASET}.user_embeddings\` u
[agent:bash]   CROSS JOIN \`${GCP_BQ_DATASET}.item_embeddings\` i
[agent:bash]   WHERE NOT EXISTS (
[agent:bash]     SELECT 1 FROM \`${GCP_BQ_DATASET}.interactions\` x
[agent:bash]     WHERE x.user_id = u.user_id AND x.item_id = i.item_id
[agent:bash]   )
[agent:bash] ),
[agent:bash] ranked AS (
[agent:bash]   SELECT
[agent:bash]     user_id, item_id, score,
[agent:bash]     ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY score DESC, item_id ASC) AS rank
[agent:bash]   FROM scores
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   CONCAT(user_id, '#', CAST(rank AS STRING)) AS rec_id,
[agent:bash]   user_id,
[agent:bash]   rank,
[agent:bash]   item_id
[agent:bash] FROM ranked
[agent:bash] WHERE rank <= 5
[agent:bash] ORDER BY user_id, rank"
