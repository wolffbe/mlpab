[agent:bash] cd "$(pwd)" && python -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] c=bigquery.Client(project=proj)
[agent:bash] # confirm f2 step: min after onset vs max before
[agent:bash] q=f'''
[agent:bash] SELECT
[agent:bash]  (SELECT MAX(am) FROM (SELECT AVG(f2) am FROM \`{proj}.{ds}.features_raw\` WHERE DATE(event_time) < '2026-02-22' GROUP BY DATE(event_time))) max_before,
[agent:bash]  (SELECT MIN(am) FROM (SELECT AVG(f2) am FROM \`{proj}.{ds}.features_raw\` WHERE DATE(event_time) >= '2026-02-22' GROUP BY DATE(event_time))) min_after
[agent:bash] '''
[agent:bash] r=list(c.query(q).result())[0]
[agent:bash] print('f2 max daily mean before 02-22:', round(r['max_before'],3))
[agent:bash] print('f2 min daily mean on/after 02-22:', round(r['min_after'],3))
[agent:bash] "
