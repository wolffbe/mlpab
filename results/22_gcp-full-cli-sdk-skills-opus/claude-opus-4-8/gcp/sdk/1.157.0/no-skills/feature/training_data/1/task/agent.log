[agent:bash] python3 -c "
[agent:bash] import os; import google.cloud.bigquery as bq
[agent:bash] c=bq.Client(project=os.environ['GCP_PROJECT'], location=os.environ['GCP_LOCATION'])
[agent:bash] ds='\`'+os.environ['GCP_PROJECT']+'.'+os.environ['GCP_BQ_DATASET']+'\`'
[agent:bash] tgt=os.environ['GCP_PROJECT']+'.'+os.environ['GCP_BQ_DATASET']+'.churntrainingcdae59'
[agent:bash] sql='CREATE OR REPLACE TABLE \`'+tgt+'\` AS WITH j AS (SELECT l.account_id, l.label_time, l.churned, (SELECT ARRAY_AGG(STRUCT(amount,balance) ORDER BY event_time DESC LIMIT 1)[SAFE_OFFSET(0)] FROM '+ds+'.f_transactions t WHERE t.account_id=l.account_id AND t.event_time<=l.label_time) AS tx, (SELECT ARRAY_AGG(STRUCT(credit_score,tier) ORDER BY event_time DESC LIMIT 1)[SAFE_OFFSET(0)] FROM '+ds+'.f_profiles p WHERE p.account_id=l.account_id AND p.event_time<=l.label_time) AS pr, (SELECT ARRAY_AGG(sessions_7d ORDER BY event_time DESC LIMIT 1)[SAFE_OFFSET(0)] FROM '+ds+'.f_activity a WHERE a.account_id=l.account_id AND a.event_time<=l.label_time) AS sess, (SELECT ARRAY_AGG(health_score ORDER BY event_time DESC LIMIT 1)[SAFE_OFFSET(0)] FROM '+ds+'.f_account_health h WHERE h.account_id=l.account_id AND h.event_time<=l.label_time) AS hs FROM '+ds+'.labels l) SELECT account_id, label_time, tx.amount AS amount, tx.balance AS balance, pr.credit_score AS credit_score, pr.tier AS tier, sess AS sessions_7d, hs AS health_score, churned FROM j'
[agent:bash] job=c.query(sql); job.result(); t=c.get_table(tgt); print('rows', t.num_rows); print('cols', [f.name for f in t.schema])
