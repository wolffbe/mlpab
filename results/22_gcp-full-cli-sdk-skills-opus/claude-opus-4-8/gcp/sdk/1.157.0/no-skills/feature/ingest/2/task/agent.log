[agent:bash] final=f'{project}.{dataset}.transactions8cf1c0'
[agent:bash] q=f"""
[agent:bash] CREATE OR REPLACE TABLE `{final}` AS
[agent:bash] SELECT row_id, account_id, event_time, amount, category,
[agent:bash]        TIMESTAMP_MILLIS(event_time) AS feature_timestamp
[agent:bash] FROM `{staging}`
[agent:bash] QUALIFY ROW_NUMBER() OVER (PARTITION BY row_id ORDER BY event_time) = 1
[agent:bash] """
