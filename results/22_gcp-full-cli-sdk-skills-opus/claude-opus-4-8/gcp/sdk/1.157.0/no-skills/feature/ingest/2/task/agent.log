[agent:bash]     bigquery.SchemaField('account_id','STRING'),
[agent:bash]     bigquery.SchemaField('event_time','INT64'),
[agent:bash]     bigquery.SchemaField('amount','FLOAT64'),
[agent:bash]     bigquery.SchemaField('category','STRING'),
[agent:bash] ]
[agent:bash] # fresh staging
[agent:bash] c.query(f"DROP TABLE IF EXISTS `{staging}`", location=loc).result()
[agent:bash] job_config=bigquery.LoadJobConfig(
[agent:bash]     schema=schema, skip_leading_rows=1, source_format=bigquery.SourceFormat.CSV,
[agent:bash]     write_disposition=bigquery.WriteDisposition.WRITE_APPEND,
[agent:bash] )
[agent:bash] for f in ['data/transactions_export_1.csv','data/transactions_export_2.csv']:
