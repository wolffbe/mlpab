[agent] Data loaded. Now compute recommendations via BigQuery SQL (platform-side) into the `recs75dfad` table.
[agent:bash] cd "$PWD" && venv/bin/python -c "
[agent:bash] import os
[agent:bash] import google.cloud.bigquery as bq
[agent:bash] project=os.environ['GCP_PROJECT']; dataset=os.environ['GCP_BQ_DATASET']
[agent:bash] client=bq.Client(project=project)
[agent:bash] fq=lambda t: '\`'+project+'.'+dataset+'.'+t+'\`'
[agent:bash] sql='''
[agent:bash] CREATE OR REPLACE TABLE {rec} AS
[agent:bash] WITH scores AS (
[agent:bash]   SELECT u.user_id, i.item_id,
[agent:bash]     u.e1*i.e1+u.e2*i.e2+u.e3*i.e3+u.e4*i.e4+u.e5*i.e5+u.e6*i.e6+u.e7*i.e7+u.e8*i.e8 AS score
[agent:bash]   FROM {u} u CROSS JOIN {i} i
[agent:bash]   WHERE NOT EXISTS (SELECT 1 FROM {x} x WHERE x.user_id=u.user_id AND x.item_id=i.item_id)
[agent:bash] ),
[agent:bash] ranked AS (
[agent:bash]   SELECT user_id, item_id,
[agent:bash]     ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY score DESC, item_id ASC) AS rank
[agent:bash]   FROM scores
[agent:bash] )
[agent:bash] SELECT CONCAT(user_id,'#',CAST(rank AS STRING)) AS rec_id, user_id, rank, item_id
[agent:bash] FROM ranked WHERE rank<=5
[agent:bash] '''.format(rec=fq('recs75dfad'), u=fq('user_embeddings'), i=fq('item_embeddings'), x=fq('interactions'))
[agent:bash] client.query(sql).result()
[agent:bash] t=client.get_table(project+'.'+dataset+'.recs75dfad')
[agent:bash] print('recs75dfad rows', t.num_rows, 'schema', [f.name+':'+f.field_type for f in t.schema])
[agent:bash] for r in client.query('SELECT rec_id,user_id,rank,item_id FROM '+fq('recs75dfad')+' ORDER BY user_id, rank LIMIT 7').result():
[agent:bash]     print(dict(r))
[agent:bash] "
