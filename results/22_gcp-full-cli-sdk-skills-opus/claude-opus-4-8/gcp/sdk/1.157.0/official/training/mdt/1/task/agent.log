[agent] Now build the standardized source table via BigQuery SQL (population std over train only, applied to both splits, rounded to 6 decimals).
[agent:bash] cd "$(pwd)" && python3 -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] PROJECT=os.environ['GCP_PROJECT']; DATASET=os.environ['GCP_BQ_DATASET']; LOCATION=os.environ['GCP_LOCATION']
[agent:bash] bq=bigquery.Client(project=PROJECT, location=LOCATION)
[agent:bash] ds=f'{PROJECT}.{DATASET}'
[agent:bash] sql=f'''
[agent:bash] CREATE OR REPLACE TABLE \`{ds}.scaled_source\` AS
[agent:bash] WITH stats AS (
[agent:bash]   SELECT AVG(f1) m1, AVG(f2) m2, AVG(f3) m3, AVG(f4) m4,
[agent:bash]          STDDEV_POP(f1) s1, STDDEV_POP(f2) s2, STDDEV_POP(f3) s3, STDDEV_POP(f4) s4
[agent:bash]   FROM \`{ds}.features_train\`
[agent:bash] ),
[agent:bash] combined AS (
[agent:bash]   SELECT row_id, 'train' AS split, f1,f2,f3,f4 FROM \`{ds}.features_train\`
[agent:bash]   UNION ALL
[agent:bash]   SELECT row_id, 'serve' AS split, f1,f2,f3,f4 FROM \`{ds}.features_serve\`
[agent:bash] )
[agent:bash] SELECT c.row_id, c.split,
[agent:bash]   ROUND((c.f1-s.m1)/s.s1,6) AS f1,
[agent:bash]   ROUND((c.f2-s.m2)/s.s2,6) AS f2,
[agent:bash]   ROUND((c.f3-s.m3)/s.s3,6) AS f3,
[agent:bash]   ROUND((c.f4-s.m4)/s.s4,6) AS f4,
[agent:bash]   TIMESTAMP('2024-01-01 00:00:00 UTC') AS feature_timestamp
[agent:bash] FROM combined c CROSS JOIN stats s
[agent:bash] '''
[agent:bash] bq.query(sql, location=LOCATION).result()
[agent:bash] t=bq.get_table(f'{ds}.scaled_source')
[agent:bash] print('scaled_source rows:', t.num_rows)
[agent:bash] for r in bq.query(f'SELECT split, COUNT(*) n FROM \`{ds}.scaled_source\` GROUP BY split ORDER BY split', location=LOCATION).result():
[agent:bash]     print(r.split, r.n)
[agent:bash] for r in bq.query(f'SELECT * FROM \`{ds}.scaled_source\` ORDER BY row_id LIMIT 3', location=LOCATION).result():
[agent:bash]     print(dict(r))
[agent:bash] "
