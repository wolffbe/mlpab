[agent:bash] loc = os.environ["GCP_LOCATION"]
[agent:bash] client = bigquery.Client(project=project, location=loc)
[agent:bash] 
[agent:bash] def load(csv_path, table, schema):
[agent:bash]     tid = f"{project}.{dataset}.{table}"
[agent:bash]     job_config = bigquery.LoadJobConfig(
[agent:bash]         source_format=bigquery.SourceFormat.CSV,
[agent:bash]         skip_leading_rows=1,
[agent:bash]         schema=schema,
[agent:bash]         write_disposition="WRITE_TRUNCATE",
[agent:bash]     )
[agent:bash]     with open(csv_path, "rb") as f:
[agent:bash]         job = client.load_table_from_file(f, tid, job_config=job_config)
[agent:bash]     job.result()
[agent:bash]     t = client.get_table(tid)
[agent:bash]     print(f"loaded {table}: {t.num_rows} rows")
[agent:bash] 
