[agent:bash] sel=", ".join(["CORR("+f+", label) AS c_"+f for f in feats])
[agent:bash] q="SELECT "+sel+" FROM `"+t+"`"
[agent:bash] row=list(client.query(q).result())[0]
[agent:bash] print("Pearson corr with label:")
[agent:bash] for f in feats:
[agent:bash]     print("  "+f+": "+format(row["c_"+f],".4f"))
[agent:bash] # class-conditional separation: mean by label and pooled std -> effect size
[agent:bash] print()
[agent:bash] print("Class-conditional means (label=0 vs 1) and separation score:")
[agent:bash] parts=[]
[agent:bash] for f in feats:
[agent:bash]     parts.append("AVG(IF(label=0,"+f+",NULL)) AS m0_"+f)
[agent:bash]     parts.append("AVG(IF(label=1,"+f+",NULL)) AS m1_"+f)
[agent:bash]     parts.append("STDDEV(IF(label=0,"+f+",NULL)) AS s0_"+f)
[agent:bash]     parts.append("STDDEV(IF(label=1,"+f+",NULL)) AS s1_"+f)
[agent:bash] q2="SELECT "+", ".join(parts)+" FROM `"+t+"`"
[agent:bash] r=list(client.query(q2).result())[0]
[agent:bash] for f in feats:
[agent:bash]     m0=r["m0_"+f]; m1=r["m1_"+f]; s0=r["s0_"+f]; s1=r["s1_"+f]
[agent:bash]     pooled=((s0**2+s1**2)/2)**0.5
[agent:bash]     d=abs(m1-m0)/pooled if pooled else float("inf")
[agent:bash]     print("  "+f+": mean0="+format(m0,".3f")+" mean1="+format(m1,".3f")+" cohen_d="+format(d,".3f"))
[agent:bash] '
