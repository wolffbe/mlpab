[agent:bash] import os
[agent:bash] import google.cloud.bigquery as bq
[agent:bash] 
[agent:bash] project = os.environ['GCP_PROJECT']
[agent:bash] dataset = os.environ['GCP_BQ_DATASET']
[agent:bash] client = bq.Client(project=project)
[agent:bash] 
[agent:bash] def load(table_id, csv_path, schema):
[agent:bash]     ref = f"{project}.{dataset}.{table_id}"
[agent:bash]     job_config = bq.LoadJobConfig(
[agent:bash]         schema=schema,
[agent:bash]         skip_leading_rows=1,
[agent:bash]         source_format=bq.SourceFormat.CSV,
[agent:bash]         write_disposition=bq.WriteDisposition.WRITE_TRUNCATE,
[agent:bash]     )
[agent:bash]     with open(csv_path, "rb") as f:
[agent:bash]         job = client.load_table_from_file(f, ref, job_config=job_config)
[agent:bash]     job.result()
[agent:bash]     t = client.get_table(ref)
[agent:bash]     print(f"{table_id}: {t.num_rows} rows, cols={[s.name for s in t.schema]}")
[agent:bash] 
