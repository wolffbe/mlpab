[agent:bash] # Training dataset assembled from the feature group
[agent:bash] cols="transaction_id, cc_num, amount, log_amount, category, hour, is_night, geo_dist_km, amount_dev, amount_ratio, amount_z, secs_since_prev, txn_1h, txn_24h, is_fraud"
[agent:bash] bq.query(f"CREATE OR REPLACE TABLE `{FQ}.cctd76ccb2` AS SELECT {cols} FROM `{FQ}.cctxn76ccb2`").result()
