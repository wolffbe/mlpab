[agent] Now feature engineering. I'll create the feature group table with engineered features.
[agent:bash] venv/bin/python3 -c '
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] proj=os.environ["GCP_PROJECT"]; ds=os.environ["GCP_BQ_DATASET"]
[agent:bash] bq=bigquery.Client(project=proj)
[agent:bash] FQ=f"{proj}.{ds}"
[agent:bash] 
[agent:bash] def feat_sql(src, with_label):
[agent:bash]     label = ", is_fraud" if with_label else ""
[agent:bash]     return f"""
[agent:bash] WITH cs AS (
[agent:bash]   SELECT cc_num, AVG(lat) home_lat, AVG(long) home_long,
[agent:bash]          AVG(amount) avg_amt, STDDEV(amount) std_amt
[agent:bash]   FROM `{FQ}.raw_txn` GROUP BY cc_num
[agent:bash] ),
[agent:bash] gcs AS (SELECT AVG(lat) g_lat, AVG(long) g_long, AVG(amount) g_amt FROM `{FQ}.raw_txn`),
[agent:bash] b AS (
[agent:bash]   SELECT s.*,
[agent:bash]     COALESCE(cs.home_lat, g.g_lat) home_lat,
[agent:bash]     COALESCE(cs.home_long, g.g_long) home_long,
[agent:bash]     COALESCE(cs.avg_amt, g.g_amt) avg_amt,
[agent:bash]     COALESCE(cs.std_amt, 1.0) std_amt
[agent:bash]   FROM `{FQ}.{src}` s CROSS JOIN gcs g LEFT JOIN cs ON s.cc_num=cs.cc_num
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   transaction_id, cc_num, datetime,
[agent:bash]   amount,
[agent:bash]   LN(amount+1) AS log_amount,
[agent:bash]   category,
[agent:bash]   EXTRACT(HOUR FROM datetime) AS hour,
[agent:bash]   IF(EXTRACT(HOUR FROM datetime) < 6, 1, 0) AS is_night,
[agent:bash]   ST_DISTANCE(ST_GEOGPOINT(long,lat), ST_GEOGPOINT(home_long,home_lat))/1000.0 AS geo_dist_km,
[agent:bash]   amount - avg_amt AS amount_dev,
[agent:bash]   SAFE_DIVIDE(amount, avg_amt) AS amount_ratio,
[agent:bash]   SAFE_DIVIDE(amount - avg_amt, NULLIF(std_amt,0)) AS amount_z,
[agent:bash]   IFNULL(TIMESTAMP_DIFF(datetime, LAG(datetime) OVER (PARTITION BY cc_num ORDER BY datetime), SECOND), 999999) AS secs_since_prev,
[agent:bash]   COUNT(*) OVER (PARTITION BY cc_num ORDER BY UNIX_SECONDS(datetime) RANGE BETWEEN 3600 PRECEDING AND CURRENT ROW) AS txn_1h,
[agent:bash]   COUNT(*) OVER (PARTITION BY cc_num ORDER BY UNIX_SECONDS(datetime) RANGE BETWEEN 86400 PRECEDING AND CURRENT ROW) AS txn_24h
[agent:bash]   {label}
[agent:bash] FROM b
[agent:bash] """
[agent:bash] 
[agent:bash] # Feature group (training features + label)
[agent:bash] bq.query(f"CREATE OR REPLACE TABLE `{FQ}.cctxn76ccb2` AS {feat_sql(\"raw_txn\", True)}").result()
[agent:bash] print("cctxn76ccb2:", bq.get_table(f"{FQ}.cctxn76ccb2").num_rows)
[agent:bash] # Score features (no label)
[agent:bash] bq.query(f"CREATE OR REPLACE TABLE `{FQ}.score_feat` AS {feat_sql(\"raw_score\", False)}").result()
[agent:bash] print("score_feat:", bq.get_table(f"{FQ}.score_feat").num_rows)
[agent:bash] # sample check
