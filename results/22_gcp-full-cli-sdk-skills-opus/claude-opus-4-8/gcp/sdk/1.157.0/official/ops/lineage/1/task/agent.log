[agent:bash] cat > .tmp_ingest.py 2>/dev/null || mkdir -p .tmp && cat > .tmp/ingest.py << 'PYEOF'
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] 
[agent:bash] proj = os.environ['GCP_PROJECT']; ds = os.environ['GCP_BQ_DATASET']; loc = os.environ['GCP_LOCATION']
[agent:bash] c = bigquery.Client(project=proj)
[agent:bash] 
[agent:bash] def load(table, path, valcol):
[agent:bash]     tid = f"{proj}.{ds}.{table}"
[agent:bash]     schema = [
[agent:bash]         bigquery.SchemaField("row_id", "STRING"),
[agent:bash]         bigquery.SchemaField(valcol, "FLOAT64"),
[agent:bash]     ]
[agent:bash]     job_config = bigquery.LoadJobConfig(
[agent:bash]         schema=schema, skip_leading_rows=1,
[agent:bash]         source_format=bigquery.SourceFormat.CSV,
[agent:bash]         write_disposition="WRITE_TRUNCATE",
[agent:bash]     )
[agent:bash]     with open(path, "rb") as f:
[agent:bash]         job = c.load_table_from_file(f, tid, job_config=job_config, location=loc)
[agent:bash]     job.result()
[agent:bash]     t = c.get_table(tid)
[agent:bash]     print(f"loaded {table}: {t.num_rows} rows, schema={[s.name for s in t.schema]}")
[agent:bash] 
[agent:bash] load("rawa55c41b", "data/raw_a.csv", "a_val")
[agent:bash] load("rawb55c41b", "data/raw_b.csv", "b_val")
[agent:bash] 
[agent:bash] # Derived: inner join, col_sum rounded to 6 decimals
[agent:bash] derived_tid = f"{proj}.{ds}.derived55c41b"
[agent:bash] sql = f"""
[agent:bash] CREATE OR REPLACE TABLE `{derived_tid}` AS
[agent:bash] SELECT a.row_id AS row_id,
[agent:bash]        ROUND(a.a_val + b.b_val, 6) AS col_sum
[agent:bash] FROM `{proj}.{ds}.rawa55c41b` a
[agent:bash] JOIN `{proj}.{ds}.rawb55c41b` b
[agent:bash]   ON a.row_id = b.row_id
[agent:bash] """
[agent:bash] c.query(sql, location=loc).result()
[agent:bash] t = c.get_table(derived_tid)
[agent:bash] print(f"derived55c41b: {t.num_rows} rows, schema={[s.name for s in t.schema]}")
[agent:bash] # sample
[agent:bash] rows = list(c.query(f"SELECT row_id, col_sum FROM `{derived_tid}` ORDER BY row_id LIMIT 3", location=loc).result())
[agent:bash] for r in rows: print(dict(r))
[agent:bash] PYEOF
