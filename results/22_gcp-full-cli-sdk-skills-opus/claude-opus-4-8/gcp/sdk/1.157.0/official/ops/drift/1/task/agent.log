[agent] Now let me compute daily statistics per feature using BigQuery (platform-side):
[agent:bash] cd "$(pwd)" && python -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] c=bigquery.Client(project=proj)
[agent:bash] q=f'''
[agent:bash] SELECT DATE(event_time) AS d,
[agent:bash]  AVG(f1) f1m, STDDEV(f1) f1s,
[agent:bash]  AVG(f2) f2m, STDDEV(f2) f2s,
[agent:bash]  AVG(f3) f3m, STDDEV(f3) f3s,
[agent:bash]  AVG(f4) f4m, STDDEV(f4) f4s,
[agent:bash]  AVG(f5) f5m, STDDEV(f5) f5s,
[agent:bash]  AVG(f6) f6m, STDDEV(f6) f6s
[agent:bash] FROM \`{proj}.{ds}.features\`
[agent:bash] GROUP BY d ORDER BY d
[agent:bash] '''
[agent:bash] rows=list(c.query(q).result())
[agent:bash] print('day', 'f1m','f2m','f3m','f4m','f5m','f6m')
[agent:bash] for r in rows:
