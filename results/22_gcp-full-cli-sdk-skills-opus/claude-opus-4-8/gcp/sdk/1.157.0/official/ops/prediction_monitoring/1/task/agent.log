[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] bq=bigquery.Client(project=proj)
[agent:bash] tid=f'\`{proj}.{ds}.prediction_log\`'
[agent:bash] sql=f'''
[agent:bash] WITH days AS (SELECT DISTINCT DATE(ts) d FROM {tid}),
[agent:bash] p AS (SELECT DATE(ts) pd, prediction FROM {tid}),
[agent:bash] scan AS (
[agent:bash]   SELECT c.d AS onset,
[agent:bash]     AVG(IF(p.pd < c.d, p.prediction, NULL)) mb,
[agent:bash]     AVG(IF(p.pd >= c.d, p.prediction, NULL)) ma,
[agent:bash]     VAR_SAMP(IF(p.pd < c.d, p.prediction, NULL)) vb,
[agent:bash]     VAR_SAMP(IF(p.pd >= c.d, p.prediction, NULL)) va,
[agent:bash]     COUNTIF(p.pd < c.d) nb,
[agent:bash]     COUNTIF(p.pd >= c.d) na
[agent:bash]   FROM days c CROSS JOIN p GROUP BY c.d )
[agent:bash] SELECT onset, ROUND(mb,4) mb, ROUND(ma,4) ma, nb, na,
[agent:bash]   ROUND(ABS(ma-mb)/SQRT(vb/nb + va/na),1) tstat
[agent:bash] FROM scan WHERE nb>0 AND na>0
