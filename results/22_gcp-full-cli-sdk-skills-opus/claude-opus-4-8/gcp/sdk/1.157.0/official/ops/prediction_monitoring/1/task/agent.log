[agent] The shift is unmistakable: daily mean is ~2.55 through 2026-02-25, then jumps to ~5.21 starting 2026-02-26. Let me confirm the exact changepoint with a rigorous BigQuery t-statistic scan over all candidate split dates.
[agent:bash] cd "$PWD" && ./venv/bin/python -c "
[agent:bash] import os
[agent:bash] from google.cloud import bigquery
[agent:bash] proj=os.environ['GCP_PROJECT']; ds=os.environ['GCP_BQ_DATASET']
[agent:bash] bq=bigquery.Client(project=proj)
[agent:bash] tid=f'\`{proj}.{ds}.prediction_log\`'
[agent:bash] # For each candidate onset date, split into before/after and compute Welch t-statistic magnitude
[agent:bash] sql=f'''
[agent:bash] WITH days AS (SELECT DISTINCT DATE(ts) d FROM {tid}),
[agent:bash] scan AS (
[agent:bash]   SELECT c.d AS onset,
[agent:bash]     (SELECT AVG(prediction) FROM {tid} WHERE DATE(ts) < c.d) mb,
[agent:bash]     (SELECT AVG(prediction) FROM {tid} WHERE DATE(ts) >= c.d) ma,
[agent:bash]     (SELECT VAR_SAMP(prediction) FROM {tid} WHERE DATE(ts) < c.d) vb,
[agent:bash]     (SELECT VAR_SAMP(prediction) FROM {tid} WHERE DATE(ts) >= c.d) va,
[agent:bash]     (SELECT COUNT(*) FROM {tid} WHERE DATE(ts) < c.d) nb,
[agent:bash]     (SELECT COUNT(*) FROM {tid} WHERE DATE(ts) >= c.d) na
[agent:bash]   FROM days c )
[agent:bash] SELECT onset, ROUND(mb,4) mb, ROUND(ma,4) ma,
[agent:bash]   ROUND(ABS(ma-mb)/SQRT(vb/nb + va/na),1) tstat
[agent:bash] FROM scan WHERE nb>0 AND na>0
[agent:bash] ORDER BY tstat DESC LIMIT 5'''
[agent:bash] for r in bq.query(sql).result():
[agent:bash]     print('onset',r.onset,'meanBefore',r.mb,'meanAfter',r.ma,'|t|',r.tstat)
[agent:bash] "
