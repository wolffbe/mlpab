[agent:result] fs = project.get_feature_store()
[agent:result] 
[agent:result] # Feature group name and version
[agent:result] FG_NAME = "incremental092284"
[agent:result] FG_VERSION = 1
[agent:result] 
[agent:result] # Get the feature group
[agent:result] fg = fs.get_feature_group(FG_NAME, version=FG_VERSION)
[agent:result] 
[agent:result] # Define the data directory (this would be configured in the job)
[agent:result] # For the job, we'll use a path that can be passed as an argument
[agent:result] import sys
[agent:result] 
[agent:result] def find_new_increment_files(data_dir):
[agent:result]     """Find increment files that haven't been processed yet."""
[agent:result]     # List all increment files
[agent:result]     increment_files = sorted(glob.glob(os.path.join(data_dir, "increment_*.csv")))
[agent:result]     return increment_files
[agent:result] 
[agent:result] def main():
[agent:result]     # Get data directory from arguments or use default
[agent:result]     if len(sys.argv) > 1:
[agent:result]         data_dir = sys.argv[1]
[agent:result]     else:
[agent:result]         data_dir = "/srv/data"  # Default path
[agent:result]     
[agent:result]     print(f"Looking for increment files in: {data_dir}")
[agent:result]     
[agent:result]     # Find all increment files
[agent:result]     increment_files = find_new_increment_files(data_dir)
[agent:result]     
[agent:result]     if not increment_files:
[agent:result]         print("No increment files found to process.")
[agent:result]         return
[agent:result]     
[agent:result]     print(f"Found {len(increment_files)} increment files to process")
[agent:result]     
[agent:result]     # Process each file
[agent:result]     for file_path in increment_files:
[agent:result]         print(f"Processing {file_path}")
[agent:result]         
[agent:result]         # Read the CSV file
[agent:result]         df = pd.read_csv(file_path)
[agent:result]         
[agent:result]         # Insert into feature group
[agent:result]         fg.insert(df)
[agent:result]         print(f"Inserted {len(df)} rows from {file_path}")
[agent:result]     
