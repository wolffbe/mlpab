[agent:result] # Define the window: partition by account_id, order by event_time_days
[agent:result] # Range between -7 and 0 (7 days before current row, inclusive)
[agent:result] window_spec = Window.partitionBy("account_id").orderBy("event_time_days").rangeBetween(-7, 0)
[agent:result] 
[agent:result] # Compute the sum of amount over the 7-day window
[agent:result] merged_df = merged_df.withColumn("amount_7d", spark_sum(col("amount")).over(window_spec))
[agent:result] 
[agent:result] # Select the required columns
[agent:result] result_df = merged_df.select("row_id", "account_id", "event_time", "amount_usd", "is_weekend", "amount_7d")
[agent:result] 
[agent:result] # Create the new feature group
[agent:result] feature_group_name = "features08ad16"
[agent:result] fg = fs.create_feature_group(
[agent:result]     name=feature_group_name,
[agent:result]     version=1,
[agent:result]     primary_key=["row_id"],
[agent:result]     event_time="event_time",
[agent:result]     online_enabled=True,
[agent:result]     description="Derived feature table with amount_usd, is_weekend, and amount_7d"
[agent:result] )
[agent:result] 
[agent:result] # Insert the data
[agent:result] fg.insert(result_df)
[agent:result] 
[agent:result] print(f"Feature group {feature_group_name} v1 created and populated successfully")
