[agent:result]         seven_days_ago = current_time - timedelta(days=7)
[agent:result]         # Filter rows within the 7-day window (inclusive)
[agent:result]         mask = (group["event_time_dt"] >= seven_days_ago) & (group["event_time_dt"] <= current_time)
[agent:result]         window_amounts = group.loc[mask, "amount"]
[agent:result]         group.at[i, "amount_7d"] = window_amounts.sum()
[agent:result]     return group
