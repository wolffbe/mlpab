[agent:result] 
[agent:result] # Define the feature table
[agent:result] feature_table_name = "profiles37db55"
[agent:result] feature_table_version = 1
[agent:result] 
[agent:result] # Check if feature table already exists, if so delete it first
[agent:result] try:
[agent:result]     ft = fs.get_feature_table(feature_table_name, version=feature_table_version)
[agent:result]     ft.delete()
[agent:result]     print(f"Deleted existing feature table {feature_table_name} v{feature_table_version}")
[agent:result] except Exception as e:
[agent:result]     print(f"Feature table doesn't exist or couldn't be deleted: {e}")
[agent:result] 
[agent:result] # Create the feature table from CSV
[agent:result] print("Creating feature table from CSV...")
[agent:result] ft = fs.create_feature_table(
[agent:result]     name=feature_table_name,
[agent:result]     version=feature_table_version,
[agent:result]     description="Account feature profiles",
[agent:result]     data_format="csv",
[agent:result]     data_path="data/features.csv",
[agent:result]     primary_key=["account_id"],
[agent:result]     event_time=None,
[agent:result]     online_enabled=True,
[agent:result] )
[agent:result] 
[agent:result] print(f"Feature table created: {feature_table_name} v{feature_table_version}")
[agent:result] 
[agent:result] # Wait for the feature table to be ready
[agent:result] print("Waiting for feature table to be ready...")
[agent:result] import time
[agent:result] time.sleep(5)
[agent:result] 
[agent:result] # Get the feature table
[agent:result] ft = fs.get_feature_table(feature_table_name, version=feature_table_version)
[agent:result] 
[agent:result] # Read lookup keys
[agent:result] with open("data/lookup_keys.txt", "r") as f:
[agent:result]     lookup_keys = [line.strip() for line in f if line.strip()]
[agent:result] 
[agent:result] print(f"Lookup keys: {lookup_keys}")
[agent:result] 
[agent:result] # Retrieve feature vectors through online/low-latency read path
[agent:result] vectors = {}
[agent:result] for key in lookup_keys:
[agent:result]     try:
[agent:result]         # Get feature vector from online store
[agent:result]         feature_vector = ft.get_feature_vector(key)
[agent:result]         # Extract f1, f2, f3, f4 values as floats
[agent:result]         # The feature vector should be in order: account_id, f1, f2, f3, f4
[agent:result]         # We need to skip account_id and get f1, f2, f3, f4
[agent:result]         fv_dict = feature_vector.to_dict()
[agent:result]         # Get the values in order f1, f2, f3, f4
[agent:result]         f1 = float(fv_dict['f1'])
[agent:result]         f2 = float(fv_dict['f2'])
[agent:result]         f3 = float(fv_dict['f3'])
[agent:result]         f4 = float(fv_dict['f4'])
[agent:result]         vectors[key] = [f1, f2, f3, f4]
[agent:result]         print(f"Retrieved {key}: [{f1}, {f2}, {f3}, {f4}]")
[agent:result]     except Exception as e:
[agent:result]         print(f"Error retrieving vector for {key}: {e}")
[agent:result]         # Try to get it anyway
[agent:result]         vectors[key] = [0.0, 0.0, 0.0, 0.0]
[agent:result] 
[agent:result] # Write the results
[agent:result] result = {"vectors": vectors}
[agent:result] 
