[agent:result]         # Using datetime objects
[agent:result]         from datetime import datetime
[agent:result]         fg.filter(fg.category == "A").read(start_time=datetime(2024, 1, 1), end_time=datetime(2024, 1, 31))
[agent:result]         # Reading data from yesterday to now
[agent:result]         from datetime import datetime, timedelta
[agent:result]         fg.filter(fg.category == "A").read(start_time=datetime.now() - timedelta(days=1), end_time=datetime.now())
[agent:result]         ```
