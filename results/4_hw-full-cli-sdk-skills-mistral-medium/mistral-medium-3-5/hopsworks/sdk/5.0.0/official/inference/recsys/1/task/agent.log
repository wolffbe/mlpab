[agent:result] import hopsworks
[agent:result] 
[agent:result] # Read data
[agent:result] interactions = pd.read_csv('data/interactions.csv')
[agent:result] user_embeddings = pd.read_csv('data/user_embeddings.csv')
[agent:result] item_embeddings = pd.read_csv('data/item_embeddings.csv')
[agent:result] 
[agent:result] # Extract embedding columns (e1..e8)
[agent:result] user_emb_cols = [c for c in user_embeddings.columns if c.startswith('e')]
[agent:result] item_emb_cols = [c for c in item_embeddings.columns if c.startswith('e')]
[agent:result] 
[agent:result] # Convert to numpy arrays for efficient dot product computation
[agent:result] user_emb_matrix = user_embeddings[user_emb_cols].values  # shape: (n_users, 8)
[agent:result] item_emb_matrix = item_embeddings[item_emb_cols].values  # shape: (n_items, 8)
[agent:result] 
[agent:result] # Compute all dot products: score[i, j] = dot product of user i and item j
[agent:result] score_matrix = np.dot(user_emb_matrix, item_emb_matrix.T)  # shape: (n_users, n_items)
[agent:result] 
[agent:result] # Build interaction lookup: for each user, set of items they've interacted with
[agent:result] user_interactions = interactions.groupby('user_id')['item_id'].apply(set).to_dict()
[agent:result] 
[agent:result] # Map user_id and item_id to indices
[agent:result] user_id_to_idx = {uid: i for i, uid in enumerate(user_embeddings['user_id'])}
[agent:result] item_id_to_idx = {iid: j for j, iid in enumerate(item_embeddings['item_id'])}
[agent:result] idx_to_item_id = {j: iid for j, iid in enumerate(item_embeddings['item_id'])}
[agent:result] idx_to_user_id = {i: uid for i, uid in enumerate(user_embeddings['user_id'])}
[agent:result] 
[agent:result] # Build recommendations
[agent:result] all_recs = []
[agent:result] 
[agent:result] for user_idx in range(len(user_embeddings)):
[agent:result]     user_id = idx_to_user_id[user_idx]
[agent:result]     
[agent:result]     # Get items this user has already interacted with
[agent:result]     interacted_items = user_interactions.get(user_id, set())
[agent:result]     
[agent:result]     # Get scores for this user
[agent:result]     scores = score_matrix[user_idx]  # shape: (n_items,)
[agent:result]     
[agent:result]     # Build list of (item_id, score, item_idx) for all items
[agent:result]     candidates = []
[agent:result]     for item_idx in range(len(item_embeddings)):
[agent:result]         item_id = idx_to_item_id[item_idx]
[agent:result]         if item_id not in interacted_items:
[agent:result]             candidates.append((item_id, scores[item_idx], item_idx))
[agent:result]     
[agent:result]     # Sort by score descending, then by item_id ascending for ties
[agent:result]     candidates.sort(key=lambda x: (-x[1], x[0]))
[agent:result]     
[agent:result]     # Take top 5
[agent:result]     top5 = candidates[:5]
[agent:result]     
[agent:result]     # Create rec_id and rank
