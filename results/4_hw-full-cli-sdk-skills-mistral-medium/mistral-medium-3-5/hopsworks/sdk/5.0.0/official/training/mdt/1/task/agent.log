[agent:result] # Compute mean and std (population) from training data only
[agent:result] stats = {}
[agent:result] for col in ['f1', 'f2', 'f3', 'f4']:
[agent:result]     mean = train_df[col].mean()
[agent:result]     std = train_df[col].std(ddof=0)  # population std
[agent:result]     stats[col] = {'mean': mean, 'std': std}
