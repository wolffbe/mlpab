[agent:result] content: #!/usr/bin/env python3
[agent:result] import pandas as pd
[agent:result] import hopsworks
[agent:result] 
[agent:result] # Read the data
[agent:result] train_df = pd.read_csv('data/features_train.csv')
[agent:result] serve_df = pd.read_csv('data/features_serve.csv')
[agent:result] 
[agent:result] # Compute mean and std (population) from training data only
[agent:result] stats = {}
[agent:result] for col in ['f1', 'f2', 'f3', 'f4']:
[agent:result]     mean = train_df[col].mean()
[agent:result]     std = train_df[col].std(ddof=0)  # population std
[agent:result]     stats[col] = {'mean': mean, 'std': std}
[agent:result] 
[agent:result] # Standardize both splits
[agent:result] for df, split_name in [(train_df, 'train'), (serve_df, 'serve')]:
[agent:result]     df['split'] = split_name
[agent:result] 
[agent:result] # Standardize features
[agent:result] def standardize(value, mean, std):
[agent:result]     return round((value - mean) / std, 6)
[agent:result] 
[agent:result] for col in ['f1', 'f2', 'f3', 'f4']:
[agent:result]     mean = stats[col]['mean']
[agent:result]     std = stats[col]['std']
[agent:result]     train_df[col] = train_df[col].apply(lambda x: standardize(x, mean, std))
[agent:result]     serve_df[col] = serve_df[col].apply(lambda x: standardize(x, mean, std))
[agent:result] 
[agent:result] # Combine both splits
