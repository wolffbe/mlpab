[agent:result] serve_df['split'] = 'serve'
[agent:result] 
[agent:result] # Standardize features using training statistics
[agent:result] def standardize(value, mean, std):
[agent:result]     return round((value - mean) / std, 6)
[agent:result] 
[agent:result] for col in ['f1', 'f2', 'f3', 'f4']:
[agent:result]     mean = stats[col]['mean']
[agent:result]     std = stats[col]['std']
[agent:result]     train_df[col] = train_df[col].apply(lambda x: standardize(x, mean, std))
[agent:result]     serve_df[col] = serve_df[col].apply(lambda x: standardize(x, mean, std))
[agent:result] 
[agent:result] # Combine both splits
[agent:result] combined_df = pd.concat([train_df, serve_df], ignore_index=True)
[agent:result] 
