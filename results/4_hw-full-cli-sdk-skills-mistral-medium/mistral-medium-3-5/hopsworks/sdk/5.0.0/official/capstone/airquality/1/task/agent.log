[agent:result] print(f"Forecast columns: {forecast_df.columns.tolist()}")
[agent:result] 
[agent:result] # Feature Engineering
[agent:result] # We have: date, pm25_lag1, temperature, humidity, wind_speed, pressure, precipitation, pm25
[agent:result] # We need to create additional features for better prediction
[agent:result] 
[agent:result] # Convert date to datetime
[agent:result] history_df['date'] = pd.to_datetime(history_df['date'])
[agent:result] forecast_df['date'] = pd.to_datetime(forecast_df['date'])
[agent:result] 
[agent:result] # Add rolling features to history data
[agent:result] history_df = history_df.sort_values('date')
[agent:result] 
[agent:result] # Create rolling statistics (7-day rolling mean, std)
[agent:result] history_df['pm25_rolling_7d_mean'] = history_df['pm25'].rolling(window=7, min_periods=1).mean()
[agent:result] history_df['pm25_rolling_7d_std'] = history_df['pm25'].rolling(window=7, min_periods=1).std()
[agent:result] history_df['temp_rolling_7d_mean'] = history_df['temperature'].rolling(window=7, min_periods=1).mean()
[agent:result] history_df['humidity_rolling_7d_mean'] = history_df['humidity'].rolling(window=7, min_periods=1).mean()
[agent:result] 
[agent:result] # Create lag features
[agent:result] history_df['pm25_lag2'] = history_df['pm25'].shift(1)
[agent:result] history_df['pm25_lag3'] = history_df['pm25'].shift(2)
[agent:result] 
[agent:result] # Add time-based features
[agent:result] history_df['day_of_week'] = history_df['date'].dt.dayofweek
[agent:result] history_df['day_of_month'] = history_df['date'].dt.day
[agent:result] history_df['month'] = history_df['date'].dt.month
[agent:result] history_df['year'] = history_df['date'].dt.year
[agent:result] 
[agent:result] # Interaction features
[agent:result] history_df['temp_humidity'] = history_df['temperature'] * history_df['humidity']
[agent:result] history_df['pressure_temp'] = history_df['pressure'] * history_df['temperature']
[agent:result] 
[agent:result] # Fill NaN values from rolling/lag features
[agent:result] history_df = history_df.fillna(method='bfill').fillna(method='ffill')
[agent:result] 
