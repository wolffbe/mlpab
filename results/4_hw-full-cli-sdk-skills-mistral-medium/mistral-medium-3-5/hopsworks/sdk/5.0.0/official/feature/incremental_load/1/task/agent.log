[agent:result]         cron_expression="0 0 * ? * * *",
[agent:result]         start_time=datetime.now(tz=timezone.utc),
[agent:result]     )
[agent:result] 
[agent:result]     # Fixed 2-hour window ending at the cron fire (e.g. 08:00 → 10:00 at 10:00):
[agent:result]     job.schedule(
[agent:result]         cron_expression="0 0 * ? * * *",
[agent:result]         start_time_offset_seconds=-2 * 3600,   # HOPS_START_TIME = fire - 2h
[agent:result]         end_time_offset_seconds=0,             # HOPS_END_TIME   = fire
[agent:result]         catchup=True,              # replay all missed intervals on recovery
[agent:result]         max_active_runs=2,         # allow at most 2 concurrent runs
[agent:result]     )
[agent:result]     ```
