[agent:result]     std_diff = np.std(diff)
[agent:result]     max_abs_diff = np.max(abs_diff)
[agent:result]     correlation = np.corrcoef(merged[train_col], merged[serve_col])[0, 1]
[agent:result]     
[agent:result]     print(f"\n{feat}:")
