[agent:result] print(f"\nCommon entities: {len(common_entities)}")
[agent:result] 
[agent:result] # Merge on entity_id
[agent:result] training_common = training[training['entity_id'].isin(common_entities)]
[agent:result] serving_common = serving[serving['entity_id'].isin(common_entities)]
[agent:result] 
[agent:result] # Merge to compare
[agent:result] merged = pd.merge(training_common, serving_common, on='entity_id', suffixes=('_train', '_serve'))
[agent:result] 
