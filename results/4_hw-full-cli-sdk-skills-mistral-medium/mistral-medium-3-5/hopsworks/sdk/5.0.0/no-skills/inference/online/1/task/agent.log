[agent:result]     ],
[agent:result]     data_path="data/features.csv",
[agent:result] )
[agent:result] 
[agent:result] # Enable online access
[agent:result] print("Enabling online access...")
[agent:result] ft.enable_online()
[agent:result] 
[agent:result] # Wait for online store to be ready
[agent:result] print("Waiting for online store to be ready...")
[agent:result] import time
[agent:result] time.sleep(5)
[agent:result] 
[agent:result] # Read lookup keys
[agent:result] print("Reading lookup keys...")
[agent:result] with open("data/lookup_keys.txt", "r") as f:
[agent:result]     lookup_keys = [line.strip() for line in f.readlines()]
[agent:result] 
[agent:result] print(f"Found {len(lookup_keys)} lookup keys: {lookup_keys}")
[agent:result] 
[agent:result] # Retrieve feature vectors through online/low-latency read path
[agent:result] print("Retrieving feature vectors from online store...")
[agent:result] vectors = {}
[agent:result] 
