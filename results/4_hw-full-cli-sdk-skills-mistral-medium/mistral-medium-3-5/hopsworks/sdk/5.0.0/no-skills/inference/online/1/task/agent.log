[agent:result]     ft.delete()
[agent:result] except:
[agent:result]     print(f"Feature table {FEATURE_TABLE_NAME} v{FEATURE_TABLE_VERSION} does not exist, will create it")
[agent:result] 
[agent:result] # Create the feature table from CSV
[agent:result] print("Creating feature table...")
[agent:result] ft = fs.create_feature_table(
[agent:result]     name=FEATURE_TABLE_NAME,
[agent:result]     version=FEATURE_TABLE_VERSION,
[agent:result]     description="Account feature profiles",
[agent:result]     primary_key=["account_id"],
[agent:result]     schema=[
[agent:result]         {"name": "account_id", "type": "string"},
[agent:result]         {"name": "f1", "type": "float"},
[agent:result]         {"name": "f2", "type": "float"},
