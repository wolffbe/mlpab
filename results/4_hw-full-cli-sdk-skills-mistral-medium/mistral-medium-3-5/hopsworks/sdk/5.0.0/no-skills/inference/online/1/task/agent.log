[agent:result] fs = hopsworks.feature_store()
[agent:result] 
[agent:result] # Define feature table name and version
[agent:result] FEATURE_TABLE_NAME = "profiles37db55"
[agent:result] FEATURE_TABLE_VERSION = 1
[agent:result] 
[agent:result] # Check if feature table already exists, if so delete it first
[agent:result] try:
[agent:result]     ft = fs.get_feature_table(FEATURE_TABLE_NAME, FEATURE_TABLE_VERSION)
