[agent:result]     f2 = feature_vector["f2"]
[agent:result]     f3 = feature_vector["f3"]
[agent:result]     f4 = feature_vector["f4"]
[agent:result]     vectors[key] = [float(f1), float(f2), float(f3), float(f4)]
[agent:result]     print(f"    {key}: [{f1}, {f2}, {f3}, {f4}]")
[agent:result] 
[agent:result] # Write results to submission/answers.json
