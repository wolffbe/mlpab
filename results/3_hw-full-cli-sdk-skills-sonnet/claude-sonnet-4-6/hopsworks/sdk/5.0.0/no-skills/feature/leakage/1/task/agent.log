[agent:bash] 
[agent:bash] features = ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']
[agent:bash] n = len(rows)
[agent:bash] 
[agent:bash] # For each feature, compute point-biserial correlation with label
[agent:bash] # and also check if there's a nearly perfect separation
[agent:bash] for feat in features:
[agent:bash]     vals = [float(r[feat]) for r in rows]
[agent:bash]     labels = [int(r['label']) for r in rows]
[agent:bash]     
[agent:bash]     # Mean of feature for each class
[agent:bash]     class0 = [v for v, l in zip(vals, labels) if l == 0]
[agent:bash]     class1 = [v for v, l in zip(vals, labels) if l == 1]
[agent:bash]     
[agent:bash]     mean0 = sum(class0) / len(class0)
[agent:bash]     mean1 = sum(class1) / len(class1)
[agent:bash]     
[agent:bash]     # Simple point-biserial correlation
[agent:bash]     mean_all = sum(vals) / n
[agent:bash]     std_all = (sum((v - mean_all)**2 for v in vals) / n) ** 0.5
[agent:bash]     
[agent:bash]     p1 = len(class1) / n
[agent:bash]     p0 = len(class0) / n
[agent:bash]     
[agent:bash]     corr = (mean1 - mean0) / std_all * (p1 * p0) ** 0.5
[agent:bash]     
[agent:bash]     # Check overlap between classes
[agent:bash]     min1, max1 = min(class1), max(class1)
[agent:bash]     min0, max0 = min(class0), max(class0)
[agent:bash]     
[agent:bash]     # Overlap range
[agent:bash]     overlap_start = max(min0, min1)
[agent:bash]     overlap_end = min(max0, max1)
[agent:bash]     overlap = max(0, overlap_end - overlap_start)
[agent:bash]     
[agent:bash]     print(f'{feat}: corr={corr:.4f}, mean0={mean0:.3f}, mean1={mean1:.3f}, range0=[{min0:.3f},{max0:.3f}], range1=[{min1:.3f},{max1:.3f}], overlap={overlap:.3f}')
