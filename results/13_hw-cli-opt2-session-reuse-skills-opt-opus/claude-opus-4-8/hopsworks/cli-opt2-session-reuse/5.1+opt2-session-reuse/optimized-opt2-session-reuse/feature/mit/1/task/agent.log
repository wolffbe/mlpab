[agent] Offline reads correctly. Let me verify the `amount_7d` window semantics with an independent self-join cross-check on the platform, and confirm a few rows match:
[agent:bash] cd "$(pwd)" && hops sql --no-verify --catalog delta --schema mlpabb12ef4_featurestore "
[agent:bash] WITH w AS (
[agent:bash]   SELECT row_id, account_id, event_time, amount,
[agent:bash]     SUM(amount) OVER (PARTITION BY account_id ORDER BY event_time RANGE BETWEEN 604800000 PRECEDING AND CURRENT ROW) AS win
[agent:bash]   FROM transactions_raw56bbbb_1
[agent:bash] ),
[agent:bash] sj AS (
[agent:bash]   SELECT a.row_id, SUM(b.amount) AS sj_sum
[agent:bash]   FROM transactions_raw56bbbb_1 a
[agent:bash]   JOIN transactions_raw56bbbb_1 b
[agent:bash]     ON a.account_id = b.account_id
[agent:bash]    AND b.event_time BETWEEN a.event_time - 604800000 AND a.event_time
[agent:bash]   GROUP BY a.row_id
[agent:bash] )
[agent:bash] SELECT count(*) AS mismatches
[agent:bash] FROM w JOIN sj ON w.row_id = sj.row_id
[agent:bash] WHERE abs(w.win - sj.sj_sum) > 0.0001
[agent:bash] " --json 2>/dev/null
