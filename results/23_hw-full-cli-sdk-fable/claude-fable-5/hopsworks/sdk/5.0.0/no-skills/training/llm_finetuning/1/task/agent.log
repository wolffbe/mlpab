[agent:result]     for _ in range(ITERATIONS):
[agent:result]         logits = base_logits + A @ B
[agent:result]         e = np.exp(logits - logits.max(axis=1, keepdims=True))
[agent:result]         p = e / e.sum(axis=1, keepdims=True)
[agent:result]         g = (row_totals * p - ft_counts) / n
[agent:result]         A, B = A - LEARNING_RATE * (g @ B.T), B - LEARNING_RATE * (A.T @ g)
[agent:result] 
[agent:result]     np.savez("finetuned_model.npz", logits=base_logits + A @ B,
[agent:result]              adapter_a=A, adapter_b=B)
[agent:result]     metrics = {
[agent:result]         "eval_loss": round(float(cross_entropy(base_logits + A @ B, eval_counts)), 4),
[agent:result]         "base_eval_loss": round(float(cross_entropy(base_logits, eval_counts)), 4),
[agent:result]     }
[agent:result]     json.dump(metrics, open("metrics.json", "w"), indent=2)
