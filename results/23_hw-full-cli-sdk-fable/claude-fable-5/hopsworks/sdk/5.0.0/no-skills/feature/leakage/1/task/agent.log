[agent:result] """Runs ON the Hopsworks cluster as a Python job.
[agent:result] 
[agent:result] Finds the feature that leaks the label in the uploaded training data and
[agent:result] writes the answer to the project's dataset storage at submission/answers.json.
[agent:result] """
[agent:result] 
[agent:result] import json
[agent:result] import os
[agent:result] 
[agent:result] import pandas as pd
[agent:result] import hopsworks
[agent:result] 
[agent:result] project = hopsworks.login()
[agent:result] dataset_api = project.get_dataset_api()
[agent:result] 
[agent:result] local_csv = dataset_api.download("Resources/leakage_task/training_data.csv", overwrite=True)
[agent:result] df = pd.read_csv(local_csv)
[agent:result] 
[agent:result] features = ["f1", "f2", "f3", "f4", "f5", "f6"]
[agent:result] label = df["label"]
[agent:result] 
[agent:result] report = {}
[agent:result] for c in features:
[agent:result]     x = df[c]
[agent:result]     corr = float(x.corr(label))
[agent:result]     # best single-threshold accuracy for this feature alone
[agent:result]     order = x.sort_values()
[agent:result]     thresholds = order.rolling(2).mean().dropna().unique()
[agent:result]     best_acc = 0.0
[agent:result]     for t in thresholds:
[agent:result]         acc = max(
[agent:result]             float(((x > t).astype(int) == label).mean()),
[agent:result]             float(((x <= t).astype(int) == label).mean()),
[agent:result]         )
[agent:result]         if acc > best_acc:
[agent:result]             best_acc = acc
[agent:result]     report[c] = {"corr_with_label": corr, "best_single_threshold_accuracy": best_acc}
[agent:result]     print(c, report[c])
[agent:result] 
[agent:result] leaker = max(features, key=lambda c: abs(report[c]["corr_with_label"]))
[agent:result] answer = {
[agent:result]     "feature": leaker,
[agent:result]     "evidence": (
[agent:result]         "Computed on the Hopsworks cluster from Resources/leakage_task/training_data.csv: "
[agent:result]         f"'{leaker}' has point-biserial correlation {report[leaker]['corr_with_label']:.4f} with the label "
[agent:result]         f"and a single-threshold rule on it alone classifies "
[agent:result]         f"{report[leaker]['best_single_threshold_accuracy']*100:.1f}% of rows correctly, "
[agent:result]         "far above every other feature. Full per-feature stats: "
[agent:result]         + json.dumps(report)
[agent:result]     ),
[agent:result] }
[agent:result] 
[agent:result] out_local = os.path.abspath("answers.json")
[agent:result] with open(out_local, "w") as f:
[agent:result]     json.dump(answer, f, indent=2)
[agent:result] 
[agent:result] if not dataset_api.exists("submission"):
[agent:result]     try:
[agent:result]         dataset_api.mkdir("submission")
[agent:result]     except Exception as e:
[agent:result]         print("mkdir submission failed:", e)
[agent:result] 
[agent:result] uploaded = dataset_api.upload(out_local, "submission", overwrite=True)
[agent:result] print("uploaded answers to:", uploaded)
[agent:result] 
[agent:result] report_local = os.path.abspath("leakage_report.json")
[agent:result] with open(report_local, "w") as f:
[agent:result]     json.dump(report, f, indent=2)
[agent:result] dataset_api.upload(report_local, "Resources/leakage_task", overwrite=True)
[agent:result] 
