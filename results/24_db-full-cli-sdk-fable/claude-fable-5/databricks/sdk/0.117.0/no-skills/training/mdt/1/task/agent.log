[agent:bash] sql(f"""
[agent:bash] CREATE TABLE {FQN} (
[agent:bash]   row_id STRING NOT NULL,
[agent:bash]   split STRING,
[agent:bash]   f1 DOUBLE, f2 DOUBLE, f3 DOUBLE, f4 DOUBLE,
[agent:bash]   CONSTRAINT scaledf9e607_pk PRIMARY KEY (row_id)
[agent:bash] ) TBLPROPERTIES (delta.enableChangeDataFeed = true)
[agent:bash] """)
[agent:bash] print('table created')
[agent:bash] 
[agent:bash] sql(f"""
[agent:bash] WITH train AS (
[agent:bash]   SELECT row_id, CAST(f1 AS DOUBLE) f1, CAST(f2 AS DOUBLE) f2, CAST(f3 AS DOUBLE) f3, CAST(f4 AS DOUBLE) f4
[agent:bash]   FROM read_files('{VOL}/features_train.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] serve AS (
[agent:bash]   SELECT row_id, CAST(f1 AS DOUBLE) f1, CAST(f2 AS DOUBLE) f2, CAST(f3 AS DOUBLE) f3, CAST(f4 AS DOUBLE) f4
[agent:bash]   FROM read_files('{VOL}/features_serve.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] allrows AS (
[agent:bash]   SELECT row_id, 'train' AS split, f1, f2, f3, f4 FROM train
[agent:bash]   UNION ALL
[agent:bash]   SELECT row_id, 'serve' AS split, f1, f2, f3, f4 FROM serve
[agent:bash] ),
[agent:bash] stats AS (
[agent:bash]   SELECT avg(f1) m1, stddev_pop(f1) s1,
[agent:bash]          avg(f2) m2, stddev_pop(f2) s2,
[agent:bash]          avg(f3) m3, stddev_pop(f3) s3,
[agent:bash]          avg(f4) m4, stddev_pop(f4) s4
[agent:bash]   FROM train
[agent:bash] )
[agent:bash] INSERT INTO {FQN}
[agent:bash] SELECT row_id, split,
[agent:bash]        round((f1 - m1) / s1, 6),
[agent:bash]        round((f2 - m2) / s2, 6),
[agent:bash]        round((f3 - m3) / s3, 6),
[agent:bash]        round((f4 - m4) / s4, 6)
[agent:bash] FROM allrows CROSS JOIN stats
[agent:bash] """)
[agent:bash] print('data inserted')
