[agent:bash] mkdir -p .tmp submission && cat > .tmp/analyze_shift.py <<'EOF'
[agent:bash] # Databricks notebook source
[agent:bash] from pyspark.sql import functions as F
[agent:bash] 
[agent:bash] df = (spark.read.option("header", True)
[agent:bash]       .csv("/Volumes/workspace/mlpabf9b9a1/predlogs/prediction_log.csv")
[agent:bash]       .select(F.to_timestamp("ts").alias("ts"), F.col("prediction").cast("double").alias("prediction")))
[agent:bash] 
[agent:bash] df.write.mode("overwrite").saveAsTable("workspace.mlpabf9b9a1.prediction_log")
[agent:bash] 
[agent:bash] daily = (df.groupBy(F.to_date("ts").alias("day"))
[agent:bash]            .agg(F.mean("prediction").alias("mean_pred"),
[agent:bash]                 F.stddev("prediction").alias("std_pred"),
[agent:bash]                 F.count("*").alias("n"))
[agent:bash]            .orderBy("day"))
[agent:bash] daily.write.mode("overwrite").saveAsTable("workspace.mlpabf9b9a1.prediction_daily_stats")
[agent:bash] 
[agent:bash] rows = daily.collect()
[agent:bash] days = [r["day"] for r in rows]
[agent:bash] means = [r["mean_pred"] for r in rows]
[agent:bash] stds = [r["std_pred"] for r in rows]
[agent:bash] 
[agent:bash] # Changepoint: split daily means at each candidate day k (segment 2 starts at k),
[agent:bash] # minimize total within-segment sum of squared errors of the daily mean series.
[agent:bash] def sse(xs):
[agent:bash]     if not xs:
[agent:bash]         return 0.0
[agent:bash]     m = sum(xs) / len(xs)
[agent:bash]     return sum((x - m) ** 2 for x in xs)
[agent:bash] 
[agent:bash] best_k, best_cost = None, float("inf")
[agent:bash] for k in range(1, len(means)):
[agent:bash]     cost = sse(means[:k]) + sse(means[k:])
[agent:bash]     if cost < best_cost:
[agent:bash]         best_cost, best_k = cost, k
[agent:bash] 
[agent:bash] onset_mean = str(days[best_k])
[agent:bash] 
[agent:bash] # Same on daily stddev in case the shift is in variance rather than mean
[agent:bash] best_k2, best_cost2 = None, float("inf")
[agent:bash] for k in range(1, len(stds)):
[agent:bash]     cost = sse(stds[:k]) + sse(stds[k:])
[agent:bash]     if cost < best_cost2:
[agent:bash]         best_cost2, best_k2 = cost, k
[agent:bash] onset_std = str(days[best_k2])
[agent:bash] 
[agent:bash] pre = means[:best_k]; post = means[best_k:]
[agent:bash] mean_jump = abs(sum(post)/len(post) - sum(pre)/len(pre))
[agent:bash] pre_s = stds[:best_k2]; post_s = stds[best_k2:]
[agent:bash] std_jump = abs(sum(post_s)/len(post_s) - sum(pre_s)/len(pre_s))
[agent:bash] 
[agent:bash] result = [(onset_mean, float(mean_jump), onset_std, float(std_jump))]
[agent:bash] spark.createDataFrame(result, "onset_mean string, mean_jump double, onset_std string, std_jump double") \
[agent:bash]      .write.mode("overwrite").saveAsTable("workspace.mlpabf9b9a1.shift_result")
[agent:bash] 
[agent:bash] print("ONSET_MEAN", onset_mean, "jump", mean_jump)
[agent:bash] print("ONSET_STD", onset_std, "jump", std_jump)
[agent:bash] for d, m, s in zip(days, means, stds):
[agent:bash]     print(d, round(m, 4), round(s, 4))
[agent:bash] EOF
