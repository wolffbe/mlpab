[agent:result] """Provided fine-tuning script — deterministic LoRA-style adapter update.
[agent:result] 
[agent:result] Reads base_model.npz (bigram logits + vocab), finetune.txt and eval.txt from
[agent:result] its working directory. The base logits stay FROZEN; only a rank-4 additive
[agent:result] adapter delta = A @ B is trained by plain full-batch gradient descent
[agent:result] (learning rate 2.0, exactly 400 iterations; B initialized to zero so the
[agent:result] adapter delta starts at zero, A to a fixed 0.5-scaled tiled identity).
[agent:result] Writes finetuned_model.npz and metrics.json with the fine-tuned and unadapted
[agent:result] cross-entropy on eval.txt (both rounded to 4 decimals). Fully deterministic —
[agent:result] do NOT modify it; run it as-is.
[agent:result] """
[agent:result] import json
[agent:result] 
[agent:result] import numpy as np
[agent:result] 
[agent:result] RANK = 4
[agent:result] LEARNING_RATE = 2.0
[agent:result] ITERATIONS = 400
[agent:result] ADAPTER_SCALE = 0.5
[agent:result] 
[agent:result] 
[agent:result] def bigram_counts(text, vocab):
[agent:result]     index = {ch: i for i, ch in enumerate(vocab)}
[agent:result]     idx = np.array([index[ch] for ch in text], dtype=int)
[agent:result]     counts = np.zeros((len(vocab), len(vocab)), dtype=float)
[agent:result]     np.add.at(counts, (idx[:-1], idx[1:]), 1.0)
[agent:result]     return counts
[agent:result] 
[agent:result] 
[agent:result] def cross_entropy(logits, counts):
[agent:result]     logp = logits - logits.max(axis=1, keepdims=True)
[agent:result]     logp = logp - np.log(np.exp(logp).sum(axis=1, keepdims=True))
[agent:result]     return -(counts * logp).sum() / counts.sum()
[agent:result] 
[agent:result] 
[agent:result] def main():
[agent:result]     ckpt = np.load("base_model.npz")
[agent:result]     base_logits = ckpt["logits"].astype(float)
[agent:result]     vocab = [str(ch) for ch in ckpt["vocab"]]
[agent:result]     ft_counts = bigram_counts(open("finetune.txt").read(), vocab)
[agent:result]     eval_counts = bigram_counts(open("eval.txt").read(), vocab)
[agent:result] 
[agent:result]     n_vocab = base_logits.shape[0]
[agent:result]     A = np.zeros((n_vocab, RANK), dtype=float)
[agent:result]     for i in range(n_vocab):
[agent:result]         A[i, i % RANK] = ADAPTER_SCALE
[agent:result]     B = np.zeros((RANK, n_vocab), dtype=float)
[agent:result]     n = ft_counts.sum()
[agent:result]     row_totals = ft_counts.sum(axis=1, keepdims=True)
[agent:result]     for _ in range(ITERATIONS):
