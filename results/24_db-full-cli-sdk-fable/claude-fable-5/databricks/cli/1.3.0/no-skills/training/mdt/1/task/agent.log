[agent] Table created. Now the standardization insert — computing train-only means and population stddevs in SQL and applying them to both splits:
[agent:bash] databricks api post /api/2.0/sql/statements --json '{"warehouse_id": "8a93fc195da2ceb1", "wait_timeout": "50s", "on_wait_timeout": "CONTINUE", "statement": "INSERT INTO workspace.mlpabff41ad.scaledf9e607 WITH train AS (SELECT row_id, f1, f2, f3, f4 FROM read_files(\"/Volumes/workspace/mlpabff41ad/raw/features_train.csv\", format => \"csv\", header => true, schema => \"row_id STRING, f1 DOUBLE, f2 DOUBLE, f3 DOUBLE, f4 DOUBLE\")), serve AS (SELECT row_id, f1, f2, f3, f4 FROM read_files(\"/Volumes/workspace/mlpabff41ad/raw/features_serve.csv\", format => \"csv\", header => true, schema => \"row_id STRING, f1 DOUBLE, f2 DOUBLE, f3 DOUBLE, f4 DOUBLE\")), stats AS (SELECT avg(f1) m1, stddev_pop(f1) s1, avg(f2) m2, stddev_pop(f2) s2, avg(f3) m3, stddev_pop(f3) s3, avg(f4) m4, stddev_pop(f4) s4 FROM train), unioned AS (SELECT row_id, \"train\" AS split, f1, f2, f3, f4 FROM train UNION ALL SELECT row_id, \"serve\" AS split, f1, f2, f3, f4 FROM serve) SELECT u.row_id, u.split, round((u.f1 - s.m1)/s.s1, 6), round((u.f2 - s.m2)/s.s2, 6), round((u.f3 - s.m3)/s.s3, 6), round((u.f4 - s.m4)/s.s4, 6) FROM unioned u CROSS JOIN stats s"}'
