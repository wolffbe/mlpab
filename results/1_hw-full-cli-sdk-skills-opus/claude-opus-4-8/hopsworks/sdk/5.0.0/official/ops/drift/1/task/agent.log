[agent:bash] df['event_time'] = pd.to_datetime(df['event_time'])
[agent:bash] days = sorted(df['event_time'].dt.strftime('%Y-%m-%d').unique())
[agent:bash] proj = hopsworks.login()
[agent:bash] fs = proj.get_feature_store()
[agent:bash] fg = fs.get_or_create_feature_group(
