[agent:result]         self._variable_api: VariableApi = VariableApi()
[agent:result]         self._service_discovery_domain = (
[agent:result]             self._variable_api.get_service_discovery_domain()
[agent:result]         )
[agent:result]         self._secret_api: secret_api.SecretsApi = secret_api.SecretsApi()
[agent:result]         self._project_api: project_api.ProjectApi = project_api.ProjectApi()
[agent:result]         if project is None:
[agent:result]             _client = client.get_instance()
[agent:result]             self.project_name = _client._project_name
[agent:result]         else:
[agent:result]             self.project_name = project.name
[agent:result] 
