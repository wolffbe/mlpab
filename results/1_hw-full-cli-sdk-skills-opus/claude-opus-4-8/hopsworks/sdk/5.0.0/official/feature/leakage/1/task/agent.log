[agent:result]         conn = trino_api.connect(catalog="iceberg", schema="my_db")  # Get a DBAPI connection
[agent:result]         cursor = conn.cursor()
[agent:result]         cursor.execute("SELECT * FROM my_table")
[agent:result]         rows = cursor.fetchall()
[agent:result]         for row in rows:
[agent:result]             print(row)
[agent:result] 
[agent:result]         # Or using SQLAlchemy
[agent:result]         engine = trino_api.create_engine(catalog="iceberg", schema="my_db")
[agent:result]         with engine.connect() as connection:
[agent:result]             result = connection.execute(text("SELECT * FROM my_table"))
[agent:result]             for row in result:
[agent:result]                 print(row)
[agent:result]         ```
[agent:result]     """
