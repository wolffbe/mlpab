[agent:result] 381	def _cli_arg_after(tokens: list, cli_binary: str) -> str | None:
[agent:result] 382	    """The CLI service/subcommand token following `cli_binary` in `tokens`
[agent:result] 383	    (e.g. `sagemaker` in `aws sagemaker list-models`), skipping global options
[agent:result] 384	    that may precede it (`aws --region us-east-1 sagemaker …`). None if the
[agent:result] 385	    binary isn't present or no service token follows.
[agent:result] 386	
[agent:result] 387	    Option-value ambiguity resolves AGAINST the caller (fail closed): an
[agent:result] 388	    unknown valueless option swallows the following token, so the service is
[agent:result] 389	    missed and the command denied — never the reverse (`aws --profile
[agent:result] 390	    sagemaker ec2 …` must not read the option's value as the service).
[agent:result] 391	    """
[agent:result] 392	    for i, tok in enumerate(tokens):
[agent:result] 393	        if not _is_cli_tok(tok, cli_binary):
[agent:result] 394	            continue
[agent:result] 395	        j = i + 1
[agent:result] 396	        while j < len(tokens):
[agent:result] 397	            t = tokens[j]
[agent:result] 398	            if not t.startswith("-"):
[agent:result] 399	                return t
[agent:result] 400	            if "=" in t or t in _NO_VALUE_OPTS or t.startswith("--no-"):
[agent:result] 401	                j += 1  # option carries no separate value token
[agent:result] 402	            else:
[agent:result] 403	                j += 2  # `--opt value` — skip both
[agent:result] 404	        return None
[agent:result] 405	    return None
