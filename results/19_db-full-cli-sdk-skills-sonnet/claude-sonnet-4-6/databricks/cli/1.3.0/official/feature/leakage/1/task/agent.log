[agent:bash] cat > /tmp/leakage_analysis.py << 'NOTEBOOK_END'
[agent:bash] # Databricks notebook source
[agent:bash] import pandas as pd
[agent:bash] import numpy as np
[agent:bash] from scipy import stats
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Read the training data - upload via workspace API first
[agent:bash] # We'll use spark to read from the uploaded file
[agent:bash] 
[agent:bash] # First let's check available data
[agent:bash] df = spark.createDataFrame(
[agent:bash]     pd.read_csv("/dbfs/tmp/training_data_mlpab6007c0.csv")
[agent:bash] )
[agent:bash] df.createOrReplaceTempView("training_data")
[agent:bash] print("Row count:", df.count())
[agent:bash] df.show(5)
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Calculate correlation of each feature with the label
[agent:bash] pdf = df.toPandas()
[agent:bash] 
[agent:bash] print("Correlations with label:")
[agent:bash] for col in ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']:
[agent:bash]     corr = abs(pdf[col].corr(pdf['label']))
[agent:bash]     print(f"  {col}: {corr:.4f}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Point-biserial correlation (Pearson with binary target)
[agent:bash] print("\nPoint-biserial correlation (absolute value):")
[agent:bash] for col in ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']:
[agent:bash]     corr, pval = stats.pointbiserialr(pdf['label'], pdf[col])
[agent:bash]     print(f"  {col}: corr={corr:.4f}, p-value={pval:.2e}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Check AUC for each feature alone
[agent:bash] from sklearn.metrics import roc_auc_score
[agent:bash] 
[agent:bash] print("\nAUC for each feature alone:")
[agent:bash] for col in ['f1', 'f2', 'f3', 'f4', 'f5', 'f6']:
[agent:bash]     auc = roc_auc_score(pdf['label'], pdf[col])
[agent:bash]     auc = max(auc, 1 - auc)  # take larger AUC
[agent:bash]     print(f"  {col}: AUC={auc:.4f}")
[agent:bash] 
[agent:bash] NOTEBOOK_END
[agent:bash] echo "Notebook script created"
