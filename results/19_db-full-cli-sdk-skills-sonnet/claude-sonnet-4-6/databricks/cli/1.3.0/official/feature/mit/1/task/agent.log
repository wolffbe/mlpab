[agent:bash] cat > /tmp/feature_notebook.py << 'NOTEBOOK_EOF'
[agent:bash] # Databricks notebook source
[agent:bash] from pyspark.sql import Window
[agent:bash] from pyspark.sql.functions import (
[agent:bash]     col, when, dayofweek, from_unixtime, sum as spark_sum, lit
[agent:bash] )
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Read input data from volume
[agent:bash] transactions = spark.read.option("header", "true").option("inferSchema", "true").csv(
[agent:bash]     "/Volumes/workspace/mlpab9e4ddc/data_files/transactions.csv"
[agent:bash] )
[agent:bash] fx_rates = spark.read.option("header", "true").option("inferSchema", "true").csv(
[agent:bash]     "/Volumes/workspace/mlpab9e4ddc/data_files/fx_rates.csv"
[agent:bash] )
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Join transactions with fx_rates to compute amount_usd
[agent:bash] df = transactions.join(fx_rates, on="currency", how="left")
[agent:bash] df = df.withColumn("amount_usd", col("amount") * col("fx_rate"))
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Compute is_weekend: dayofweek returns 1=Sunday, 7=Saturday
[agent:bash] df = df.withColumn(
[agent:bash]     "is_weekend",
[agent:bash]     when(
[agent:bash]         dayofweek(from_unixtime(col("event_time") / lit(1000))).isin([1, 7]),
[agent:bash]         lit(1)
[agent:bash]     ).otherwise(lit(0))
[agent:bash] )
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Compute amount_7d: rolling 7-day sum of amount per account
[agent:bash] # event_time is in epoch milliseconds; 7 days = 7 * 24 * 60 * 60 * 1000 = 604800000 ms
[agent:bash] seven_days_ms = 7 * 24 * 60 * 60 * 1000
[agent:bash] window_spec = (
[agent:bash]     Window.partitionBy("account_id")
[agent:bash]     .orderBy(col("event_time").cast("long"))
[agent:bash]     .rangeBetween(-seven_days_ms, 0)
[agent:bash] )
[agent:bash] df = df.withColumn("amount_7d", spark_sum(col("amount")).over(window_spec))
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Select final columns
[agent:bash] result = df.select(
[agent:bash]     col("row_id").cast("string"),
[agent:bash]     col("account_id").cast("string"),
[agent:bash]     col("event_time").cast("long"),
[agent:bash]     col("amount_usd").cast("double"),
[agent:bash]     col("is_weekend").cast("int"),
[agent:bash]     col("amount_7d").cast("double")
[agent:bash] )
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Write to Delta table
[agent:bash] result.write.format("delta").mode("overwrite").saveAsTable("workspace.mlpab9e4ddc.featuresb1ea93")
[agent:bash] 
[agent:bash] print("Feature table written successfully")
[agent:bash] result.show(5)
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] 
[agent:bash] # Enable Change Data Feed for online table support
[agent:bash] spark.sql("""
[agent:bash]     ALTER TABLE workspace.mlpab9e4ddc.featuresb1ea93
[agent:bash]     SET TBLPROPERTIES (delta.enableChangeDataFeed = true)
[agent:bash] """)
[agent:bash] 
[agent:bash] print("Change Data Feed enabled")
[agent:bash] NOTEBOOK_EOF
[agent:bash] echo "Done writing notebook"
