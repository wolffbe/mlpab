[agent:result] 48	    F.col("amount_usd").cast("double").alias("amount_usd"),
[agent:result] 49	    F.col("is_weekend").cast("int").alias("is_weekend"),
[agent:result] 50	    F.col("amount_7d").cast("double").alias("amount_7d")
[agent:result] 51	)
[agent:result] 52	
