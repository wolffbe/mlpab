[agent:result] 2	from pyspark.sql import functions as F
[agent:result] 3	from pyspark.sql.window import Window
[agent:result] 4	
[agent:result] 5	# COMMAND ----------
[agent:result] 6	# Read source data from UC Volume
[agent:result] 7	txn = spark.read.csv(
[agent:result] 8	    "/Volumes/workspace/mlpab9e4ddc/data_files/transactions.csv",
[agent:result] 9	    header=True, inferSchema=True
[agent:result] 10	)
[agent:result] 11	fx = spark.read.csv(
[agent:result] 12	    "/Volumes/workspace/mlpab9e4ddc/data_files/fx_rates.csv",
[agent:result] 13	    header=True, inferSchema=True
[agent:result] 14	)
[agent:result] 15	
[agent:result] 16	# COMMAND ----------
[agent:result] 17	# Join to get fx_rate
[agent:result] 18	txn = txn.join(fx, on="currency", how="left")
[agent:result] 19	
[agent:result] 20	# amount_usd = amount * fx_rate
[agent:result] 21	txn = txn.withColumn("amount_usd", F.col("amount") * F.col("fx_rate"))
[agent:result] 22	
[agent:result] 23	# is_weekend: event_time is epoch milliseconds; dayofweek: 1=Sunday, 7=Saturday
[agent:result] 24	txn = txn.withColumn(
[agent:result] 25	    "is_weekend",
[agent:result] 26	    F.when(
[agent:result] 27	        F.dayofweek(F.from_unixtime(F.col("event_time") / 1000)).isin([1, 7]),
[agent:result] 28	        1
[agent:result] 29	    ).otherwise(0)
[agent:result] 30	)
[agent:result] 31	
[agent:result] 32	# amount_7d: rolling 7-day sum of amount per account_id
[agent:result] 33	# Window: [event_time - 7 days, event_time] inclusive, in milliseconds
[agent:result] 34	seven_days_ms = 7 * 24 * 60 * 60 * 1000
[agent:result] 35	w = (
[agent:result] 36	    Window.partitionBy("account_id")
[agent:result] 37	    .orderBy(F.col("event_time").cast("long"))
[agent:result] 38	    .rangeBetween(-seven_days_ms, 0)
[agent:result] 39	)
[agent:result] 40	txn = txn.withColumn("amount_7d", F.sum("amount").over(w))
[agent:result] 41	
[agent:result] 42	# COMMAND ----------
[agent:result] 43	# Select final columns
[agent:result] 44	result = txn.select(
[agent:result] 45	    "row_id",
