[agent:bash] cat > /tmp/drift_analysis.py << 'NOTEBOOK_EOF'
[agent:bash] # Databricks notebook source
[agent:bash] # MAGIC %md # Drift Detection Analysis
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] from pyspark.sql import functions as F
[agent:bash] from pyspark.sql.types import *
[agent:bash] from pyspark.sql.window import Window
[agent:bash] 
[agent:bash] # Load the data
[agent:bash] df = spark.read.csv(
[agent:bash]     "/Volumes/workspace/mlpabe8ecdb/mlpabe8ecdb_drift_data/features.csv",
[agent:bash]     header=True,
[agent:bash]     inferSchema=True
[agent:bash] )
[agent:bash] 
[agent:bash] # Parse event_time to date
[agent:bash] df = df.withColumn("event_date", F.to_date(F.col("event_time")))
[agent:bash] 
[agent:bash] df.printSchema()
[agent:bash] df.show(5)
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Compute daily statistics for each feature
[agent:bash] features = ["f1", "f2", "f3", "f4", "f5", "f6"]
[agent:bash] 
[agent:bash] # Aggregate daily mean and std for each feature
[agent:bash] agg_exprs = []
[agent:bash] for f in features:
[agent:bash]     agg_exprs.append(F.mean(F.col(f)).alias(f"mean_{f}"))
[agent:bash]     agg_exprs.append(F.stddev(F.col(f)).alias(f"std_{f}"))
[agent:bash]     agg_exprs.append(F.count(F.col(f)).alias(f"count_{f}"))
[agent:bash] 
[agent:bash] daily_stats = df.groupBy("event_date").agg(*agg_exprs).orderBy("event_date")
[agent:bash] daily_stats.show(30)
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Save daily stats to a Delta table for inspection
[agent:bash] daily_stats.write.format("delta").mode("overwrite").saveAsTable(
[agent:bash]     "workspace.mlpabe8ecdb.mlpabe8ecdb_drift_daily_stats"
[agent:bash] )
[agent:bash] 
[agent:bash] print("Daily stats saved!")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Statistical drift detection: compare first half vs second half with sliding window
[agent:bash] # Use a KS-like approach: compare mean in rolling windows
[agent:bash] 
[agent:bash] import pyspark.sql.functions as F
[agent:bash] from pyspark.sql.window import Window
[agent:bash] 
[agent:bash] # Use Databricks built-in - collect daily stats as Pandas for analysis  
[agent:bash] pdf = daily_stats.toPandas()
[agent:bash] pdf = pdf.sort_values("event_date").reset_index(drop=True)
[agent:bash] 
[agent:bash] print(f"Total days: {len(pdf)}")
[agent:bash] print(pdf.head(10))
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # For each feature, compute a rolling mean (window of 7 days) and detect shift
[agent:bash] # Compare window [0:30] vs [30:60] vs [60:90] to find the change point
[agent:bash] 
[agent:bash] import numpy as np
[agent:bash] 
[agent:bash] n_days = len(pdf)
[agent:bash] results = {}
[agent:bash] 
[agent:bash] for f in features:
[agent:bash]     means = pdf[f"mean_{f}"].values
[agent:bash]     stds = pdf[f"std_{f}"].values
[agent:bash]     
[agent:bash]     # Try all split points from day 10 to day 80
[agent:bash]     # For each split, compute the difference between pre and post mean
[agent:bash]     best_split = None
[agent:bash]     best_score = 0
[agent:bash]     
[agent:bash]     for split in range(10, n_days - 10):
[agent:bash]         pre_mean = np.mean(means[:split])
[agent:bash]         post_mean = np.mean(means[split:])
[agent:bash]         pre_std = np.std(means[:split])
[agent:bash]         post_std = np.std(means[split:])
[agent:bash]         
[agent:bash]         # Score: how much bigger is the shift than the within-period variance
[agent:bash]         pooled_std = np.sqrt((pre_std**2 + post_std**2) / 2) + 1e-10
[agent:bash]         score = abs(post_mean - pre_mean) / pooled_std
[agent:bash]         
[agent:bash]         if score > best_score:
[agent:bash]             best_score = score
[agent:bash]             best_split = split
[agent:bash]     
[agent:bash]     onset_date = pdf["event_date"].iloc[best_split] if best_split is not None else None
[agent:bash]     results[f] = {
[agent:bash]         "best_split_idx": best_split,
[agent:bash]         "onset_date": str(onset_date),
[agent:bash]         "score": best_score,
[agent:bash]         "pre_mean": float(np.mean(means[:best_split])) if best_split else None,
[agent:bash]         "post_mean": float(np.mean(means[best_split:])) if best_split else None,
[agent:bash]     }
[agent:bash]     print(f"{f}: score={best_score:.3f}, split_idx={best_split}, onset={onset_date}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Find the feature with the highest drift score
[agent:bash] best_feature = max(results, key=lambda f: results[f]["score"])
[agent:bash] print(f"\nBest drifted feature: {best_feature}")
[agent:bash] print(f"Score: {results[best_feature]['score']:.3f}")
[agent:bash] print(f"Onset date: {results[best_feature]['onset_date']}")
[agent:bash] print(f"Pre-drift mean: {results[best_feature]['pre_mean']:.4f}")
[agent:bash] print(f"Post-drift mean: {results[best_feature]['post_mean']:.4f}")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Save the answer to a Delta table
[agent:bash] import json
[agent:bash] 
[agent:bash] answer = {
[agent:bash]     "feature": best_feature,
[agent:bash]     "onset": results[best_feature]["onset_date"]
[agent:bash] }
[agent:bash] 
[agent:bash] print("ANSWER:", json.dumps(answer))
[agent:bash] 
[agent:bash] # Save to Delta table
[agent:bash] answer_df = spark.createDataFrame([answer])
[agent:bash] answer_df.write.format("delta").mode("overwrite").saveAsTable(
[agent:bash]     "workspace.mlpabe8ecdb.mlpabe8ecdb_drift_answer"
[agent:bash] )
[agent:bash] 
[agent:bash] print("Answer saved to Delta table!")
[agent:bash] 
[agent:bash] # COMMAND ----------
[agent:bash] # Also save detailed results for all features
[agent:bash] all_results = []
[agent:bash] for f, r in results.items():
[agent:bash]     all_results.append({
[agent:bash]         "feature": f,
[agent:bash]         "score": float(r["score"]),
[agent:bash]         "onset_date": str(r["onset_date"]),
[agent:bash]         "split_idx": int(r["best_split_idx"]) if r["best_split_idx"] else 0,
[agent:bash]         "pre_mean": float(r["pre_mean"]) if r["pre_mean"] else 0.0,
[agent:bash]         "post_mean": float(r["post_mean"]) if r["post_mean"] else 0.0,
[agent:bash]     })
[agent:bash] 
[agent:bash] results_df = spark.createDataFrame(all_results)
[agent:bash] results_df.write.format("delta").mode("overwrite").saveAsTable(
[agent:bash]     "workspace.mlpabe8ecdb.mlpabe8ecdb_drift_results"
[agent:bash] )
