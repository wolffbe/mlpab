[agent] Now let me set up a SQL helper and create the v1 feature table. First I'll test the TIMESERIES constraint on a BIGINT column.
[agent:bash] cat > .tmp_sql.py <<'PYEOF'
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] import os, sys, time
[agent:bash] w = WorkspaceClient()
[agent:bash] WH = '4dfab06c923fe3cc'
[agent:bash] cat, sch = os.environ['MLPAB_DATABRICKS_SCHEMA'].split('.')
[agent:bash] 
[agent:bash] def runsql(sql, fetch=False):
[agent:bash]     r = w.statement_execution.execute_statement(statement=sql, warehouse_id=WH, wait_timeout='50s')
[agent:bash]     st = r.status.state.value
[agent:bash]     if st not in ('SUCCEEDED',):
[agent:bash]         # poll if pending
[agent:bash]         sid = r.statement_id
[agent:bash]         while st in ('PENDING','RUNNING'):
[agent:bash]             time.sleep(2)
[agent:bash]             r = w.statement_execution.get_statement(sid)
[agent:bash]             st = r.status.state.value
[agent:bash]     if r.status.state.value != 'SUCCEEDED':
[agent:bash]         raise RuntimeError(f"SQL FAILED: {r.status.state.value} :: {r.status.error}")
[agent:bash]     if fetch and r.result and r.result.data_array is not None:
[agent:bash]         return r.result.data_array
[agent:bash]     return None
[agent:bash] 
[agent:bash] if __name__ == '__main__':
[agent:bash]     # quick test: can BIGINT be a TIMESERIES PK column?
[agent:bash]     fq = f'`{cat}`.`{sch}`.`_tsk_test`'
[agent:bash]     runsql(f'DROP TABLE IF EXISTS {fq}')
[agent:bash]     try:
[agent:bash]         runsql(f'CREATE TABLE {fq} (row_id STRING NOT NULL, updated_at BIGINT NOT NULL, CONSTRAINT pk PRIMARY KEY (row_id, updated_at TIMESERIES))')
