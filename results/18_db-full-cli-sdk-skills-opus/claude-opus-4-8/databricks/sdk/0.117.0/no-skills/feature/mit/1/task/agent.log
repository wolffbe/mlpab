[agent:bash] run("ALTER TABLE workspace.mlpab4bb10d.features74f1ef ADD CONSTRAINT pk_features74f1ef PRIMARY KEY (row_id)")
[agent:bash] print("pk added")
[agent:bash] 
[agent:bash] # enable change data feed for online sync
[agent:bash] run("ALTER TABLE workspace.mlpab4bb10d.features74f1ef SET TBLPROPERTIES (delta.enableChangeDataFeed = true)")
