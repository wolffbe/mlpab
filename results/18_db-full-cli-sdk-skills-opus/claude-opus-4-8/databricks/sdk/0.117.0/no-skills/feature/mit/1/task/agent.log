[agent] Both CSVs uploaded. Now I'll build the feature table with SQL via the statement execution API. Let me create a helper and run the queries.
[agent:bash] cat > .tmp_sql.py <<'PYEOF'
[agent:bash] import sys
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service.sql import StatementState
[agent:bash] w = WorkspaceClient()
[agent:bash] WH = "4dfab06c923fe3cc"
[agent:bash] 
[agent:bash] def run(sql, wait=120):
[agent:bash]     r = w.statement_execution.execute_statement(statement=sql, warehouse_id=WH, wait_timeout="50s")
[agent:bash]     # poll if pending
[agent:bash]     import time
[agent:bash]     sid = r.statement_id
[agent:bash]     while r.status.state in (StatementState.PENDING, StatementState.RUNNING):
[agent:bash]         time.sleep(2)
[agent:bash]         r = w.statement_execution.get_statement(sid)
[agent:bash]     if r.status.state != StatementState.SUCCEEDED:
[agent:bash]         print("FAILED:", r.status.state, getattr(r.status,'error',None))
[agent:bash]         sys.exit(1)
[agent:bash]     return r
[agent:bash] 
[agent:bash] # 1. Build feature table
[agent:bash] sql = """
[agent:bash] CREATE OR REPLACE TABLE workspace.mlpab4bb10d.features74f1ef AS
[agent:bash] WITH tx AS (
[agent:bash]   SELECT row_id, account_id, CAST(event_time AS BIGINT) AS event_time,
[agent:bash]          CAST(amount AS DOUBLE) AS amount, currency
[agent:bash]   FROM read_files('/Volumes/workspace/mlpab4bb10d/raw/transactions.csv',
[agent:bash]        format => 'csv', header => true)
[agent:bash] ),
[agent:bash] fx AS (
[agent:bash]   SELECT currency, CAST(fx_rate AS DOUBLE) AS fx_rate
[agent:bash]   FROM read_files('/Volumes/workspace/mlpab4bb10d/raw/fx_rates.csv',
[agent:bash]        format => 'csv', header => true)
[agent:bash] ),
[agent:bash] j AS (
[agent:bash]   SELECT tx.row_id, tx.account_id, tx.event_time, tx.amount, tx.currency, fx.fx_rate
[agent:bash]   FROM tx LEFT JOIN fx ON tx.currency = fx.currency
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   row_id,
[agent:bash]   account_id,
[agent:bash]   event_time,
[agent:bash]   amount * fx_rate AS amount_usd,
[agent:bash]   CASE WHEN pmod(CAST(floor(event_time/86400000) AS BIGINT), 7) IN (2,3) THEN 1 ELSE 0 END AS is_weekend,
[agent:bash]   SUM(amount) OVER (
[agent:bash]     PARTITION BY account_id ORDER BY event_time
[agent:bash]     RANGE BETWEEN 604800000 PRECEDING AND CURRENT ROW
[agent:bash]   ) AS amount_7d
[agent:bash] FROM j
[agent:bash] """
[agent:bash] run(sql)
[agent:bash] print("table created")
[agent:bash] 
[agent:bash] # 2. set NOT NULL + primary key on row_id (record key) for feature table / online sync
