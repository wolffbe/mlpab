[agent:result] 16	def main():
[agent:result] 17	    train = pd.read_csv("train.csv")
[agent:result] 18	    score = pd.read_csv("score.csv")
[agent:result] 19	    X = train[FEATURES].to_numpy(dtype=float)
[agent:result] 20	    y = train["label"].to_numpy(dtype=float)
[agent:result] 21	    w = np.zeros(X.shape[1], dtype=float)
[agent:result] 22	    b = 0.0
[agent:result] 23	    for _ in range(ITERATIONS):
[agent:result] 24	        p = 1.0 / (1.0 + np.exp(-(X @ w + b)))
[agent:result] 25	        g = p - y
