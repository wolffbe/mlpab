[agent] Now let me build the standardized feature table on the platform via SQL (train-only population stats, applied to both splits).
[agent:bash] cat > .tmp_sql.py << 'PYEOF'
[agent:bash] from databricks.sdk import WorkspaceClient
[agent:bash] from databricks.sdk.service.sql import StatementState
[agent:bash] import time, sys
[agent:bash] w = WorkspaceClient()
[agent:bash] WH = '4dfab06c923fe3cc'
[agent:bash] def run(sql):
[agent:bash]     r = w.statement_execution.execute_statement(statement=sql, warehouse_id=WH, wait_timeout='50s')
[agent:bash]     # poll if pending
[agent:bash]     while r.status.state in (StatementState.PENDING, StatementState.RUNNING):
[agent:bash]         time.sleep(2)
[agent:bash]         r = w.statement_execution.get_statement(r.statement_id)
[agent:bash]     if r.status.state != StatementState.SUCCEEDED:
[agent:bash]         print('FAILED:', r.status.state, r.status.error)
[agent:bash]         sys.exit(1)
[agent:bash]     rows = r.result.data_array if r.result else None
[agent:bash]     return rows
[agent:bash] 
[agent:bash] base = '/Volumes/workspace/mlpabf94ccc/ingest'
[agent:bash] tbl = 'workspace.mlpabf94ccc.scaledd437a3'
[agent:bash] 
[agent:bash] sql_create = f"""
[agent:bash] CREATE OR REPLACE TABLE {tbl}
[agent:bash] TBLPROPERTIES (delta.enableChangeDataFeed = true) AS
[agent:bash] WITH train AS (
[agent:bash]   SELECT cast(row_id AS string) AS row_id, cast(f1 AS double) f1, cast(f2 AS double) f2, cast(f3 AS double) f3, cast(f4 AS double) f4
[agent:bash]   FROM read_files('{base}/train.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] serve AS (
[agent:bash]   SELECT cast(row_id AS string) AS row_id, cast(f1 AS double) f1, cast(f2 AS double) f2, cast(f3 AS double) f3, cast(f4 AS double) f4
[agent:bash]   FROM read_files('{base}/serve.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] allrows AS (
[agent:bash]   SELECT row_id, 'train' AS split, f1, f2, f3, f4 FROM train
[agent:bash]   UNION ALL
[agent:bash]   SELECT row_id, 'serve' AS split, f1, f2, f3, f4 FROM serve
[agent:bash] ),
[agent:bash] stats AS (
[agent:bash]   SELECT avg(f1) m1, stddev_pop(f1) s1, avg(f2) m2, stddev_pop(f2) s2,
[agent:bash]          avg(f3) m3, stddev_pop(f3) s3, avg(f4) m4, stddev_pop(f4) s4
[agent:bash]   FROM train
[agent:bash] )
[agent:bash] SELECT a.row_id, a.split,
[agent:bash]   round((a.f1 - s.m1)/s.s1, 6) AS f1,
[agent:bash]   round((a.f2 - s.m2)/s.s2, 6) AS f2,
[agent:bash]   round((a.f3 - s.m3)/s.s3, 6) AS f3,
[agent:bash]   round((a.f4 - s.m4)/s.s4, 6) AS f4
[agent:bash] FROM allrows a CROSS JOIN stats s
[agent:bash] """
[agent:bash] run(sql_create)
[agent:bash] print('table created')
[agent:bash] run(f"ALTER TABLE {tbl} ALTER COLUMN row_id SET NOT NULL")
[agent:bash] run(f"ALTER TABLE {tbl} ADD CONSTRAINT pk_scaledd437a3 PRIMARY KEY (row_id)")
[agent:bash] print('PK added')
[agent:bash] # verify
[agent:bash] cnt = run(f"SELECT split, count(*) FROM {tbl} GROUP BY split ORDER BY split")
[agent:bash] print('counts:', cnt)
[agent:bash] samp = run(f"SELECT * FROM {tbl} ORDER BY row_id LIMIT 3")
[agent:bash] print('sample:', samp)
