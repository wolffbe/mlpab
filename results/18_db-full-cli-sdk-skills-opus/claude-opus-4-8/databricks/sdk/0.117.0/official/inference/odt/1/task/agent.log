[agent:bash] print("catalog/schema:", CATALOG, SCHEMA)
[agent:bash] 
[agent:bash] def sql(stmt, catalog=CATALOG, schema=SCHEMA):
[agent:bash]     r = w.statement_execution.execute_statement(stmt, WID, catalog=catalog, schema=schema, wait_timeout="50s")
[agent:bash]     sid = r.statement_id
[agent:bash]     while r.status.state in (StatementState.PENDING, StatementState.RUNNING):
[agent:bash]         time.sleep(2); r = w.statement_execution.get_statement(sid)
[agent:bash]     if r.status.state != StatementState.SUCCEEDED:
[agent:bash]         raise RuntimeError(f"SQL FAILED: {r.status.state} :: {r.status.error} :: {stmt[:200]}")
[agent:bash]     return r
[agent:bash] 
