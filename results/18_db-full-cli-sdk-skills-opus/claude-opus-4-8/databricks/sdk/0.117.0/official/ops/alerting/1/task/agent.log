[agent:result] 271	## Timeout Configuration
[agent:result] 272	
[agent:result] 273	### Job-Level Timeout
[agent:result] 274	
[agent:result] 275	```yaml
[agent:result] 276	resources:
[agent:result] 277	  jobs:
[agent:result] 278	    timeout_job:
[agent:result] 279	      name: "Job with Timeout"
[agent:result] 280	      timeout_seconds: 7200  # 2 hours max run time
[agent:result] 281	      tasks:
[agent:result] 282	        - task_key: main
[agent:result] 283	          notebook_task:
[agent:result] 284	            notebook_path: ../src/main.py
[agent:result] 285	```
[agent:result] 286	
[agent:result] 287	### Task-Level Timeout
[agent:result] 288	
[agent:result] 289	```yaml
[agent:result] 290	tasks:
[agent:result] 291	  - task_key: long_running
[agent:result] 292	    timeout_seconds: 3600  # 1 hour max for this task
[agent:result] 293	    notebook_task:
[agent:result] 294	      notebook_path: ../src/long_running.py
[agent:result] 295	```
[agent:result] 296	
[agent:result] 297	### Python SDK
[agent:result] 298	
[agent:result] 299	```python
[agent:result] 300	from databricks.sdk.service.jobs import Task, NotebookTask
[agent:result] 301	
[agent:result] 302	Task(
[agent:result] 303	    task_key="long_running",
[agent:result] 304	    timeout_seconds=3600,
[agent:result] 305	    notebook_task=NotebookTask(
