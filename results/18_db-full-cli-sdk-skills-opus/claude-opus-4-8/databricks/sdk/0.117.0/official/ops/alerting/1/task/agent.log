[agent:result] 198	        rules:
[agent:result] 199	          - metric: RUN_DURATION_SECONDS
[agent:result] 200	            op: GREATER_THAN
[agent:result] 201	            value: 3600  # Alert if run > 1 hour
[agent:result] 202	          - metric: STREAMING_BACKLOG_BYTES
[agent:result] 203	            op: GREATER_THAN
[agent:result] 204	            value: 1073741824  # Alert if backlog > 1GB
[agent:result] 205	          - metric: STREAMING_BACKLOG_SECONDS
[agent:result] 206	            op: GREATER_THAN
[agent:result] 207	            value: 300  # Alert if backlog > 5 minutes
