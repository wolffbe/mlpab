[agent:bash] cd "$(pwd)" && python3 -c "
[agent:bash] from db import *
[agent:bash] T=f'{CAT}.{SCH}'
[agent:bash] q=f'''CREATE OR REPLACE TABLE {T}.churntraining605fb7 AS
[agent:bash] WITH tx AS (
[agent:bash]   SELECT l.account_id, l.label_time, t.amount, t.balance
[agent:bash]   FROM {T}.src_labels l JOIN {T}.src_transactions t
[agent:bash]     ON t.account_id=l.account_id AND t.event_time<=l.label_time
[agent:bash]   QUALIFY ROW_NUMBER() OVER (PARTITION BY l.account_id,l.label_time ORDER BY t.event_time DESC)=1
[agent:bash] ),
[agent:bash] pr AS (
[agent:bash]   SELECT l.account_id, l.label_time, p.credit_score, p.tier
[agent:bash]   FROM {T}.src_labels l JOIN {T}.src_profiles p
[agent:bash]     ON p.account_id=l.account_id AND p.event_time<=l.label_time
[agent:bash]   QUALIFY ROW_NUMBER() OVER (PARTITION BY l.account_id,l.label_time ORDER BY p.event_time DESC)=1
[agent:bash] ),
[agent:bash] ac AS (
[agent:bash]   SELECT l.account_id, l.label_time, a.sessions_7d
[agent:bash]   FROM {T}.src_labels l JOIN {T}.src_activity a
[agent:bash]     ON a.account_id=l.account_id AND a.event_time<=l.label_time
[agent:bash]   QUALIFY ROW_NUMBER() OVER (PARTITION BY l.account_id,l.label_time ORDER BY a.event_time DESC)=1
[agent:bash] ),
[agent:bash] he AS (
[agent:bash]   SELECT l.account_id, l.label_time, h.health_score
[agent:bash]   FROM {T}.src_labels l JOIN {T}.src_health h
[agent:bash]     ON h.account_id=l.account_id AND h.event_time<=l.label_time
[agent:bash]   QUALIFY ROW_NUMBER() OVER (PARTITION BY l.account_id,l.label_time ORDER BY h.event_time DESC)=1
[agent:bash] )
[agent:bash] SELECT l.account_id, l.label_time,
[agent:bash]        tx.amount, tx.balance,
[agent:bash]        pr.credit_score, pr.tier,
[agent:bash]        ac.sessions_7d, he.health_score,
[agent:bash]        l.churned
[agent:bash] FROM {T}.src_labels l
[agent:bash] LEFT JOIN tx ON tx.account_id=l.account_id AND tx.label_time=l.label_time
[agent:bash] LEFT JOIN pr ON pr.account_id=l.account_id AND pr.label_time=l.label_time
[agent:bash] LEFT JOIN ac ON ac.account_id=l.account_id AND ac.label_time=l.label_time
[agent:bash] LEFT JOIN he ON he.account_id=l.account_id AND he.label_time=l.label_time'''
