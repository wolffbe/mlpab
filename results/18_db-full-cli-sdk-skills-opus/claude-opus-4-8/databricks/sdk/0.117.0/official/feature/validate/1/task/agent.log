[agent:result] PYTHON_PREFIXES = ("python", "python3", "uv run python", "uv run", "pip", "pip3")
[agent:result] 
[agent:result] 
[agent:result] def _env_subcommands() -> list:
[agent:result]     """TESTBED_CLI_SUBCOMMAND is a comma-joined allowlist of subcommand
[agent:result]     entrypoints (e.g. `sagemaker,sagemaker-runtime,s3`); empty → no scoping."""
[agent:result]     raw = os.environ.get("TESTBED_CLI_SUBCOMMAND") or ""
[agent:result]     return [s for s in (p.strip() for p in raw.split(",")) if s]
[agent:result] 
[agent:result] 
[agent:result] def _env_aux_binaries() -> list:
[agent:result]     """TESTBED_CLI_AUX is a comma-joined allowlist of EXTRA on-interface binaries
[agent:result]     beyond TESTBED_CLI_BINARY (e.g. GCP's `bq` alongside `gcloud`). Each is
[agent:result]     allowed with any subcommand in CLI mode; empty → none."""
[agent:result]     raw = os.environ.get("TESTBED_CLI_AUX") or ""
[agent:result]     return [s for s in (p.strip() for p in raw.split(",")) if s]
