[agent:result] def _is_env_assign(tok: str) -> bool:
[agent:result]     if "=" not in tok or tok.startswith("="):
[agent:result]         return False
[agent:result]     head = tok.split("=", 1)[0]
[agent:result]     return (
[agent:result]         bool(head)
[agent:result]         and (head[0].isalpha() or head[0] == "_")
[agent:result]         and all(c.isalnum() or c == "_" for c in head)
[agent:result]     )
