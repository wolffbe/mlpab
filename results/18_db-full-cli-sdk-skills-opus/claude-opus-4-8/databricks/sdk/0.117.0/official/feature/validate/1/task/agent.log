[agent:result] # --- Remote-only / single-interface enforcement -------------------------------
[agent:result] # Everything runs on the platform; local training is forbidden and the agent
[agent:result] # must stay on the interface under test. These helpers split a Bash command into
[agent:result] # segments, find each segment's executable, and extract the python payload
[agent:result] # (inline `-c`, `.py` files, `-m module`) to distinguish LOCAL execution of a
[agent:result] # compute library from a script merely written to be shipped to the cluster.
