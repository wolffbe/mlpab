[agent:result]     # `sagemaker,sagemaker-runtime,s3`), only `<cli_binary> <one of these> …` is
[agent:result]     # on-interface — other services of the same binary (`aws ec2 …`) are
[agent:result]     # off-interface escapes.
[agent:result]     cli_subcommands = _env_subcommands()
[agent:result]     # Extra on-interface binaries (e.g. `bq` alongside `gcloud`), on-interface in
