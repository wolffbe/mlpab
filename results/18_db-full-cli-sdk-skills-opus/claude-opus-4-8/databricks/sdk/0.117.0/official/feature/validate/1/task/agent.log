[agent:result] #!/usr/bin/env python3
[agent:result] """Claude Code PreToolUse hook. Reads stdin JSON, classifies the call as
[agent:result] cli / mcp / sdk / python / bash / other, appends one JSONL line to
[agent:result] TESTBED_COMMAND_LOG, and blocks calls that escape the boundary or run
[agent:result] unobservable background work.
[agent:result] 
[agent:result] Exit 0 → allow. Non-zero → block (claude-code rejects the call, shows the
[agent:result] error to the model).
[agent:result] 
[agent:result] Blocked:
[agent:result]   - Tool-input flags `dangerouslyDisableSandbox: true`, `run_in_background: true`.
[agent:result]   - `Read`/`Write`/`Edit` paths outside the boundary (`TESTBED_BOUNDARY`) or at
[agent:result]     sensitive $HOME subdirs. Only way to enforce these denies under
[agent:result]     `bypassPermissions`: `permissions.deny` patterns are silently skipped in
[agent:result]     bypass mode, but PreToolUse hooks fire in every mode.
[agent:result] """
[agent:result] 
[agent:result] from __future__ import annotations
[agent:result] 
[agent:result] import json
[agent:result] import os
