[agent:result]     # ("none" or unset) trains locally by design — never blocked.
[agent:result]     if interface not in ("cli", "mcp", "sdk"):
[agent:result]         return None
[agent:result]     cli_binary = os.environ.get("TESTBED_CLI_BINARY") or None
