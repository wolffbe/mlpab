[agent] All uploaded. Now I'll create the training dataset table with a single point-in-time as-of join in SQL. Transactions and transactions_late are unioned (same data). I use `QUALIFY row_number()` to pick the most-recent row at-or-before `label_time` per source, and LEFT JOINs to keep every label row.
[agent:bash] cat > .tmp_query.sql <<'SQL'
[agent:bash] CREATE OR REPLACE TABLE workspace.mlpabef05e2.churntraining605fb7 AS
[agent:bash] WITH tx AS (
[agent:bash]   SELECT account_id, CAST(event_time AS BIGINT) AS event_time, CAST(amount AS DOUBLE) AS amount, CAST(balance AS DOUBLE) AS balance
[agent:bash]   FROM read_files('/Volumes/workspace/mlpabef05e2/rawdata/transactions.csv', format => 'csv', header => true)
[agent:bash]   UNION ALL
[agent:bash]   SELECT account_id, CAST(event_time AS BIGINT), CAST(amount AS DOUBLE), CAST(balance AS DOUBLE)
[agent:bash]   FROM read_files('/Volumes/workspace/mlpabef05e2/rawdata/transactions_late.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] prof AS (
[agent:bash]   SELECT account_id, CAST(event_time AS BIGINT) AS event_time, CAST(credit_score AS INT) AS credit_score, CAST(tier AS STRING) AS tier
[agent:bash]   FROM read_files('/Volumes/workspace/mlpabef05e2/rawdata/profiles.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] act AS (
[agent:bash]   SELECT account_id, CAST(event_time AS BIGINT) AS event_time, CAST(sessions_7d AS INT) AS sessions_7d
[agent:bash]   FROM read_files('/Volumes/workspace/mlpabef05e2/rawdata/activity.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] hlth AS (
[agent:bash]   SELECT account_id, CAST(event_time AS BIGINT) AS event_time, CAST(health_score AS DOUBLE) AS health_score
[agent:bash]   FROM read_files('/Volumes/workspace/mlpabef05e2/rawdata/account_health.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] lbl AS (
[agent:bash]   SELECT account_id, CAST(label_time AS BIGINT) AS label_time, CAST(churned AS INT) AS churned
[agent:bash]   FROM read_files('/Volumes/workspace/mlpabef05e2/rawdata/labels.csv', format => 'csv', header => true)
[agent:bash] ),
[agent:bash] tx_asof AS (
[agent:bash]   SELECT l.account_id, l.label_time, t.amount, t.balance
[agent:bash]   FROM lbl l JOIN tx t ON t.account_id = l.account_id AND t.event_time <= l.label_time
[agent:bash]   QUALIFY row_number() OVER (PARTITION BY l.account_id, l.label_time ORDER BY t.event_time DESC) = 1
[agent:bash] ),
[agent:bash] prof_asof AS (
[agent:bash]   SELECT l.account_id, l.label_time, p.credit_score, p.tier
[agent:bash]   FROM lbl l JOIN prof p ON p.account_id = l.account_id AND p.event_time <= l.label_time
[agent:bash]   QUALIFY row_number() OVER (PARTITION BY l.account_id, l.label_time ORDER BY p.event_time DESC) = 1
[agent:bash] ),
[agent:bash] act_asof AS (
[agent:bash]   SELECT l.account_id, l.label_time, a.sessions_7d
[agent:bash]   FROM lbl l JOIN act a ON a.account_id = l.account_id AND a.event_time <= l.label_time
[agent:bash]   QUALIFY row_number() OVER (PARTITION BY l.account_id, l.label_time ORDER BY a.event_time DESC) = 1
[agent:bash] ),
[agent:bash] hlth_asof AS (
[agent:bash]   SELECT l.account_id, l.label_time, h.health_score
[agent:bash]   FROM lbl l JOIN hlth h ON h.account_id = l.account_id AND h.event_time <= l.label_time
[agent:bash]   QUALIFY row_number() OVER (PARTITION BY l.account_id, l.label_time ORDER BY h.event_time DESC) = 1
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   l.account_id,
[agent:bash]   l.label_time,
[agent:bash]   t.amount,
[agent:bash]   t.balance,
[agent:bash]   p.credit_score,
[agent:bash]   p.tier,
[agent:bash]   a.sessions_7d,
[agent:bash]   h.health_score,
[agent:bash]   l.churned
[agent:bash] FROM lbl l
[agent:bash] LEFT JOIN tx_asof   t ON t.account_id = l.account_id AND t.label_time = l.label_time
[agent:bash] LEFT JOIN prof_asof p ON p.account_id = l.account_id AND p.label_time = l.label_time
[agent:bash] LEFT JOIN act_asof  a ON a.account_id = l.account_id AND a.label_time = l.label_time
[agent:bash] LEFT JOIN hlth_asof h ON h.account_id = l.account_id AND h.label_time = l.label_time
[agent:bash] SQL
