[agent:result] 329	    retry_on_timeout: true
[agent:result] 330	    notebook_task:
[agent:result] 331	      notebook_path: ../src/flaky_task.py
[agent:result] 332	```
[agent:result] 333	
[agent:result] 334	### Python SDK
[agent:result] 335	
[agent:result] 336	```python
[agent:result] 337	from databricks.sdk.service.jobs import Task, NotebookTask
[agent:result] 338	
[agent:result] 339	Task(
[agent:result] 340	    task_key="flaky_task",
[agent:result] 341	    max_retries=3,
[agent:result] 342	    min_retry_interval_millis=30000,
[agent:result] 343	    retry_on_timeout=True,
[agent:result] 344	    notebook_task=NotebookTask(
[agent:result] 345	        notebook_path="/Workspace/flaky_task"
