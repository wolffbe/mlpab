[agent] Table loaded correctly (13500 rows, 150 entities, 90 days). Now let me find which feature drifted. First, identify the feature by comparing between-day variance of daily means vs within-day variance (a step-shift inflates between-day variance):
[agent:bash] databricks experimental aitools tools query "
[agent:bash] WITH daily AS (
[agent:bash]   SELECT event_date,
[agent:bash]     avg(f1) m1, avg(f2) m2, avg(f3) m3, avg(f4) m4, avg(f5) m5, avg(f6) m6,
[agent:bash]     var_pop(f1) v1, var_pop(f2) v2, var_pop(f3) v3, var_pop(f4) v4, var_pop(f5) v5, var_pop(f6) v6
[agent:bash]   FROM workspace.mlpabd051e2.features GROUP BY event_date
[agent:bash] )
[agent:bash] SELECT
[agent:bash]   round(var_pop(m1)/avg(v1),4) f1, round(var_pop(m2)/avg(v2),4) f2, round(var_pop(m3)/avg(v3),4) f3,
[agent:bash]   round(var_pop(m4)/avg(v4),4) f4, round(var_pop(m5)/avg(v5),4) f5, round(var_pop(m6)/avg(v6),4) f6
[agent:bash] FROM daily" 2>&1 | head -30
