[agent] f3 stands out dramatically (ratio 3.94 vs ~0.006 for others). f3 drifted. Now find the onset date via changepoint detection on f3's daily mean:
[agent:bash] databricks experimental aitools tools query "
[agent:bash] WITH daily AS (
[agent:bash]   SELECT event_date, avg(f3) m3 FROM workspace.mlpabd051e2.features GROUP BY event_date
[agent:bash] ),
[agent:bash] ranked AS (
[agent:bash]   SELECT event_date, m3,
[agent:bash]     row_number() OVER (ORDER BY event_date) rn,
[agent:bash]     count(*) OVER () tot,
[agent:bash]     avg(m3) OVER () gmean
[agent:bash]   FROM daily
[agent:bash] ),
[agent:bash] splits AS (
[agent:bash]   SELECT a.event_date AS split_date, a.rn AS k,
[agent:bash]     avg(CASE WHEN b.rn <= a.rn THEN b.m3 END) AS mean_before,
[agent:bash]     avg(CASE WHEN b.rn >  a.rn THEN b.m3 END) AS mean_after,
[agent:bash]     a.rn AS n1, a.tot - a.rn AS n2
[agent:bash]   FROM ranked a CROSS JOIN ranked b
[agent:bash]   GROUP BY a.event_date, a.rn, a.tot
[agent:bash] )
[agent:bash] SELECT split_date, round(mean_before,4) mean_before, round(mean_after,4) mean_after,
[agent:bash]   round(abs(mean_before-mean_after),4) gap
[agent:bash] FROM splits
[agent:bash] WHERE k BETWEEN 3 AND 87
[agent:bash] ORDER BY gap DESC LIMIT 8" 2>&1 | head -60
