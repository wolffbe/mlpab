[agent] Now compute features and insert. Using a timezone-independent UTC weekend calc and a range window for the 7-day sum.
[agent:bash] databricks api post /api/2.0/sql/statements --json '{"warehouse_id":"4dfab06c923fe3cc","catalog":"workspace","schema":"mlpab824ae3","wait_timeout":"50s","statement":"INSERT INTO workspace.mlpab824ae3.features74f1ef SELECT t.row_id, t.account_id, CAST(t.event_time AS BIGINT) AS event_time, CAST(t.amount AS DOUBLE) * CAST(f.fx_rate AS DOUBLE) AS amount_usd, CASE WHEN ((CAST(floor(CAST(t.event_time AS BIGINT)/86400000) AS BIGINT) + 4) % 7) IN (0,6) THEN 1 ELSE 0 END AS is_weekend, SUM(CAST(t.amount AS DOUBLE)) OVER (PARTITION BY t.account_id ORDER BY CAST(t.event_time AS BIGINT) RANGE BETWEEN 604800000 PRECEDING AND CURRENT ROW) AS amount_7d FROM read_files(\"/Volumes/workspace/mlpab824ae3/data74f1ef/transactions.csv\", format => \"csv\", header => true) t JOIN read_files(\"/Volumes/workspace/mlpab824ae3/data74f1ef/fx_rates.csv\", format => \"csv\", header => true) f ON t.currency = f.currency"}' 2>&1 | grep -E '"state"|"message"|error' | head -20
