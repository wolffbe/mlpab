@misc{erol_test-time_2026,
	title = {Test-{Time} {Optimization} of {Physical} {Query} {Plans} with {LLMs}},
	url = {http://arxiv.org/abs/2602.10387},
	doi = {10.48550/arXiv.2602.10387},
	abstract = {Traditional query optimization relies on cost-based optimizers that estimate execution cost (e.g., runtime, memory, and I/O) using predefined heuristics and statistical models. Improving these requires substantial engineering effort, yet they often cannot exploit semantic correlations in queries and schemas that could enable better physical plans. Large language models (LLMs), however, can reason about column semantics, value distributions, and broader domain context that classical statistics miss. We introduce DBPlanBench, a harness for the DataFusion engine that exposes physical plans through a compact serialized representation and applies LLM-proposed edits as JSON patches. On this harness, we instantiate a test-time optimization workflow where an LLM examines physical query plans, proposes localized edits based on semantic reasoning, and an evolutionary search refines the candidates across iterations. We target OLAP queries, where heavy, repeated execution turns even small efficiency gains into substantial cumulative savings. We specifically focus our evaluation on join reordering and join-side selection, where cardinality-estimation errors compound multiplicatively. Median speedups reach \$1.10\$-\$1.12{\textbackslash}times\$ on TPC-H and \$1.05\$-\$1.07{\textbackslash}times\$ on TPC-DS, with some achieving up to \$4.78{\textbackslash}times\$. We also demonstrate that optimizations discovered at small scale factors transfer effectively to larger ones, supporting a low-cost small-to-large workflow.},
	urldate = {2026-07-15},
	publisher = {arXiv},
	author = {Erol, Mehmet Hamza and Hao, Xiangpeng and Bianchi, Federico and Greco, Ciro and Tagliabue, Jacopo and Zou, James},
	month = jun,
	year = {2026},
	note = {arXiv:2602.10387 [cs.DB]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Databases},
	annote = {Comment: Code is available at: https://github.com/BauplanLabs/DBPLANBENCH},
}

