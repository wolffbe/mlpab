{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MlpabExecutionRoleBootstrap",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:CreateRole", "iam:AttachRolePolicy", "iam:PutRolePolicy"],
      "Resource": "arn:aws:iam::710271938540:role/mlpab-sagemaker-execution-role"
    },
    {
      "Sid": "MlpabPassExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::710271938540:role/mlpab-sagemaker-execution-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "sagemaker.amazonaws.com" }
      }
    }
  ]
}
