runs/
# results/ (generated run output) and configs/treatments/ are TRACKED so runs
# and treatment definitions are versioned and never silently lost. The committed
# `.githooks/pre-commit` guard (enabled via `git config core.hooksPath
# .githooks`, run by `make install`) blocks the two things that must never land
# in git: secret VALUES (matched against .env) and per-run venvs. Per-run venvs
# are still excluded here too — they are pure build artifacts (multi-GB CoW
# clones), torn down after each run, never worth versioning.
results/**/venv/
# setuptools editable-install metadata (auto-generated build output)
*.egg-info/
src/mlpab.egg-info/
# configs/ holds yaml manifests plus committed platform CONTENT (skills
# SKILL.md trees, setup/teardown .py files). build/ is the gitignored BUILD
# HOME ($INTERFACE_DIR): source checkouts + built wheels/binaries, rebuilt on
# demand.
build/
__pycache__/
.ruff_cache/
.venv/
.env
.python-version
cache/
.DS_Store
config/
.claude-oauth
# scratch dirs from ad-hoc probes — should never be committed
.runtime/
_sbxtest/
_denytest/
.azure/
.gcp/
# Entire session tracker (removed; ignore if the CLI regenerates it)
.entire/
# local tectonic compile helper (symlink) and build artifacts
docs/thesis/thesis
docs/thesis/*.pdf
docs/thesis/*.log
